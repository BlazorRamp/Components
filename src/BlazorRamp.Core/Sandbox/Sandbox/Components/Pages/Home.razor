@code{

    private ElementReference MyContainer { get; set; }

    private async Task TestService()
    {
        var announcement = new Announcement("Test replay", AnnouncementType.Info, "TestService Button", LiveRegionType.Polite);

        await _liveRegionService.MakeAnnouncement(announcement, true);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(true == firstRender)
        {
           await _coreUtilityService.RegisterContainerForAutoTabindex(MyContainer);
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await _coreUtilityService.UnregisterContainerForAutoTabindex(MyContainer);
        }
        catch{}
    }


}