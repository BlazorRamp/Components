<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
	<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\..\assets\BlazorRampKey.snk</AssemblyOriginatorKeyFile>
    <Title>BlazorRamp.Core</Title>
    <Copyright>Copyright (c) 2026 Paul Kent and BlazorRamp Contributors</Copyright>
    <PackageProjectUrl>https://github.com/BlazorRamp/Components</PackageProjectUrl>
    <RepositoryUrl>https://github.com/BlazorRamp/Components</RepositoryUrl>
    <PackageTags>Blazor; Accessible Components; Accessibility; ARIA; Live Region;</PackageTags>
    <PackageReleaseNotes>Restored binary compatibility for pre-compiled consumers by adding an explicit single-parameter overload of MakeAnnouncement. The v1.1.0 release introduced a replayable parameter with a default value which, while source-compatible, broke binary compatibility for assemblies compiled against the previous interface signature.</PackageReleaseNotes>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <AssemblyVersion>1.1.1</AssemblyVersion>
    <FileVersion>1.1.1</FileVersion>
	  <Version>1.1.1</Version>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
	  <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
	  <Deterministic>true</Deterministic>
	  <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
	  <Authors>Paul Kent</Authors>
	  <PackageId>$(AssemblyName)</PackageId>
	  <Description>Core project for Blazor Ramp that contians a Live Regions Service and an Announcement History component. 
All Blazor Ramp components reference this project.
</Description>
	  <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<DebugType>embedded</DebugType>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<DebugType>embedded</DebugType>
	</PropertyGroup>

  <ItemGroup>
    <Content Remove="compilerconfig.json" />
  </ItemGroup>


  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="8.0.28" />
		<PackageReference Include="BuildWebCompiler2022" Version="1.14.15">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<!-- 
		It seems having the typesript msbuild causes the static asset errors. The compiler works without it
		but you cannot debug - so include it when debugging.
	  -->
		<!--<PackageReference Include="Microsoft.TypeScript.MSBuild" Version="6.0.3">
	    <PrivateAssets>all</PrivateAssets>
	    <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	  </PackageReference>-->
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="BlazorRamp.Switch" key="" />
		<InternalsVisibleTo Include="BlazorRamp.DocSite" key="" />
		<InternalsVisibleTo Include="BlazorRamp.WebSite" key="" />
		<InternalsVisibleTo Include="BlazorRamp.SkipTo" key="" />
		<InternalsVisibleTo Include="BlazorRamp.BusyIndicator" key="" />
		<InternalsVisibleTo Include="BlazorRamp.BusyIndicator.Tests.Unit" key="" />
		<InternalsVisibleTo Include="BlazorRamp.Core.Tests.Unit" key="" />
	</ItemGroup>


	<ItemGroup>
    <Folder Include="wwwroot\assets\js\" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\LICENSE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="compilerconfig.json" />
  </ItemGroup>
	
<!--<ItemGroup>
	<None Update="tsconfig.json">
		<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		<CopyToPublishDirectory>Never</CopyToPublishDirectory>
		<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
	</None>
	<Content Update="tsconfig.json">
		<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		<CopyToPublishDirectory>Never</CopyToPublishDirectory>
		<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
	</Content>
</ItemGroup>-->


</Project>
