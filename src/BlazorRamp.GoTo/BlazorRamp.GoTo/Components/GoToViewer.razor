<dialog id="@_gotoViewerID" class="@GlobalValues.GoTo_Viewer_Block_Class @GlobalValues.GoTo_Viewer_Base_Class" popover="auto" aria-label="Goto Viewer" tabindex="-1">



        <h2 class="@GlobalValues.GoTo_Viewer_Header_Class">Goto Viewer</h2>

        <div class="@GlobalValues.GoTo_Viewer_Content_Class">

            @if (_gotoList.Count != 0)
            {
                <ul>
                    @foreach (var gotoItem in _gotoList)
                    {
                        <li>
                            <button type="button" @onclick="(() => GoToMarker(gotoItem))" @onfocus="() => ScrollToMarker(gotoItem.MarkerID)">@gotoItem.GoToNumber - @gotoItem.GoToText</button>
                        </li>
                    }
                </ul>
            }


            @*         <h2 id="@CoreGlobalValues.AH_Title_ID" class="@CoreGlobalValues.AH_Header_Class">
            @_historyTitle
        </h2>
        <div id="@CoreGlobalValues.AH_Content_ID" class="@CoreGlobalValues.AH_Content_Class" tabindex="-1">
            <ol class="@CoreGlobalValues.AH_Ol_list_Class"></ol>
            <p>@_noDataText</p>
        </div> *@
            <div class="@GlobalValues.GoTo_Viewer_Footer_Class">
                <button type="button" class="@GlobalValues.GoTo_Viewer_Footer_Button_Class">@_closeButtonText</button>
            </div>
        </div>


</dialog>


