<dialog id="@_gotoViewerID" class="@GlobalValues.GoTo_Viewer_Block_Class" popover="auto" aria-labelledby="@_headingTextID" tabindex="-1">

    <div class="@GlobalValues.GoTo_Viewer_Content_Area_Class">
        <h2 id="@_headingTextID" class="@GlobalValues.GoTo_Viewer_Header_Class">Goto Viewer</h2>

        <div class="@GlobalValues.GoTo_Viewer_Content_Class">

            @if (_gotoList.Count != 0)
            {
                <ul>
                    @foreach (var gotoItem in _gotoList)
                    {
                        <li>
                            <button type="button" @onclick="(() => GoToMarker(gotoItem))" @onfocus="() => ScrollToMarker(gotoItem.MarkerID)">@gotoItem.GoToNumber - @gotoItem.GoToText</button>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p style="text-align:center">
                    @_noGoToMarkersText
                </p>
            }
        </div>

        <div class="@GlobalValues.GoTo_Viewer_Footer_Class">
            <button type="button" class="@GlobalValues.GoTo_Viewer_Footer_Button_Class" @onclick="async () => await CloseGotoViewer(_gotoViewerID)">@_closeButtonText</button>
        </div>
    </div>

</dialog>


