

<nav class="@GetPagerClasses(PageAlignment)">

    <span id="@_ariaLabelID">@_ariaLabel</span>

    <div class="@GlobalValues.Pager_Items_Class">

        @if (PagerSelectorType == PagerSelectorType.Button)
        {

            @if (_showFirstLast)
            {

                <button type="button" class="@GlobalValues.Pager_Button_Class @GlobalValues.Pager_Button_First_Modifier" @onclick="() => RequestPageChange(NavSelectorType.First, 1, _lastPage)"
                aria-disabled="@CheckSetDisableButton(NavSelectorType.First, _currentPage, _lastPage, _currentRowCount, _totalRowCount)" tabindex="@CheckSetTabIndex(NavSelectorType.First, _currentPage, _lastPage, _currentRowCount, _totalRowCount)">
                    <span class="@GlobalValues.Pager_Icon_Class @GlobalValues.Pager_Icon_First_Modifier"></span>
                    <span class="@GlobalValues.Pager_Selector_Text_Class">@_firstText</span>
                </button>
            }
            <button @ref="PreviousNavRef" id="@_navSelectorPreviousID" type="button" class="@GlobalValues.Pager_Button_Class @GlobalValues.Pager_Button_Previous_Modifier" @onclick="() => RequestPageChange(NavSelectorType.Previous, _currentPage - 1, _lastPage)"
            aria-disabled="@CheckSetDisableButton(NavSelectorType.Previous, _currentPage, _lastPage, _currentRowCount, _totalRowCount)" tabindex="@CheckSetTabIndex(NavSelectorType.Previous, _currentPage, _lastPage, _currentRowCount, _totalRowCount)">
                <span class="@GlobalValues.Pager_Icon_Class @GlobalValues.Pager_Icon_Prev_Modifier"></span>
                <span class="@GlobalValues.Pager_Selector_Text_Class">@_prevText</span>
            </button>
            <button @ref="@NextNavRef" id="@_navSelectorNextID" type="button" class="@GlobalValues.Pager_Button_Class @GlobalValues.Pager_Button_Next_Modifier" @onclick="() => RequestPageChange(NavSelectorType.Next, _currentPage + 1, _lastPage)"
            aria-disabled="@CheckSetDisableButton(NavSelectorType.Next, _currentPage, _lastPage, _currentRowCount, _totalRowCount)" tabindex="@CheckSetTabIndex(NavSelectorType.Next, _currentPage, _lastPage, _currentRowCount, _totalRowCount)">
                <span class="@GlobalValues.Pager_Selector_Text_Class">@_nextText</span>
                <span class="@GlobalValues.Pager_Icon_Class @GlobalValues.Pager_Icon_Next_Modifier"></span>
            </button>

            @if (_showFirstLast)
            {
                <button type="button" class="@GlobalValues.Pager_Button_Class @GlobalValues.Pager_Button_Last_Modifier" @onclick="() => RequestPageChange(NavSelectorType.Last, _lastPage, _lastPage)"
                aria-disabled="@CheckSetDisableButton(NavSelectorType.Last, _currentPage, _lastPage, _currentRowCount, _totalRowCount)" tabindex="@CheckSetTabIndex(NavSelectorType.Last, _currentPage, _lastPage, _currentRowCount, _totalRowCount)">
                    <span class="@GlobalValues.Pager_Selector_Text_Class">@_lastText</span>
                    <span class="@GlobalValues.Pager_Icon_Class @GlobalValues.Pager_Icon_Last_Modifier"></span>
                </button>
            }

            <div id="@_infoTextID" class="@GlobalValues.Pager_Information_Class">@_informationText</div>
        }

    </div>
    
</nav>























