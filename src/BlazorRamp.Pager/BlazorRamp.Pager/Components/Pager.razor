

<nav @ref="NavElementRef" class="@GetPagerClasses(PageAlignment)" aria-labelledby="@_ariaLabelledbyIDs">

    <span id="@_ariaLabelID">@_ariaLabel</span>

    <div class="@GlobalValues.Pager_Items_Class">

        @if (PagerSelectorType == PagerSelectorType.Button)
        {

            @if (_showFirstLast)
            {

                <button type="button" class="@GlobalValues.Pager_Button_Class @GlobalValues.Pager_Button_First_Modifier" @onclick="() => RequestPageChange(NavSelectorType.First,_currentPage,  1, _lastPage)"
                aria-disabled="@CheckSetDisableButton(NavSelectorType.First, _currentPage, _lastPage, _currentRowCount, _totalRowCount)">
                    <span class="@GlobalValues.Pager_Icon_Class @GlobalValues.Pager_Icon_First_Modifier"></span>
                    <span class="@GlobalValues.Pager_Selector_Text_Class">@_firstText</span>
                </button>
            }
            
            <button type="button" class="@GlobalValues.Pager_Button_Class @GlobalValues.Pager_Button_Previous_Modifier" @onclick="() => RequestPageChange(NavSelectorType.Previous, _currentPage, _currentPage - 1, _lastPage)"
            aria-disabled="@CheckSetDisableButton(NavSelectorType.Previous, _currentPage, _lastPage, _currentRowCount, _totalRowCount)" >
                <span class="@GlobalValues.Pager_Icon_Class @GlobalValues.Pager_Icon_Prev_Modifier"></span>
                <span class="@GlobalValues.Pager_Selector_Text_Class">@_prevText</span>
            </button>

            <button type="button" class="@GlobalValues.Pager_Button_Class @GlobalValues.Pager_Button_Next_Modifier" @onclick="() => RequestPageChange(NavSelectorType.Next, _currentPage, _currentPage + 1, _lastPage)"
            aria-disabled="@CheckSetDisableButton(NavSelectorType.Next, _currentPage, _lastPage, _currentRowCount, _totalRowCount)" >
                <span class="@GlobalValues.Pager_Selector_Text_Class">@_nextText</span>
                <span class="@GlobalValues.Pager_Icon_Class @GlobalValues.Pager_Icon_Next_Modifier"></span>
            </button>

            @if (_showFirstLast)
            {
                <button type="button" class="@GlobalValues.Pager_Button_Class @GlobalValues.Pager_Button_Last_Modifier" @onclick="() => RequestPageChange(NavSelectorType.Last, _currentPage, _lastPage, _lastPage)"
                aria-disabled="@CheckSetDisableButton(NavSelectorType.Last, _currentPage, _lastPage, _currentRowCount, _totalRowCount)">
                    <span class="@GlobalValues.Pager_Selector_Text_Class">@_lastText</span>
                    <span class="@GlobalValues.Pager_Icon_Class @GlobalValues.Pager_Icon_Last_Modifier"></span>
                </button>
            }

        }
        else
        {

            @if (_showFirstLast)
            {
                <a href="@UpdateUriQueryParams(1, _currentPage, _lastPage, _queryParamName)" class="@GlobalValues.Pager_Link_Class @GlobalValues.Pager_Link_First_Modifier"
                        @onclick="() => RequestPageChange(NavSelectorType.First, _currentPage, 1, _lastPage)" @onclick:preventDefault tabindex="0"
                        aria-disabled="@CheckSetDisableButton(NavSelectorType.First, _currentPage, _lastPage, _currentRowCount, _totalRowCount)">
                        <span class="@GlobalValues.Pager_Icon_Class @GlobalValues.Pager_Icon_First_Modifier"></span>
                        <span class="@GlobalValues.Pager_Selector_Text_Class">@_firstText</span>
                    </a>
                }

            <a href="@UpdateUriQueryParams(_currentPage - 1, _currentPage, _lastPage, _queryParamName)" class="@GlobalValues.Pager_Link_Class @GlobalValues.Pager_Link_Previous_Modifier"
                   @onclick="() => RequestPageChange(NavSelectorType.Previous, _currentPage, _currentPage - 1, _lastPage)" @onclick:preventDefault tabindex="0"
                    aria-disabled="@CheckSetDisableButton(NavSelectorType.Previous, _currentPage, _lastPage, _currentRowCount, _totalRowCount)">
                    <span class="@GlobalValues.Pager_Icon_Class @GlobalValues.Pager_Icon_Prev_Modifier"></span>
                    <span class="@GlobalValues.Pager_Selector_Text_Class">@_prevText</span>
             </a>

            <a href="@UpdateUriQueryParams(_currentPage + 1, _currentPage, _lastPage, _queryParamName)" class="@GlobalValues.Pager_Link_Class @GlobalValues.Pager_Link_Next_Modifier"
                @onclick="() => RequestPageChange(NavSelectorType.Next, _currentPage, _currentPage + 1, _lastPage)" @onclick:preventDefault tabindex="0"
               aria-disabled="@CheckSetDisableButton(NavSelectorType.Next, _currentPage, _lastPage, _currentRowCount, _totalRowCount)">
                <span class="@GlobalValues.Pager_Selector_Text_Class">@_nextText</span>
                <span class="@GlobalValues.Pager_Icon_Class @GlobalValues.Pager_Icon_Next_Modifier"></span>
            </a>

            @if (_showFirstLast)
            {
                <a href="@UpdateUriQueryParams(_lastPage, _currentPage, _lastPage, _queryParamName)" class="@GlobalValues.Pager_Link_Class @GlobalValues.Pager_Link_Last_Modifier"
                    @onclick="() => RequestPageChange(NavSelectorType.Last, _currentPage, _lastPage, _lastPage)" @onclick:preventDefault tabindex="0"
                   aria-disabled="@CheckSetDisableButton(NavSelectorType.Last, _currentPage, _lastPage, _currentRowCount, _totalRowCount)">
                    <span class="@GlobalValues.Pager_Selector_Text_Class">@_lastText</span>
                    <span class="@GlobalValues.Pager_Icon_Class @GlobalValues.Pager_Icon_Last_Modifier"></span>
                </a>
            }


        }
        <div id="@_infoTextID" class="@GlobalValues.Pager_Information_Class">@_informationText</div>
    </div>
    
</nav>

