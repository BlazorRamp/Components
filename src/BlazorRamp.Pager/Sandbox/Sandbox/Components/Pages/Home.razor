@page "/"


<PageTitle>Home</PageTitle>


@rendermode @(new InteractiveServerRenderMode(false))

<h1>Hello, world!</h1>

Welcome to your new app.

<p>
    <Pager @bind-CurrentPage="buttonCurrentPage" TotalItemCount="100" CurrentItemCount="69" ItemsPerPage="10" PagerSelectorType="PagerSelectorType.Button" ShowFirstLast="false"></Pager>
</p>
<Pager @bind-CurrentPage="linkCurrentPage" TotalItemCount="100" CurrentItemCount="100" ItemsPerPage="10" PagerSelectorType="PagerSelectorType.Link" ShowFirstLast="false"></Pager>

<button @onclick="() => linkCurrentPage = 3">Set to zero</button>
@code{
    private int buttonCurrentPage = 1;
    private int linkCurrentPage = 1;
}