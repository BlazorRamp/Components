@page "/"

@rendermode @(new InteractiveServerRenderMode(false))

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>

Welcome to your new app.
<p>
    <Pager @bind-CurrentPage="buttonCurrentPage" AriaLabel="Min Button" TotalItemCount="100" CurrentItemCount="69" ItemsPerPage="10" 
   PagerAnnouncementType="PagerAnnouncementType.WithoutAnnouncement" PagerSelectorType="PagerSelectorType.Button" ShowFirstLast="false"></Pager>
</p>
<p>
    <Pager @bind-CurrentPage="buttonCurrentPage" AriaLabel="Full Button" TotalItemCount="100" CurrentItemCount="69" 
    PagerAnnouncementType="PagerAnnouncementType.WithAnnouncement" ItemsPerPage="10" PagerSelectorType="PagerSelectorType.Button" ShowFirstLast="true"></Pager>
</p>
<p>
    <Pager @bind-CurrentPage="linkCurrentPage" AriaLabel="Min LInk" TotalItemCount="100" CurrentItemCount="100" ItemsPerPage="10" PagerSelectorType="PagerSelectorType.Link" ShowFirstLast="false"></Pager>
</p>
