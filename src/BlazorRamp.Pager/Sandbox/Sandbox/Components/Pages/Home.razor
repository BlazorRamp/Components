    <Pager @bind-CurrentPage="linkCurrentPage" AriaLabel="Full Link" TotalItemCount="100" CurrentItemCount="100" ItemsPerPage="10" PagerSelectorType="PagerSelectorType.Link" ShowFirstLast="true"></Pager>
</p> *@

