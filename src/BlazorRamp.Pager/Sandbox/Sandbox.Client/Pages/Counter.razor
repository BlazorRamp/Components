@page "/counter"
@rendermode InteractiveAuto

<PageTitle>Counter</PageTitle>

<h1>Counter</h1>

<p role="status">Current count: @currentCount</p>

<button class="btn btn-primary" @onclick="IncrementCount">Click me</button>


@* <p>
    <Pager @bind-CurrentPage="fullCurrentPage" TotalItemCount="100" CurrentItemCount="100" ItemsPerPage="10" PagerSelectorType="PagerSelectorType.Button" ShowFirstLast="false"></Pager>
</p> *@
<p>
    <Pager @bind-CurrentPage="minCurrentPage" TotalItemCount="50" CurrentItemCount="50" ItemsPerPage="10" PagerSelectorType="PagerSelectorType.Button" ShowFirstLast="true"></Pager>
</p>
@* <p>
    <Pager @bind-CurrentPage="fulllinkCurrentPage" TotalItemCount="100" CurrentItemCount="100" ItemsPerPage="10" PagerSelectorType="PagerSelectorType.Link" ShowFirstLast="false"></Pager>
</p>
<p>
    <Pager @bind-CurrentPage="minlinkCurrentPage" TotalItemCount="50" CurrentItemCount="50" ItemsPerPage="10" PagerSelectorType="PagerSelectorType.Link" ShowFirstLast="true"></Pager>
</p> *@


@code{
    private int fullCurrentPage = 1;
    private int minCurrentPage = 1;
    private int fulllinkCurrentPage = 1;
    private int minlinkCurrentPage = 1;

    private int currentCount = 0;

    private void IncrementCount()
    {
        currentCount++;
    }
}
