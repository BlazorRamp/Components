<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
	  <AssemblyOriginatorKeyFile>..\..\..\assets\BlazorRampKey.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <ItemGroup>
	  <PackageReference Include="AngleSharp" Version="1.10.0" />
	  <PackageReference Include="BlazorRamp.Core" Version="1.1.9" />
	  <PackageReference Include="bunit" Version="2.14.0" />
	  <PackageReference Include="coverlet.collector" Version="10.1.0">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	  </PackageReference>
	  <PackageReference Include="FluentAssertions" Version="8.11.0" />
	  <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
	  <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	  </PackageReference>
	  <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>


  <ItemGroup>
	  <AssemblyAttribute Include="System.Diagnostics.CodeAnalysis.ExcludeFromCodeCoverageAttribute" />
  </ItemGroup>


  <ItemGroup>
	  <ProjectReference Include="..\BlazorRamp.Notifications\BlazorRamp.Notifications.csproj" />
  </ItemGroup>
  <ItemGroup>
	  <Using Include="Xunit" />
  </ItemGroup>

</Project>
