
<dialog id="@GlobalValues.Notification_Centre_Dialog_ID" class="@GlobalValues.Notification_Centre_Class" popover="auto">

    <div class="@GlobalValues.Notification_Centre_Content_Area_Class">
        <h2 class="@GlobalValues.Notification_Centre_Header_Class">
            @_headingText
        </h2>
        <div class="@GlobalValues.Notification_Centre_Dialog_Actions_Class">
            <button class="@GlobalValues.Notification_Centre_Button_Class"  type="button" @onclick="RemoveNotifications">
                <span class="@GlobalValues.Notification_Centre_Remove_Icon_Class"></span>
                <span>@_removeAllText</span>    
            </button>
        </div>
        <div class="@GlobalValues.Notification_Centre_Content_Class">
            @if(_notificationItems.Count > 0)
            {
                <ul role="list">
                    @foreach (var notificationItem in _notificationItems)
                    {
                        <Notification NotificationItem="notificationItem" RemoveText="@_removeText" />
                    }
                </ul>
            }
        </div>

        <div class="@GlobalValues.Notification_Centre_Footer_Class">
            <button class="@GlobalValues.Notification_Centre_Button_Class" type="button" @onclick="CloseCentre">
                @_closeText
            </button>
        </div>

    </div>

</dialog>


