@page "/counter"
@rendermode @(new InteractiveWebAssemblyRenderMode(false))

@inject INotificationService _notificationService;

<PageTitle>Counter</PageTitle>

<style>
    h1:focus{
        border: 2px solid red;
    }
</style>

<h1 tabindex="0">Counter</h1>

<p role="status">Current count: @currentCount</p>

<button id="count-button" class="btn btn-primary" @onclick="IncrementCount">Click me</button>

<p>@location</p>
<button @onclick="Test">Test</button>
@code {
    private int currentCount = 0;
    private string location = "Server";
    private int counter = 1000;
    private void IncrementCount()
    {
        currentCount++;
    }

    protected override void OnInitialized()
    {
        location = OperatingSystem.IsBrowser() ? "Wasm" : "Server";
    }

    private async Task Test()
    {
        var notification = new NotificationItem { Title = $"Test Message {counter}; ", Message = "Some message", ActionText = "View this message", ActionUrl = "/counter" };
        counter++;
        await _notificationService.AddNotificationItem(notification);

        var all = await _notificationService.GetNotifications();

    }
}
