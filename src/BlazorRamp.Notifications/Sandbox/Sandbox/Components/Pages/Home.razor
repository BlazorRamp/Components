@page "/"
@using BlazorRamp.Notifications.Common.Models


@rendermode @(new InteractiveServerRenderMode(false))

@inject INotificationService _notificationService;

<PageTitle>Home</PageTitle>

<h1>Hello, world! - @_location</h1>

Welcome to your new app.

<p>Service ID: @_notificationService.ServiceID</p>

<button @onclick="Test" >Test</button>
@code{

    private string _location = "Server";


    private async Task Test()
    {
        var notification = new NotificationItem { Title = "Test Message", Message = "Some message" };

        await _notificationService.AddNotificationItem(notification);

        var all = await _notificationService.GetNotifications();

    }

protected override void OnInitialized()
{
    _location = OperatingSystem.IsBrowser() ? "Wasm" : "Server";
}

}