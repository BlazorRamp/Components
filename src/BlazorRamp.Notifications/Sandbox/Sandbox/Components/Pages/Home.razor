@page "/"
@using System.Timers


@rendermode @(new InteractiveServerRenderMode(false))

@inject INotificationService _notificationService;

<PageTitle>Home</PageTitle>

<h1>Hello, world! - @_location</h1>

Welcome to your new app.

<p>Service ID: @_notificationService.ServiceID</p>

<button @onclick="Test">Test</button>
<button @onclick="StartTimer">Start Timeer</button>
@code {

    private string _location = "Server";

    private System.Timers.Timer timer = new System.Timers.Timer();

    private int counter = 1;

    private void StartTimer()
    {
        timer.Interval = 5000;
        timer.Start();
    }


    private async void OnTimedEvent(Object source, ElapsedEventArgs e)
    {
        await Test();
    }


    private async Task Test()
    {
        var notification = new NotificationItem { Title = $"Test Message {counter}; ", Message = "Some message", ActionText="View this message", ActionUrl="/counter" };
        counter++;
        await _notificationService.AddNotificationItem(notification);

        var all = await _notificationService.GetNotifications();

    }

    protected override void OnInitialized()
    {
        _location = OperatingSystem.IsBrowser() ? "Wasm" : "Server";
        timer.Elapsed += OnTimedEvent;
    }

}