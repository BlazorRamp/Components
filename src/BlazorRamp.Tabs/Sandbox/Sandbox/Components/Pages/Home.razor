@page "/"
@using BlazorRamp.Tabs.Common.Constants
@using BlazorRamp.Tabs.Components

<PageTitle>Home</PageTitle>

@rendermode @(new InteractiveServerRenderMode(false))

<h1>Hello, world!</h1>

Welcome to your new app.


<Tabs ActiveTabIndex="_tabIndex" ActiveTabIndexChanged="TabChangedHandler" AutoActivatePanel="false">
    <Tab TabTitle="Tab One" SvgIcon="--svg-information-icon">
        <TabPanelContent>
            Tab one panel content <input type="text" />
        </TabPanelContent>
    </Tab>
    <Tab TabTitle="Tab Two" PersistContent="false">
        <TabPanelContent>
            Tab two panel content <input type="text" />
        </TabPanelContent>
    </Tab>
    <Tab TabTitle="Tab Three">
        <TabPanelContent>
            Tab three panel content <input type="text" />
        </TabPanelContent>
    </Tab>
</Tabs>

@code{


    private int _tabIndex = 0;

    private void TabChangedHandler(int index)

    => _tabIndex = index;
}