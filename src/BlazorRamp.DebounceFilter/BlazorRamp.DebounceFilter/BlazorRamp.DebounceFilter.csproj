<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
	  <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\..\assets\BlazorRampKey.snk</AssemblyOriginatorKeyFile>
    <Title>BlazorRamp.DebounceFilter</Title>
    <Version>1.0.0</Version>
    <Authors>Paul Kent</Authors>
    <Description>Debounce filter</Description>
    <Copyright>Copyright (c) 2026 Paul Kent and BlazorRamp Contributors</Copyright>
    <PackageProjectUrl>https://github.com/BlazorRamp/Components</PackageProjectUrl>
    <RepositoryUrl>https://github.com/BlazorRamp/Components</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>Blazor; Accessible Components; Accessibility; ARIA; Debounce; Filter;</PackageTags>
    <PackageReleaseNotes>Initial release of the BlazorRamp Debounce Filter</PackageReleaseNotes>
    <AssemblyVersion>1.0.0</AssemblyVersion>
    <FileVersion>1.0.0</FileVersion>
	  	  <PackageLicenseFile>LICENSE</PackageLicenseFile>	  	  <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
  </PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<DebugType>embedded</DebugType>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<DebugType>embedded</DebugType>
	</PropertyGroup>


	<ItemGroup>
    <Content Remove="compilerconfig.json" />
  </ItemGroup>


  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

	<ItemGroup>
		<PackageReference Include="BlazorRamp.Core" Version="1.1.1" />
		<PackageReference Include="BuildWebCompiler2022" Version="1.14.15" />
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="8.0.28" />

		<!-- 
		It seems having the typesript msbuild causes the static asset errors. The compiler works without it
		but you cannot debug - so include it when debugging.
	  -->
		<!--<PackageReference Include="Microsoft.TypeScript.MSBuild" Version="6.0.3">
	    <PrivateAssets>all</PrivateAssets>
	    <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	  </PackageReference>-->
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="wwwroot\assets\css\" />
	  <Folder Include="wwwroot\assets\js\" />
	</ItemGroup>

	<ItemGroup>
	  <None Include="..\..\..\LICENSE">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	  <None Include="..\README.md">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	  <None Include="compilerconfig.json" />
	</ItemGroup>

</Project>
