@page "/"
@using BlazorRamp.DebounceFilter.Common.Models


@rendermode InteractiveServer

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>

Welcome to your new app.


<DebounceFilter @ref="control" DebounceDelayMs="500" ValidationMessage="Invalid entry filtering paused, numbers only" RegexPattern="^[A-Za-z0-9]*$" SvgIcon="--svg-filter-icon"
                FilterLabelText="Filter Results" HintText="Data filtered on pause of typing." OnDebounceFilterResult="HandleDebounce"  ParseErrorMessage="System error, filtering is unavailable at this time." />

<div>
    Just som text in here to see it move
</div>

<button type="button" @onclick="Clear">Clear</button>

<button type="button">Focus On Me</button>
@code{

    public DebounceFilter control { get; set; }

    public async Task HandleDebounce(DebouncedFilterResult result)
    {
        if(result.IsValid)
        {
            var inputValue = result.FilterValue;

            /*
                * Pass the input value to your filtering mechanism 
                * And remember to inform Blazor as callback is using a Func not EventCallback.
            */
            await InvokeAsync(StateHasChanged); 

        }
    }


    public async Task Clear()
    {
        await control.ClearFilter();
    }
}
