@using Microsoft.AspNetCore.Components.Forms


<div @attributes="@AdditionalAttributes" id="@_containerID" class="@GlobalValues.Tooltip_class">
    @ChildContent
    <div id="@_tooltipID" popover="manual" role="tooltip" data-br-tooltip-position="@_tooltipPosition" class="@GlobalValues.Tooltip_Content_Wrapper_class">

        <div class="@GetContentAreaClasses(InvertColours)">
            <span class="@GlobalValues.Tooltip_Closer_Class" @onclick="async () => await CloseTooltip()" aria-hidden="true">
                <span class="@GlobalValues.Tooltip_icon_class"></span>
            </span>
            <span class="@GlobalValues.Tooltip_Content_class">
                @TooltipText
            </span>

        </div>
    </div>
</div>

