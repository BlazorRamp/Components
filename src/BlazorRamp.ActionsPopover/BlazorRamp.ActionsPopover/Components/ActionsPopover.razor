
<div @ref="ContainerElementRef" class="@(Stretch ? $"{GlobalValues.Actions_Popover_Class} {GlobalValues.Actions_Popover_Stretch_Modifier}" : GlobalValues.Actions_Popover_Class)">

    <button @attributes="@AdditionalAttributes" type="button" class="@GlobalValues.Actions_Popover_Trigger_Class" popovertarget="@_popoverPanelID">

        @if (_svgIcon is not null)
        {
            <span aria-hidden="true" class="@GlobalValues.Actions_Popover_Trigger_Icon_Class" style="@_svgIcon"></span>
        }
        <span id="@_triggerTextID" class="@GlobalValues.Actions_Popover_Trigger_Text_Class">@_triggerText</span>

        <span class="@GlobalValues.Actions_Popover_Trigger_Expander_Icon_Class" aria-hidden="true">
            <span></span>
        </span>
    </button>

    <div id="@_popoverPanelID" @ref="PopoverElementRef" 
        class="@GlobalValues.Actions_Popover_Panel_Class" 
        popover="auto" 
        data-br-actions-popover-position="@_popoverPosition">
        
        <ul aria-labelledby="@_triggerTextID">
            <CascadingValue Name="@GlobalValues.Actions_Popover_Panel_Cascading_ID_Name" Value="@_popoverPanelID" IsFixed="true">
                @PopoverItems
            </CascadingValue>
        </ul>

    </div>

</div>


