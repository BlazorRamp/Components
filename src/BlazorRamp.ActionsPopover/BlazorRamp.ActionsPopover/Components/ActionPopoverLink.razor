@typeparam TData

<li>
    <a @attributes="@AdditionalAttributes" @ref="AnchorElementRef" class="@GlobalValues.Actions_Popover_Action_Link_Class"
            href="@_path"
            target="@_targetType"
            tabindex="0"
            rel="@(TargetType == TargetType.Blank ? "noopener noreferrer" : null)"
            @onclick:stopPropagation="true"
            @onclick="() => RaiseOnClick(LinkText, ItemData, TargetType, _path)">

        <span 
              aria-hidden="true" 
              class="@(_svgIcon is null ? GlobalValues.Actions_Popover_Action_Icon_Slot_Class : $"{GlobalValues.Actions_Popover_Action_Icon_Slot_Class} {GlobalValues.Actions_Popover_Action_Icon_Slot_Modifier}")" 
              style="@($"{_svgIcon}{_iconColour}")">
        </span>

        <span class="@GlobalValues.Actions_Popover_Action_Text_Class">
            @LinkText
        </span>

    </a>
</li>


