@attribute [Route($"{GlobalValues.Root_path_Theming}/{GlobalValues.Common_Page_Path_Sandbox}")]

@implements IAsyncDisposable

<PageTitle>@GlobalValues.Theming_Name @GlobalValues.Common_Page_Title_Sandbox</PageTitle>

<h1>@GlobalValues.Theming_Name @GlobalValues.Common_Page_Title_Sandbox . . . In Progress . . .</h1>




@* <button @onclick="LessRounded">Less Rounded</button>

<button @onclick="LessRounded">Less Rounded</button> *@


<div class="flex-content justify-content-between">
    <a class="@GlobalValues.Link_Button_Class @GlobalValues.Link_Button_Left_Arrow_Modifier" href="@($"{GlobalValues.Root_path_Theming}/{GlobalValues.Common_Page_Path_Colours}")">
        <span aria-hidden="true"></span>
        <span>@GlobalValues.Theming_Name - @GlobalValues.Common_Page_Title_Colours</span>
        <span aria-hidden="true"></span>
    </a>
    <a class="@GlobalValues.Link_Button_Class @GlobalValues.Link_Button_Right_Arrow_Modifier" href="@($"{GlobalValues.Root_path_FAQS}/{GlobalValues.Common_Page_Path_Questions}")">
        <span aria-hidden="true"></span>
        <span>@GlobalValues.Faqs_Name - @GlobalValues.Common_Page_Title_FAQ_Questions</span>
        <span aria-hidden="true"></span>
    </a>
</div>




@code {
    [Inject] IJSRuntime JSRuntime { get; set; }

    private IJSObjectReference? _jsModule = null;



    private async Task LessRounded()
    {
        if(_jsModule is not null)
        {
            var radiusValue = "var(--br-unit-radius-2)";

            await _jsModule.InvokeVoidAsync(GlobalValues.JS_Theme_Set_Style_Property_Func, CoreCssVariables.All_Button_Radius, radiusValue);
            await _jsModule.InvokeVoidAsync(GlobalValues.JS_Theme_Set_Style_Property_Func, "--br-comp-history-trigger-pane-surface-border-radius", radiusValue);
            await _jsModule.InvokeVoidAsync(GlobalValues.JS_Theme_Set_Style_Property_Func, "--br-comp-history-pane-base-border-radius", radiusValue);
            await _jsModule.InvokeVoidAsync(GlobalValues.JS_Theme_Set_Style_Property_Func, "--br-comp-mdframe-area-content-border-radius", radiusValue);
            await _jsModule.InvokeVoidAsync(GlobalValues.JS_Theme_Set_Style_Property_Func, "--br-comp-toggle-tip-pane-surface-border-radius", radiusValue);

            await _jsModule.InvokeVoidAsync(GlobalValues.JS_Theme_Set_Style_Property_Func, "--br-comp-skip-to-pane-surface-border-radius-top-right", radiusValue);
            await _jsModule.InvokeVoidAsync(GlobalValues.JS_Theme_Set_Style_Property_Func, "--br-comp-skip-to-pane-surface-border-radius-top-left", radiusValue);
            await _jsModule.InvokeVoidAsync(GlobalValues.JS_Theme_Set_Style_Property_Func, "--br-comp-skip-to-pane-surface-border-radius-bottom-right", radiusValue);
            await _jsModule.InvokeVoidAsync(GlobalValues.JS_Theme_Set_Style_Property_Func, "--br-comp-skip-to-pane-surface-border-radius-bottom-left", radiusValue);


            await _jsModule.InvokeVoidAsync(GlobalValues.JS_Theme_Set_Style_Property_Func, "--br-comp-all-pane-base-border-radius", radiusValue);
            await _jsModule.InvokeVoidAsync(GlobalValues.JS_Theme_Set_Style_Property_Func, "--br-comp-all-pane-panel-border-radius", radiusValue);
            await _jsModule.InvokeVoidAsync(GlobalValues.JS_Theme_Set_Style_Property_Func, "--br-comp-all-pane-surface-border-radius", radiusValue);
            await _jsModule.InvokeVoidAsync(GlobalValues.JS_Theme_Set_Style_Property_Func, "--br-comp-all-area-header-border-radius", radiusValue);
            await _jsModule.InvokeVoidAsync(GlobalValues.JS_Theme_Set_Style_Property_Func, "--br-comp-all-area-content-border-radius", radiusValue);
            await _jsModule.InvokeVoidAsync(GlobalValues.JS_Theme_Set_Style_Property_Func, "--br-comp-all-area-footer-border-radius", radiusValue);


            


             
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _jsModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", GlobalValues.JS_Doc_Theme_Module_File_Path);
    }


    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_jsModule is not null) await _jsModule.DisposeAsync();
        }
        catch { }
    }
}
