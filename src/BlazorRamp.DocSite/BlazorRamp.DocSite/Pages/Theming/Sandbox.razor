@attribute [Route($"{GlobalValues.Root_path_Theming}/{GlobalValues.Common_Page_Path_Sandbox}")]



<PageTitle>@GlobalValues.Theming_Name @GlobalValues.Common_Page_Title_Sandbox</PageTitle>

<h1>@GlobalValues.Theming_Name @GlobalValues.Common_Page_Title_Sandbox</h1>

<p>
    You can use the following colour and border tools to alter everything on this site. On most component usage pages you will find
    the Theme border tool showing the applicable groups for that component so you can adjust the sliders and view the affected parts of the component live.  
</p>
<p>
    There is a lot much more I can add regarding the colours (as well as other facets), and over time I will most likely make the Theme colour tool more like the borders tool and place
    that too on each usage page.
</p>
<p>
    You can use button below to view and copy the live colour and border variables, as well as copy the dark theme variables/values used on this site. 
</p>
<p>
    Regarding the dark theme, I simply use a selector based on the id of the theme button (switch) appearing at the top of the page, and its <span class="@CodeSpan.Base">aria-checked</span> attribute. The
    copied text includes this, just to give you ideas if you want to go the non JavasScript theme switch root.
</p>
<div style="display:flex;gap:var(--br-unit-space-5); justify-content:center;margin-block:var(--br-unit-space-5)">
        <button type="button" class="@Button.Base @Button.ExtraLarge" @onclick="OpenDialog">View & get theme variables</button>
</div>


<ThemeColourTool @ref="ThemeColourToolRef" />

<ThemeBorderTool @ref="ThemeBorderToolRef" Title="Theme border tool" ThemeToolHeadingLevel="ThemeToolHeadingLevel.H2">
    <BorderGroups>

        <BorderGroup Title="Dialog borders">
            <BorderRadius LabelText="Outer radius" ResetText="Reset outer radius" MaxRangeValue="@GlobalValues.Radius_Dialog_Surface_Max_Range_Value" CssProperties="@([new(CoreCssVariables.Group_Dialog_Radius_Surface), new(CoreCssVariables.Group_Dialog_Radius_Base)])" />
            <BorderRadius LabelText="Inner radius" ResetText="Reset inner radius" MaxRangeValue="@GlobalValues.Radius_Dialog_Content_Max_Range_Value" CssProperties="@([new(CoreCssVariables.Group_Dialog_Radius_Content)])" />
        </BorderGroup>
        <BorderGroup Title="Container borders">
            <BorderRadius LabelText="Content radius" ResetText="Reset content radius" MaxRangeValue="@GlobalValues.Radius_Container_Max_Range_Value" CssProperties="@([new(CoreCssVariables.Group_Container_Radius_Content)])" />
            <BorderRadius LabelText="Header radius" ResetText="Reset header radius" MaxRangeValue="@GlobalValues.Radius_Container_Header_Max_Range_Value" CssProperties="@([new(CoreCssVariables.Group_Container_Radius_Header)])" />
        </BorderGroup>

        <BorderGroup Title="Menu borders">
            <BorderRadius LabelText="Trigger, panel radius" ResetText="Reset trigger, panel radius" MaxRangeValue="@GlobalValues.Radius_Menu_Trigger_Panel_Max_Range_Value" 
                CssProperties="@([new(CoreCssVariables.Group_Menu_Radius_Panel), new(CoreCssVariables.Group_Menu_Radius_Header), new(CoreCssVariables.Group_Menu_Radius_Content)])" />
            <BorderRadius LabelText="Menu item radius" ResetText="Reset menu item radius" MaxRangeValue="@GlobalValues.Radius_Menu_Item_Max_Range_Value" CssProperties="@([new(CoreCssVariables.Group_Menu_Radius_item)])" />
        </BorderGroup>
        <BorderGroup Title="Content borders">
            <BorderRadius LabelText="Content radius" ResetText="Reset content radius" MaxRangeValue="@GlobalValues.Radius_Content_Max_Range_Value" CssProperties="@([new(CoreCssVariables.Group_Content_Radius)])" />
        </BorderGroup>
        <BorderGroup Title="Input borders">
            <BorderRadius LabelText="Input radius" ResetText="Reset input radius" MaxRangeValue="@GlobalValues.Radius_Input_Max_Range_Value" CssProperties="@([new(CoreCssVariables.Group_Input_Radius_Base)])" />
            <BorderRadius LabelText="Field radius" ResetText="Reset field radius" MaxRangeValue="@GlobalValues.Radius_Input_Field_Max_Range_Value" CssProperties="@([new(CoreCssVariables.Group_Input_Field_Radius)])" />

        </BorderGroup>

        <BorderGroup Title="Button borders">
            <BorderRadius LabelText="Button radius" ResetText="Reset button radius" MaxRangeValue="@GlobalValues.Radius_Button_Max_Range_Value" CssProperties="@([new(CoreCssVariables.Group_Button_Radius)])" />
        </BorderGroup>
        <BorderGroup Title="Revealed borders">
            <BorderRadius LabelText="Revealed radius" ResetText="Reset revealed radius" MaxRangeValue="@GlobalValues.Radius_Reveal_Max_Range_Value" CssProperties="@([new(CoreCssVariables.Group_Revealed_Radius_Surface)])"  />
        </BorderGroup>

    </BorderGroups>
</ThemeBorderTool>



<div class="flex-content justify-content-between">
    <a class="@GlobalValues.Link_Button_Class @GlobalValues.Link_Button_Left_Arrow_Modifier" href="@($"{GlobalValues.Root_path_Theming}/{GlobalValues.Common_Page_Path_Colours}")">
        <span aria-hidden="true"></span>
        <span>@GlobalValues.Theming_Name - @GlobalValues.Common_Page_Title_Colours</span>
        <span aria-hidden="true"></span>
    </a>
    <a class="@GlobalValues.Link_Button_Class @GlobalValues.Link_Button_Right_Arrow_Modifier" href="@($"{GlobalValues.Root_path_CSS_Classes}/{GlobalValues.Common_Page_Path_Overview}")">
        <span aria-hidden="true"></span>
        <span>@GlobalValues.CSS_Name_Classes - @GlobalValues.Common_Page_Title_Overview</span>
        <span aria-hidden="true"></span>
    </a>
</div>




@code {

    private ThemeBorderTool ThemeBorderToolRef { get; set; }
    private ThemeColourTool ThemeColourToolRef { get; set; }

    [Inject] ModalDialogService DialogService { get; set; } = default!;

    [Inject] private ThemeService ThemeService { get; set; } = default!;

    private async Task Test()
    {

        var currentProperties = await ThemeBorderToolRef.GetLiveBorderProperties();
        var cssProperties = await ThemeService.GetPropertyValues(currentProperties);
    }


    private async Task OpenDialog()
    {
        List<CssProperty> themeProperties     = [];
        List<CssProperty> darkThemeProperties = [];

        darkThemeProperties.AddRange(await ThemeService.GetRawPropertiesFromStyleSheet());

        themeProperties.AddRange(ThemeColourToolRef.GetStoredProperties());
        themeProperties.AddRange(ThemeBorderToolRef.GetStoredBorderProperties());

        var dialogParameters = new ModalDialogParameters<ThemeDialog>();

        dialogParameters.Add<string>(v => v.DialogTitle, "Variables and their current values");
        dialogParameters.Add<List<CssProperty>>(v => v.ThemeProperties, themeProperties);
        dialogParameters.Add<List<CssProperty>>(v => v.DarkThemeProperties, darkThemeProperties);

        var dialogOptions = new ModalDialogOptions(HorizontalAlignment.Centre, VerticalAlignment.Centre, maxWidthPercent: 75);

        _ = await DialogService.ShowDialog<ThemeDialog>(dialogParameters, dialogOptions);
    }

}
