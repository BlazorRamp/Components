        var buttonHoverOnDarkRGB = ColourUtils.HexToRgbColour(buttonHoverOnDarkValue);

        _focusOnNeutral20Contrast = ColourUtils.CalculateContrast(focusOnLightRGB, neutral20RGB);
        _focusOnNeutral70Contrast = ColourUtils.CalculateContrast(focusOnDarkRGB, neutral70RGB);

        _borderOnNeutral20Contrast = ColourUtils.CalculateContrast(borderOnLightRGB, neutral20RGB);
        _borderOnNeutral70Contrast = ColourUtils.CalculateContrast(borderOnDarkRGB, neutral70RGB);

        _headingTextOnNeutral20Contrast = ColourUtils.CalculateContrast(headingTextRGB, neutral20RGB);
        _headingTextOnNeutral70Contrast = ColourUtils.CalculateContrast(headingTextOnDarkRGB, neutral70RGB);
        _buttonTextOnNeutral20Contrast  = ColourUtils.CalculateContrast(buttonTextRGB, neutral20RGB);
        _buttonTextOnNeutral70Contrast  = ColourUtils.CalculateContrast(buttonTextOnDarkRGB, neutral70RGB);

        _errorOn5Contrast  = ColourUtils.CalculateContrast(dangerValueRGB, neutral5RGB);
        _errorOn90Contrast = ColourUtils.CalculateContrast(dangerLightValueRGB, neutral90RGB);

        _hintOn5Contrast  = ColourUtils.CalculateContrast(neutral90WithOPValueRGB, neutral5RGB);
        _hintOn90Contrast = ColourUtils.CalculateContrast(neutral5WithOPValueRGB, neutral90RGB);

        _successOn5Contrast  = ColourUtils.CalculateContrast(successRGB, neutral5RGB);
        _successOn90Contrast = ColourUtils.CalculateContrast(successLightRGB, neutral90RGB);


        _buttonTextOnHoverContrast = ColourUtils.CalculateContrast(buttonHoverRGB, buttonTextRGB);

        _buttonTextOnDarkHoverContrast = ColourUtils.CalculateContrast(buttonHoverOnDarkRGB, buttonTextOnDarkRGB);
    }

    private string GetContrastStateIconClass(double contrastRatio, double passValue)

        => contrastRatio < passValue ? "invalid-contrast-icon" : "valid-contrast-icon";

    private string GetContrastStateText(double contrastRatio, double passValue)

        => contrastRatio < passValue ? "Fail" : "Pass";

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_jsModule is not null) await _jsModule.DisposeAsync();
        }
        catch { }
    }
}
