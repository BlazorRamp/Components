    protected override async Task OnInitializedAsync()
    {
        _jsModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", GlobalValues.JS_Doc_Theme_Module_File_Path);

        await GetSetContrastInformation();
    }

    private async Task HandleColourChanged()
    {
        await GetSetContrastInformation();
    }

    private async Task GetSetContrastInformation()
    {
        if (_jsModule is null) return;
        /*
        * Button hover background - but check, is primary with 0.10 opacity, easier than trying to get this and then apply to 
         * buttons which have transparent backgrounds but sit on neutral 20.
         */
                                var hintOpacityValue        = await _jsModule.InvokeAsync<string>(GlobalValues.JS_Theme_Get_Comp_Style_Property_Func, "--br-comp-input-hint-opacity");
        var neutral5Value           = await _jsModule.InvokeAsync<string>(GlobalValues.JS_Theme_Get_Resolved_Colour_Func, CoreCssVariables.Colour_Neutral_5);
        var neutral20Value          = await _jsModule.InvokeAsync<string>(GlobalValues.JS_Theme_Get_Resolved_Colour_Func, CoreCssVariables.Colour_Neutral_20);
        var neutral70Value          = await _jsModule.InvokeAsync<string>(GlobalValues.JS_Theme_Get_Resolved_Colour_Func, CoreCssVariables.Colour_Neutral_70);
        var neutral90Value          = await _jsModule.InvokeAsync<string>(GlobalValues.JS_Theme_Get_Resolved_Colour_Func, CoreCssVariables.Colour_Neutral_90);
        var primary70Value          = await _jsModule.InvokeAsync<string>(GlobalValues.JS_Theme_Get_Resolved_Colour_Func, CoreCssVariables.Colour_Primary_70);
        var primary20Value          = await _jsModule.InvokeAsync<string>(GlobalValues.JS_Theme_Get_Resolved_Colour_Func, CoreCssVariables.Colour_Primary_20);
        var primary50Value          = await _jsModule.InvokeAsync<string>(GlobalValues.JS_Theme_Get_Resolved_Colour_Func, CoreCssVariables.Colour_Primary_50);
        var focusOnDarkValue        = await _jsModule.InvokeAsync<string>(GlobalValues.JS_Theme_Get_Resolved_Colour_Func, CoreCssVariables.Colour_Primary_30);
        var headingTextValue        = await _jsModule.InvokeAsync<string>(GlobalValues.JS_Theme_Get_Resolved_Colour_Func, CoreCssVariables.All_Area_Header_Text_Colour_Value);
        var headingOnDarkValue      = await _jsModule.InvokeAsync<string>(GlobalValues.JS_Theme_Get_Resolved_Colour_Func, CoreCssVariables.Colour_Primary_Text_Light);
        var buttonTextValue         = await _jsModule.InvokeAsync<string>(GlobalValues.JS_Theme_Get_Resolved_Colour_Func, CoreCssVariables.All_Button_Text_Colour_Value);
        var buttonOnDarkValue       = await _jsModule.InvokeAsync<string>(GlobalValues.JS_Theme_Get_Resolved_Colour_Func, CoreCssVariables.Colour_Primary_Text_Light);
        var dangerValue             = await _jsModule.InvokeAsync<string>(GlobalValues.JS_Theme_Get_Resolved_Colour_Func, CoreCssVariables.Colour_Danger);
        var dangerLightValue        = await _jsModule.InvokeAsync<string>(GlobalValues.JS_Theme_Get_Resolved_Colour_Func, CoreCssVariables.Colour_Danger_Light);
        var neutral90WithOPValue    = await _jsModule.InvokeAsync<string>(GlobalValues.JS_Theme_Apply_Opacity_To_Hex_Value, neutral90Value, hintOpacityValue, neutral5Value);
        var neutral5WithOPValue     = await _jsModule.InvokeAsync<string>(GlobalValues.JS_Theme_Apply_Opacity_To_Hex_Value, neutral5Value, hintOpacityValue, neutral90Value);
        var successColourValue      = await _jsModule.InvokeAsync<string>(GlobalValues.JS_Theme_Get_Resolved_Colour_Func, CoreCssVariables.Colour_Success);
        var successColourLightValue = await _jsModule.InvokeAsync<string>(GlobalValues.JS_Theme_Get_Resolved_Colour_Func, CoreCssVariables.Colour_Success_Light);

        //var secondaryColourValue = await _jsModule.InvokeAsync<string>(GlobalValues.JS_Theme_Get_Resolved_Colour_Func, CoreCssVariables.Colour_Secondary);

        var buttonHoverValue       = await _jsModule.InvokeAsync<string>(GlobalValues.JS_Theme_Apply_Opacity_To_Hex_Value, primary50Value, 0.1, neutral20Value);
        var buttonHoverOnDarkValue = await _jsModule.InvokeAsync<string>(GlobalValues.JS_Theme_Apply_Opacity_To_Hex_Value, primary50Value, 0.1, neutral70Value);

        var focusOnLightValue = primary70Value;

        var neutral5RGB             = ColourUtils.HexToRgbColour(neutral5Value);
        var neutral20RGB            = ColourUtils.HexToRgbColour(neutral20Value);
        var neutral90RGB            = ColourUtils.HexToRgbColour(neutral90Value);
        var neutral70RGB            = ColourUtils.HexToRgbColour(neutral70Value);
        var primary70RGB            = ColourUtils.HexToRgbColour(primary70Value);
        var borderOnLightRGB        = ColourUtils.HexToRgbColour(primary50Value);
        var borderOnDarkRGB         = ColourUtils.HexToRgbColour(primary20Value);
        var focusOnLightRGB         = ColourUtils.HexToRgbColour(primary70Value);
        var focusOnDarkRGB          = ColourUtils.HexToRgbColour(focusOnDarkValue);
        var headingTextRGB          = ColourUtils.HexToRgbColour(headingTextValue);
        var headingTextOnDarkRGB    = ColourUtils.HexToRgbColour(headingOnDarkValue);
        var buttonTextRGB           = ColourUtils.HexToRgbColour(buttonTextValue);
        var buttonTextOnDarkRGB     = ColourUtils.HexToRgbColour(buttonOnDarkValue);
        var dangerValueRGB          = ColourUtils.HexToRgbColour(dangerValue);
        var dangerLightValueRGB     = ColourUtils.HexToRgbColour(dangerLightValue);
        var neutral90WithOPValueRGB = ColourUtils.HexToRgbColour(neutral90WithOPValue);
        var neutral5WithOPValueRGB  = ColourUtils.HexToRgbColour(neutral5WithOPValue);
        var successRGB              = ColourUtils.HexToRgbColour(successColourValue);
        var successLightRGB         = ColourUtils.HexToRgbColour(successColourValue);

