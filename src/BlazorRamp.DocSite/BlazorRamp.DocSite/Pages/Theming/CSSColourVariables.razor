@attribute [Route(GlobalValues.Path_Theming_CSS_Colour_Variables)]

<PageTitle>@GlobalValues.Page_Title_Theming_CSS_Colour_Variables</PageTitle>

<h1 class="page-heading">@GlobalValues.Page_Heading_Theming_CSS_Colour_Variables</h1>

<p>
    The following tables contain all of the colour unit css variables that can be used by the base variables.
</p>

<section class="code-table">

    <h2 id="primary-colour-variables" class="code-table__heading">Primary colour variables</h2>

    <table aria-labelledby="primary-colour-variables">

        <thead>
            <tr>
                <th scope="col">Variable Name</th>
                <th scope="col">Default Value</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>--br-unit-colour-primary</td>
                <td>hsl(220, 44%, 48%)</td>
            </tr>
            <tr>
                <td>--br-unit-colour-primary-0</td>
                <td>hsl(0, 0%, 0%)</td>
            </tr>
            <tr>
                <td>--br-unit-colour-primary-5</td>
                <td>hsl(from var(--br-unit-colour-primary) h s calc(l + (100 - l) * 0.9))</td>
            </tr>
            <tr>
                <td>--br-unit-colour-primary-10</td>
                <td>hsl(from var(--br-unit-colour-primary) h s calc(l + (100 - l) * 0.8))</td>
            </tr>
            <tr>
                <td>--br-unit-colour-primary-20</td>
                <td>hsl(from var(--br-unit-colour-primary) h s calc(l + (100 - l) * 0.6))</td>
            </tr>
            <tr>
                <td>--br-unit-colour-primary-30</td>
                <td>hsl(from var(--br-unit-colour-primary) h s calc(l + (100 - l) * 0.4))</td>
            </tr>
            <tr>
                <td>--br-unit-colour-primary-40</td>
                <td>hsl(from var(--br-unit-colour-primary) h s calc(l + (100 - l) * 0.2))</td>
            </tr>
            <tr>
                <td>--br-unit-colour-primary-50</td>
                <td>var(--br-unit-colour-primary)</td>
            </tr>
            <tr>
                <td>--br-unit-colour-primary-60</td>
                <td>hsl(from var(--br-unit-colour-primary) h s calc(l * 0.8))</td>
            </tr>
            <tr>
                <td>--br-unit-colour-primary-70</td>
                <td>hsl(from var(--br-unit-colour-primary) h s calc(l * 0.6))</td>
            </tr>
            <tr>
                <td>--br-unit-colour-primary-80</td>
                <td>hsl(from var(--br-unit-colour-primary) h s calc(l * 0.4))</td>
            </tr>
            <tr>
                <td>--br-unit-colour-primary-90</td>
                <td>hsl(from var(--br-unit-colour-primary) h s calc(l * 0.2))</td>
            </tr>
            <tr>
                <td>--br-unit-colour-primary-100</td>
                <td>hsl(0, 0%, 100%)</td>
            </tr>

        </tbody>
    </table>

</section>

<section class="code-table">

    <h2 id="neutral-colour-variables" class="code-table__heading">Neutral colour variables</h2>
    <p>
        <b>Note: </b> The <span class="code-span">--br-unit-colour-neutral-saturation</span> variable is used to increase or decrease the amount of 
        primary colour in the neutral colour.
    </p>
    <table aria-labelledby="neutral-colour-variables">

        <thead>
            <tr>
                <th scope="col">Variable Name</th>
                <th scope="col">Default Value</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>--br-unit-colour-neutral</td>
                <td>hsl(from var(--br-unit-colour-primary) h var(--br-unit-colour-neutral-saturation) 70%)</td>
            </tr>
            <tr>
                <td>--br-unit-colour-neutral-saturation</td>
                <td>10</td>
            </tr>
            <tr>
                <td>--br-unit-colour-neutral-0</td>
                <td>hsl(0, 0%, 100%)</td>
            </tr>
            <tr>
                <td>--br-unit-colour-neutral-5</td>
                <td>hsl(from var(--br-unit-colour-neutral) h calc(var(--br-unit-colour-neutral-saturation) + 8) calc(l + (100 - l) * 0.95))</td>
            </tr>
            <tr>
                <td>--br-unit-colour-neutral-10</td>
                <td>hsl(from var(--br-unit-colour-neutral) h calc(var(--br-unit-colour-neutral-saturation) + 13) calc(l + (100 - l) * 0.85))</td>
            </tr>
            <tr>
                <td>--br-unit-colour-neutral-20</td>
                <td>hsl(from var(--br-unit-colour-neutral) h calc(var(--br-unit-colour-neutral-saturation) + 16) calc(l + (100 - l) * 0.80))</td>
            </tr>
            <tr>
                <td>--br-unit-colour-neutral-30</td>
                <td>hsl(from var(--br-unit-colour-neutral) h s calc(l + (100 - l) * 0.4))</td>
            </tr>
            <tr>
                <td>--br-unit-colour-neutral-40</td>
                <td>hsl(from var(--br-unit-colour-neutral) h s calc(l + (100 - l) * 0.2))</td>
            </tr>
            <tr>
                <td>--br-unit-colour-neutral-50</td>
                <td>var(--br-unit-colour-neutral)</td>
            </tr>
            <tr>
                <td>--br-unit-colour-neutral-60</td>
                <td>hsl(from var(--br-unit-colour-neutral) h s calc(l * 0.5))</td>
            </tr>
            <tr>
                <td>--br-unit-colour-neutral-70</td>
                <td>hsl(from var(--br-unit-colour-neutral) h s calc(l * 0.30))</td>
            </tr>
            <tr>
                <td>--br-unit-colour-neutral-80</td>
                <td>hsl(from var(--br-unit-colour-neutral) h s calc(l * 0.20))</td>
            </tr>
            <tr>
                <td>--br-unit-colour-neutral-90</td>
                <td>hsl(from var(--br-unit-colour-neutral) h s calc(l * 0.15))</td>
            </tr>
            <tr>
                <td>--br-unit-colour-neutral-100</td>
                <td>hsl(0, 0%, 0%)</td>
            </tr>
        </tbody>
    </table>

</section>

