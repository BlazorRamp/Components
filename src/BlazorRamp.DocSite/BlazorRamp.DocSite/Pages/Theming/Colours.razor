                <ColourSwatch VariableName="@CoreCssVariables.Colour_Primary_10" />
                <ColourSwatch VariableName="@CoreCssVariables.Colour_Primary_20" />
                <ColourSwatch VariableName="@CoreCssVariables.Colour_Primary_30" />
                <ColourSwatch VariableName="@CoreCssVariables.Colour_Primary_40" />
                <ColourSwatch VariableName="@CoreCssVariables.Colour_Primary_50" />
                <ColourSwatch VariableName="@CoreCssVariables.Colour_Primary_60" />
                <ColourSwatch VariableName="@CoreCssVariables.Colour_Primary_70" />
                <ColourSwatch VariableName="@CoreCssVariables.Colour_Primary_80" />
                <ColourSwatch VariableName="@CoreCssVariables.Colour_Primary_90" />
            </Swatches>
        </ColourPalette>
        <ColourPalette Title="Neutral colour variables" Information="(No. 50 is the exact colour - this text is on white)">
            <Swatches>
                <ColourSwatch VariableName="@CoreCssVariables.Colour_Neutral_5" />
                <ColourSwatch VariableName="@CoreCssVariables.Colour_Neutral_10" />
                <ColourSwatch VariableName="@CoreCssVariables.Colour_Neutral_20" />
                <ColourSwatch VariableName="@CoreCssVariables.Colour_Neutral_30" />
                <ColourSwatch VariableName="@CoreCssVariables.Colour_Neutral_40" />
                <ColourSwatch VariableName="@CoreCssVariables.Colour_Neutral_50" />
                <ColourSwatch VariableName="@CoreCssVariables.Colour_Neutral_60" />
                <ColourSwatch VariableName="@CoreCssVariables.Colour_Neutral_70" />
                <ColourSwatch VariableName="@CoreCssVariables.Colour_Neutral_80" />
                <ColourSwatch VariableName="@CoreCssVariables.Colour_Neutral_90" />
