<section>
    <h2 style="margin-block:var(--br-unit-space-9);">Regular text and page background colours</h2>
    <p>
        Regular text (on a light canvas) uses the variable <span class="code-span">@CoreCssVariables.Colour_Canvas_Text</span> which just gets is value from
        the neutral variable <span class="code-span">@CoreCssVariables.Colour_Neutral_90</span>; this neutral value is the value for the dark theme canvas. 
        For regular text (on a dark canvas) the aforementioned variable uses the value from the neutral variable <span class="code-span">@CoreCssVariables.Colour_Neutral_5</span>
    </p>
    <p>
        All of the colours have a light and dark text variable.
    </p>
    <p>
        The canvas colour used is off-white as its the neutral colour created from the primary colour. You can off course just set the underlying variable <span class="code=span">@CoreCssVariables.Colour_Canvas</span> to white
        if you prefer. And then black for a dark theme.
    </p>
    <div style="display:flex;flex-wrap:wrap; border-radius: var(--br-unit-radius-3); border: 1px solid var(--br-comp-all-divider-colour); padding:var(--br-unit-space-2);">
        
        <div style="flex: 1 1 400px; font-size:var(--br-unit-font-size-1); display:flex;flex-direction:column;gap:var(--br-unit-space-7); 
            background-color:var(--br-unit-colour-neutral-5); padding:var(--br-unit-space-4);border-radius: var(--br-unit-radius-3);">
        
            <span style="color:var(@CoreCssVariables.Colour_Primary_Text_Dark);">Primary dark text @CoreCssVariables.Colour_Primary_Text_Dark<br />(which uses the value from --br-unit-colour-primary-70)</span>

            <span style="color:var(@CoreCssVariables.Colour_Secondary_Text_Dark);">Secondary dark text @CoreCssVariables.Colour_Secondary_Text_Dark <br />(which uses the value from --br-unit-colour-secondary-darker)</span>

            <span style="color:var(@CoreCssVariables.Colour_Accent_Text_Dark);">Accent dark text @CoreCssVariables.Colour_Accent_Text_Dark <br />(which uses the value from --br-unit-colour-accent-darker)</span>
            
            <span style="color:var(--br-unit-colour-neutral-90);">Neutral (regular) dark text @CoreCssVariables.Colour_Canvas_Text<br />(which uses the value from --br-unit-colour-neutral-90)</span>

            <span style="color:var(@CoreCssVariables.Colour_Success_Text_Dark);">Success dark text @CoreCssVariables.Colour_Success_Text_Dark <br />(which uses the value from --br-unit-colour-success-darker)</span>

            <span style="color:var(@CoreCssVariables.Colour_Info_Text_Dark);">Info dark text @CoreCssVariables.Colour_Info_Text_Dark <br />(which uses the value from --br-unit-colour-info-darker)</span>

            <span style="color:var(@CoreCssVariables.Colour_Warning_Text_Dark);">Warning dark text @CoreCssVariables.Colour_Warning_Text_Dark <br />(which uses the value from --br-unit-colour-warning-darker)</span>

            <span style="color:var(@CoreCssVariables.Colour_Danger_Text_Dark);">Danger dark text @CoreCssVariables.Colour_Danger_Text_Dark <br />(which uses the value from --br-unit-colour-danger-darker)</span>
        </div>
        <div style="flex: 1 1 400px;font-size:var(--br-unit-font-size-1); display:flex;flex-direction:column;gap:var(--br-unit-space-7); 
            background-color:var(--br-unit-colour-neutral-90);padding:var(--br-unit-space-4);border-radius:var(--br-unit-radius-3)">

            <span style="color:var(@CoreCssVariables.Colour_Primary_Text_Light);">Primary light text @CoreCssVariables.Colour_Primary_Text_Light <br />(which uses the value from --br-unit-colour-primary-30)</span>

            <span style="color:var(@CoreCssVariables.Colour_Secondary_Text_Light);">Secondary light text @CoreCssVariables.Colour_Secondary_Text_Light <br />(which uses the value from --br-unit-colour-secondary-lighter)</span>

            <span style="color:var(@CoreCssVariables.Colour_Accent_Text_Light);">Accent light text @CoreCssVariables.Colour_Accent_Text_Light <br />(which uses the value from --br-unit-colour-accent-lighter)</span>

            <span style="color:var(--br-unit-colour-neutral-5);">Neutral (regular) light text --br-unit-colour-canvas-text<br />(which uses the value from --br-unit-colour-neutral-5)</span>

            <span style="color:var(@CoreCssVariables.Colour_Success_Text_Light);">Success light text @CoreCssVariables.Colour_Success_Text_Light <br />(which uses the value from --br-unit-colour-success-lighter)</span>

            <span style="color:var(@CoreCssVariables.Colour_Info_Text_Light);">Info light text @CoreCssVariables.Colour_Info_Text_Light <br />(which uses the value from --br-unit-colour-info-lighter)</span>

            <span style="color:var(@CoreCssVariables.Colour_Warning_Text_Light);">Warning light text @CoreCssVariables.Colour_Warning_Text_Light <br />(which uses the value from --br-unit-colour-warning-lighter)</span>

            <span style="color:var(@CoreCssVariables.Colour_Danger_Text_Light);">Danger light text @CoreCssVariables.Colour_Danger_Text_Light <br />(which uses the value from --br-unit-colour-danger-lighter)</span>

        </div>
    </div>
</section>


<div class="flex-content justify-content-between">
    <a class="@GlobalValues.Link_Button_Class @GlobalValues.Link_Button_Left_Arrow_Modifier" href="@($"{GlobalValues.Root_path_Theming}/{GlobalValues.Common_Page_Path_CSS_Variables}")">
        <span aria-hidden="true"></span>
        <span>@GlobalValues.Theming_Name - @GlobalValues.Common_Page_Title_Core_Variables</span>
        <span aria-hidden="true"></span>
    </a>
    <a class="@GlobalValues.Link_Button_Class @GlobalValues.Link_Button_Right_Arrow_Modifier" href="@($"{GlobalValues.Root_path_Theming}/{GlobalValues.Common_Page_Path_Sandbox}")">
        <span aria-hidden="true"></span>
        <span>@GlobalValues.Theming_Name - @GlobalValues.Common_Page_Title_Sandbox</span>
        <span aria-hidden="true"></span>
    </a>
</div>
@code {

    [Inject] ILiveRegionService LiveRegionService { get; set; } = default!;
    [Inject] IJSRuntime         JSRuntime         { get; set; } = default!;

    private IJSObjectReference? _jsModule = null;

    private string _primaryColourValue     = "#008C8C";
    private string _rootPrimaryVar         = "--br-unit-colour-primary";
    private string _neutralSaturationVar   = "--br-unit-colour-neutral-saturation";
    private string _neutralSaturationValue = "10";

    private async Task HandleSaturation(ChangeEventArgs args)
    {
        _neutralSaturationValue = args.Value.ToString();
        if (_jsModule is not null) await _jsModule.InvokeVoidAsync(GlobalValues.JS_Theme_Set_Style_Property_Func, _neutralSaturationVar, _neutralSaturationValue);
    }

    private async Task HandleColourChange(ChangeEventArgs args)
    {
        _primaryColourValue = args.Value.ToString();

        if (_jsModule is not null) await _jsModule.InvokeVoidAsync(GlobalValues.JS_Theme_Set_Style_Property_Func, _rootPrimaryVar, _primaryColourValue);
    }

    private async Task ResetColourValues()
    {
        if (_jsModule is not null)
        {
            _primaryColourValue    = await _jsModule.InvokeAsync<string>(GlobalValues.JS_Theme_Get_Comp_Style_Property_Func, CoreCssVariables.Original_Primary_Value_Store_Name);
            _neutralSaturationValue = await _jsModule.InvokeAsync<string>(GlobalValues.JS_Theme_Get_Comp_Style_Property_Func, CoreCssVariables.Original_Saturation_Value_Store_Name);

            // await _jsModule.InvokeVoidAsync(GlobalValues.JS_Theme_Set_Root_Variable_Func, _neutralSaturationVar, _neutralSaturationValue);
            // await _jsModule.InvokeVoidAsync(GlobalValues.JS_Theme_Set_Root_Variable_Func, _rootPrimaryVar, _primaryColourValue);

            await _jsModule.InvokeVoidAsync(GlobalValues.JS_Theme_Remove_Style_Property_Func, _rootPrimaryVar);
            await _jsModule.InvokeVoidAsync(GlobalValues.JS_Theme_Remove_Style_Property_Func, _neutralSaturationVar);

            await LiveRegionService.MakeAnnouncement(new("Site colours have been reset to the default values",AnnouncementTrigger:"Colour reset button"), true);

        }
    }

    protected override async Task OnInitializedAsync()
    {
        _jsModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", GlobalValues.JS_Doc_Theme_Module_File_Path);

        if (_jsModule is null) return; 

        _primaryColourValue     = await _jsModule.InvokeAsync<string>(GlobalValues.JS_Theme_Get_Comp_Style_Property_Func, _rootPrimaryVar);
        _neutralSaturationValue = await _jsModule.InvokeAsync<string>(GlobalValues.JS_Theme_Get_Comp_Style_Property_Func, _neutralSaturationVar);


    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_jsModule is not null) await _jsModule.DisposeAsync();
        }
        catch { }
    }
}
