                <ColourSwatch VariableName="@CoreCssVariables.Colour_Accent_Light" />
                <ColourSwatch VariableName="@CoreCssVariables.Colour_Accent" />
                <ColourSwatch VariableName="@CoreCssVariables.Colour_Accent_Dark" />
                <ColourSwatch VariableName="@CoreCssVariables.Colour_Accent_Darker" />
            </Swatches>
