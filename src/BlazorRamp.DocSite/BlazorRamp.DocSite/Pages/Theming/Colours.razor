            <Swatches>
                <ColourSwatch VariableName="@CoreCssVariables.Colour_Secondary_Lighter" />
                <ColourSwatch VariableName="@CoreCssVariables.Colour_Secondary_Light" />
                <ColourSwatch VariableName="@CoreCssVariables.Colour_Secondary" />
                <ColourSwatch VariableName="@CoreCssVariables.Colour_Secondary_Dark" />
