@attribute [Route($"{GlobalValues.Root_path_FAQS}/{GlobalValues.Common_Page_Path_Questions}")]

<PageTitle>@GlobalValues.Faqs_Name @GlobalValues.Common_Page_Title_FAQ_Questions</PageTitle>

<h1 class="mobile-centred-heading">@GlobalValues.Faqs_Name @GlobalValues.Common_Page_Title_FAQ_Questions</h1>

<p>
    This section will be amended with all the answers to frequently asked questions.  
</p>

<div class="@FlexContent.Base @FlexContent.Wrap(UnitFlexWrap.Wrap) @LayoutAlignment.JustifyContent(UnitJustifyContent.SpaceBetween) @LayoutAlignment.AlignItems(UnitAlignItems.Centre)">
        <a class="@Button.Base @Button.LinkStyle @Gap.SetColGap(UnitGapSize.Four)" href="@($"{GlobalValues.Root_path_CSS_Classes}/{GlobalValues.CSS_Path_Part_VerticalAlign}/{GlobalValues.Common_Page_Path_Api}")">
        <span class="@SvgIcon.Base @SvgIcon.Size(UnitIconSize.ExtraLarge)" aria-hidden="true" style="--_svg-icon-source:var(--svg-left-arrow-circle-icon)"></span>
        <span>@GlobalValues.CSS_Name_VerticalAlign - @GlobalValues.Common_Page_Title_Api</span>

    </a>
@*         <a class="@Button.Base @Button.LinkStyle @Gap.SetColGap(UnitGapSize.Four)" href="@GlobalValues.Page_Heading_FAQs_Questions">

        <span>@GlobalValues.Main_Nav_Section_Heading_FAQs - @GlobalValues.Page_Heading_FAQs_Questions</span>

    </a> *@
</div>