@using BlazorRamp.DocSite.Pages.GettingStarted
@attribute [Route($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_DataTable}/{GlobalValues.Common_Page_Path_Api}")]

<PageTitle>@GlobalValues.Component_Name_Data_Table @GlobalValues.Common_Page_Title_Api</PageTitle>

<h1>@GlobalValues.Component_Name_Data_Table @GlobalValues.Common_Page_Title_Api</h1>
<p>
    Everything you need to work with the Data Table component: parameters, methods, models, enums, and CSS variables for styling.
</p>

<section>
    <h2 class="page-heading">
        Component parameters, methods, supporting classes and enums.
    </h2>
    <p>
        The following sections cover all components that make up this feature, including their parameters,
        public methods, and any supporting classes or enumerations required for use.
    </p>
    <section class="code-table">

        <h3 id="data-table-component-parameters" class="code-table__heading">Data Table parent component parameters</h3>

        <table aria-labelledby="data-table-component-parameters">

            <thead>
                <tr>
                    <th scope="col">Parameter</th>
                    <th scope="col">Type</th>
                    <th scope="col">Description</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>TableColumns</td>
                    <td>RenderFragment</td>
                    <td>
                        Placeholder for all of the <span class="@CodeSpan.Base">DataColumn</span> and <span class="@CodeSpan.Base">TemplateColumn</span>
                        components, which get added to the tables column collection.
                    </td>
                </tr>
                <tr>
                    <td>Title</td>
                    <td>string</td>
                    <td>Gets or sets the table's title, shown above the content and used as the accessible name for the table. Default value: <span class="@CodeSpan.Base">Results</span>.</td>
                </tr>
                <tr>
                    <td>TitleAlignment</td>
                    <td>TitleAlignment (enum)</td>
                    <td>Gets or sets the horizontal alignment of the title. Default value: <span class="@CodeSpan.Base">TitleAlignment.Start</span>.</td>
                </tr>
                <tr>
                    <td>TitleHidden</td>
                    <td>bool</td>
                    <td>Gets or sets whether the title is visually hidden while remaining available to assistive technology. Default value: <span class="@CodeSpan.Base">false</span>.</td>
                </tr>
                <tr>
                    <td>Filter</td>
                    <td>RenderFragment?</td>
                    <td>The optional markup for a custom filter UI, rendered above the table.</td>
                </tr>
                <tr>
                    <td>FilterAlignment</td>
                    <td>FilterAlignment</td>
                    <td>Gets or sets the horizontal alignment of the filter area. Default value: <span class="@CodeSpan.Base">FilterAlignment.End</span>.</td>
                </tr>
                <tr>
                    <td>TopPager</td>
                    <td>RenderFragment?</td>
                    <td>The optional markup for a pager rendered above the table.</td>
                </tr>
                <tr>
                    <td>BottomPager</td>
                    <td>RenderFragment?</td>
                    <td>The optional markup for a pager rendered below the table.</td>
                </tr>
                <tr>
                    <td>VirtualizeItemSizePX</td>
                    <td>int</td>
                    <td>
                        Gets or sets the estimated pixel height of each row, used by the virtualized rendering path. 
                        Set below 1 to disable virtualization. Default value: <span class="@CodeSpan.Base">32</span>.
                    </td>
                </tr>
                <tr>
                    <td>OverscanCount</td>
                    <td>int</td>
                    <td>
                        Gets or sets the number of extra rows rendered above and below the visible viewport when virtualization 
                        is active, to reduce blank space during fast scrolling. 
                        Default value: <span class="@CodeSpan.Base">50</span>.
                    </td>
                </tr>
                <tr>
                    <td>TableHeight</td>
                    <td>string?</td>
                    <td>
                        Gets or sets the table's height, in any valid CSS unit. Applied as a fixed <span class="@CodeSpan.Base">height</span> when 
                        using virtualized rendering (required, since the Virtualize component needs a definite height to measure against), 
                        or as a <span class="@CodeSpan.Base">max-height</span> when paging is enabled, allowing the table to shrink for fewer rows. 
                        Defaults if null, empty, or whitespace. Default value: <span class="@CodeSpan.Base">500px</span>.</td>
                </tr>
                <tr>
                    <td>PagerBinding</td>
                    <td>PagerBinding?</td>
                    <td>
                        When supplied, enables paging and binds the table to the given paging state.
                        Default value: <span class="@CodeSpan.Base">null</span>.
                    </td>
                </tr>
                <tr>
                    <td>RowSelectHeading</td>
                    <td>string?</td>
                    <td>
                        Gets or sets the header text for the row-selection column. Defaults if null, empty, or whitespace.
                        Default value: <span class="@CodeSpan.Base">Select</span>.
                        <br /><b>Note:</b> This value is captured during the OnInitialized method and changes thereafter are ignored.
                    </td>
                </tr>
                <tr>
                    <td>RowIdentifierFunc</td>
                    <td>Func&lt;TData, string&gt;?</td>
                    <td>
                        Gets or sets an optional function producing a per-row accessible label for that row's selection checkbox to make a better/unique accessible name.
                    </td>
                </tr>
                <tr>
                    <td>NoRecordText</td>
                    <td>string?</td>
                    <td>
                        Gets or sets the text shown when there are no rows to display. Defaults if null, empty, or whitespace.
                        Default value: <span class="@CodeSpan.Base">No entries found.</span>.
                    </td>
                </tr>
                <tr>
                    <td>FilterCountText</td>
                    <td>string?</td>
                    <td>
                        Gets or sets a template for the row-count message shown when a filter is active. Supports {filteredrows} and {totalrows} tokens.
                        Default value: <span class="@CodeSpan.Base">Showing {filteredrows} filtered items from a total of {totalrows}.</span>.
                    </td>
                </tr>
                <tr>
                    <td>RecordCountText</td>
                    <td>string?</td>
                    <td>
                        Gets or sets a template for the row-count message shown when no filter is active.
                        Supports the {totalrows} token. Default value: <span class="@CodeSpan.Base">Showing {totalrows} items.</span>.
                    </td>
                </tr>
                <tr>
                    <td>DataSource</td>
                    <td>List&lt;TData&gt;</td>
                    <td>
                        The full list of rows to display. Required. Treated as immutable: to add, remove, or otherwise change rows, 
                        assign a new List instance rather than mutating this one in place — only a new reference is detected as a data change.
                        If you mutate DataSource in place instead, call Refresh() afterwards via an ElementReference set on the DataTable i.e 
                        <span class="@CodeSpan.Base">private DataTable DataTableRef {get;set;}</span> with <span class="@CodeSpan.Base">@@ref="DataTableRef"</span>
                        Default value: <span class="@CodeSpan.Base">[]</span>.</td>
                </tr>
                <tr>
                    <td>RowSelectionMode</td>
                    <td>RowSelectionMode (enum)</td>
                    <td>
                        Determines whether rows can be selected, and if so, whether selection is single or multiple. 
                        Default value: <span class="@CodeSpan.Base">RowSelectionMode.None</span>.
                    </td>
                </tr>
                <tr>
                    <td>SelectedRows</td>
                    <td>List&lt;TData&gt;</td>
                    <td>
                        The currently selected rows. Default value: <span class="@CodeSpan.Base">[]</span>.
                    </td>
                </tr>
                <tr>
                    <td>RowStyleFunc</td>
                    <td>Func&lt;TData, string?&gt;?</td>
                    <td>
                        Gets or sets an optional function returning inline CSS for a row's <span class="@CodeSpan.Base">&lt;tr&gt;</span> element.
                        Default value: <span class="@CodeSpan.Base">null</span>.
                    </td>
                </tr>
                <tr>
                    <td>FilterRule</td>
                    <td>Func&lt;TData, bool&gt;?</td>
                    <td>
                        Gets or sets an options predicate used to filter the DataSource. Supplying a new delegate instance triggers re-filtering; reusing the same instance across renders will not.
                    </td>
                </tr>
                <tr>
                    <td>FilteredStatusText</td>
                    <td>string</td>
                    <td>
                        Gets or sets screen reader announcement text used when a filter has been applied.
                        Default value: <span class="@CodeSpan.Base">Filtering completed.</span>.
                    </td>
                </tr>
                <tr>
                    <td>SortUpStatusText</td>
                    <td>string</td>
                    <td>
                        Gets or sets screen reader announcement text used when a column is sorted ascending.
                        Default value: <span class="@CodeSpan.Base">Sort up completed.</span>. 
                        <b>Note:</b> I find it audibly hard to distinguish, ascending / descending when using a screen reader
                        up / down I never mis hear. 
                    </td>
                </tr>
                <tr>
                    <td>SortDownStatusText</td>
                    <td>string</td>
                    <td>
                        Gets or sets screen reader announcement text used when a column is sorted descending.
                        Default value: <span class="@CodeSpan.Base">Sort down completed.</span>.
                        <b>Note:</b> I find it audibly hard to distinguish, ascending / descending when using a screen reader
                        up / down I never mis hear.
                    </td>
                </tr>
                <tr>
                    <td>SortRemovedStatusText</td>
                    <td>string</td>
                    <td>
                        Gets or sets screen reader announcement text used when a column's sort is cleared.
                        Default value: <span class="@CodeSpan.Base">Sort removed.</span>.
                    </td>
                </tr>
                <tr>
                    <td>PressToSortText</td>
                    <td>string</td>
                    <td>
                        Gets or sets the hidden hint text describing sort buttons to assistive technology, referenced via
                        <span class="@CodeSpan.Base">aria-describedby</span>.
                        Default value: <span class="@CodeSpan.Base">Press to sort.</span>.
                    </td>
                </tr>
                <tr>
                    <td>AddTableTabIndex</td>
                    <td>bool</td>
                    <td>
                        Changes the tabindex of -1 to 0 on the table element. You would only need to do this if 
                        the table was scrollable without any interactive focusable elements such as sortable headers, selection checkboxes or custom row actions. 
                        A focusable item on the table allows keyboard only users the ability move any scrollbars. Default value: <span class="@CodeSpan.Base">false</span>.
                    </td>
                </tr>
                <tr>
                    <td>AdditionalAttributes</td>
                    <td>Dictionary&lt;string, object&gt;?</td>
                    <td>Gets or sets additional attributes applied to the underlying table element.</td>
                </tr>
                <tr>
                    <td>SelectedRowsChanged</td>
                    <td>EventCallback&lt;List&lt;TData&gt;&gt;</td>
                    <td>Raised whenever the selected rows change.</td>
                </tr>
            </tbody>
        </table>

    </section>
    <section class="code-table">

        <h3 id="data-column-component-parameters" class="code-table__heading">DataColumn component parameters</h3>

        <table aria-labelledby="data-column-component-parameters">

            <thead>
                <tr>
                    <th scope="col">Parameter</th>
                    <th scope="col">Type</th>
                    <th scope="col">Description</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>DataProperty</td>
                    <td>Expression&lt;Func&lt;TData, object&gt;&gt;?</td>
                    <td>
                        The property on TData this column reads its value from. Required. 
                        Default value: <span class="@CodeSpan.Base">default</span>.
                    </td>
                </tr>
                <tr>
                    <td>CellStyleFunc</td>
                    <td>Func&lt;TData, string?&gt;?</td>
                    <td>
                        Gets or sets the optional function returning inline CSS for a specific row's cell in this column. 
                        Default value: <span class="@CodeSpan.Base">null</span>.
                    </td>
                </tr>
                <tr>
                    <td>IsSortable</td>
                    <td>bool</td>
                    <td>Gets or sets the whether column sorting is available for this column. Default value: <span class="@CodeSpan.Base">false</span>.</td>
                </tr>
                <tr>
                    <td>CellTemplate</td>
                    <td>RenderFragment&lt;TData&gt;?</td>
                    <td>
                        Gets or sets the optional template used to render each cell's content instead of just the raw value. 
                        Default value: <span class="@CodeSpan.Base">default</span>.
                    </td>
                </tr>
                <tr>
                    <td>HeaderStyle</td>
                    <td>string?</td>
                    <td>
                        Gets or sets the optional inline CSS values applied to a style attribute on the column's header cell. 
                        Default value: <span class="@CodeSpan.Base">null</span>.
                    </td>
                </tr>
                <tr>
                    <td>CellStyle</td>
                    <td>string?</td>
                    <td>
                        Gets or sets the optional inline CSS values applied to a style attribute added to every cell in the column. 
                        Default value: <span class="@CodeSpan.Base">null</span>.
                    </td>
                </tr>
                <tr>
                    <td>DisplayName</td>
                    <td>string</td>
                    <td>Gets or sets the text shown in the column header. Default to the field name if not entered.</td>
                </tr>
                <tr>
                    <td>CellFormat</td>
                    <td>string?</td>
                    <td>
                        Gets or sets the optional .NET format string applied to the cell's value, e.g. for dates or numbers. 
                        Default value: <span class="@CodeSpan.Base">null</span>.
                    </td>
                </tr>
                <tr>
                    <td>ColumnAlignment</td>
                    <td>ColumnAlignment (enum)</td>
                    <td>
                        Horizontal alignment applied to the column's header and cells. 
                        Default value: <span class="@CodeSpan.Base">ColumnAlignment.Start</span>.
                    </td>
                </tr>
            </tbody>
        </table>

    </section>
    <section class="code-table">
        <h3 id="template-column-component-parameters" class="code-table__heading">TemplateColumn component parameters</h3>

        <table aria-labelledby="template-column-component-parameters">

            <thead>
                <tr>
                    <th scope="col">Parameter</th>
