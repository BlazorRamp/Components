@attribute [Route($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_DataTable}/{GlobalValues.Component_Path_Part_Usage}/{GlobalValues.Common_Page_Path_Paging}")]

<PageTitle>@GlobalValues.Component_Name_Data_Table @GlobalValues.Common_Page_Title_Paging</PageTitle>

<h1>@GlobalValues.Component_Name_Data_Table @GlobalValues.Common_Page_Title_Paging</h1>

<p>
    The Data Table has two slots (RenderFragments) for pagers, TopPager and BottomPager, with the top pager slot appearing below the filter slot. In the following example, I have added two instances of the Blazor Ramp Pager component to be used for both the top and bottom pager slots, without the filter.
</p>
<p>
    <strong>Note: </strong> when using two pagers, it is important to remember that the pagers take care of their own announcements for the number of pages and rows displayed, so, to avoid the screen reader user hearing the same message twice, you should set one of the pagers not to make announcements by using the value <span class="code-span">PagerAnnouncementType.WithoutAnnouncement</span> for the <span class="code-span">PagerAnnouncementType</span> parameter.
</p>
<p>
    I have used a data source with only <b>100 rows</b> and an <b>items-per-page value of 25.</b> Given the reduced number of pages, I opted to exclude the First and Last selectors from the pagers.
</p>
<p>
    As I did not change the <span class="code-span">TableHeight</span> parameter from its default value of <b>500px</b>, the table's vertical scrollbar is displayed, as the content exceeds that height.
    With pagination, the style property is set to use <span class="code-span">max-height</span>, so the table can grow, unlike virtualisation, which requires the fixed <span class="code-span">height</span> property.
    I could have set <span class="code-span">TableHeight</span> to a much larger value, knowing it would not occupy that space unless necessary; however, I deliberately left it as is so you could see the scrollbar in action alongside pagination, which would not normally be the case.
</p>

<DataTable TData="Contact" DataSource="@_dataSource" Title="Contact Results" PagerBinding="@_pagerBinding">
    <TopPager>
        <Pager @bind-CurrentPage="@_pagerBinding.CurrentPage" AriaLabel="Contacts top pager" TotalItemCount="@_pagerBinding.TotalItemCount" CurrentItemCount="@_pagerBinding.CurrentItemCount"
               ItemsPerPage="@_pagerBinding.ItemsPerPage" PagerSelectorType="PagerSelectorType.Button" ShowFirstLast="false" PageAlignment="PageAlignment.End" 
               PagerAnnouncementType="PagerAnnouncementType.WithoutAnnouncement" />
    </TopPager>
    <TableColumns>
        <DataColumn DataProperty="c => c.ContactID"   DisplayName="ID"            IsSortable="true" />
        <DataColumn DataProperty="c => c.GivenName"   DisplayName="First Name"    IsSortable="true" />
        <DataColumn DataProperty="c => c.FamilyName"  DisplayName="Surname"       IsSortable="true" />
        <DataColumn DataProperty="c => c.Country"     DisplayName="Country"       IsSortable="true" />
        <DataColumn DataProperty="c => c.DateOfBirth" DisplayName="Date of Birth" ColumnAlignment="ColumnAlignment.Centre" IsSortable="true" />
        <DataColumn DataProperty="c => c.Rate"        DisplayName="Hourly Rate"   IsSortable="true" CellFormat="C" ColumnAlignment="ColumnAlignment.End" />
    </TableColumns>
    <BottomPager>
        <Pager @bind-CurrentPage="@_pagerBinding.CurrentPage" AriaLabel="Contacts bottom pager" TotalItemCount="@_pagerBinding.TotalItemCount" CurrentItemCount="@_pagerBinding.CurrentItemCount"
               ItemsPerPage="@_pagerBinding.ItemsPerPage" PagerSelectorType="PagerSelectorType.Button" ShowFirstLast="false" PageAlignment="PageAlignment.Start" 
               PagerAnnouncementType="PagerAnnouncementType.WithAnnouncement" />
    </BottomPager>
</DataTable>
<p>
  <b>Note: </b> The Blazor Ramp Pager controls its own horizonal alignment, so unlike the filter slot where the Data Table will control the position (Start, Centre or End), for the Pager you use its alignment paramater.
</p>
<p>
    The code from the example above.
</p>
<CodeBox CodeBlock="@DataTableSnippets.Paging_Usage_Example" AriaLabel="Paging usage code example." />

<div class="flex-content justify-content-between">
    <a class="@GlobalValues.Link_Button_Class @GlobalValues.Link_Button_Left_Arrow_Modifier" href="@($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_DataTable}/{GlobalValues.Component_Path_Part_Usage}/{GlobalValues.Common_Page_Path_Virtualizing}")">
        <span aria-hidden="true"></span>
        <span>@GlobalValues.Component_Name_Data_Table - @GlobalValues.Common_Page_Title_Virtualizing</span>
        <span aria-hidden="true"></span>
    </a>
    <a class="@GlobalValues.Link_Button_Class @GlobalValues.Link_Button_Right_Arrow_Modifier" href="@($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_DataTable}/{GlobalValues.Component_Path_Part_Usage}/{GlobalValues.Common_Page_Path_Sorting}")">
        <span aria-hidden="true"></span>
        <span>@GlobalValues.Component_Name_Data_Table - @GlobalValues.Common_Page_Title_Sorting</span>
        <span aria-hidden="true"></span>
    </a>
</div>


@code{

    private PagerBinding _pagerBinding = new(itemsPerPage: 25);
    private List<Contact>  _dataSource   = [];

    protected override void OnInitialized()
    
        => _dataSource = StaticData.GetContacts(100);

}