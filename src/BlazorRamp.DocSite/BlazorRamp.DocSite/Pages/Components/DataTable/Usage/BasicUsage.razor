
@attribute [Route($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_DataTable}/{GlobalValues.Component_Path_Part_Usage}/{GlobalValues.Common_Page_Path_Basic_Usage}")]

<PageTitle>@GlobalValues.Component_Name_Data_Table @GlobalValues.Common_Page_Title_Usage_Basic</PageTitle>

<h1>@GlobalValues.Component_Name_Data_Table @GlobalValues.Common_Page_Title_Usage_Basic . . . In Progress . . .</h1>


<DataTable TData="Contact" DataSource="@_dataSource" DefaultSortIndex="-1" Title="Contact Results" RowSelectionMode="RowSelectionMode.Multiple">
    <TableColumns>
        <DataColumn DataProperty="c => c.ContactID" DisplayName="Contact ID" />
        <DataColumn DataProperty="c => c.GivenName" DisplayName="First Name" IsSortable="true" />
        <DataColumn DataProperty="c => c.GivenName" DisplayName="Surname" />
        <DataColumn DataProperty="c => c.DateOfBirth" DisplayName="Data of Birth" ColumnAlignment="ColumnAlignment.Centre" />
        <DataColumn DataProperty="c => c.Country" DisplayName="Residence" />
        <DataColumn DataProperty="c => c.Rate" DisplayName="Hourly Rate" ColumnAlignment="ColumnAlignment.End" />
    </TableColumns>
</DataTable>

<div class="flex-content justify-content-between">
    <a class="@GlobalValues.Link_Button_Class @GlobalValues.Link_Button_Left_Arrow_Modifier" href="@($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_DataTable}/{GlobalValues.Component_Path_Part_Usage}/{GlobalValues.Common_Page_Path_About}")">
        <span aria-hidden="true"></span>
        <span>@GlobalValues.Component_Name_Data_Table - @GlobalValues.Common_Page_Title_Usage_About</span>
        <span aria-hidden="true"></span>
    </a>
    <a class="@GlobalValues.Link_Button_Class @GlobalValues.Link_Button_Right_Arrow_Modifier" href="@($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_DataTable}/{GlobalValues.Component_Path_Part_Usage}/{GlobalValues.Common_Page_Path_Virtualizing}")">
        <span aria-hidden="true"></span>
        <span>@GlobalValues.Component_Name_Data_Table - @GlobalValues.Common_Page_Title_Virtualizing</span>
        <span aria-hidden="true"></span>
    </a>
</div>




@code{

    private List<Contact> _dataSource = [];

    protected override void OnInitialized()
    {
        _dataSource = StaticData.GetContacts(100);
    }
}
