@attribute [Route($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_Pager}/{GlobalValues.Common_Page_Path_Api}")]

<PageTitle>@GlobalValues.Component_Name_Pager @GlobalValues.Common_Page_Title_Api</PageTitle>

<h1>@GlobalValues.Component_Name_Pager @GlobalValues.Common_Page_Title_Api</h1>

<p>
    Everything you need to work with the Pager component: parameters, methods, models, enums, and CSS variables for styling.
</p>


<section>
    <h2 class="page-heading">
        Component parameters, methods, supporting classes and enums.
    </h2>
    <p>
        The following sections cover all components that make up this feature, including their parameters,
        public methods, and any supporting classes or enumerations required for use.
    </p>

    <section class="code-table">

        <h3 id="pager-component-parameters" class="code-table__heading">Pager component parameters</h3>

        <table aria-labelledby="pager-component-parameters">

            <thead>
                <tr>
                    <th scope="col">Parameter</th>
                    <th scope="col">Type</th>
                    <th scope="col">Description</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>AriaLabel</td>
                    <td>string</td>
                    <td>
                        Gets or sets the accessible label describing the purpose of the pager, exposed to assistive technology
                        via the pager's <span class="code-span">nav</span> landmark. Defaults to <span class="code-span">Results Pager</span>.
                        <br />
                        <strong>Note: </strong>This value is captured during the <span class="code-span">OnInitialized</span> method
                        and changes there after are ignored.
                    </td>
                </tr>
                <tr>
                    <td>PagerSelectorType</td>
                    <td>PagerSelectorType (enum)</td>
                    <td>
                        Gets or sets whether the pager renders its navigation controls as button elements or as
                        anchor elements. For anchors the current page number is added to the address bar, but the
                        default <span class="code-span">href</span> has been supressed, but it can be used for favourites or
                        open in new page etc. Defaults to <span class="code-span">PagerSelectorType.Button</span>.
                        <br />
                        <strong>Note: </strong>This value is captured during the <span class="code-span">OnInitialized</span> method
                        and changes there after are ignored.
                    </td>
                </tr>
                <tr>
                    <td>PagerAnnouncementType</td>
                    <td>PagerAnnouncementType (enum)</td>
                    <td>
                        Gets or sets whether page changes are announced to assistive technology via the live region. Defaults to
                        <span class="code-span">PagerAnnouncementType.WithAnnouncement</span>. You would only want to use
                        <span class="code-span">PagerAnnouncementType.WithoutAnnouncement</span> to suppress announcements for situations
                        where you had two pagers bound to the same variables, for example when having a pager both above and below the results being paged.
                    </td>
                </tr>
                <tr>
                    <td>PageAlignment</td>
                    <td>PageAlignment (enum)</td>
                    <td>
                        Gets or sets the horizontal alignment of the pager within its container. Defaults to <span class="code-span">PageAlignment.Centred</span>.
                    </td>
                </tr>
                <tr>
                    <td>FirstText</td>
                    <td>string</td>
                    <td>
                        Gets or sets the visible and accessible name for the "first page" control. Only rendered when
                        <span class="code-span">ShowFirstLast</span> is true. Defaults to <span class="code-span">First</span>.
                        <br />
                        <strong>Note: </strong>This value is captured during the <span class="code-span">OnInitialized</span> method
                        and changes there after are ignored.
                    </td>
                </tr>
                <tr>
                    <td>PreviousText</td>
                    <td>string</td>
                    <td>
                        Gets or sets the visible and accessible name for the "previous page" control. Defaults to <span class="code-span">Previous</span>.
                        <br />
                        <strong>Note: </strong>This value is captured during the <span class="code-span">OnInitialized</span> method
                        and changes there after are ignored.
                    </td>
                </tr>
                <tr>
                    <td>NextText</td>
                    <td>string</td>
                    <td>
                        Gets or sets the visible and accessible name for the "next page" control. Defaults to <span class="code-span">Next</span>.
                        <br />
                        <strong>Note: </strong>This value is captured during the <span class="code-span">OnInitialized</span> method
                        and changes there after are ignored.
                    </td>
                </tr>
                <tr>
                    <td>LastText</td>
                    <td>string</td>
                    <td>
                        Gets or sets the visible and accessible name for the "last page" control. Only rendered when
                        <span class="code-span">ShowFirstLast</span> is true. Defaults to <span class="code-span">First</span>.
                        <br />
                        <strong>Note: </strong>This value is captured during the <span class="code-span">OnInitialized</span> method
                        and changes there after are ignored.
                    </td>
                </tr>
                <tr>
                    <td>ShowFirstLast</td>
                    <td>bool</td>
                    <td>
                        Gets or sets whether the "first page" and "last page" controls are rendered in addition to previous and next.
                        Defaults to <span class="code-span">true</span>.
                    </td>
                </tr>
                <tr>
                    <td>QueryParamName</td>
                    <td>string</td>
                    <td>
                        Gets or sets the name of the query string parameter used to encode the page number when anchors are used. Defaults to "page".
                    </td>
                </tr>
                <tr>
                    <td>PageCountText</td>
                    <td>string</td>
                    <td>
                        Gets or sets the template used to build the pager's information text. Supports the placeholders
                        <span class="code-span">{currentpage}</span>, <span class="code-span">{lastpage}</span>, <span class="code-span">{startrow}</span>, <span class="code-span">{endrow}</span>,
                        <span class="code-span">{currentrows}</span> (the rowcount after filtering, if any), and <span class="code-span">{totalrows}</span> (the true, unfiltered row count), which are
                        replaced with the current values at render time. 
                        <br />
                        Defaults to <span class="code-span">Current page {currentpage} of {lastpage}, items {startrow} to {endrow}</span>
                    </td>
                </tr>
                <tr>
                    <td>FilterCountText</td>
                    <td>string</td>
                    <td>
                        Gets or sets the template appended directly after the main information text when
                        <span class="code-span">CurrentItemCount</span> differs from <span class="code-span">TotalItemCount</span>,
                        indicating that the current row count reflects an active filter. Supports the placeholders <span class="code-span">{filteredrows}</span>
                        and <span class="code-span">{totalrows}</span>. No separator is inserted between the two templates, so a custom value should include its own leading
                        punctuation or spacing (the default begins with ", ").
                        <br />
                        Defaults to <span class="code-span">, {filteredrows} items filtered from {totalrows}.</span>.
                    </td>
                </tr>
                <tr>
                    <td>NoRecordsText</td>
                    <td>string</td>
                    <td>
                        Gets or sets the text displayed and announced in place of the information text when there are no
                        records to page through. Defaults to <span class="code-span">No entries found.</span>
                    </td>
                </tr>
                <tr>
                    <td>TotalItemCount</td>
                    <td>int</td>
                    <td>
                        Gets or sets the total number of records available, before any filtering is applied. Used together with
                        <span class="code-span">CurrentItemCount</span> to determine whether the information text should indicate that the
                        results are filtered. Defaults to <span class="code-span">0</span>.
                    </td>
                </tr>
                <tr>
                    <td>CurrentItemCount</td>
                    <td>int</td>
                    <td>
                        Gets or sets the number of records available after any filtering is applied. Used to calculate the
                        total number of pages and the row range shown in the information text. Values greater than
                        <span class="code-span">TotalItemCount</span> are clamped to <span class="code-span">TotalItemCount</span>.
                        Defaults to <span class="code-span">0</span>.
                    </td>
                </tr>
                <tr>
                    <td>ItemsPerPage</td>
                    <td>int</td>
                    <td>
                        Gets or sets the number of records shown per page. Values less than <span class="code-span">1</span> fall back to the default
                        of <span class="code-span">10</span>.
                    </td>
                </tr>
                <tr>
                    <td>CurrentPage</td>
                    <td>int</td>
                    <td>
                        Gets or sets the currently displayed page number, using a 1-based index. Values outside the valid range
                        are clamped between <span class="code-span">1</span> and the last available page.
                    </td>
                </tr>
                <tr>
                    <td>AdditionalAttributes</td>
                    <td>Dictionary&lt;string, object&gt;?</td>
                    <td>Sets additional attributes applied to the component's root element.</td>
                </tr>
                <tr>
                    <td>CurrentPageChanged</td>
                    <td>EventCallback&lt;int&gt;</td>
                    <td>
                        Gets or sets the callback invoked when the user requests a page change, receiving the newly requested
                        1-based page number. The pager does not update <span class="code-span">CurrentPage</span> itself; consumers are expected
                        to handle this callback and pass the new value back in via the <span class="code-span">CurrentPage</span> parameter.
                    </td>
                </tr>
            </tbody>
        </table>
    </section>
</section>

<section>
    <h2 class="page-heading">Supporting enums</h2>

    <section class="code-table">

        <h3 id="pager-selector-type-enum" class="code-table__heading">PagerSelectorType enum</h3>

        <table aria-labelledby="pager-selector-type-enum">

            <thead>
                <tr>
                    <th scope="col">Value</th>
                    <th scope="col">Name</th>
                    <th scope="col">Description</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>0</td>
                    <td>PagerSelectorType</td>
                    <td>
                        Navigation controls are rendered as button elements.
                        This is the default value.
                    </td>
                </tr>
                <tr>
                    <td>1</td>
                    <td>Blank</td>
                    <td>
                        Navigation controls are rendered as anchor elements.
                    </td>
                </tr>
            </tbody>
        </table>

    </section>

    <section class="code-table">

        <h3 id="pager-announcement-type-enum" class="code-table__heading">PagerAnnouncementType enum</h3>

        <table aria-labelledby="pager-announcement-type-enum">

            <thead>
                <tr>
                    <th scope="col">Value</th>
                    <th scope="col">Name</th>
                    <th scope="col">Description</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>0</td>
                    <td>WithAnnouncement</td>
                    <td>Page changes are announced to assistive technology via the live region service.</td>
                </tr>
                <tr>
                    <td>1</td>
                    <td>WithoutAnnouncement</td>
                    <td>Page changes are not announced by the pager. Useful for when two pagers are being used for the same data set</td>
                </tr>
            </tbody>
        </table>
        <p>
            <strong>Note: </strong>The announcements sent to the live region services are flagged as not replayable so they will not be
            included in the rolling log / shown in the announcement history viewer.
        </p>
    </section>

    <section class="code-table">

        <h3 id="pager-alignment-enum" class="code-table__heading">PageAlignment enum</h3>

        <table aria-labelledby="pager-alignment-enum">

            <thead>
                <tr>
                    <th scope="col">Value</th>
                    <th scope="col">Name</th>
                    <th scope="col">Description</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>0</td>
                    <td>Centred</td>
                    <td>
                        The pager is centred within its container. (nav element).
                        This is the default value.
                    </td>
                </tr>
                <tr>
                    <td>1</td>
                    <td>Start</td>
                    <td>The pager is aligned to the start of its container (nav element).</td>
                </tr>
                <tr>
                    <td>2</td>
                    <td>End</td>
                    <td>The pager is aligned to the end of its container</td>
                </tr>
            </tbody>
        </table>


    </section>

</section>

