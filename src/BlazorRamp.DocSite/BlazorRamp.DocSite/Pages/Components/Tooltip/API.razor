@using BlazorRamp.DocSite.Pages.GettingStarted
@attribute [Route($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_Tooltip}/{GlobalValues.Common_Page_Path_Api}")]

<PageTitle>@GlobalValues.Component_Name_Tooltip @GlobalValues.Common_Page_Title_Api</PageTitle>

<h1>@GlobalValues.Component_Name_Tooltip @GlobalValues.Common_Page_Title_Api</h1>

<p>
    Everything you need to work with the Tooltip component: parameters, methods, models, enums, and CSS variables for styling.
</p>

<section>
    <h2 class="mobile-centred-heading">
        Component parameters, methods, supporting classes and enums.
    </h2>
    <p>
        The following sections cover all components that make up this feature, including their parameters,
        public methods, and any supporting classes or enumerations required for use.
    </p>

    <section>

        <h3 id="tooltip-component-parameters" class="mobile-centred-heading">Tooltip component parameters</h3>

        <div class="@Section.Base @Section.NoPadding @Section.OverflowX(UnitScroll.Auto) @Padding.Block(UnitSpace.Four)">
            <table class="@Table.Base @Table.CodeTable" tabindex="0" aria-labelledby="tooltip-component-parameters">

                <thead>
                    <tr>
                        <th scope="col">Parameter</th>
                        <th scope="col">Type</th>
                        <th scope="col">Description</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>ChildContent</td>
                        <td>RenderFragment?</td>
                        <td>Gets or sets the content the tooltip is attached to (wraps) such as an icon only button.</td>
                    </tr>
                    <tr>
                        <td>TooltipID</td>
                        <td>string</td>
                        <td>
                            Gets or sets the unique id used for the tooltip element, so the consumer can
                            reference it via <span class="@CodeSpan.Base">aria-describedby</span> on the trigger element.
                        </td>
                    </tr>
                    <tr>
                        <td>TooltipText</td>
                        <td>string</td>
                        <td>Gets or sets the text displayed inside the tooltip.</td>
                    </tr>
                    <tr>
                        <td>InvertColours</td>
                        <td>bool</td>
                        <td>Gets or sets whether the tooltip uses its inverted colour scheme.</td>
                    </tr>
                    <tr>
                        <td>TooltipPosition</td>
                        <td>TooltipPosition (enum)</td>
                        <td>
                            Gets or sets the position of the popover relative to the trigger.
                            Defaults to <span class="@CodeSpan.Base">TooltipPosition.TopCentre</span>.
                        </td>
                    </tr>
                    <tr>
                        <td>AdditionalAttributes</td>
                        <td>Dictionary&lt;string, object&gt;?</td>
                        <td>Sets additional attributes applied to the component's root element.</td>
                    </tr>
                </tbody>
            </table>
        </div>

    </section>
</section>
<section>
    <h2 class="mobile-centred-heading">Supporting enums</h2>

    <section>

        <h3 id="tooltippposition-enum" class="mobile-centred-heading">ToolTipPosition enum</h3>
        <div class="@Section.Base @Section.NoPadding @Section.OverflowX(UnitScroll.Auto) @Padding.Block(UnitSpace.Four)">
            <table class="@Table.Base @Table.CodeTable" tabindex="0" aria-labelledby="tooltippposition-enum">

                <thead>
                    <tr>
                        <th scope="col">Value</th>
                        <th scope="col">Name</th>
                        <th scope="col">Description</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>0</td>
                        <td>TopCentre</td>
                        <td>Positions the tooltip above and centred on the container.</td>
                    </tr>
                    <tr>
                        <td>1</td>
                        <td>TopLeft</td>
                        <td>Positions the tooltip above and aligned to the left of the container.</td>
                    </tr>
                    <tr>
                        <td>2</td>
                        <td>TopRight</td>
                        <td>Positions the tooltip above and aligned to the right of the container.</td>
                    </tr>
                    <tr>
                        <td>3</td>
                        <td>CentreLeft</td>
                        <td>Positions the tooltip to the left and vertically centred on the container.</td>
                    </tr>
                    <tr>
                        <td>4</td>
                        <td>CentreRight</td>
                        <td>Positions the tooltip to the right and vertically centred on the container.</td>
                    </tr>
                    <tr>
                        <td>5</td>
                        <td>BottomCentre</td>
                        <td> Positions the tooltip below and centred on the container.</td>
                    </tr>
                    <tr>
                        <td>6</td>
                        <td>BottomLeft</td>
                        <td>Positions the tooltip below and aligned to the left of the container.</td>
                    </tr>
                    <tr>
                        <td>7</td>
                        <td>BottomRight</td>
                        <td>Positions the tooltip below and aligned to the right of the container.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>
</section>

<section>
    <h2 class="mobile-centred-heading">CSS variables defined for the tooltip component.</h2>

    <p>
        The following sections outline all of the css variables that can be set to alter the styling of the tooltip component.
        You can of course also override its style classes directly.
    </p>
    <section>

        <h3 id="tooltip-content-area-variables" class="mobile-centred-heading">Content area variables</h3>
        <div class="@Section.Base @Section.NoPadding @Section.OverflowX(UnitScroll.Auto) @Padding.Block(UnitSpace.Four)">
            <table class="@Table.Base @Table.CodeTable" tabindex="0" aria-labelledby="Tooltip-content-area-variables">

                <thead>
                    <tr>
                        <th scope="col">Variable Name</th>
                        <th scope="col">Default Value</th>
                        <th scope="col">Description</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>--br-comp-tooltip-area-content-background</td>
                        <td>var(--br-unit-colour-canvas)</td>
                        <td>The background colour for the content - <b>does not use the shared component variable.</b></td>
                    </tr>
                    <tr>
                        <td>--br-comp-tooltip-area-content-text</td>
                        <td>var(--br-unit-colour-canvas-text)</td>
                        <td>The content text colour -  <b>does not use the shared component variable.</b></td>
                    </tr>
                    <tr>
                        <td>--br-comp-tooltip-area-content-font-family</td>
                        <td>var(--br-comp-all-area-content-font-family)</td>
                        <td>The font family used - uses the shared component variable.</td>
                    </tr>
                    <tr>
                        <td>--br-comp-tooltip-area-content-font-size</td>
                        <td>var(--br-unit-font-size-label)</td>
                        <td>The size of the font - <b>does not use the shared variable.</b></td>
                    </tr>
                    <tr>
                        <td> --br-comp-tooltip-area-content-font-weight</td>
                        <td>var(--br-comp-all-area-content-font-weight)</td>
                        <td>The font weight- uses the shared component variable.</td>
                    </tr>
                    <tr>
                        <td>--br-comp-tooltip-area-content-line-height</td>
                        <td>var(--br-comp-all-area-content-line-height)</td>
                        <td>The line height used - uses the shared component variable.</td>
                    </tr>
                    <tr>
                        <td>--br-comp-tooltip-area-content-border-style</td>
                        <td>var(--br-comp-all-area-content-border-style)</td>
                        <td>The border style for the content- uses the shared component variable.</td>
                    </tr>
                     <tr>
                        <td>---br-comp-tooltip-area-content-border-colour</td>
                        <td>var(--br-comp-all-area-content-border-colour)</td>
                        <td>The border colour - uses the shared component variable.</td>
                    </tr>
                    <tr>
                        <td>--br-comp-tooltip-area-content-border-width</td>
                        <td>var(--br-unit-border-1)</td>
                        <td>The border width - <b>does not use the shared variable.</b></td>
                    </tr>
                    <tr>
                        <td>--br-comp-tooltip-area-content-border-radius</td>
                        <td>var(--br-group-container-area-content-border-radius)</td>
                        <td>The border radius - uses a shared border radius grouping variable.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>

    <section>

        <h3 id="unmapped-variables" class="mobile-centred-heading">CSS variables from the above not mapped to the --br-comp-all variables.</h3>
        <p>
            The following table of unmapped variables are those for those that needed to deviate from the underlying values provided by
            by standard mappings to the <span class="@CodeSpan.Base">--br-comp-all</span> variables.
        </p>
        <div class="@Section.Base @Section.NoPadding @Section.OverflowX(UnitScroll.Auto) @Padding.Block(UnitSpace.Four)">
            <table class="@Table.Base @Table.CodeTable" tabindex="0" aria-labelledby="unmapped-variables">

                <thead>
                    <tr>
                        <th scope="col">Variable Name</th>
                        <th scope="col">Default Value</th>
                        <th scope="col">Description</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>--br-comp-tooltip-area-content-background</td>
                        <td>var(--br-unit-colour-canvas)</td>
                        <td>The background colour for the content - <b>does not use the shared component variable.</b></td>
                    </tr>
                    <tr>
                        <td>--br-comp-tooltip-area-content-text</td>
                        <td>var(--br-unit-colour-canvas-text)</td>
                        <td>The content text colour -  <b>does not use the shared component variable.</b></td>
                    </tr>
                    <tr>
                        <td>--br-comp-tooltip-area-content-font-size</td>
                        <td>var(--br-unit-font-size-label)</td>
                        <td>The size of the font - <b>does not use the shared variable.</b></td>
                    </tr>
                    <tr>
                        <td>--br-comp-tooltip-area-content-border-width</td>
                        <td>var(--br-unit-border-1)</td>
                        <td>The border width - <b>does not use the shared variable.</b></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>

</section>

<div class="@FlexContent.Base @FlexContent.Wrap(UnitFlexWrap.Wrap) @LayoutAlignment.JustifyContent(UnitJustifyContent.SpaceBetween) @LayoutAlignment.AlignItems(UnitAlignItems.Centre)">
        <a class="@Button.Base @Button.LinkStyle @Gap.SetColGap(UnitGapSize.Four)" href="@($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_Tooltip}/{GlobalValues.Common_Page_Path_Accessibility}")">
        <span class="@SvgIcon.Base @SvgIcon.Size(UnitIconSize.ExtraLarge)" aria-hidden="true" style="--_svg-icon-source:var(--svg-left-arrow-circle-icon)"></span>
        <span>@GlobalValues.Component_Name_Tooltip - @GlobalValues.Common_Page_Title_Accessibility</span>

    </a>
        <a class="@Button.Base @Button.LinkStyle @Gap.SetColGap(UnitGapSize.Four)" href="@($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_Tooltip}/{GlobalValues.Common_Page_Path_Usage}")">

        <span>@GlobalValues.Component_Name_Tooltip - @GlobalValues.Common_Page_Title_Usage</span>
        <span class="@SvgIcon.Base @SvgIcon.Size(UnitIconSize.ExtraLarge)" aria-hidden="true" style="--_svg-icon-source:var(--svg-right-arrow-circle-icon)"></span>
    </a>
</div>
