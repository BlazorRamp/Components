@attribute [Route($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_Tooltip}/{GlobalValues.Common_Page_Path_Installation}")]

<PageTitle>@GlobalValues.Component_Name_Tooltip @GlobalValues.Common_Page_Title_Installation</PageTitle>

<h1>@GlobalValues.Component_Name_Tooltip @GlobalValues.Common_Page_Title_Installation</h1>


<p>
    <strong>Note: </strong> It is a requirement that the Blazor Ramp Core <span class="@CodeSpan.Base">core-live-region.js</span> script, <span class="@CodeSpan.Base">LiveRegionService</span>, and
    associated <span class="@CodeSpan.Base">&lt;AnnouncementHistory /&gt;</span> component are added alongside this component’s specific
    requirements (a stylesheet reference in this instance).
        
</p>
<p>
    You do not need to add the BlazorRamp.Core package separately, as BlazorRamp.Core is included as a transitive package, you only need to add the packages that contain the components
    that you wish to use i.e the <b>BlazorRamp.ToolTip</b> NuGet package.
</p>
<p>
    Please follow the instructions in the <a class="@GlobalValues.Link_Class" href="@($"{GlobalValues.Root_path_Getting_Started}{GlobalValues.Common_Page_Path_Installation}")">@GlobalValues.Getting_Started_Name - @GlobalValues.Common_Page_Title_Installation</a>
    ensuring that in the <span class="@CodeSpan.Base">&lt;head&gt;</span> section you also add the Tooltip stylesheet as follows:
</p>
<CodeBox CodeBlock="@TooltipSnippets.Add_Tooltip_Style_Sheet" AriaLabel="Add tooltip stylesheet code block" />
<p>
    <strong>Important: </strong>The Tooltip component uses CSS anchor positioning with fallbacks for when it wont fit in the desired location which was only baseline at the start of the year 2026.
    Dependant on your target audience and supported browser versions, you may want to consider referencing the OddBird anchor positioning polyfill
    see: <a class="@GlobalValues.Link_Class" target="_blank" href="https://github.com/oddbird/css-anchor-positioning">https://github.com/oddbird/css-anchor-positioning (opens in new window)</a>
    to support older browser versions.
</p>


<h2 id="release-history">Release history</h2>

<ol reversed class="history-list">
    <li>
        <h3>
            Version 1.0.0 — <time datetime="2026-09-24">September 24, 2026</time>
        </h3>
        <ul>
            <li>Initial release part of the <span class="@CodeSpan.Base">BlazorRamp.ToolTip v1.0.0</span> NuGet package, multi-targeting <span class="@CodeSpan.Base">.NET 8.0, .NET 9.0 & .NET 10.0</span></li>
        </ul>
    </li>
</ol>



<div class="@FlexContent.Base @FlexContent.Wrap(UnitFlexWrap.Wrap) @LayoutAlignment.JustifyContent(UnitJustifyContent.SpaceBetween) @LayoutAlignment.AlignItems(UnitAlignItems.Centre)">
        <a class="@Button.Base @Button.LinkStyle @Gap.SetColGap(UnitGapSize.Four)" href="@($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_Tooltip}/{GlobalValues.Common_Page_Path_Overview}")">
        <span class="@SvgIcon.Base @SvgIcon.Size(UnitIconSize.ExtraLarge)" aria-hidden="true" style="--_svg-icon-source:var(--svg-left-arrow-circle-icon)"></span>
        <span>@GlobalValues.Component_Name_Tooltip - @GlobalValues.Common_Page_Title_Overview</span>

    </a>
        <a class="@Button.Base @Button.LinkStyle @Gap.SetColGap(UnitGapSize.Four)" href="@($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_Tooltip}/{GlobalValues.Common_Page_Path_Accessibility}")">

        <span>@GlobalValues.Component_Name_Tooltip - @GlobalValues.Common_Page_Title_Accessibility</span>
        <span class="@SvgIcon.Base @SvgIcon.Size(UnitIconSize.ExtraLarge)" aria-hidden="true" style="--_svg-icon-source:var(--svg-right-arrow-circle-icon)"></span>
    </a>
</div>
