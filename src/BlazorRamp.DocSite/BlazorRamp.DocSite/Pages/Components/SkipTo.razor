@attribute [Route(GlobalValues.Path_Components_Skip_To)]

<PageTitle>@GlobalValues.Page_Title_Components_Skip_To</PageTitle>

<h1 class="page-heading">. . @GlobalValues.Page_Heading_Components_Skip_To . . should be released in a few days . . . docs in progress.</h1>

<section>
    <h2 class="page-heading">CSS variables defined for the skip to component.</h2>

    <p>
        The following sections outline all of the css variables that can be set to alter the styling of the skip to component.
        You can of course also override its style classes directly.
    </p>


    <section class="code-table">

        <h3 id="pane-base-variables" class="code-table__heading">Pane base variables</h3>

        <table aria-labelledby="pane-base-variables">

            <thead>
                <tr>
                    <th scope="col">Variable Name</th>
                    <th scope="col">Default Value</th>
                    <th scope="col">Description</th>
                </tr>
            </thead>
            <tbody>

            </tbody>
        </table>

    </section>



</section>
<div class="flex-content justify-content-between">
    <a class="@GlobalValues.Link_Button_Class @GlobalValues.Link_Button_Left_Arrow_Modifier" href="@GlobalValues.Path_Components_Busy_Indicator">
        <span aria-hidden="true"></span>
        <span>@GlobalValues.Main_Nav_Section_Heading_Components - @GlobalValues.Page_Heading_Components_Busy_Indicator</span>
        <span aria-hidden="true"></span>
    </a>
    <a class="@GlobalValues.Link_Button_Class @GlobalValues.Link_Button_Right_Arrow_Modifier" href="@GlobalValues.Path_FAQs_Questions">
        <span aria-hidden="true"></span>
        <span>@GlobalValues.Main_Nav_Section_Heading_FAQs - @GlobalValues.Page_Heading_FAQs_Questions</span>
        <span aria-hidden="true"></span>
    </a>
</div>

