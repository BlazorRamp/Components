                    <th scope="col">Description</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>--br-comp-accordion-area-header-background</td>
                    <td>inherit</td>
                    <td>The background colour of the accordion heading - <b>does not use the shared variable.</b></td>
                </tr>
                <tr>
                    <td>--br-comp-accordion-area-header-text</td>
                    <td>var(--br-comp-all-area-header-text)</td>
                    <td>The text colour used for the according headings and icons - uses the shared component variable.</td>
                </tr>
                <tr>
                    <td>--br-comp-accordion-area-header-font-family</td>
                    <td>var(--br-comp-all-area-header-font-family)</td>
                    <td>The font family used - uses the shared component variable.</td>
                </tr>
                <tr>
                    <td>--br-comp-accordion-area-header-font-size</td>
                    <td>var(--br-unit-font-size-label)</td>
                    <td>The size of the accordion heading font - <b>does not use the shared variable.</b></td>
                </tr>
                <tr>
                    <td>--br-comp-accordion-area-header-font-weight</td>
                    <td>var(--br-comp-all-area-header-font-weight)</td>
