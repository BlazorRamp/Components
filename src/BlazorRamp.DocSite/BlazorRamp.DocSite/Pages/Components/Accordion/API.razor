@attribute [Route($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_Accordion}/{GlobalValues.Common_Page_Path_Api}")]

<PageTitle>@GlobalValues.Component_Name_Accordion @GlobalValues.Common_Page_Title_Api</PageTitle>

<h1>@GlobalValues.Component_Name_Accordion @GlobalValues.Common_Page_Title_Api</h1>

<p>
    Everything you need to work with the Accordion component: parameters, methods, models, enums, and CSS variables for styling.
</p>

<section>
    <h2 class="page-heading">
        Component parameters, methods, supporting classes and enums.
    </h2>
    <p>
        The following sections cover all components that make up this feature, including their parameters,
        public methods, and any supporting classes or enumerations required for use.
    </p>

    <section class="code-table">
        
        <h3 id="accordion-component-parameters" class="code-table__heading">Accordion component (parent) parameters</h3>

        <table aria-labelledby="accordion-component-parameters">

            <thead>
                <tr>
                    <th scope="col">Parameter</th>
                    <th scope="col">Type</th>
                    <th scope="col">Description</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>ChildContent</td>
                    <td>RenderFragment?</td>
                    <td>
                        The render fragment used for the child content (for each AccordionItem).
                    </td>
                </tr>
                <tr>
                    <td>ExpandMode</td>
                    <td>ExpandMode (enum)?</td>
                    <td>
                        Gets or sets the expand mode controlling whether one or multiple panels can be
                        open simultaneously. Defaults to <span class="code-span">ExpandMode.Multiple</span>.
                    </td>
                </tr>
                <tr>
                    <td>HeadingLevel</td>
                    <td>HeadingLevel (enum)</td>
                    <td>
                        Gets or sets the semantic heading level rendered for each accordion item trigger.
                        Defaults to <span class="code-span">HeadingLevel.H3</span>.
                    </td>
                </tr>

                <tr>
                    <td>OnAccordionItemHeadingClicked</td>
                    <td>EventCallback&lt;ItemHeadingData&gt;</td>
                    <td>
                        Gets or sets the callback invoked when an accordion item heading is clicked,
                        providing an <span class="code-span">ItemHeadingData</span> payload containing the item index,
                        heading text, and expanded state.
                    </td>
                </tr>
                <tr>
                    <td>AdditionalAttributes</td>
                    <td>Dictionary&lt;string, object&gt;?</td>
                    <td>Sets additional attributes applied to the component's root element.</td>
                </tr>
            </tbody>
        </table>
    </section>

    <section class="code-table">
        <h3 id="accordion-component-methods" class="code-table__heading">Accordion component methods</h3>

        <table aria-labelledby="accordion-component-methods">

            <thead>
                <tr>
                    <th scope="col">Return</th>
                    <th scope="col">Method</th>
                    <th scope="col">Description</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Task</td>
                    <td>ExpandAllPanels()</td>
                    <td>
                        Expands all accordion panels irrespective of the <span class="code-span">ExpandMode</span>.
                    </td>
                </tr>
                <tr>
                    <td>Task</td>
                    <td>CollapseAllPanels()</td>
                    <td>
                        Collapses all accordion panels.
                    </td>
                </tr>
                <tr>
                    <td>Task</td>
                    <td>ExpandPanel(int index, bool codeFocused = false)</td>
                    <td>
                        Expands the accordion panel at the specified zero-based index.
                        <br />In <span class="code-span">ExpandMode.Single</span>, all other panels are collapsed first.
                        <br />Does nothing if the index is out of range.
                        Setting the <span class="code-span">codeFocused</span> argument to <span class="code-span">true</span>
                        programmatically moves focus to the trigger button (accordion heading) and applies a style that mimics
                        <span class="code-span">:focus-visible</span>. The default of <span class="code-span">false</span> only
                        expands the panel without moving focus.
                    </td>
                </tr>
            </tbody>
        </table>
    </section>

    <section class="code-table">
        <h3 id="accordion-item-component-parameters" class="code-table__heading">AccordionItem component (child) parameters</h3>

        <table aria-labelledby="accordion-item-component-parameters">

            <thead>
                <tr>
                    <th scope="col">Parameter</th>
                    <th scope="col">Type</th>
                    <th scope="col">Description</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>PanelContent</td>
                    <td>RenderFragment?</td>
                    <td>
                        The content for accordion items panel.
                    </td>
                </tr>
                <tr>
                    <td>HeadingText</td>
                    <td>string</td>
                    <td>
                        Gets or sets the visible label for the accordion trigger button, which is the contest for the heading. Also used as the
                        accessible name. This parameter is required and cannot be null, empty, or whitespace.
                    </td>
                </tr>
                <tr>
                    <td>PanelIsRegion</td>
                    <td>bool</td>
                    <td>
                        Gets or sets a value indicating whether the panel element is given a <span class="code-span">role="region"</span>, making it
                        a landmark navigable by screen readers. <strong>
                        Only set to true when the panel contains sufficiently important content to
                        warrant landmark navigation.
                    </strong> Defaults to <span class="code-span">false"</span>.
                </td>
            </tr>
            <tr>
                <td>Expanded</td>
                <td>bool</td>
                <td>
                    Gets or sets a value indicating whether the panel is expanded or collapsed.
                    Supports two-way binding via <span class="code-span">ExpandedChanged</span>. Defaults to <span class="code-span">false</span>.
                </td>
            </tr>
            <tr>
                <td>ExpandedChanged</td>
                <td>EventCallback&lt;bool&gt;</td>
                <td>
                    Gets or sets the callback invoked when the expanded state changes, supporting
                    two-way binding with <span class="code-span">@@bind-Expanded</span>.
                </td>
            </tr>

            <tr>
                <td>PanelHasTabIndex</td>
                <td>bool</td>
                <td>
                    Gets or sets a value indicating whether <span class="code-span">tabindex="0"</span> is applied to the
                    accordion panel, enabling keyboard focus and arrow key scrolling if the panel has a constrained height. Defaults to <span class="code-span">true</span>.
                    For more details see: <a class="@GlobalValues.Link_Class" href="@($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_Accordion}/{GlobalValues.Common_Page_Path_Accessibility}")">
                    @GlobalValues.Component_Name_Accordion - @GlobalValues.Common_Page_Title_Accessibility
                </a>
            </td>
        </tr>
        <tr>
            <td>PersistContent</td>
            <td>bool</td>
            <td>
                Determine whether the accordion item panel content is retained in the DOM when the accordion item is collapsed. Defaults to
                <span class="code-span">false</span>.
            </td>
        </tr>
        <tr>
            <td>SvgIcon</td>
            <td>string?</td>
            <td>
                Optional, the name of the css svg variable. As its a css variable it must start with a double dash (--).
                The airplane icon used in the example above has the name --svg-airplane-icon. <br />
                The details in the :root pseudo-class is: --svg-airplane-icon: url("data:image/svg+xml,%3Csvg . . .
            </td>
        </tr>
    </tbody>
</table>
</section>

</section>
