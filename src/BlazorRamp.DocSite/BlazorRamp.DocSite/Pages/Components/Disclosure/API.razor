@attribute [Route($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_Disclosure}/{GlobalValues.Common_Page_Path_Api}")]

<PageTitle>@GlobalValues.Component_Name_Disclosure @GlobalValues.Common_Page_Title_Api</PageTitle>

<h1>@GlobalValues.Component_Name_Disclosure @GlobalValues.Common_Page_Title_Api</h1>

<p>
    Everything you need to work with the Disclosure component: parameters, methods, and CSS variables for styling.
</p>

<section>
    <h2 class="mobile-centred-heading">
        Component parameters and methods.
    </h2>
    <p>
        The following sections cover the component, including its parameters and public methods.
    </p>

    <section>

        <h3 id="disclosure-component-parameters" class="mobile-centred-heading">Disclosure component parameters</h3>

        <div class="@Section.Base @Section.NoPadding @Section.OverflowX(UnitScroll.Auto) @Padding.Block(UnitSpace.Four)">
            <table class="@Table.Base @Table.CodeTable" tabindex="0" aria-labelledby="disclosure-component-parameters">

                <thead>
                    <tr>
                        <th scope="col">Parameter</th>
                        <th scope="col">Type</th>
                        <th scope="col">Description</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>ChildContent</td>
                        <td>RenderFragment?</td>
                        <td>Gets or sets the content displayed in the expandable region.</td>
                    </tr>
                    <tr>
                        <td>TriggerText</td>
                        <td>string</td>
                        <td>
                            Gets or sets the text of the trigger button, which is also its accessible name. Leading and trailing whitespace is trimmed.
                            Required - an <span class="@CodeSpan.Base">ArgumentNullException</span> is thrown if it is <span class="@CodeSpan.Base">null</span>, empty or whitespace.
                        </td>
                    </tr>
                    <tr>
                        <td>Expanded</td>
                        <td>bool</td>
                        <td>
                            Gets or sets whether the content is expanded. Supports two-way binding using <span class="@CodeSpan.Base">@@bind-Expanded</span>.
                            Defaults to <span class="@CodeSpan.Base">false</span>.
                        </td>
                    </tr>
                    <tr>
                        <td>ExpandedChanged</td>
                        <td>EventCallback&lt;bool&gt;</td>
                        <td>
                            Gets or sets the callback invoked with the new state when the disclosure is expanded or collapsed by the user or by the <span class="@CodeSpan.Base">SetExpandedState</span> method.
                            It isn't invoked when the parent changes the <span class="@CodeSpan.Base">Expanded</span> value.
                        </td>
                    </tr>
                    <tr>
                        <td>PersistContent</td>
                        <td>bool</td>
                        <td>
                            Gets or sets whether the content is kept in the DOM while collapsed. When <span class="@CodeSpan.Base">false</span> the content is removed when collapsed and created again
                            when expanded, so any state inside it is lost. Defaults to <span class="@CodeSpan.Base">true</span>.
                        </td>
                    </tr>
                    <tr>
                        <td>ContentIsRegion</td>
                        <td>bool</td>
                        <td>
                            Gets or sets whether the content element is given <span class="@CodeSpan.Base">role="region"</span> and named by the trigger, making it a landmark.
                            Only use this for substantial content. Defaults to <span class="@CodeSpan.Base">false</span>.
                        </td>
                    </tr>
                    <tr>
                        <td>SvgIcon</td>
                        <td>string?</td>
                        <td>
                            Gets or sets the name of a CSS custom property that resolves to an SVG data URI, used as an icon beside the trigger text, for example <span class="@CodeSpan.Base">--svg-my-icon</span>.
                            The value must begin with <span class="@CodeSpan.Base">--</span>, otherwise it is ignored and no icon is shown. Defaults to <span class="@CodeSpan.Base">null</span>.
                        </td>
                    </tr>
                    <tr>
                        <td>RemoveTriggerBorderPadding</td>
                        <td>bool</td>
                        <td>
                            Gets or sets whether the border and the inline (left and right) padding are removed from the trigger.
                            Defaults to <span class="@CodeSpan.Base">false</span>.
                        </td>
                    </tr>
                    <tr>
                        <td>RemoveContentBorderPadding</td>
                        <td>bool</td>
                        <td>
                            Gets or sets whether the border and the inline (left and right) padding are removed from the content.
                            Defaults to <span class="@CodeSpan.Base">false</span>.
                        </td>
                    </tr>
                    <tr>
                        <td>ContentMaxHeight</td>
                        <td>string?</td>
                        <td>
                            Gets or sets the maximum height of the content as a CSS length, for example <span class="@CodeSpan.Base">20rem</span>. Content taller than this scrolls within its own region.
                            Accepts a non-negative number followed by one of <span class="@CodeSpan.Base">rem</span>, <span class="@CodeSpan.Base">em</span>, <span class="@CodeSpan.Base">lh</span>,
                            <span class="@CodeSpan.Base">ch</span>, <span class="@CodeSpan.Base">px</span>, <span class="@CodeSpan.Base">vh</span>, <span class="@CodeSpan.Base">dvh</span>,
                            <span class="@CodeSpan.Base">svh</span>, <span class="@CodeSpan.Base">lvh</span> or <span class="@CodeSpan.Base">vw</span>. Percentages and functions such as
                            <span class="@CodeSpan.Base">calc()</span> aren't supported, and an <span class="@CodeSpan.Base">ArgumentException</span> is thrown for any other value.
                            Defaults to <span class="@CodeSpan.Base">null</span>, meaning no limit.
                        </td>
                    </tr>
                    <tr>
                        <td>AdditionalAttributes</td>
                        <td>Dictionary&lt;string, object&gt;?</td>
                        <td>Sets additional attributes applied to the component's root element. Any <span class="@CodeSpan.Base">class</span> value is added to the component's own class.</td>
                    </tr>
                </tbody>
            </table>
        </div>

    </section>

    <section>

        <h3 id="disclosure-component-methods" class="mobile-centred-heading">Disclosure component methods</h3>
        <div class="@Section.Base @Section.NoPadding @Section.OverflowX(UnitScroll.Auto) @Padding.Block(UnitSpace.Four)">
            <table class="@Table.Base @Table.CodeTable" tabindex="0" aria-labelledby="disclosure-component-methods">

                <thead>
                    <tr>
                        <th scope="col">Return</th>
                        <th scope="col">Method</th>
                        <th scope="col">Description</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Task</td>
                        <td>SetExpandedState(bool expandedState)</td>
                        <td>
                            Expands (<span class="@CodeSpan.Base">true</span>) or collapses (<span class="@CodeSpan.Base">false</span>) the disclosure programmatically, for example through a component reference.
                            Invokes <span class="@CodeSpan.Base">ExpandedChanged</span> if the state changes, and does nothing if the disclosure is already in the requested state.
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>
</section>

