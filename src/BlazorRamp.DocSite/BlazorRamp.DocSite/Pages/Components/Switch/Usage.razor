@attribute [Route($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_Switch}/{GlobalValues.Common_Page_Path_Usage}")]

<PageTitle>@GlobalValues.Component_Name_Switch @GlobalValues.Common_Page_Title_Usage</PageTitle>

<h1>@GlobalValues.Component_Name_Switch @GlobalValues.Common_Page_Title_Usage</h1>



<p>Example showing the parameters being set for the switch with the two way binding syntax for the <span>SwitchState</span> parameter.</p>

<CodeBox CodeBlock="@SwitchSnippets.Switch_Two_Way_Bind_Example" AriaLabel="Switch two way binding code block" />

<p><strong>Note: </strong>If you want to use the event then use one way binding for the <span>SwitchState</span> parameter.</p>

<CodeBox CodeBlock="@SwitchSnippets.Switch_One_Way_Bind_Event_Example" AriaLabel="Switch one way binding with event code block" />

<p>
    Below are two switches, the top one has the <span class="@CodeSpan.Base">SpaceBetween</span> parameter set to false so the label stays next to the switch. The second
    switch has its  <span class="@CodeSpan.Base">SpaceBetween</span> parameter set to true, which forces the label and switch to be at either side of its parent container.
</p>
<section class="@Section.Base @Section.Bordered @Section.Radius(SectionRadius.Content)">

    <Switch Label="Airplane mode:" SpaceBetween="false" style="margin-block:1rem;" />
    <Switch Label="Bluetooth:" SpaceBetween="true" style="margin-block:1rem;" />
</section>
<ThemeBorderTool Title="Applicable theme border tools" ThemeToolHeadingLevel="ThemeToolHeadingLevel.H2" style="margin-top:var(--br-unit-space-9);">
    <BorderGroups>
        <BorderGroup Title="Button borders">
            <BorderRadius LabelText="Button radius" ResetText="Reset button radius" MaxRangeValue="@GlobalValues.Radius_Button_Max_Range_Value" CssProperties="@([new(CoreCssVariables.Group_Button_Radius)])" />
        </BorderGroup>
    </BorderGroups>
</ThemeBorderTool>

<div class="flex-content justify-content-between">
    <a class="@GlobalValues.Link_Button_Class @GlobalValues.Link_Button_Left_Arrow_Modifier" href="@($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_Switch}/{GlobalValues.Common_Page_Path_Api}")">
        <span aria-hidden="true"></span>
        <span>@GlobalValues.Component_Name_Switch - @GlobalValues.Common_Page_Title_Api</span>
        <span aria-hidden="true"></span>
    </a>
    <a class="@GlobalValues.Link_Button_Class @GlobalValues.Link_Button_Right_Arrow_Modifier" href="@($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_Tabs}/{GlobalValues.Common_Page_Path_Overview}")">
        <span aria-hidden="true"></span>
        <span>@GlobalValues.Component_Name_Tabs - @GlobalValues.Common_Page_Title_Overview</span>
        <span aria-hidden="true"></span>
    </a>
</div>


