@attribute [Route($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_Switch}/{GlobalValues.Common_Page_Path_Accessibility}")]

<PageTitle>@GlobalValues.Component_Name_Switch @GlobalValues.Common_Page_Title_Accessibility</PageTitle>

<h1>@GlobalValues.Component_Name_Switch @GlobalValues.Common_Page_Title_Accessibility</h1>


<h2 id="switch-keyboard" class="@GlobalValues.Info_Box_Heading_Class">Keyboard interaction</h2>
<ul aria-labelledby="switch-keyboard">
    <li><kbd>Space</kbd> - when focus is on the Switch, toggles the state of the switch.</li>
    <li><kbd>Enter</kbd> - when focus is on the Switch, toggles the state of the switch.</li>
</ul>

<h3 id="screen-reader-quirks" class="@GlobalValues.Info_Box_Heading_Class" style="margin-top:var(--br-unit-space-9);">Screen reader quirks or known issues</h3>
<ul aria-labelledby="screen-reader-quirks">
    <li><b>Narrator</b> paired with <b>Firefox</b> announces button on/off instead of switch on/off.</li>
</ul>


<div class="flex-content justify-content-between">
    <a class="@GlobalValues.Link_Button_Class @GlobalValues.Link_Button_Left_Arrow_Modifier" href="@($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_Switch}/{GlobalValues.Common_Page_Path_Installation}")">
        <span aria-hidden="true"></span>
        <span>@GlobalValues.Component_Name_Switch - @GlobalValues.Common_Page_Title_Installation</span>
        <span aria-hidden="true"></span>
    </a>
    <a class="@GlobalValues.Link_Button_Class @GlobalValues.Link_Button_Right_Arrow_Modifier" href="@($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_Switch}/{GlobalValues.Common_Page_Path_Api}")">
        <span aria-hidden="true"></span>
        <span>@GlobalValues.Component_Name_Switch - @GlobalValues.Common_Page_Title_Api</span>
        <span aria-hidden="true"></span>
    </a>
</div>
@code {

}
