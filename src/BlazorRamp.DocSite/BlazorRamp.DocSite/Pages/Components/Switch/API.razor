                    <td>Style of the outline around the switch part of the component on focus - uses the shared component variable.</td>
                </tr>
                <tr>
                    <td>-br-comp-switch-outline-width</td>
                    <td>var(--br-comp-all-outline-width)</td>
                    <td>Width of the outline - uses the shared component variable.</td>
                </tr>
                <tr>
                    <td>--br-comp-switch-outline-offset</td>
