@attribute [Route(GlobalValues.Path_Components_Busy_Indicator)]

<PageTitle>@GlobalValues.Page_Title_Components_Busy_Indicator</PageTitle>

<h1 class="page-heading">. . @GlobalValues.Page_Heading_Components_Busy_Indicator . . should be released in the first or second week of February 2026</h1>

<div class="flex-content justify-content-between">
    <a class="@GlobalValues.Link_Button_Class @GlobalValues.Link_Button_Left_Arrow_Modifier" href="@GlobalValues.Path_Components_Announcement_History">
        <span aria-hidden="true"></span>
        <span>@GlobalValues.Main_Nav_Section_Heading_Components - @GlobalValues.Page_Heading_Components_Announcement_History</span>
        <span aria-hidden="true"></span>
    </a>
    <a class="@GlobalValues.Link_Button_Class @GlobalValues.Link_Button_Right_Arrow_Modifier" href="@GlobalValues.Path_FAQs_Questions">
        <span aria-hidden="true"></span>
        <span>@GlobalValues.Main_Nav_Section_Heading_FAQs - @GlobalValues.Page_Heading_FAQs_Questions</span>
        <span aria-hidden="true"></span>
    </a>
</div>



