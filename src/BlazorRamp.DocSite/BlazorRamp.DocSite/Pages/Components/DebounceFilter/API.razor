@using BlazorRamp.DocSite.Pages.GettingStarted
@attribute [Route($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_DebounceFilter}/{GlobalValues.Common_Page_Path_Api}")]

<PageTitle>@GlobalValues.Component_Name_Debounce_Filter @GlobalValues.Common_Page_Title_Api</PageTitle>

<h1>@GlobalValues.Component_Name_Debounce_Filter @GlobalValues.Common_Page_Title_Api</h1>
<p>
    Everything you need to work with the Debounce Filter component: parameters, methods, models, enums, and CSS variables for styling.
</p>


<section>
    <h2 class="page-heading">
        Component parameters, methods, supporting classes and enums.
    </h2>
    <p>
        The following sections cover all components that make up this feature, including their parameters,
        public methods, and any supporting classes or enumerations required for use.
    </p>
    <section class="code-table">

        <h3 id="debounce-filter-component-parameters" class="code-table__heading">DebounceFilter component parameters</h3>

        <table aria-labelledby="debounce-filter-component-parameters">

            <thead>
                <tr>
                    <th scope="col">Parameter</th>
                    <th scope="col">Type</th>
                    <th scope="col">Description</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>FilterLabelText</td>
                    <td>string</td>
                    <td>
                        Gets or sets the name used for the filter input control label.
                        If the value is null, empty, or whitespace then the default of "Filter" is used. 
                    </td>
                </tr>
                <tr>
                    <td>ControlID</td>
                    <td>string</td>
                    <td>
                        Gets or sets the <span class="code-span">id</span> attribute applied to the underlying <c>&lt;input&gt;</c>
                        element. When null, empty, or whitespace a <see cref="Guid"/> string is generated automatically. 
                        Leading and trailing whitespace is trimmed before use.         
                    </td>
                    </tr>
                <tr>
                    <td>HintText</td>
                    <td>string?</td>
                    <td>
                        Gets or sets the hint text rendered below the label and above the input field.
                        When set, the text is normalised so it always ends with a full stop, and is
                        associated to the input via <span class="code-span">aria-describedby</span>. 
                        When null, empty, or whitespace no hint element is rendered.
                    </td>
                </tr>
                <tr>
                    <td>SvgIcon</td>
                    <td>string?</td>
                    <td>
                        Gets or sets the name of a CSS custom property that resolves to an SVG data URI,
                        used as a mask-image icon alongside the tab title. Must begin with <span class="code-span">--</span>.
                        For example: <span class="code-span">--svg-my-icon</span>.
                    </td>
                </tr>
                <tr>
                    <td>FilterDataPosition</td>
                    <td>FilterDataPosition (enum)</td>
                    <td>
                        Gets or sets the text/data alignment in the input.
                        Defaults to <span class="code-span">FilterDataPosition.Start</span>
                    </td>
                </tr>
                <tr>
                    <td>DebounceDelayMs</td>
                    <td>int</td>
                    <td>
                        Gets or sets the debounce delay in milliseconds used.
                        Defaults to 500ms.
                    </td>
                </tr>
                <tr>
                    <td>RegexPattern</td>
                    <td>string?</td>
                    <td>
                        Gets or sets the regular expression pattern used to validate the filter input.
                        When null or empty no validation is applied.
                    </td>
                </tr>
                <tr>
                    <td>ValidationMessage</td>
                    <td>string?</td>
                    <td>
                        Gets or sets the validation message displayed when the regex pattern is not matched.
                    </td>
                </tr>
                <tr>
                    <td>ParseErrorMessage</td>
                    <td>string?</td>
                    <td>
                        Gets or sets the error message displayed when the regex pattern fails to compile.
                        Defaults to "System error, filtering is unavailable at this time."
                    </td>
                </tr>
                <tr>
                    <td>Replayable</td>
                    <td>bool</td>
                    <td>
                        Gets or sets whether non-system-error validation messages are added to the replayable
                        announcement history. Defaults to <span class="code-span">true</span>. Genuine system errors (e.g. an invalid
                        regex pattern) are always added to history regardless of this setting.
                    </td>
                </tr>
                <tr>
                    <td>OnDebounceFilterResult</td>
                    <td>Func&lt;DebouncedFilterResult, Task&gt;?</td>
                    <td>Func used like an event to pass the <span class="code-span">DebouncedFilterResult</span>
                        back to the parent component after each debounced input event.
                    </td>
                </tr>
                <tr>
                    <td>AdditionalAttributes</td>
                    <td>Dictionary&lt;string, object&gt;?</td>
                    <td>
                        Gets or sets additional attributes applied to the input element, but classes
                        get merged with the root component classes.
                    </td>
                </tr>
            </tbody>
        </table>

    </section>

    <section class="code-table">
        <h3 id="debouce-filter-methods" class="code-table__heading">DebounceFilter component methods</h3>

        <table aria-labelledby="debouce-filter-methods">

            <thead>
                <tr>
                    <th scope="col">Return</th>
                    <th scope="col">Method</th>
                    <th scope="col">Description</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Task</td>
                    <td>ClearFilter()</td>
                    <td>
                        Clears the filter input and resets the validation state
                    </td>
                </tr>
            </tbody>
        </table>
    </section>

    <section class="code-table">

        <h3 id="debounced-filter-result-class" class="code-table__heading">DebouncedFilterResult class</h3>

        <table aria-labelledby="debounced-filter-result-class">

            <thead>
                <tr>
                    <th scope="col">Type</th>
                    <th scope="col">Property</th>
                    <th scope="col">Description</th>
                </tr>
            </thead>
            <tbody>

                <tr>
                    <td>string</td>
                    <td>FilterValue</td>
                    <td>
                        The current value of the filter input at the time the debounce fired.
                    </td>
                </tr>
                <tr>
                    <td>bool</td>
                    <td>IsValid</td>
                    <td>
                        Indicates whether the input passed regex validation, or <span class="code-spane">true</span> 
                        if no regex pattern is configured.
                    </td>
                </tr>
                <tr>
                    <td>bool</td>
                    <td>ClearCalled</td>
                    <td>
                        Indicates whether the result was raised as a result of the filter being programmatically cleared.
                    </td>
                </tr>
                <tr>
                    <td>string?</td>
                    <td>ExceptionMessage</td>
                    <td>
                        The exception message if the regex pattern failed to compile, otherwise <span class="code-span">null</span>.
                    </td>
                </tr>
            </tbody>
        </table>

    </section>


</section>

<section>

    <h2 class="code-table__heading">Supporting enums</h2>

    <section class="code-table">

