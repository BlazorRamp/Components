@attribute [Route($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_Tabs}/{GlobalValues.Common_Page_Path_Api}")]

<PageTitle>@GlobalValues.Component_Name_Tabs @GlobalValues.Common_Page_Title_Api</PageTitle>

<h1>@GlobalValues.Component_Name_Tabs @GlobalValues.Common_Page_Title_Api</h1>

<p>
    Everything you need to work with the Tabs component: parameters, methods, models, enums, and CSS variables for styling.
</p>

<section class="code-table">

    <h2 id="tabs-component-parameters" class="code-table__heading">Tabs component (parent) parameters</h2>

    <table aria-labelledby="tabs-component-parameters">

        <thead>
            <tr>
                <th scope="col">Parameter</th>
                <th scope="col">Type</th>
                <th scope="col">Description</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>ChildContent</td>
                <td>RenderFragment?</td>
                <td>
                    The render fragment used for the child content (for each Tab).
                </td>
            </tr>
            <tr>
                <td>AriaLabelledBy</td>
                <td>string?</td>
                <td>
                    You can give the Tabs component an accessible name by either providing an ID of an element such
                    as a heading to use, or by setting the <span class="code-span">AriaLabel</span> paramater.
                </td>
            </tr>
            <tr>
                <td>AriaLabel</td>
                <td>string?</td>
                <td>
                    Used for the accessible name if the <span class="code-span">AriaLabelledBy</span> parameter was not provided.
                    <strong>Note:</strong> if neither value is provided a default of "Tabs" will be used for the <span class="code-span">aria-label</span> attribute.
                </td>
            </tr>
            <tr>
                <td>ActiveTabIndex</td>
                <td>int</td>
                <td>Gets or sets the zero-based index of the active tab. Defaults to 0.</td>
            </tr>
            <tr>
                <td>ActiveTabIndexChanged</td>
                <td>EventCallback&lt;int&gt;</td>
                <td>Event to recieve the active index manually or used for two-way binding for the active index.</td>
            </tr>
            <tr>
                <td>AutoActivatePanel</td>
                <td>bool</td>
                <td>
                    Determines if the tab panels are shown automatically when its associated tab recieves the focus, or has to be
                    activated manually using the space or enter key after recieving the focus. Defauts to <span class="code-span">false</span>, manual activation.
                </td>
            </tr>
            <tr>
                <td>TabIconPosition</td>
                <td>TabIconPosition (enum)</td>
                <td>Determines the location of any optional icon used on Tabs. Defaults to <span class="code-span">TabIconPosition.Left</span></td>
            </tr>
            <tr>
                <td>AdditionalAttributes</td>
                <td>Dictionary&lt;string, object&gt;?</td>
                <td>Sets additional attributes applied to the component's root element.</td>
            </tr>
        </tbody>
    </table>

    <h2 id="tabs-component-methods" class="code-table__heading">Tabs component methods</h2>

    <table aria-labelledby="tabs-component-methods">

        <thead>
            <tr>
                <th scope="col">Return</th>
                <th scope="col">Method</th>
                <th scope="col">Description</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Task</td>
                <td>SetActiveTab(int tabIndex)</td>
                <td>
                    Programmatically activates a tab by index and moves browser focus to its
                    button so that screen readers announce the change correctly.
                </td>
            </tr>
        </tbody>
    </table>

    <h2 id="tab-component-parameters" class="code-table__heading">Tab component (child) parameters</h2>

    <table aria-labelledby="tab-component-parameters">

        <thead>
            <tr>
                <th scope="col">Parameter</th>
                <th scope="col">Type</th>
                <th scope="col">Description</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>TabPanelContent</td>
                <td>RenderFragment?</td>
                <td>
                    The content for tab panel.
                </td>
            </tr>
            <tr>
                <td>TabTitle</td>
                <td>string</td>
                <td>
                    The tab title but also its accessible name. An exception is raised if a value is not provided.
                </td>
            </tr>
            <tr>
                <td>PersistContent</td>
                <td>bool</td>
                <td>
                    Determine whether the tab panel content is retained in the DOM when the tab is not active. Defaults to true.
                </td>
            </tr>
            <tr>
                <td>SvgIcon</td>
                <td>string?</td>
                <td>
                    Optional, the name of the css svg variable. As its a css variable it must start with a double dash (--).
                    The airplane icon used in the example above has the name --svg-airplane-icon. <br />
                    The details in the :root pseudo-class is: --svg-airplane-icon: url("data:image/svg+xml,%3Csvg . . .
                </td>
            </tr>
            <tr>
                <td>HasPanelTabIndex</td>
                <td>bool</td>
                <td>
                    Determines whether a <span class="code-span">tabindex=0</span> is added to the tab panel. If the
                    tab panel does not contain focusable elements then this should be set to true, otherwise it
                    can be set to false. The default value is true.
                </td>
            </tr>

        </tbody>
    </table>
</section>

<section>
    <h2 class="page-heading">Supporting enums</h2>

    <section class="code-table">

        <h3 id="tabiconposition-enum" class="code-table__heading">TabIconPosition enum</h3>

        <table aria-labelledby="tabiconposition-enum">

            <thead>
                <tr>
                    <th scope="col">Value</th>
                    <th scope="col">Name</th>
                    <th scope="col">Description</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>0</td>
                    <td>Left</td>
                    <td>Renders the icon to the left of the tab title.</td>
                </tr>
                <tr>
                    <td>1</td>
                    <td>Right</td>
                    <td>Renders the icon to the right of the tab title.</td>
                </tr>
                <tr>
                    <td>2</td>
                    <td>Top</td>
                    <td>Renders the icon above the tab title.</td>
                </tr>
                <tr>
                    <td>3</td>
                    <td>Bottom</td>
                    <td>Renders the icon below the tab title.</td>
                </tr>
            </tbody>
        </table>

    </section>

</section>

<section>
    <h2 class="page-heading">CSS variables defined for the tabs component.</h2>

    <p>
        The following sections outline all of the css variables that can be set to alter the styling of the Tabs component.
        You can of course also override its style classes directly.
    </p>

    <section class="code-table">

        <h3 id="outline-misc-variables" class="code-table__heading">Tab/tab panel outline/miscellaneous variables</h3>
        <p>
            There are focus indicators (outlines) applied using <span class="code-span">:focus-visible</span> for the Tab
            and for the actual Tab Panel if it uses <span class="code-span">tabindex=0</span>
        </p>
        <table aria-labelledby="outline-misc-variables">

            <thead>
                <tr>
                    <th scope="col">Variable Name</th>
                    <th scope="col">Default Value</th>
                    <th scope="col">Description</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>--br-comp-tabs-outline-style</td>
                    <td>var(--br-comp-all-outline-style)</td>
                    <td>The style of the outline - uses the shared component variable.</td>
                </tr>
                <tr>
                    <td>--br-comp-tabs-outline-width</td>
                    <td>var(--br-comp-all-outline-width)</td>
                    <td>The outline colour - uses the shared component variable.</td>
                </tr>
                <tr>
                    <td>--br-comp-tabs-outline-offset</td>
                    <td>0px</td>
                    <td>The outline offest - <b>does not use the shared variable.</b></td>
                </tr>
                <tr>
                    <td>--br-comp-tabs-outline-colour</td>
                    <td>var(--br-comp-all-outline-colour)</td>
                    <td>The outline colour - uses the shared component variable.</td>
                </tr>
                <tr>
                    <td>--br-comp-tabs-selected-hover</td>
                    <td>var(--br-comp-all-selection-colour)</td>
                    <td>The background colour on hover of a selected tab - uses the shared component variable.</td>
                </tr>
                <tr>
                    <td>--br-comp-tabs-hover</td>
                    <td>var(--br-comp-all-link-hover-background-colour)</td>
                    <td>
                        The background colour on hover of an unselected tab - uses the shared component variable.
                        <strong>Note:</strong> Tabs are buttons not links, but this exisiting css variable was suitable.
                    </td>
                </tr>
                <tr>
                    <td>--br-tabs-icon-size</td>
                    <td>1.5em</td>
                    <td>
                        Used to contrain the size of the optional icon inline with the font-size used for the tab title
                        - no shared component variable so uses a value directly.
                    </td>
                </tr>
            </tbody>
        </table>
    </section>
    <section class="code-table">

        <h3 id="tabs-header-variables" class="code-table__heading">Header area variables</h3>
        <table aria-labelledby="tabs-header-variables">

            <thead>
                <tr>
                    <th scope="col">Variable Name</th>
                    <th scope="col">Default Value</th>
                    <th scope="col">Description</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>--br-comp-tabs-area-header-background</td>
                    <td>inherit</td>
                    <td>The backgound colour of the tablist where the tabs sit - <b>does not use the shared variable.</b></td>
                </tr>
                <tr>
                    <td>--br-comp-tabs-area-header-text</td>
                    <td>var(--br-comp-all-area-header-text)</td>
                    <td>The text colour used for the tab titles and icons - uses the shared component variable.</td>
                </tr>
                <tr>
                    <td>--br-comp-tabs-area-header-font-family</td>
                    <td>var(--br-comp-all-area-header-font-family)</td>
                    <td>The font family used - uses the shared component variable.</td>
                </tr>
                <tr>
                    <td>--br-comp-tabs-area-header-font-size</td>
                    <td>var(--br-unit-font-size-label)</td>
                    <td>The size of the tab title font - <b>does not use the shared variable.</b></td>
                </tr>
                <tr>
                    <td>--br-comp-tabs-area-header-font-weight</td>
                    <td>var(--br-comp-all-area-header-font-weight)</td>
                    <td>The font weight - uses the shared component variable.</td>
                </tr>
                <tr>
                    <td>--br-comp-tabs-area-header-line-height</td>
                    <td>var(--br-comp-all-area-header-line-height)</td>
                    <td>The line height - uses the shared component variable.</td>
                </tr>
                <tr>
                    <td>--br-comp-tabs-area-header-border-style</td>
                    <td>var(--br-comp-all-area-header-border-style)</td>
                    <td>The border style - uses the shared component variable.</td>
                </tr>
                <tr>
                    <td>--br-comp-tabs-area-header-border-colour</td>
                    <td>var(--br-comp-all-divider-colour)</td>
                    <td>The colour of the bottom border which forms the dividing line between the tabs and the tab panel content - uses the shared component variable.</td>
                </tr>
                <tr>
                    <td>--br-comp-tabs-area-header-border-width</td>
                    <td>var(--br-unit-border-1)</td>
                    <td>The border width - <b>does not use the shared variable.</b></td>
                </tr>
                <tr>
                    <td>--br-comp-tabs-area-header-border-radius</td>
                    <td>var(--br-comp-all-area-header-border-radius)</td>
                    <td>The radius applied to each border corner - uses the shared component variable.</td>
                </tr>
            </tbody>
        </table>

    </section>
    <section class="code-table">

        <h3 id="tab-content-area-variables" class="code-table__heading">Content area (tab panel) variables</h3>

        <table aria-labelledby="tab-content-area-variables">

            <thead>
                <tr>
                    <th scope="col">Variable Name</th>
                    <th scope="col">Default Value</th>
                    <th scope="col">Description</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>--br-comp-tabs-area-content-background</td>
                    <td>transparent</td>
                    <td>The backgound colour - <b>does not use the shared variable.</b></td>
                </tr>
                <tr>
                    <td>--br-comp-tabs-area-content-text</td>
                    <td>var(--br-comp-all-area-content-text)</td>
                    <td>The text/content colour - uses the shared component variable.</td>
                </tr>
                <tr>
                    <td>--br-comp-tabs-area-content-font-family</td>
                    <td>var(--br-comp-all-area-content-font-family)</td>
                    <td>The font family - uses the shared component variable.</td>
                </tr>
                <tr>
                    <td>--br-comp-tabs-area-content-font-size</td>
                    <td>var(--br-comp-all-area-content-text)</td>
                    <td>The font size - uses the shared component variable.</td>
                </tr>
                <tr>
                    <td>--br-comp-tabs-area-content-font-weight</td>
                    <td>var(--br-comp-all-area-content-font-weight)</td>
                    <td>The font weight - uses the shared component variable.</td>
                </tr>
                <tr>
                    <td>--br-comp-tabs-area-content-line-height</td>
                    <td>var(--br-comp-all-area-content-line-height)</td>
                    <td>The line height - uses the shared component variable.</td>
                </tr>

            </tbody>
        </table>

    </section>
    <section class="code-table">

        <h3 id="unmapped-variables" class="code-table__heading">CSS variables from the above not mapped to the --br-comp-all variables.</h3>
        <p>
            The following table of unmapped variables are those for those that needed to deviate from the underlying values provided by
            by standard mappings to the <span class="code-span">--br-comp-all</span> variables.
        </p>

        <table aria-labelledby="unmapped-variables">

            <thead>
                <tr>
                    <th scope="col">Variable Name</th>
                    <th scope="col">Default Value</th>
                    <th scope="col">Description</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>--br-comp-tabs-outline-offset</td>
                    <td>0px</td>
                    <td>The outline offest - <b>does not use the shared variable.</b></td>
                </tr>
                <tr>
                    <td>--br-tabs-icon-size</td>
                    <td>1.5em</td>
                    <td>
                        Used to contrain the size of the optional icon inline with the font-size used for the tab title
                        - no shared component variable so uses a value directly.
                    </td>
                </tr>
                <tr>
                    <td>--br-comp-tabs-area-header-background</td>
                    <td>inherit</td>
                    <td>The backgound colour of the tablist where the tabs sit - <b>does not use the shared variable.</b></td>
                </tr>
                <tr>
                    <td>--br-comp-tabs-area-header-font-size</td>
                    <td>var(--br-unit-font-size-label)</td>
                    <td>The size of the tab title font - <b>does not use the shared variable.</b></td>
                </tr>
                <tr>
                    <td>--br-comp-tabs-area-header-border-width</td>
                    <td>var(--br-unit-border-1)</td>
                    <td>The border width - <b>does not use the shared variable.</b></td>
                </tr>
                <tr>
                    <td>--br-comp-tabs-area-content-background</td>
                    <td>transparent</td>
                    <td>The backgound colour - <b>does not use the shared variable.</b></td>
                </tr>
            </tbody>
        </table>

    </section>
</section>

<div class="flex-content justify-content-between">
    <a class="@GlobalValues.Link_Button_Class @GlobalValues.Link_Button_Left_Arrow_Modifier" href="@($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_Tabs}/{GlobalValues.Common_Page_Path_Accessibility}")">
