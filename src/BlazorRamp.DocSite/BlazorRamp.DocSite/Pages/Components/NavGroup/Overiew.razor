        <span aria-hidden="true"></span>
        <span>@GlobalValues.Component_Name_Busy - @GlobalValues.Common_Page_Title_Usage</span>
        <span aria-hidden="true"></span>
    </a>
    <a class="@GlobalValues.Link_Button_Class @GlobalValues.Link_Button_Right_Arrow_Modifier" href="@($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_NavGroup}/{GlobalValues.Common_Page_Path_Installation}")">
        <span aria-hidden="true"></span>
        <span>@GlobalValues.Component_Name_NavGroup - @GlobalValues.Common_Page_Title_Installation</span>
        <span aria-hidden="true"></span>
    </a>
</div>
