@attribute [Route($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_Busy}/{GlobalValues.Common_Page_Path_Installation}")]

<PageTitle>@GlobalValues.Component_Name_Busy @GlobalValues.Common_Page_Title_Installation</PageTitle>

<h1>@GlobalValues.Component_Name_Busy @GlobalValues.Common_Page_Title_Installation</h1>


<section>
    <h2 class="page-heading">Installation</h2>

    <p>
        <strong>Note: </strong> It is a requirement that the Blazor Ramp Core <span class="code-span">core-live-region.js</span> script, <span class="code-span">LiveRegionService</span>, and
        associated <span class="code-span">&lt;AnnouncementHistory /&gt;</span> component are added alongside this component’s specific
        requirements (a stylesheet reference in this instance). You do not need to add the BlazorRamp.Core package separately, as BlazorRamp.Core is included as a transitive package, you only need to add the packages that contain the components
        that you wish to use i.e the <b>BlazorRamp.BusyIndicator</b> NuGet package.
    </p>
    <p>
        Please follow the instructions in the <a class="@GlobalValues.Link_Class" href="@GlobalValues.Path_Overview_Getting_Started">@GlobalValues.Main_Nav_Section_Heading_About - @GlobalValues.Page_Heading_Overview_Getting_Started</a>
        ensuring that in the <span class="code-span">&lt;head&gt;</span> section you also add the Busy Indicator stylesheet as follows:
    </p>
    <CodeBox CodeBlock="@CodeSnippets.Add_Busy_Indicator_Style_Sheet" AriaLabel="Add busy indicator stylesheet code block" />

</section>


<section class="info-box" aria-labelledby="release-history">

    <h2 id="release-history">Release history</h2>

    <ol reversed>
        <li>
            <h3>
                Version 1.0.2 — <time datetime="2026-02-01">February 02, 2026</time>
            </h3>
            <ul>
                <li>
                    Resolved JSDisconnectedException in the component disposal that could appear when debugging
                    when quickly switching between server and wasm
                </li>
            </ul>
        </li>
        <li>
            <h3>
                Version 1.0.1 — <time datetime="2026-02-01">February 01, 2026</time>
            </h3>
            <ul>
                <li>Added additional target support for <span class="code-span">.NET 9.0 & .NET10.0</span></li>
            </ul>
        </li>
        <li>
            <h3>
                Version 1.0.0 — <time datetime="2026-01-27">January 27, 2026</time>
            </h3>
            <ul>
                <li>Initial release of the <span class="code-span">BlazorRamp.BusyIndicator v1.0.0</span> NuGet package, only targeting <span class="code-span">.NET 8.0</span></li>
            </ul>
        </li>
    </ol>

</section>

<div class="flex-content justify-content-between">
    <a class="@GlobalValues.Link_Button_Class @GlobalValues.Link_Button_Left_Arrow_Modifier" href="@($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_Busy}/{GlobalValues.Common_Page_Path_Overview}")">
        <span aria-hidden="true"></span>
        <span>@GlobalValues.Component_Name_Busy - @GlobalValues.Common_Page_Title_Overview</span>
        <span aria-hidden="true"></span>
    </a>
    <a class="@GlobalValues.Link_Button_Class @GlobalValues.Link_Button_Right_Arrow_Modifier" href="@($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_Busy}/{GlobalValues.Common_Page_Path_Accessibility}")">
        <span aria-hidden="true"></span>
        <span>@GlobalValues.Component_Name_Busy - @GlobalValues.Common_Page_Title_Accessibility</span>
        <span aria-hidden="true"></span>
    </a>
</div>
