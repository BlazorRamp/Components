            <thead>
                <tr>
                    <th scope="col">Variable Name</th>
                    <th scope="col">Default Value</th>
                    <th scope="col">Description</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>--br-comp-input-button-background</td>
                    <td>var(--br-comp-all-button-background)</td>
                    <td>
                        The background colour of the button - uses the shared component variable.
                    </td>
                </tr>
                <tr>
                    <td>--br-comp-input-button-text</td>
                    <td>var(--br-comp-all-button-text)</td>
                    <td>
                        The text colour used on the button - uses the shared component variable.
                    </td>
                </tr>
                <tr>
                    <td>--br-comp-input-button-font-family</td>
                    <td>var(--br-comp-all-button-font-family)</td>
                    <td>
                        The font family used - uses the shared component variable.
                    </td>
                </tr>
                <tr>
                    <td>--br-comp-input-button-font-size</td>
                    <td>var(--br-comp-all-button-font-size)</td>
                    <td>
                        The font size - uses the shared component variable.
                    </td>
                </tr>
                <tr>
                    <td>--br-comp-input-button-font-weight</td>
                    <td>var(--br-comp-all-button-font-weight)</td>
                    <td>
                        The font weight - uses the shared component variable.
                    </td>
                </tr>
                <tr>
                    <td>--br-comp-input-button-line-height</td>
                    <td>var(--br-comp-all-button-line-height)</td>
                    <td>
                        The line height - uses the shared component variable.
                    </td>
                </tr>
                <tr>
                    <td>--br-comp-input-button-border-style</td>
                    <td>var(--br-comp-all-button-border-style)</td>
                    <td>
                        The border style - uses the shared component variable.
                    </td>
                </tr>
                <tr>
                    <td>--br-comp-input-button-border-colour</td>
                    <td>var(--br-comp-all-button-border-colour)</td>
                    <td>
                        The border colour - uses the shared component variable.
                    </td>
                </tr>
                <tr>
                    <td>--br-comp-input-button-border-width</td>
                    <td>var(--br-comp-all-button-border-width)</td>
                    <td>
                        The border width - uses the shared component variable.
                    </td>
                </tr>
                <tr>
                    <td>--br-comp-input-button-border-radius</td>
                    <td>var(--br-comp-all-button-border-radius)</td>
                    <td>
                        The border radius - uses the shared component variable.
                    </td>
                </tr>
                <tr>
                    <td>--br-comp-input-button-state-hover</td>
                    <td>var(--br-comp-all-button-state-hover)</td>
                    <td>
                        The buttons hover state background colour - uses the shared component variable.
                    </td>
                </tr>
                <tr>
                    <td>--br-comp-input-button-state-active-brightness</td>
                    <td>var(--br-comp-all-button-state-active-brightness)</td>
                    <td>
                        The value of the brightness filter used when active - uses the shared component variable.
                    </td>
                </tr>
                <tr>
                    <td>--br-comp-input-button-state-active-scale</td>
                    <td>var(--br-comp-all-button-state-active-scale)</td>
                    <td>
                        The scale value for any transformations used when active - uses the shared component variable.
                    </td>
                </tr>

            </tbody>
        </table>
    </section>

    <section class="code-table">
        <h3 id="input-pane-base-variables" class="code-table__heading">Input pane base variables</h3>

        <table aria-labelledby="input-pane-base-variables">

            <thead>
                <tr>
                    <th scope="col">Variable Name</th>
                    <th scope="col">Default Value</th>
                    <th scope="col">Description</th>
                </tr>
            </thead>
            <tbody>
                
                <tr>
                    <td>--br-comp-input-pane-base-background</td>
                    <td>inherit</td>
                    <td>
                        The background colour of the base pane - <b>does not use the shared component variable.</b>
                    </td>
                </tr>
                <tr>
                    <td>--br-comp-input-pane-base-border-style</td>
                    <td>var(--br-comp-all-pane-base-border-style)</td>
                    <td>
                        The border style - uses the shared component variable.
                    </td>
                </tr>
                <tr>
                    <td>--br-comp-input-pane-base-border-colour</td>
                    <td>var(--br-comp-all-pane-base-border-colour)</td>
                    <td>
                        The border colour - uses the shared component variable.
                    </td>
                </tr>
                <tr>
                    <td>--br-comp-input-pane-base-border-width</td>
                    <td>var(--br-comp-all-pane-base-border-width)</td>
                    <td>
                        The border width - uses the shared component variable.
                    </td>
                </tr>
                <tr>
                    <td>--br-comp-input-pane-base-border-radius</td>
                    <td>var(--br-comp-all-pane-base-border-radius)</td>
                    <td>
                        The border radius - uses the shared component variable
                    </td>
                </tr>
            </tbody>
        </table>
    </section>
    <section class="code-table">
        <h3 id="input-content-area-variables" class="code-table__heading">Input content area variables</h3>

        <table aria-labelledby="input-content-area-variables">

            <thead>
                <tr>
                    <th scope="col">Variable Name</th>
                    <th scope="col">Default Value</th>
                    <th scope="col">Description</th>
                </tr>
            </thead>
            <tbody>
      
                <tr>
                    <td>--br-comp-input-area-content-background</td>
                    <td>inherit</td>
                    <td>
                        The background colour of the content areas - <b>does not use the shared component variable.</b>
                    </td>
                </tr>
                <tr>
                    <td>--br-comp-input-area-content-colour</td>
                    <td>var(--br-comp-all-area-content-text)</td>
                    <td>
                        The text colour used on the content area - uses the shared component variable.
                    </td>
                </tr>
                <tr>
                    <td>--br-comp-input-area-content-font-family</td>
                    <td>var(--br-comp-all-area-content-font-family)</td>
                    <td>
                        The font family used - uses the shared component variable.
                    </td>
                </tr>
                <tr>
                    <td>--br-comp-input-area-content-font-size</td>
                    <td>var(--br-comp-all-area-content-font-size)</td>
                    <td>
                        The font size - uses the shared component value.
                    </td>
                </tr>
                <tr>
                    <td>--br-comp-input-area-content-font-weight</td>
                    <td>var(--br-comp-all-area-content-font-weight)</td>
                    <td>
                        The font weight - uses the shared component variable.
                    </td>
                </tr>
                <tr>
                    <td>--br-comp-input-area-content-line-height</td>
                    <td>var(--br-comp-all-area-content-line-height)</td>
                    <td>
                        The line height - uses the shared component variable.
                    </td>
                </tr>
            </tbody>
        </table>
    </section>

    <section class="code-table">
        <h3 id="input-label-variables" class="code-table__heading">Input label variables</h3>

        <table aria-labelledby="input-label-variables">

            <thead>
                <tr>
                    <th scope="col">Variable Name</th>
                    <th scope="col">Default Value</th>
                    <th scope="col">Description</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>--br-comp-input-label-font-size</td>
                    <td>var(--br-unit-font-size-label)</td>
                    <td>
                        The font size - uses the shared component variable.
                    </td>
                </tr>
                <tr>
                    <td>--br-comp-input-label-font-weight</td>
                    <td>var(--br-unit-font-weight-500)</td>
                    <td>
                        The font weight - uses a Core unit value directly.
                    </td>
                </tr>
                <tr>
                    <td>--br-comp-input-label-color</td>
                    <td>inherit</td>
                    <td>
                        The text colour - inherits its containers text colour.
                    </td>
                </tr>
                <tr>
                    <td>--br-comp-input-label-background</td>
                    <td>inherit</td>
                    <td>
                        The background colour - inherits its containers background colour.
                    </td>
                </tr>
            </tbody>
        </table>
    </section>
    <section class="code-table">
        <h3 id="input-hit-text-variables" class="code-table__heading">Input hint text variables</h3>

        <table aria-labelledby="input-label-variables">

            <thead>
                <tr>
                    <th scope="col">Variable Name</th>
                    <th scope="col">Default Value</th>
                    <th scope="col">Description</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>--br-comp-input-hint-font-size</td>
                    <td>var(--br-unit-font-size-label)</td>
                    <td>
                        The font size - uses the shared component variable.
                    </td>
                </tr>
                <tr>
                    <td>--br-comp-input-hint-font-weight</td>
                    <td>var(--br-unit-font-weight-400)</td>
                    <td>
                        The font weight - uses a Core unit value directly.
                    </td>
                </tr>
                <tr>
                    <td>--br-comp-input-hint-color</td>
                    <td>inherit</td>
                    <td>
                        The text colour - inherits its containers text colour.
                    </td>
                </tr>
                <tr>
                    <td>--br-comp-input-hint-background</td>
                    <td>inherit</td>
                    <td>
                        The background colour - inherits its containers background colour.
                    </td>
                </tr>
                <tr>
                    <td>--br-comp-input-hint-opacity</td>
                    <td>var(--br-unit-opacity-val-80)</td>
                    <td>
                        Slight opacity used on the hint text -  uses a Core unit value directly.
                    </td>
                </tr>
            </tbody>
        </table>
    </section>
</section>

<div class="flex-content justify-content-between">
    <a class="@GlobalValues.Link_Button_Class @GlobalValues.Link_Button_Left_Arrow_Modifier" href="@($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_Inputs}/{GlobalValues.Common_Page_Path_Accessibility}")">
        <span aria-hidden="true"></span>
        <span>@GlobalValues.Component_Name_Inputs - @GlobalValues.Common_Page_Title_Accessibility</span>
        <span aria-hidden="true"></span>
    </a>
    <a class="@GlobalValues.Link_Button_Class @GlobalValues.Link_Button_Right_Arrow_Modifier" href="@($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_Inputs}/{GlobalValues.Component_Path_Part_CheckboxInput}/{GlobalValues.Common_Page_Path_Api}")">
        <span aria-hidden="true"></span>
        <span>@GlobalValues.Component_Name_Checkbox_Input - @GlobalValues.Common_Page_Title_Api</span>
        <span aria-hidden="true"></span>
    </a>
</div>