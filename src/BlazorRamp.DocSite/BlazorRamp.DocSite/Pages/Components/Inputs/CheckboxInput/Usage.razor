@attribute [Route($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_Inputs}/{GlobalValues.Component_Path_Part_CheckboxInput}/{GlobalValues.Common_Page_Path_Usage}")]

<PageTitle>@GlobalValues.Component_Name_Checkbox_Input @GlobalValues.Common_Page_Title_Usage</PageTitle>

<h1>@GlobalValues.Component_Name_Checkbox_Input @GlobalValues.Common_Page_Title_Usage</h1>

<p>
    The example below just shows two CheckboxInput components one that is enabled the other has its <span class="code-span">AriaDisabled</span> set to true. I have not added any validation as there can be only a true or false value 
    but you can of course add a validator should the need arise.
</p>
<p>
    I have added icons and toggle different icons for the Disable Account checkbox by using the onw way binding and the event instead of two way binding. As there is no validation for the checkbox and no other model
    validation, there are no state icons.
</p>
<p>
    Icons are hidden from screen reader users as they are just decorative. In the case of the state icons, green tick and red cross, screen reader
    users are informed via the <span class="code-span">aria-invalid</span> attribute..
</p>

<section class="section-box">
    
    <h2>Checkbox input example</h2>

    <EditForm Model="@_userAccountData">

        <div class="br-input-row">

            <CheckboxInput class="br-col-xs-12 br-col-sm-6" Value="@_userAccountData.Disabled" ValueChanged="HandleValueChanged" ValueExpression="() => _userAccountData.Disabled"
            LabelText="Disable Account" HintText="Tick if the user account should be disabled." SvgIcon="@_disabledIcon" Required="false" />

            <CheckboxInput class="br-col-xs-12 br-col-sm-6" @bind-Value="_userAccountData.IncreaseSalary" LabelText="Increase Salary" HintText="Tick to give yourself a pay rise."
                            SvgIcon="--svg-money-icon" AriaDisabled="true" Required="false" />

     </div>

    </EditForm>

</section>

<p style="padding-block:1rem;">
    Below is the code that was used for the example. 
</p>

<CodeBox CodeBlock="@InputSnippets.Checkbox_Input_Example" AriaLabel="Checkbox input code example" />


<div class="flex-content justify-content-between">
    <a class="@GlobalValues.Link_Button_Class @GlobalValues.Link_Button_Left_Arrow_Modifier" href="@($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_Inputs}/{GlobalValues.Component_Path_Part_CheckboxInput}/{GlobalValues.Common_Page_Path_Api}")">
        <span aria-hidden="true"></span>
        <span>@GlobalValues.Component_Name_Checkbox_Input - @GlobalValues.Common_Page_Title_Api</span>
        <span aria-hidden="true"></span>
    </a>
    <a class="@GlobalValues.Link_Button_Class @GlobalValues.Link_Button_Right_Arrow_Modifier" href="@($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_Inputs}/{GlobalValues.Component_Path_Part_DateInput}/{GlobalValues.Common_Page_Path_Api}")">
        <span aria-hidden="true"></span>
        <span>@GlobalValues.Component_Name_Date_Input - @GlobalValues.Common_Page_Title_Api</span>
        <span aria-hidden="true"></span>
    </a>
</div>

@code {

    public UserAccountDto _userAccountData = new();

    private string _userIcon            = "--svg-user-icon";
    private string _accountLockedIcon = "--svg-lock-account-icon";
    private string _disabledIcon        = "--svg-user-icon";

    private void HandleValueChanged(bool value)
    {
        _disabledIcon = value ? _accountLockedIcon : _userIcon;
        _userAccountData.Disabled = value;
    }

    public class UserAccountDto
    {
        public bool Disabled       { get; set; }
        public bool IncreaseSalary { get; set; }
    }
}