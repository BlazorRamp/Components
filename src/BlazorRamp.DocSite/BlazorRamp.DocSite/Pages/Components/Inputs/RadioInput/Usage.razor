@using BlazorRamp.Inputs.Components.RadioGroup
@attribute [Route($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_Inputs}/{GlobalValues.Component_Path_Part_RadioInputGroup}/{GlobalValues.Common_Page_Path_Usage}")]

<PageTitle>@GlobalValues.Component_Name_Radio_Input_Group @GlobalValues.Common_Page_Title_Usage</PageTitle>

<h1>@GlobalValues.Component_Name_Radio_Input_Group @GlobalValues.Common_Page_Title_Usage</h1>

<p>
    The example below has its Orientation parameter set to <span class="@CodeSpan.Base">Orientation.Horizontal</span> and its ValidationDisplayMode set to <span class="@CodeSpan.Base">ValidationDisplayMode.TabbableWithHint</span>. 
    The optional icon has not been assigned to the component.
</p>
<p>
   The Radio Input Group follows the standard default browser keyboard pattern whereby you tab to the group and then use the arrow keys to both move and select the focused option.
</p>
<p>
    <b>Note: </b>I have used my open source Validation framework and its Blazor NuGet package <a class="@GlobalValues.Link_Class" href="@GlobalValues.Validated_Blazor_Repo_Site" target="_blank">Validated.Blazor (opens in new window)</a>.
    but you can use any validators that work with Blazors <span class="@CodeSpan.Base">EditContext</span>.
</p>
<section class="@Section.Base @Section.Bordered @Section.Radius(SectionRadius.Content)">
    <h2 class="@Section.Heading.Base @Section.Heading.MobileCentred @Section.Heading.Text(SectionHeadingText.SecondaryDark)">Radio input group example</h2>

    <EditForm Model="@_profileData">
        <BlazorValidated TEntity="ProfileDto" BoxedValidators="_boxedValidators" AddDisplayName="true" />
        <div class="br-input-row">
            <RadioInputGroup class=" br-col-xs-12 br-col-sm-6" LabelText="Favourite Food" HintText="What food do you like the most?" Required="true"
                             @bind-Value="@_profileData.FavouriteFoodID" ValidationDisplayMode="ValidationDisplayMode.TabbableWithHint">
            <OptionValues>
                    <RadioInput LabelText="Fish & Chips" Value="1" />
                    <RadioInput LabelText="Burger & Fries" Value="2" />
                    <RadioInput LabelText="Pizza" Value="3" />
            </OptionValues>
            </RadioInputGroup>

        </div>
    </EditForm>

</section>

<ThemeBorderTool Title="Applicable theme border tools" ThemeToolHeadingLevel="ThemeToolHeadingLevel.H2">
    <BorderGroups>
        <BorderGroup Title="Input borders">
            <BorderRadius LabelText="Input radius" ResetText="Reset input radius" MaxRangeValue="@GlobalValues.Radius_Input_Max_Range_Value" CssProperties="@([new(CoreCssVariables.Group_Input_Radius_Base)])" />
        </BorderGroup>
    </BorderGroups>
</ThemeBorderTool>
<h2>
    About the example
</h2>
<p>
    Please note that in general when using the Validated library the validators would be in a shared library so they could be used in any part of your application.
</p>

<CodeBox CodeBlock="@InputSnippets.Radio_Input_Group_Code_Example" AriaLabel="Radio input groupd code example" />


<div class="flex-content justify-content-between">
    <a class="@GlobalValues.Link_Button_Class @GlobalValues.Link_Button_Left_Arrow_Modifier" href="@($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_Inputs}/{GlobalValues.Component_Path_Part_RadioInputGroup}/{GlobalValues.Common_Page_Path_Api}")">
        <span aria-hidden="true"></span>
        <span>@GlobalValues.Component_Name_Radio_Input_Group - @GlobalValues.Common_Page_Title_Api</span>
        <span aria-hidden="true"></span>
    </a>
    <a class="@GlobalValues.Link_Button_Class @GlobalValues.Link_Button_Right_Arrow_Modifier" href="@($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_Inputs}/{GlobalValues.Component_Path_Part_SelectInput}/{GlobalValues.Common_Page_Path_Api}")">
        <span aria-hidden="true"></span>
        <span>@GlobalValues.Component_Name_Select_Input - @GlobalValues.Common_Page_Title_Api</span>
        <span aria-hidden="true"></span>
    </a>
</div>

@code {

    
    private ProfileDto _profileData = new();
    private ImmutableDictionary<string, BoxedValidator> _boxedValidators = default!;

    protected override void OnInitialized()
    {

        var foodValidator = MemberValidators.CreatePredicateValidator<int>(c => c == 1, "FavouriteFoodID", "Favourite Food", "Wrong answer, it has to be Fish & Chips");

        _boxedValidators = BlazorValidationBuilder<ProfileDto>.Create()
                                .ForMember(c => c.FavouriteFoodID, foodValidator)
                                .GetBoxedValidators();
    }

    public class ProfileDto
    {
        public int FavouriteFoodID { get; set; }
    }

}