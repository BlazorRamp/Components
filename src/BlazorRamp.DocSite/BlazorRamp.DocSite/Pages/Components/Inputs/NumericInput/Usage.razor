

@attribute [Route($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_Inputs}/{GlobalValues.Component_Path_Part_NumericInput}/{GlobalValues.Common_Page_Path_Usage}")]

<PageTitle>@GlobalValues.Component_Name_Numeric_Input @GlobalValues.Common_Page_Title_Usage</PageTitle>

<h1>@GlobalValues.Component_Name_Numeric_Input @GlobalValues.Common_Page_Title_Usage . . . In Progress . . . </h1>


<EditForm Model="@_inventoryData" OnValidSubmit="HandleSubmit">
    <BlazorValidated TEntity="InventoryDto" BoxedValidators="_boxedValidators" AddDisplayName="true" />

    <div class="br-input-row">
        <NumericInput maxlength="3" class="br-col-xs-12 br-col-sm-6" @bind-Value="_inventoryData.UnitsInStock" Required="false" LabelText="Units in stock" ErrorsLabel="errors" HintText="Required, the number in stock." UpdateOnInput="true"></NumericInput>
    </div>
    
    <div class="br-input-row">
        <button class="br-col-xs-12 test-button" type="submit">Fake Submit</button>
    </div>

</EditForm>

<div class="flex-content justify-content-between">
    <a class="@GlobalValues.Link_Button_Class @GlobalValues.Link_Button_Left_Arrow_Modifier" href="@($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_Inputs}/{GlobalValues.Component_Path_Part_NumericInput}/{GlobalValues.Common_Page_Path_Api}")">
        <span aria-hidden="true"></span>
        <span>@GlobalValues.Component_Name_Numeric_Input - @GlobalValues.Common_Page_Title_Api</span>
        <span aria-hidden="true"></span>
    </a>
    <a class="@GlobalValues.Link_Button_Class @GlobalValues.Link_Button_Right_Arrow_Modifier" href="@($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_Inputs}/{GlobalValues.Component_Path_Part_PasswordInput}/{GlobalValues.Common_Page_Path_Api}")">
        <span aria-hidden="true"></span>
        <span>@GlobalValues.Component_Name_Password_Input - @GlobalValues.Common_Page_Title_Api</span>
        <span aria-hidden="true"></span>
    </a>
</div>

@code {

    public InventoryDto _inventoryData = new();
    private ImmutableDictionary<string, BoxedValidator> _boxedValidators = default!;

    public class InventoryDto
    {
        public decimal Price { get; set; }
        public int UnitsInStock { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {

        var unitValidator = MemberValidators.CreateRangeValidator<int>(1, 999, "UnitsInStock", "Units in stock", "Must be between 1 and 999");

        _boxedValidators = BlazorValidationBuilder<InventoryDto>.Create()
                                .ForMember(c => c.UnitsInStock, unitValidator)
                                 .GetBoxedValidators();

        base.OnInitialized();
    }

    private void HandleSubmit()
    {
        
    }
}