        <table aria-labelledby="summary-display-enum">

            <thead>
                <tr>
                    <th scope="col">Value</th>
                    <th scope="col">Name</th>
                    <th scope="col">Description</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>0</td>
                    <td>OnModelValidated</td>
                    <td>The summary should only be displayed after a model validation has occurred.</td>
