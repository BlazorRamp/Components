@attribute [Route($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_Inputs}/{GlobalValues.Component_Path_Part_InputErrors}/{GlobalValues.Common_Page_Path_Api}")]

<PageTitle>@GlobalValues.Component_Name_Input_Errors_Summary @GlobalValues.Common_Page_Title_Api</PageTitle>

<h1>@GlobalValues.Component_Name_Input_Errors_Summary @GlobalValues.Common_Page_Title_Api</h1>
<p>
    Everything you need to work with the InputErrorsSummary component: parameters, methods, models, enums, and CSS variables for styling.
</p>
<section>
    <h2 class="page-heading">
        Component parameters, methods, supporting classes and enums.
    </h2>
    <p>
        The following sections cover all components that make up this feature, including their parameters,
        public methods, and any supporting classes or enumerations required for use.
    </p>
    <section class="code-table">

        <h3 id="input-errors-component-parameters" class="code-table__heading">InputErrorsSummary component parameters</h3>

        <table aria-labelledby="input-errors-component-parameters">

            <thead>
                <tr>
                    <th scope="col">Parameter</th>
                    <th scope="col">Type</th>
                    <th scope="col">Description</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>ChildContent</td>
                    <td>RenderFragment?</td>
                    <td>
                        Gets or sets the child content rendered inside the cascading value scope. Typically contains the form's input controls.
                    </td>
                </tr>
                <tr>
                    <td>Title</td>
                    <td>string</td>
                    <td>
                        Gets or sets the heading text rendered at the top of the error summary section.
                        Defaults to "There is a problem with your entries" when null, empty, or whitespace.
                    </td>
                </tr>
                <tr>
                    <td>InputSuffix</td>
                    <td>string</td>
                    <td>
                        Gets or sets the suffix appended to each field link in the summary list.
                        Defaults to "field" when null, empty, or whitespace
                    </td>
                </tr>
                <tr>
                    <td>SummaryDisplay</td>
                    <td>SummaryDisplay (enum)</td>
                    <td>
                        Gets or sets when the error summary is displayed. Either after the first full model validation (i.e form submit) or always, as soon as any validation
                        failure occurs.Defaults to <span class=code-span>SummaryDisplay.OnModelValidated</span>
                    </td>
                </tr>
                <tr>
                    <td>TitleHeadingLevel</td>
                    <td>TitleHeadingLevel (enum)</td>
                    <td>
                        Gets or sets the heading level used for the error summary title.
                        Allows the heading to fit correctly within the page's heading hierarchy.
                        Defaults to <span class="code-span">TitleHeadingLevel.H2</span>.
                    </td>
                </tr>
            </tbody>
        </table>
    </section>
</section>

