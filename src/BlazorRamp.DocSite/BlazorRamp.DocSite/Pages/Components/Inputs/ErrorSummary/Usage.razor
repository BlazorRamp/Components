@attribute [Route($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_Inputs}/{GlobalValues.Component_Path_Part_InputErrors}/{GlobalValues.Common_Page_Path_Usage}")]

<PageTitle>@GlobalValues.Component_Name_Input_Errors_Summary @GlobalValues.Common_Page_Title_Usage</PageTitle>

<h1>@GlobalValues.Component_Name_Input_Errors_Summary @GlobalValues.Common_Page_Title_Usage</h1>

<p>
    Practical examples showing the Input Errors Summary component configured with various parameters.
</p>
<p>
    You can choose to have the error summary displayed immediately on any validation error (<span class="code-span">SummaryDisplay.Always</span>) or only after a full model validation has occurred (<span class="code-span">SummaryDisplay.OnModelValidated</span>)
    which generally occurs when the user is trying to submit the form. 
</p>
<p>
    To use the component all you need to do is place the component inside of the <span class="code-span">EditForm</span> wrapping the inputs that you want including in the summary; these will then
    appear in the summary with inks pointing to them.
</p>
<p>
    When a full model validation event occurs and there are validation errors, the summary is displayed and the focus moved to it. 
    This focus event causes screen readers to announce the heading as the section element containing this summary information has an <span class="code-span">aria-labelledby</span> attribute that point to the heading element.
    The section has also been given a <span class="code-span">role="region"</span> attribute promoting it to a landmark in order to make it easier for screen reader users to navigate to, given the lists of short cuts they have access to.
</p>
<p>
    The input errors summary example below has been configured to only show after a full model validation event has occurred. It uses an input suffix of "Field" which is appended to the label names. In this instance the 
    title that gets displayed for the section was configured to use an <span class="code-span">h3</span> element, which on this page was the next logical heading.
</p>
<p>
    The three fields with the asterisk next to the label are required, with the Hourly Rate field being a nullable (optional) decimal value. 
    Each field has validation rules and uses the setting <span class="code-span">UpdateOnInput="true"</span> for immediate validation opting to use the tabbable regions for the validation error messages. Clicking the fake submit button will
    validate the entire model showing any validation error messages on the respective input as well as to display the input error summary.
</p>
<p>
    <b>Note: </b>I have used my open source Validation framework and its Blazor NuGet package <a class="@GlobalValues.Link_Class" href="@GlobalValues.Validated_Blazor_Repo_Site" target="_blank">Validated.Blazor (opens in new window)</a>.
    but you can use any validators that work with Blazors <span class="code-span">EditContext</span>.
</p>
<section class="section-box">
    <h2>Input error summary example one</h2>

    <EditForm Model="@_contactData" OnValidSubmit="HandleSubmit">
        
        <BlazorValidated TEntity="ContactDto" BoxedValidators="_boxedValidators" AddDisplayName="true" DeferFieldValidation="false" />

        <InputErrorsSummary InputSuffix="Field" TitleHeadingLevel="TitleHeadingLevel.H3" SummaryDisplay="SummaryDisplay.OnModelValidated" Title="There is a problem with your entries">

            <div class="br-input-row">
                <TextInput class="br-col-xs-12 br-col-sm-6" LabelText="First Name" Required="true" ErrorsLabel="errors" UpdateOnInput="true" TextInputType="TextInputType.Text" ValidationDisplayMode="ValidationDisplayMode.TabbableWithHint"
                           @bind-Value="_contactData.FirstName" HintText="The name you use on official documents" SvgIcon="--svg-user-icon" autocomplete="given-name"/>

                <TextInput class="br-col-xs-12 br-col-sm-6" LabelText="Surname" Required="true" ErrorsLabel="errors" UpdateOnInput="true" TextInputType="TextInputType.Text" ValidationDisplayMode="ValidationDisplayMode.TabbableWithHint"
                           @bind-Value="_contactData.Surname" HintText="The surname you use on official documents" SvgIcon="--svg-user-icon" autocomplete="familiy-name" />
            </div>
            <div class="br-input-row">

                <NumericInput class="br-col-xs-12 br-col-sm-6" @bind-Value="_contactData.Age" Required="true"
                              LabelText="Age" ErrorsLabel="errors" HintText="Your current age in years." UpdateOnInput="true"
                              ValidationDisplayMode="ValidationDisplayMode.TabbableWithHint" ParseErrorMessage="Please enter a valid number for this field type." />

                <NumericInput class="br-col-xs-12 br-col-sm-6" @bind-Value="_contactData.HourlyRate" Required="false" Format="C" 
                                LabelText="Hourly Rate" ErrorsLabel="errors" HintText="Optional, how much you charge per hour." UpdateOnInput="true" 
                              ValidationDisplayMode="ValidationDisplayMode.TabbableWithHint" ParseErrorMessage="Please enter a valid number for this field type." maxlength="50"/>

            </div>
        </InputErrorsSummary>

        <div class="br-input-row">
            <button class="br-col-xs-12 normal-button" type="submit">Fake submit to trigger validation on the model</button>
        </div>
    </EditForm>

</section>

<p style="padding-block:1rem;">
    Below is the code that was used for the example. Please note that in general when using the Validated library the validators would be in a shared library so they could be used in any part of your application.
</p>
<CodeBox CodeBlock="@InputSnippets.Error_Summary_Example" AriaLabel="Input error summary code example" />

<p style="padding-block:1rem;">
    The next example is a repeat of the above, however, as we are using the Validated.Blazor package, we can use option to defer field validation until a full model validation is requested which is generally on submit
    unless requested manually. The following example uses this option so no validation will take place until the submit button is clicked, afterwich field level validaion as of the first example.  
</p>
<section class="section-box">
    <h2>Input error summary example two (no validation until submit)</h2>

    <EditForm EditContext="@_editContext" OnValidSubmit="HandleSubmit">

        <BlazorValidated TEntity="ContactDto" BoxedValidators="_boxedValidators" AddDisplayName="true" DeferFieldValidation="true" />

        <InputErrorsSummary InputSuffix="Field" TitleHeadingLevel="TitleHeadingLevel.H3" SummaryDisplay="SummaryDisplay.OnModelValidated">

            <div class="br-input-row">
                <TextInput class="br-col-xs-12 br-col-sm-6" LabelText="First Name" Required="true" ErrorsLabel="errors" UpdateOnInput="true" TextInputType="TextInputType.Text" ValidationDisplayMode="ValidationDisplayMode.TabbableWithHint"
                           @bind-Value="_contactDataTwo.FirstName" HintText="The name you use on official documents" SvgIcon="--svg-user-icon" autocomplete="given-name" />

                <TextInput class="br-col-xs-12 br-col-sm-6" LabelText="Surname" Required="true" ErrorsLabel="errors" UpdateOnInput="true" TextInputType="TextInputType.Text" ValidationDisplayMode="ValidationDisplayMode.TabbableWithHint"
                           @bind-Value="_contactDataTwo.Surname" HintText="The surname you use on official documents" SvgIcon="--svg-user-icon" autocomplete="familiy-name" />
            </div>
            <div class="br-input-row">

                <NumericInput class="br-col-xs-12 br-col-sm-6" @bind-Value="_contactDataTwo.Age" Required="true"
                              LabelText="Age" ErrorsLabel="errors" HintText="Your current age in years." UpdateOnInput="true"
                              ValidationDisplayMode="ValidationDisplayMode.TabbableWithHint" ParseErrorMessage="Please enter a valid number for this field type." />

                <NumericInput class="br-col-xs-12 br-col-sm-6" @bind-Value="_contactDataTwo.HourlyRate" Required="false" Format="C"
                              LabelText="Hourly Rate" ErrorsLabel="errors" HintText="Optional, how much you charge per hour." UpdateOnInput="true"
                              ValidationDisplayMode="ValidationDisplayMode.TabbableWithHint" ParseErrorMessage="Please enter a valid number for this field type." maxlength="50" />

            </div>
        </InputErrorsSummary>

        <div style="display:flex;justify-content:space-between;flex-wrap:wrap;gap:1rem;">
            <button class="normal-button" type="submit">Fake submit to trigger validation on the model</button>
            <button @ref="ResetButton" class="normal-button" type="button" @onclick="ResetExampleTwo">Reset example</button>
        </div>
    </EditForm>

</section>
<p style="padding-block:1rem;">
    Below is the code that was used for the example. Please note that in general when using the Validated library the validators would be in a shared library so they could be used in any part of your application.
</p>

<CodeBox CodeBlock="@InputSnippets.Error_Summary_Example_Two" AriaLabel="Input error summary code example two" />

<div class="flex-content justify-content-between">
    <a class="@GlobalValues.Link_Button_Class @GlobalValues.Link_Button_Left_Arrow_Modifier" href="@($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_Inputs}/{GlobalValues.Component_Path_Part_InputErrors}/{GlobalValues.Common_Page_Path_Api}")">
        <span aria-hidden="true"></span>
        <span>@GlobalValues.Component_Name_Input_Errors_Summary - @GlobalValues.Common_Page_Title_Api</span>
        <span aria-hidden="true"></span>
    </a>
    <a class="@GlobalValues.Link_Button_Class @GlobalValues.Link_Button_Right_Arrow_Modifier" href="@($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_NavGroup}/{GlobalValues.Common_Page_Path_Overview}")">
        <span aria-hidden="true"></span>
        <span>@GlobalValues.Component_Name_NavGroup - @GlobalValues.Common_Page_Title_Overview</span>
        <span aria-hidden="true"></span>
    </a>
</div>


@code {

    private ElementReference ResetButton { get; set; }

    private EditContext _editContext    = default!;
    private ContactDto  _contactDataTwo = new();
    private ContactDto  _contactData    = new();
    private ImmutableDictionary<string, BoxedValidator> _boxedValidators = default!;

    protected override void OnInitialized()
    {

        _editContext = new EditContext(_contactDataTwo);

        var firstNameValidator = MemberValidators.CreateStringRegexValidator(@"^(?=.{2,55}$)[A-Z][A-Za-z]*(?:['\- ][A-Za-z]+)*$", "FirstName", "First Name", "Must start with a capital letter and be between 2 and 25 characters in length.");
        /*
        * Although its easy to create a regex that does everything I prefer to break things down into separate rules, so below creates a validator made up of two rules.
        */
        var surnameValidator = MemberValidators.CreateStringRegexValidator(@"^[A-Z]+['\- ]?[A-Za-z]*['\- ]?[A-Za-z]*$", "Surname", "Surname", "Must start with a capital letter and no double spaces.")
            .AndThen(MemberValidators.CreateStringLengthValidator(2, 25, "Surname", "Surname", "Must be between 2 and 25 characters in length but you entered {ActualLength} characters."));

        var ageValidator = MemberValidators.CreateRangeValidator<int>(16, 120, "Age", "Age", "Must be between 16 and 120");

        var salaryValidator = MemberValidators.CreatePrecisionScaleValidator<decimal>(50, 2, "HourlyRate", "Hourly Rate", "Can only contain a maximum of 2 decimal places")
                        .AndThen(MemberValidators.CreateRangeValidator<decimal>(10.00M, 200.00M, "HourlyRate", "Hourly Rate", $"Must be between {String.Format("{0:C}", 10)} and {String.Format("{0:C}", 100)}"));


        _boxedValidators = BlazorValidationBuilder<ContactDto>.Create()
                                .ForMember(c => c.FirstName, firstNameValidator, true)
                                .ForMember(c => c.Surname, surnameValidator, true)
                                .ForMember(c => c.Age, ageValidator)
                                .ForNullableMember(c => c.HourlyRate, salaryValidator)
                            .GetBoxedValidators();
    }


    private void HandleSubmit() { }

    private async Task ResetExampleTwo()
    {
        _contactDataTwo = new ContactDto();
        _editContext    = new EditContext(_contactDataTwo);
        await Task.Yield();
        await ResetButton.FocusAsync();
    }

    public class ContactDto
    {
        public string   FirstName  { get; set; }
        public string   Surname    { get; set; }
        public int      Age        { get; set; }
        public decimal? HourlyRate { get; set; }
    }

}
