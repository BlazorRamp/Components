@using BlazorRamp.DocSite.Pages.Components.AnnouncementHistory
@attribute [Route($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_Inputs}/{GlobalValues.Component_Path_Part_TextInput}/{GlobalValues.Common_Page_Path_Usage}")]

<PageTitle>@GlobalValues.Component_Name_Text_Input @GlobalValues.Common_Page_Title_Usage</PageTitle>

<h1>@GlobalValues.Component_Name_Text_Input @GlobalValues.Common_Page_Title_Usage</h1>

<p>
    In the following example, both input values are required as denoted by the asterisk in each field label, screen reader users will be advised that these fields are required via the <span class="@CodeSpan.Base">aria-required</span> attribute
    that gets added as mentioned on the Inputs Accessibility page.
</p>
<p>
    Both inputs have the <span class="@CodeSpan.Base">UpdateOnInput</span> parameter set to true so validation runs on input, after the field is dirty combined with <span class="@CodeSpan.Base">ValidationDisplayMode.TabbableWithHint</span> option, but 
    you should use the options that best suit your application and intended audience.
    Neither input has a <span class="@CodeSpan.Base">maxlength</span> attribute as these can be problematic for some screen readers as it silently stops the user typing with no feedback, so it's better to catch issues with validation.
</p>
<p>
    <b>Note: </b>I have used my open source Validation framework and its Blazor NuGet package <a class="@GlobalValues.Link_Class" href="@GlobalValues.Validated_Blazor_Repo_Site" target="_blank">Validated.Blazor (opens in new window)</a>.
    but you can use any validators that work with Blazors <span class="@CodeSpan.Base">EditContext</span>. One of the options on my Blazor validation component is to remove leading and trailing whitespace from your string fields on a full model 
    validation. The validation for the First Name field below does not allow trailing spaces so causes it to be invalid if you enter any. The Surname field just as demonstration has a rule that allows a single space after its valid, 
    and I have used the option to remove spaces from this field on full model validation.
</p>
<p>
    <strong>Note: </strong>As you may not want to use this valdiation framework, and/or have differing options, there is also a <span class="@CodeSpan.Base">TrimOnBlur</span> parameter option on the text input, that when set to true
    trims the string value on lost focus.
</p>
<section class="@Section.Base @Section.Bordered @Section.Radius(SectionRadius.Content)">
    <h2 class="@Section.Heading.Base @Section.Heading.MobileCentred @Section.Heading.Text(SectionHeadingText.SecondaryDark)">Text inputs example</h2>

    <EditForm Model="@_contactData" OnValidSubmit="HandleSubmit">
        
        <BlazorValidated TEntity="ContactDto" BoxedValidators="_boxedValidators" AddDisplayName="true" />

        <div class="br-input-row">
            <TextInput class="br-col-xs-12 br-col-sm-6" LabelText="First Name" Required="true" ErrorsLabel="errors" UpdateOnInput="true" TextInputType="TextInputType.Text" ValidationDisplayMode="ValidationDisplayMode.TabbableWithHint"
                       @bind-Value="_contactData.FirstName" HintText="The name you use on official documents" SvgIcon="--svg-user-icon" ReadOnly="false" autocomplete="given-name" />

            <TextInput class="br-col-xs-12 br-col-sm-6" LabelText="Surname" Required="true" UpdateOnInput="true" TextInputType="TextInputType.Text" ValidationDisplayMode="ValidationDisplayMode.TabbableWithHint"
                       @bind-Value="_contactData.Surname" HintText="The surname you use on official documents" SvgIcon="--svg-user-icon" autocomplete="family-name" />
        </div>
        <div class="br-input-row">
            <button class="br-col-xs-12 normal-button" type="submit">Fake Submit to trigger validation on unmodified fields</button>
        </div>
    </EditForm>


</section>

<p style="padding-block:1rem;">
    Below is the code that was used for the example. Please note that in general when using the Validated library the validators would be in a shared library so they could be used in any part of your application.
</p>

<CodeBox CodeBlock="@InputSnippets.Text_Input_Example" AriaLabel="Text input code example" />

<h3 style="padding-top:1rem;">Accessibility</h3>
<p>
    Please ensure dependant on the context that you add the appropriate <span class="code-block">autocomplete</span> attribute to meet WCAG requirements, although there is no harm in just adding them regardless.
</p>

<div class="flex-content justify-content-between">
    <a class="@GlobalValues.Link_Button_Class @GlobalValues.Link_Button_Left_Arrow_Modifier" href="@($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_Inputs}/{GlobalValues.Component_Path_Part_TextInput}/{GlobalValues.Common_Page_Path_Api}")">
        <span aria-hidden="true"></span>
        <span>@GlobalValues.Component_Name_Text_Input - @GlobalValues.Common_Page_Title_Api</span>
        <span aria-hidden="true"></span>
    </a>
    <a class="@GlobalValues.Link_Button_Class @GlobalValues.Link_Button_Right_Arrow_Modifier" href="@($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_Inputs}/{GlobalValues.Component_Path_Part_TimeInput}/{GlobalValues.Common_Page_Path_Api}")">
        <span aria-hidden="true"></span>
        <span>@GlobalValues.Component_Name_Time_Input - @GlobalValues.Common_Page_Title_Api</span>
        <span aria-hidden="true"></span>
    </a>
</div>

@code {

    private ContactDto _contactData = new();
    private ImmutableDictionary<string, BoxedValidator> _boxedValidators = default!;

    protected override void OnInitialized()
    {

        var firstNameValidator = MemberValidators.CreateStringRegexValidator(@"^(?=.{2,50}$)[A-Z][A-Za-z]*(?:['\- ][A-Za-z]+)*$", "FirstName", "First Name", "Must start with a capital letter and be between 2 and 50 characters in length");
        /*
            * Although its easy to create a regex that does everything I prefer to break things down into separate rules, so below creates a validator made up of two rules. 
        */
        var surnameValidator = MemberValidators.CreateStringRegexValidator(@"^[A-Z]+['\- ]?[A-Za-z]*['\- ]?[A-Za-z]*$", "Surname", "Surname", "Must start with a capital letter and no double spaces.")
                                .AndThen(MemberValidators.CreateStringLengthValidator(2, 50, "Surname", "Surname", "Must be between 2 and 50 characters in length"));


        _boxedValidators = BlazorValidationBuilder<ContactDto>.Create()
                                .ForMember(c => c.FirstName, firstNameValidator)
                                .ForMember(c => c.Surname, surnameValidator, true)
                                .GetBoxedValidators();
    }


    private void HandleSubmit() { }

    public class ContactDto
    {

        public string FirstName { get; set; }
        public string Surname { get; set; }
    }

}
