@attribute [Route($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_Inputs}/{GlobalValues.Component_Path_Part_SelectInput}/{GlobalValues.Common_Page_Path_Usage}")]

<PageTitle>@GlobalValues.Component_Name_Select_Input @GlobalValues.Common_Page_Title_Usage</PageTitle>

<h1>@GlobalValues.Component_Name_Select_Input @GlobalValues.Common_Page_Title_Usage</h1>

<p>
    The simple example below just shows a single select in various states. The input is required and has an associated validation rule.
</p>
<p>
    <b>Note: </b>I have used my open source Validation framework and its Blazor NuGet package <a class="@GlobalValues.Link_Class" href="@GlobalValues.Validated_Blazor_Repo_Site" target="_blank">Validated.Blazor (opens in new window)</a>.
    but you can use any validators that work with Blazors <span class="@CodeSpan.Base">EditContext</span>.
</p>
<section class="@Section.Base @Section.Bordered @Section.Radius(SectionRadius.Content)">
    <h2 class="@Section.Heading.Base @Section.Heading.MobileCentred @Section.Heading.Text(SectionHeadingText.PrimaryDark)">Select input example</h2>
    <p>
        The following three select components are all bound to the same variable so you see the different styles and behaviours. The
        first select is enabled and is required. The next select has its <span class="@CodeSpan.Base">ReadOnly</span> parameter set to true with the last
        select using <span class="@CodeSpan.Base">AriaDisabled="true"</span>.
    </p>
    <p>
        <strong>Note: </strong> readonly is not native to the select element, I implemented this behaviour via JavaScript just in case. Screen readers will not
        announce read only so if you absolutely must use it, you should add some text for both sighted and screen reader users so they know why they cannot access it.
    </p>

    <EditForm Model="@_profileData" OnSubmit="HandleSubmit">
        <BlazorValidated TEntity="ProfileDto" BoxedValidators="_boxedValidators" AddDisplayName="true" />
        <div class="br-input-row">
            <SelectInput  class=" br-col-xs-12 br-col-sm-6" LabelText="Favourite Food" HintText="What food do you like the most?" Required="true" 
                @bind-Value="@_profileData.FavouriteFoodID" SvgIcon="--svg-food-icon">
                 <OptionValues>
                     <option value="0">Please select your favourite food</option>
                    @foreach(var item in _foodListItems)
                    {
                        <option value="@item.Key" >@item.Value</option>
                    }
                </OptionValues>
            </SelectInput>
        </div>
        <div class="br-input-row">
            <SelectInput class=" br-col-xs-12 br-col-sm-6" LabelText="Favourite Food" HintText="What food do you like the most?" Required="true" ReadOnly="true"
                         @bind-Value="@_profileData.FavouriteFoodID" SvgIcon="--svg-food-icon">
                <OptionValues>
                    <option value="0">Please select your favourite food</option>
                    @foreach (var item in _foodListItems)
                    {
                        <option value="@item.Key">@item.Value</option>
                    }
                </OptionValues>
            </SelectInput>
        </div>
        <div class="br-input-row">
            <SelectInput class=" br-col-xs-12 br-col-sm-6" LabelText="Favourite Food" HintText="What food do you like the most?" Required="true" AriaDisabled="true"
                         @bind-Value="@_profileData.FavouriteFoodID" SvgIcon="--svg-food-icon">
                <OptionValues>
                    <option value="0">Please select your favourite food</option>
                    @foreach (var item in _foodListItems)
                    {
                        <option value="@item.Key">@item.Value</option>
                    }
                </OptionValues>
            </SelectInput>
        </div>
    </EditForm>

</section>

<p style="padding-block:1rem;">
    Below is the code that was used for the example. Please note that in general when using the Validated library the validators would be in a shared library so they could be used in any part of your application.
</p>
<CodeBox CodeBlock="@InputSnippets.Select_Input_Code_Example" AriaLabel="Select input code example" />

<div class="flex-content justify-content-between">
    <a class="@GlobalValues.Link_Button_Class @GlobalValues.Link_Button_Left_Arrow_Modifier" href="@($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_Inputs}/{GlobalValues.Component_Path_Part_SelectInput}/{GlobalValues.Common_Page_Path_Api}")">
        <span aria-hidden="true"></span>
        <span>@GlobalValues.Component_Name_Select_Input - @GlobalValues.Common_Page_Title_Api</span>
        <span aria-hidden="true"></span>
    </a>
    <a class="@GlobalValues.Link_Button_Class @GlobalValues.Link_Button_Right_Arrow_Modifier" href="@($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_Inputs}/{GlobalValues.Component_Path_Part_TextAreaInput}/{GlobalValues.Common_Page_Path_Api}")">
        <span aria-hidden="true"></span>
        <span>@GlobalValues.Component_Name_TextArea_Input - @GlobalValues.Common_Page_Title_Api</span>
        <span aria-hidden="true"></span>
    </a>
</div>


@code {

    
    private ProfileDto _profileData               = new();
    private Dictionary<int,string> _foodListItems = new(){[1]="Fish & Chips", [2]="Burger & Fries", [3]="Pizza"};

    private ImmutableDictionary<string, BoxedValidator> _boxedValidators = default!;

    protected override void OnInitialized()
    {
        var foodValidator = MemberValidators.CreatePredicateValidator<int>(c => c == 1, "FavouriteFoodID", "Favourite Food", "Wrong answer, it has to be Fish & Chips");

        _boxedValidators = BlazorValidationBuilder<ProfileDto>.Create()
                                .ForMember(c => c.FavouriteFoodID, foodValidator)
                                .GetBoxedValidators();
    }

    private void HandleSubmit() { }

    public class ProfileDto
    {
        public int FavouriteFoodID { get; set; }
    }

}

