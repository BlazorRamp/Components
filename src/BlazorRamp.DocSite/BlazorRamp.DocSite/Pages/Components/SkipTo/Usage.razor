@attribute [Route($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_SkipTo}/{GlobalValues.Common_Page_Path_Usage}")]

<PageTitle>@GlobalValues.Component_Name_SkipTo @GlobalValues.Common_Page_Title_Usage</PageTitle>

<h1>@GlobalValues.Component_Name_SkipTo @GlobalValues.Common_Page_Title_Usage</h1>

<p>
    Practical examples showing the Skip To component configured with various parameters.
</p>

<p>The following example shows the parameters used for the skip to link on this site which is hidden top left of the page before the left hand navigation.</p>

<CodeBox CodeBlock="@SkipToSnippets.Skip_To_Params_Example" AriaLabel="Skip to example code block" />

<p>
    For something that is site wide <span class="@CodeSpan.Base">SkipToType.Site</span>, I just place the component inside the
    <span class="@CodeSpan.Base">Routes.razor</span> file or <span class="@CodeSpan.Base">App.razor</span> file above the router with the
    <span class="@CodeSpan.Base">AnnouncementHistory</span> component.
</p>

<p>The following example is the skip to on this page using the <span class="@CodeSpan.Base">SkipToType.Section</span></p>

<CodeBox CodeBlock="@SkipToSnippets.Skip_To_Section_Example" AriaLabel="Skip to section example code block" />

<div class="@Section.Base @Section.Radius(SectionRadius.Content) @Section.Bordered @Section.ColumnCentred" style="align-items:start;margin-block:var(--br-unit-space-5);">
    <SkipTo IconVisible="true" SkipToText="Skip to section content" SkipToType="SkipToType.Section" TargetID="section-one" />
    <p class="@Section.Base @Section.Bordered @Section.Radius(SectionRadius.Content)">
        The skip to is hiding here in this container that has a CSS <spoan class="@CodeSpan.Base">position:relative;</spoan> set on it.
    </p>
    <p class="@Section.Base @Section.Bordered @Section.Radius(SectionRadius.Content)">
        Some block you want to skip.
    </p>
    <p style="width:320px;" class="@Section.Base @Section.Bordered @Section.Radius(SectionRadius.Content)" tabindex="-1" id="section-one">
        The content you want to get to.
    </p>
</div>

<ThemeBorderTool Title="Applicable theme border tools" ThemeToolHeadingLevel="ThemeToolHeadingLevel.H2">
    <BorderGroups>
        <BorderGroup Title="Revealed borders">
            <BorderRadius LabelText="Revealed radius" ResetText="Reset revealed radius" MaxRangeValue="@GlobalValues.Radius_Reveal_Max_Range_Value" CssProperties="@([new(CoreCssVariables.Group_Revealed_Radius_Surface)])" />
        </BorderGroup>
    </BorderGroups>
</ThemeBorderTool>


<div class="flex-content justify-content-between">
    <a class="@GlobalValues.Link_Button_Class @GlobalValues.Link_Button_Left_Arrow_Modifier" href="@($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_SkipTo}/{GlobalValues.Common_Page_Path_Api}")">
        <span aria-hidden="true"></span>
        <span>@GlobalValues.Component_Name_SkipTo - @GlobalValues.Common_Page_Title_Api</span>
        <span aria-hidden="true"></span>
    </a>
    <a class="@GlobalValues.Link_Button_Class @GlobalValues.Link_Button_Right_Arrow_Modifier" href="@($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_Switch}/{GlobalValues.Common_Page_Path_Overview}")">
        <span aria-hidden="true"></span>
        <span>@GlobalValues.Component_Name_Switch - @GlobalValues.Common_Page_Title_Overview</span>
        <span aria-hidden="true"></span>
    </a>
</div>
