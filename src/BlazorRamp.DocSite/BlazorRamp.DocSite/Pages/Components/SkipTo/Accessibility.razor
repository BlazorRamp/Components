@attribute [Route($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_SkipTo}/{GlobalValues.Common_Page_Path_Accessibility}")]

<PageTitle>@GlobalValues.Component_Name_SkipTo @GlobalValues.Common_Page_Title_Accessibility</PageTitle>

<h1>@GlobalValues.Component_Name_SkipTo @GlobalValues.Common_Page_Title_Accessibility</h1>



<h2 id="skip-to-keyboard" class="@GlobalValues.Info_Box_Heading_Class">Keyboard interaction</h2>

<ul aria-labelledby="skip-to-keyboard" class="keyboard-list">
    <li><kbd>Enter</kbd> - activates the link and moves focus to the target element.</li>
</ul>
<p>
    <strong>Note: </strong>These keyboard interactions are primarily aimed at keyboard-only users. Screen reader users will often navigate differently using their assistive technology's
    built-in commands, though the patterns also apply when a screen reader is operating in interaction mode.
</p>

<h2 id="device-testing">Accessibility device testing</h2>

<ul aria-labelledby="device-testing">
    <li>JAWS, Narrator and NVDA on Windows were each paired with every one of the following browsers: Google Chrome, Microsoft Edge and Mozilla Firefox.</li>
    <li>VoiceOver on macOS was paired with Apple's Safari.</li>
    <li>VoiceOver on iPhone was paired with mobile Safari.</li>
    <li>Talkback on Android was paired with mobile Google Chrome.</li>
    <li>Voice access on Windows 11</li>
</ul>

<p>
    <strong>Note: </strong> Testing was performed with the latest browser and assistive technologies versions that were available at the time of testing (see release history on the installation page for approximate testing dates)
</p>

<div class="flex-content justify-content-between">
    <a class="@GlobalValues.Link_Button_Class @GlobalValues.Link_Button_Left_Arrow_Modifier" href="@($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_SkipTo}/{GlobalValues.Common_Page_Path_Installation}")">
        <span aria-hidden="true"></span>
        <span>@GlobalValues.Component_Name_SkipTo - @GlobalValues.Common_Page_Title_Installation</span>
        <span aria-hidden="true"></span>
    </a>
    <a class="@GlobalValues.Link_Button_Class @GlobalValues.Link_Button_Right_Arrow_Modifier" href="@($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_SkipTo}/{GlobalValues.Common_Page_Path_Api}")">
        <span aria-hidden="true"></span>
        <span>@GlobalValues.Component_Name_SkipTo - @GlobalValues.Common_Page_Title_Api</span>
        <span aria-hidden="true"></span>
    </a>
</div>
