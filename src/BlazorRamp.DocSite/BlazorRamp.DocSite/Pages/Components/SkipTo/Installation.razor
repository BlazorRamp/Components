@attribute [Route($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_SkipTo}/{GlobalValues.Common_Page_Path_Installation}")]

<PageTitle>@GlobalValues.Component_Name_SkipTo @GlobalValues.Common_Page_Title_Installation</PageTitle>

<h1>@GlobalValues.Component_Name_SkipTo @GlobalValues.Common_Page_Title_Installation</h1>

<p>
    <strong>Note: </strong> It is a requirement that the Blazor Ramp Core <span class="@CodeSpan.Base">core-live-region.js</span> script, <span class="@CodeSpan.Base">LiveRegionService</span>, and
    associated <span class="@CodeSpan.Base">&lt;AnnouncementHistory /&gt;</span> component are added alongside this component’s specific
    requirements (a stylesheet reference in this instance).
 </p>
 <p>
    You do not need to add the BlazorRamp.Core package separately, as BlazorRamp.Core is included as a transitive package, you only need to add the packages that contain the components
    that you wish to use i.e the <b>BlazorRamp.SkipTo</b> NuGet package.
</p>
<p>
    Please follow the instructions in the <a class="@GlobalValues.Link_Class" href="@($"{GlobalValues.Root_path_Getting_Started}{GlobalValues.Common_Page_Path_Installation}")">@GlobalValues.Getting_Started_Name - @GlobalValues.Common_Page_Title_Installation</a>
    ensuring that in the <span class="@CodeSpan.Base">&lt;head&gt;</span> section you also add the Skip To stylesheet as follows:
</p>
<CodeBox CodeBlock="@SkipToSnippets.Add_Skip_To_Style_Sheet" AriaLabel="Add skip to stylesheet code block" />




<h2 id="release-history">Release history</h2>

<ol reversed class="history-list">
    <li>
        <h3>
            Version 1.0.4 — <time datetime="2026-08-21">August 21, 2026</time>
        </h3>
        <ul>
            <li>Amended CSS border radius variables so the component border radius could be changed with others in the same grouping.</li>
        </ul>
    </li>
    <li>
        <h3>
            Version 1.0.3 — <time datetime="2026-03-21">March 21, 2026</time>
        </h3>
        <ul>
            <li>
                Added requestAnimationFrame to the JavaScript to stop the page moving up and offscreen when the layouts uses
                a fixed-height grid with a nested scrollable container.
            </li>
        </ul>
    </li>
    <li>
        <h3>
            Version 1.0.2 — <time datetime="2026-02-09">February 09, 2026</time>
        </h3>
        <ul>
            <li>
                Added an additional css property to the optional icon to use the em unit, so it scales up with base font-size changes.
            </li>
        </ul>
    </li>
    <li>
        <h3>
            Version 1.0.1 — <time datetime="2026-02-01">February 02, 2026</time>
        </h3>
        <ul>
            <li>Removal of an SCSS file that incorrectly got added to the package.</li>
        </ul>
    </li>
    <li>
        <h3>
            Version 1.0.0 — <time datetime="2026-02-01">February 02, 2026</time>
        </h3>
        <ul>
            <li>Initial release of the <span class="@CodeSpan.Base">BlazorRamp.SkipTo v1.0.0</span> NuGet package, multi-targeting <span class="@CodeSpan.Base">.NET 8.0, .NET 9.0 & .NET 10.0</span></li>
        </ul>
    </li>
</ol>



<div class="flex-content justify-content-between">
    <a class="@GlobalValues.Link_Button_Class @GlobalValues.Link_Button_Left_Arrow_Modifier" href="@($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_SkipTo}/{GlobalValues.Common_Page_Path_Overview}")">
        <span aria-hidden="true"></span>
        <span>@GlobalValues.Component_Name_SkipTo - @GlobalValues.Common_Page_Title_Overview</span>
        <span aria-hidden="true"></span>
    </a>
    <a class="@GlobalValues.Link_Button_Class @GlobalValues.Link_Button_Right_Arrow_Modifier" href="@($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_SkipTo}/{GlobalValues.Common_Page_Path_Accessibility}")">
        <span aria-hidden="true"></span>
        <span>@GlobalValues.Component_Name_SkipTo - @GlobalValues.Common_Page_Title_Accessibility</span>
        <span aria-hidden="true"></span>
    </a>
</div>
