        <table aria-labelledby="unmapped-variables">

            <thead>
                <tr>
                    <th scope="col">Variable Name</th>
                    <th scope="col">Default Value</th>
                    <th scope="col">Description</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>--br-comp-skip-to-outline-offset</td>
                    <td>var(--br-unit-outline-offset-0)</td>
                    <td>Outline offset - <b>does not use the shared component variable.</b></td>
                </tr>
                <tr>
                    <td>--br-comp-skip-to-pane-surface-border-width</td>
                    <td>var(--br-comp-all-outline-offset)</td>
                    <td>
                        The border width - <b>does not use the shared component variable</b> It uses the outline offset as its using
                        an outline without an offset. In this instance the border is the acting as an offset.
                    </td>
                </tr>
                <tr>
                    <td>--br-comp-skip-to-pane-surface-background</td>
                    <td>var(--br-unit-colour-canvas-inverted)</td>
                    <td>The background colour of the surface pane - <b>does not use the shared component variable.</b></td>
                </tr>
                <tr>
                    <td>--br-comp-skip-to-pane-surface-border-colour</td>
                    <td>var(--br-unit-colour-canvas)</td>
                    <td>The border colour - <b>does not use the shared component variable.</b></td>
                </tr>
                <tr>
                    <td>--br-comp-skip-to-pane-surface-border-radius-top-right</td>
                    <td>var(--br-group-revealed-border-radius)</td>
                    <td>The border radius - uses a shared border radius grouping variable.</td>
                </tr>
                <tr>
                    <td>--br-comp-skip-to-pane-surface-border-radius-top-left</td>
                    <td>var(--br-group-revealed-border-radius)</td>
                    <td>The border radius - uses a shared border radius grouping variable.</td>
                </tr>
                <tr>
                    <td>--br-comp-skip-to-pane-surface-border-radius-bottom-right</td>
                    <td>var(--br-group-revealed-border-radius)</td>
                    <td>The border radius - uses a shared border radius grouping variable.</td>
                </tr>
                <tr>
                    <td>--br-comp-skip-to-pane-surface-border-radius-bottom-left</td>
                    <td>var(--br-group-revealed-border-radius)</td>
                    <td>The border radius - uses a shared border radius grouping variable.</td>
                </tr>
                <tr>
                    <td>--br-comp-skip-to-area-content-background</td>
                    <td>var(--br-unit-colour-canvas-inverted)</td>
                    <td>The background colour of the content areas - <b>does not use the shared component variable</b>.</td>
                </tr>
                <tr>
