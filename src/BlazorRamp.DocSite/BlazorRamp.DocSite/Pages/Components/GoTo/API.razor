                        <th scope="col">Property/Static Method</th>
                        <th scope="col">Description</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>bool</td>
                        <td>IsValid()</td>
                        <td>Determines whether the shortcut can be used.</td>
                    </tr>
                    <tr>
                        <td>string</td>
                        <td>ToDisplayText()</td>
                        <td>
