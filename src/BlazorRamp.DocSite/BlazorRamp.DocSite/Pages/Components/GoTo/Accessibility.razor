        <span>@GlobalValues.Component_Name_GoTo - @GlobalValues.Common_Page_Title_Installation</span>

    </a>
    <a class="@Button.Base @Button.LinkStyle @Gap.SetColGap(UnitGapSize.Four)" href="@($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_GoTo}/{GlobalValues.Common_Page_Path_Api}")">

        <span>@GlobalValues.Component_Name_GoTo - @GlobalValues.Common_Page_Title_Api</span>
        <span class="@SvgIcon.Base @SvgIcon.Size(UnitIconSize.ExtraLarge)" aria-hidden="true" style="--_svg-icon-source:var(--svg-right-arrow-circle-icon)"></span>
    </a>
</div>

