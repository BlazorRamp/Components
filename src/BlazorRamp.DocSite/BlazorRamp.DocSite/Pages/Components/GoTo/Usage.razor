
@attribute [Route($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_GoTo}/{GlobalValues.Common_Page_Path_Usage}")]

<PageTitle>@GlobalValues.Component_Name_GoTo @GlobalValues.Common_Page_Title_Usage</PageTitle>


<h1>@GlobalValues.Component_Name_GoTo @GlobalValues.Common_Page_Title_Usage</h1>
<GoTo LabelText="GoTo usage page title" />

<p>
    Practical examples showing the GoTo component configured with various parameters.
</p>
<p>
    This site uses the GoTo component and at time of writing there was one GoTo marker added after the Components heading and another after the Theming headings
    within the main left hand side navigation.
</p>
<p>
    I have add two more markers, one above the button immediately below this text and another after the theme border tools section.
</p>
<p>
    Open the viewer using <kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">Alt (Option on macOS) + Z</kbd> then select a marker from the list to activate, 
    from which you can then navigate from using the tab key.
</p>
<GoTo LabelText="GoTo usage page before the tab stop button" />

<button type="button" class="@Button.Base @Margin.Block(UnitSpace.Five)">Button only used as a tab stop</button>

<p>
    Below is the code used for the GoTo marker/labels.
</p>
<CodeBox CodeBlock="@GoToSnippets.Simple_Usage_Example" AriaLabel="GoTo marker,label example" />

<ThemeBorderTool Title="Applicable theme border tools" ThemeToolHeadingLevel="ThemeToolHeadingLevel.H2" style="margin-block:var(--br-unit-space-11);">
    <BorderGroups>
        <BorderGroup Title="Dialog borders">
            <BorderRadius LabelText="Outer radius" ResetText="Reset outer radius" MaxRangeValue="@GlobalValues.Radius_Dialog_Surface_Max_Range_Value" CssProperties="@([new(CoreCssVariables.Group_Dialog_Radius_Surface), new(CoreCssVariables.Group_Dialog_Radius_Base)])" />
            <BorderRadius LabelText="Inner radius" ResetText="Reset inner radius" MaxRangeValue="@GlobalValues.Radius_Dialog_Content_Max_Range_Value" CssProperties="@([new(CoreCssVariables.Group_Dialog_Radius_Content)])" />
        </BorderGroup>
        <BorderGroup Title="Button/link borders">
            <BorderRadius LabelText="Button radius" ResetText="Reset button radius" MaxRangeValue="@GlobalValues.Radius_Button_Max_Range_Value" CssProperties="@([new(CoreCssVariables.Group_Button_Radius)])" />
        </BorderGroup>
        <BorderGroup Title="Revealed borders">
            <BorderRadius LabelText="Revealed radius" ResetText="Reset revealed radius" MaxRangeValue="@GlobalValues.Radius_Reveal_Max_Range_Value" CssProperties="@([new(CoreCssVariables.Group_Revealed_Radius_Surface)])" />
        </BorderGroup>
    </BorderGroups>
</ThemeBorderTool>

<GoTo LabelText="GoTo usage page navigation" />

<div class="@FlexContent.Base @FlexContent.Wrap(UnitFlexWrap.Wrap) @LayoutAlignment.JustifyContent(UnitJustifyContent.SpaceBetween) @LayoutAlignment.AlignItems(UnitAlignItems.Centre)">
    <a class="@Button.Base @Button.LinkStyle @Gap.SetColGap(UnitGapSize.Four)" href="@($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_GoTo}/{GlobalValues.Common_Page_Path_Api}")">
        <span class="@SvgIcon.Base @SvgIcon.Size(UnitIconSize.ExtraLarge)" aria-hidden="true" style="--_svg-icon-source:var(--svg-left-arrow-circle-icon)"></span>
        <span>@GlobalValues.Component_Name_GoTo - @GlobalValues.Common_Page_Title_Api</span>

    </a>
    <a class="@Button.Base @Button.LinkStyle @Gap.SetColGap(UnitGapSize.Four)" href="@($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_Inputs}/{GlobalValues.Common_Page_Path_Overview}")">

        <span>@GlobalValues.Component_Name_Inputs - @GlobalValues.Common_Page_Title_Overview</span>
        <span class="@SvgIcon.Base @SvgIcon.Size(UnitIconSize.ExtraLarge)" aria-hidden="true" style="--_svg-icon-source:var(--svg-right-arrow-circle-icon)"></span>
    </a>
</div>
