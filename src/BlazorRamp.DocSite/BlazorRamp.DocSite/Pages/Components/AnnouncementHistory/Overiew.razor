@attribute [Route($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_Announcement}/{GlobalValues.Common_Page_Path_Overview}")]

<PageTitle>@GlobalValues.Component_Name_Announcement @GlobalValues.Common_Page_Title_Overview</PageTitle>

<h1>@GlobalValues.Component_Name_Announcement @GlobalValues.Common_Page_Title_Overview</h1>

<p>
    The <span class="code-span">&lt;AnnouncementHistory /&gt;</span> component allows the user to view the last 20 announcements made via the live region service.
</p>
<p>
    The announcement history viewer is a non-modal dialog that can be accessed at any time by using <kbd>Ctrl</kbd> + <kbd>Shift</kbd> + <kbd>H</kbd> or by clicking
    on its associated button, which can either remain visible all the time or only when it is focused <span class="code-span">:focus-visible</span>.
</p>
<p>
    <strong>Important: </strong>In order to use the <span class="code-span">&lt;AnnouncementHistory /&gt;</span> component contained in the <span class="code-span">BlazorRamp.Core</span> NuGet package,
    please ensure that it has been added to your project as described on the <a class="@GlobalValues.Link_Class" href="@($"{GlobalValues.Root_path_Getting_Started}{GlobalValues.Common_Page_Path_Installation}")">
    @GlobalValues.Getting_Started_Name - @GlobalValues.Common_Page_Title_Installation
</a> page.
</p>

<div class="flex-content justify-content-between">
    <a class="@GlobalValues.Link_Button_Class @GlobalValues.Link_Button_Left_Arrow_Modifier" href="@($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_Accordion}/{GlobalValues.Common_Page_Path_Usage}")">
        <span aria-hidden="true"></span>
        <span>@GlobalValues.Component_Name_Accordion - @GlobalValues.Common_Page_Title_Usage</span>
        <span aria-hidden="true"></span>
    </a>
    <a class="@GlobalValues.Link_Button_Class @GlobalValues.Link_Button_Right_Arrow_Modifier" href="@($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_Announcement}/{GlobalValues.Common_Page_Path_Installation}")">
        <span aria-hidden="true"></span>
        <span>@GlobalValues.Component_Name_Announcement - @GlobalValues.Common_Page_Title_Installation</span>
        <span aria-hidden="true"></span>
    </a>
</div>
@code {

}
