@attribute [Route($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_Announcement}/{GlobalValues.Common_Page_Path_Api}")]

<PageTitle>@GlobalValues.Component_Name_Announcement @GlobalValues.Common_Page_Title_Api</PageTitle>

<h1>@GlobalValues.Component_Name_Announcement @GlobalValues.Common_Page_Title_Api</h1>
<p>
    Everything you need to work with the Announcement History component: parameters, methods, models, enums, and CSS variables for styling.
</p>

<section>
    
    <h2 class="page-heading">
        Component parameters, methods, supporting classes and enums.
    </h2>
    <p>
        The following sections cover all components that make up this feature, including their parameters,
        public methods, and any supporting classes or enumerations required for use.
    </p>
    <section class="code-table">

        <h3 id="announcement-history-component" class="code-table__heading">AnnouncementHistory component</h3>

        <table aria-labelledby="announcement-history-component">

            <thead>
                <tr>
                    <th scope="col">Parameter</th>
                    <th scope="col">Type</th>
                    <th scope="col">Description</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Title</td>
                    <td>string</td>
                    <td>
                        The h2 heading text displayed for the announcement history dialog and used for the aria-labelledby attribute.
                        A default value of "Recent Announcements" will be used if omitted.
                        <strong>Note: </strong>This value is captured during the <span class="code-span">OnInitialized</span> method
                        and changes thereafter are ignored.
                    </td>
                </tr>
                <tr>
                    <td>CloseText</td>
                    <td>string</td>
                    <td>
                        The text for the button that closes the history dialog.
                        A default value of "Close" will be used if omitted.
                        <strong>Note: </strong>This value is captured during the <span class="code-span">OnInitialized</span> method
                        and changes thereafter are ignored.
                    </td>
                </tr>
                <tr>
                    <td>ClearCloseText</td>
                    <td>string</td>
                    <td>
                        The text for the button that clears the announcement history logs and closes the dialog.
                        A default value of "Clear & Close" will be used if omitted.
                        <strong>Note: </strong>This value is captured during the <span class="code-span">OnInitialized</span> method
                        and changes thereafter are ignored.
                    </td>
                </tr>
                <tr>
                    <td>RefreshText</td>
                    <td>string</td>
                    <td>
                        The text for the button that refreshes the history list displayed in the dialog.
                        A default value of "Refresh" will be used if omitted.
                        <strong>Note: </strong>This value is captured during the <span class="code-span">OnInitialized</span> method
                        and changes thereafter are ignored.
                    </td>
                </tr>
                <tr>
                    <td>NoDataText</td>
                    <td>string</td>
                    <td>
                        The text displayed when there are no announcements in the history.
                        A default value of "No Announcements" will be used if omitted.
                        <strong>Note: </strong>This value is captured during the <span class="code-span">OnInitialized</span> method
                        and changes thereafter are ignored.
                    </td>
                </tr>
                <tr>
                    <td>TriggerText</td>
                    <td>string</td>
                    <td>
                        The text for the trigger button that opens the history dialog.
                        A default value of "Alerts" will be used if omitted.
                        <strong>Note: </strong>This value is captured during the <span class="code-span">OnInitialized</span> method
                        and changes thereafter are ignored.
                    </td>
                </tr>
                <tr>
                    <td>TriggerVisible</td>
                    <td>bool</td>
                    <td>
                        Determines if the trigger button is always visible or only visible when focused via the keyboard.
                        <b>The default value is false, so it will be hidden by default</b>. Please ensure to advise users of the
                        short cut keys.
                        <strong>Note: </strong>This value is captured during the <span class="code-span">OnInitialized</span> method
                        and changes thereafter are ignored.
                    </td>
                </tr>
            </tbody>
        </table>

    </section>

</section>

