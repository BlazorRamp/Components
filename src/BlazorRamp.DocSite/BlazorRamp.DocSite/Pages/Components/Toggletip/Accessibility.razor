@attribute [Route($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_Toggletip}/{GlobalValues.Common_Page_Path_Accessibility}")]

<PageTitle>@GlobalValues.Component_Name_Toggletip @GlobalValues.Common_Page_Title_Accessibility</PageTitle>

<h1>@GlobalValues.Component_Name_Toggletip @GlobalValues.Common_Page_Title_Accessibility</h1>


<h2 id="toggle-tip-keyboard">Keyboard interaction</h2>
<ul aria-labelledby="toggle-tip-keyboard">
    <li><kbd>Space</kbd> - when focus is on the toggletip icon, expands/collapses the toggletip popover.</li>
    <li><kbd>Enter</kbd> - when focus is on the toggletip icon, expands/collapses the toggletip popover.</li>
    <li><kbd>Escape</kbd> - closes the toggletip.</li>
    <li><kbd>Tab</kbd> - moves focus to the next focusable item in the tab sequence.</li>
    <li><kbd>Tab</kbd> <b>+</b> <kbd>Shift</kbd> - moves focus to the previous focusable item in the tab sequence.</li>
</ul>

<div class="flex-content justify-content-between">
    <a class="@GlobalValues.Link_Button_Class @GlobalValues.Link_Button_Left_Arrow_Modifier" href="@($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_Toggletip}/{GlobalValues.Common_Page_Path_Installation}")">
        <span aria-hidden="true"></span>
        <span>@GlobalValues.Component_Name_Toggletip - @GlobalValues.Common_Page_Title_Installation</span>
        <span aria-hidden="true"></span>
    </a>
    <a class="@GlobalValues.Link_Button_Class @GlobalValues.Link_Button_Right_Arrow_Modifier" href="@($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_Toggletip}/{GlobalValues.Common_Page_Path_Api}")">
        <span aria-hidden="true"></span>
        <span>@GlobalValues.Component_Name_Toggletip - @GlobalValues.Common_Page_Title_Api</span>
        <span aria-hidden="true"></span>
    </a>
</div>
