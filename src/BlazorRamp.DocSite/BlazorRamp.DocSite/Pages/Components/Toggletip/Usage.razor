@attribute [Route($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_Toggletip}/{GlobalValues.Common_Page_Path_Usage}")]

<PageTitle>@GlobalValues.Component_Name_Toggletip @GlobalValues.Common_Page_Title_Usage</PageTitle>

<h1>@GlobalValues.Component_Name_Toggletip @GlobalValues.Common_Page_Title_Usage</h1>
<p>
    Practical examples showing the Toggletip component configured with various parameters.
</p>
<p>
    Example showing all of the parameters being set for the toggletip. Despite all parameters having default values, you should set the label to a unique value for the toggletip/page.
</p>

<CodeBox CodeBlock="@ToggletipSnippets.Usage_Example" AriaLabel="Tabs setting parameters code example" />

<p>
    Set focus on and press enter or use your mouse to open the Keyboard Info Toggletip below:
</p>
<ToggleTip CloseText="Close Keyboard Info." Label="Keyboard info:" ShowClose="true" ShowLabel="true" ToggleTipLabelOrder="ToggleTipLabelOrder.LabelFirst" ToggleTipSize="ToggleTipSize.Small">
    <h2 id="toggletip-demo" class="@GlobalValues.Info_Box_Heading_Class">Keyboard interaction</h2>
    <ul aria-labelledby="toggletip-demo">
        <li><kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">Space</kbd> - when focus is on the toggletip icon, expands or collapses the content.</li>
        <li><kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">Enter</kbd> - when focus is on the toggletip icon, expands or collapses the content.</li>
        <li><kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">Escape</kbd> - closes the toggletip</li>
    </ul>

