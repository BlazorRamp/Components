@attribute [Route($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_Toggletip}/{GlobalValues.Common_Page_Path_Api}")]

<PageTitle>@GlobalValues.Component_Name_Toggletip @GlobalValues.Common_Page_Title_Api</PageTitle>

<h1>@GlobalValues.Component_Name_Toggletip @GlobalValues.Common_Page_Title_Api</h1>

<p>
    Everything you need to work with the Toggletip component: parameters, methods, models, enums, and CSS variables for styling.
</p>

<section>
    <h2 class="page-heading">
        Component parameters, methods, supporting classes and enums.
    </h2>
    <p>
        The following sections cover all components that make up this feature, including their parameters,
        public methods, and any supporting classes or enumerations required for use.
    </p>
    
    <section class="code-table">

        <h3 id="toggle-tip-component-parameters" class="code-table__heading">Toggletip component parameters</h3>

        <table aria-labelledby="toggle-tip-component-parameters">

            <thead>
                <tr>
                    <th scope="col">Parameter</th>
                    <th scope="col">Type</th>
                    <th scope="col">Description</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Label</td>
                    <td>string</td>
                    <td>
                        Text shown next to the icon button and is used as an aria-label for the icon button when not shown.
                        Defaults to "supplemental information" if not entered.
                        <strong>Note: </strong>This value is captured during the <span class="@CodeSpan.Base">OnInitialized</span> method
                        and changes thereafter are ignored.
                    </td>
                </tr>
                <tr>
                    <td>CloseText</td>
                    <td>string</td>
                    <td>
                        Text shown on the optional close button. Defaults to "Close" if not entered.
                        <strong>Note: </strong>This value is captured during the <span class="@CodeSpan.Base">OnInitialized</span> method
                        and changes thereafter are ignored.
                    </td>

                </tr>
                <tr>
                    <td>ShowLabel</td>
                    <td>bool</td>
                    <td>Removes the label and reclaims its space when set to false. Defaults to true.</td>
                </tr>
                <tr>
                    <td>ShowClose</td>
                    <td>bool</td>
                    <td>Removes the button and reclaims its space when set to false. Defaults to true.</td>
                </tr>
                <tr>
                    <td>ToggleTipLabelOrder</td>
                    <td>ToggleTipLabelOrder (enum)</td>
                    <td>Value that determines whether the label is to the left or right of the icon. Defaults to <span class="@CodeSpan.Base">ToggleTipLabelOrder.LabelFirst</span></td>
                </tr>
                <tr>
                    <td>ToggleTipPosition</td>
                    <td>ToggleTipPosition (enum)</td>
                    <td>
                        Value that determines the position of the toggletip popover in relation to the icon button. Defaults to <span class="@CodeSpan.Base">ToggleTipPosition.TopCentre</span>
                        <strong>Note: </strong>This value is captured during the <span class="@CodeSpan.Base">OnInitialized</span> method
                        and changes thereafter are ignored.
                    </td>
                </tr>
                <tr>
                    <td>ToggleTipSize</td>
                    <td>ToggleTipSize (enum)</td>
                    <td>Determines the size of the toggletip popover. Defaults to <span class="@CodeSpan.Base">ToggleTipSize.Small</span>. See note below.</td>
                </tr>
                <tr>
                    <td>AdditionalAttributes</td>
                    <td>Dictionary&lt;string, object&gt;?</td>
                    <td>Sets additional attributes applied to the component's root element.</td>
                </tr>
            </tbody>
        </table>
        <p>
            <strong>Note: </strong>The size sets the maximum widths and heights in viewport units with all sharing the fixed minimums of 320px for width (W) and 300px for height (H).
            Like everything these can be changed if necessary. The defaults for small are W:30vw H:40vh, medium W:40vw H:50vh and large W:50vw H:60vh.
        </p>
    </section>
</section>
<section>
