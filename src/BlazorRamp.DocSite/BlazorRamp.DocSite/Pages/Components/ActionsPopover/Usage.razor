@attribute [Route($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_ActionsPopover}/{GlobalValues.Common_Page_Path_Usage}")]

<PageTitle>@GlobalValues.Component_Name_Actions_Popover @GlobalValues.Common_Page_Title_Usage</PageTitle>

<h1>@GlobalValues.Component_Name_Actions_Popover @GlobalValues.Common_Page_Title_Usage</h1>

<p>
    Practical examples showing the Actions Popover component configured with various parameters.
</p>
<p>
    A typical use case for the actions popover would be to provide a compact list of row actions for a data table. The row data type can be
    assigned as the type param so this data can then be provided as the payload in the <span class="@CodeSpan.Base">OnClick</span> events.
   <strong>Note: </strong>This mechanism uses a Func instead of the Blazor <span class="@CodeSpan.Base">EventCallback</span> to prevent automatic renders, so you call the 
   <span class="@CodeSpan.Base">StateHasChanged</span> method if necessary.
</p>
<p>
    The example uses the <span class="@CodeSpan.Base">Stretch</span> parameter so the trigger buttons fill the available column space so they are the same size,
    in this instance they all size to the widest button. The <span class="@CodeSpan.Base">ActionsPopoverPosition</span> parameter was set so the popover displays
    to the bottom right of the trigger. It uses anchor positioning with fallback so if you resize the page so the list would go off page and then open it, it
    will shift to dispay above the trigger.
</p>
<p>
    For the example below, I have used the Live Region Service to announce the information that is show below the table when an actionable item is activated. I set
    the replayable option to true so the output is added to the rolling announcement log, viewable by using the announcement history dialog, shortcut keys <kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">Ctrl + Shift + H</kbd>
    or activate the alerts button, button right of the screen.
</p>

<section class="@Section.Base @Section.Bordered @Section.Radius(SectionRadius.Content)">

    <h2 id="table-title">Contacts table (Northwind lives on)</h2>

    <div class="data-table">
        <table aria-labelledby="table-title">
            <thead>
                <tr>
                    <th scope="col">Contact ID</th>
                    <th scope="col">Given Name</th>
                    <th scope="col">Family Name</th>
                    <th scope="col">Job Title</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var contact in _contacts)
                {
                    <tr>
                        <td>@contact.ContactID</td>
                        <td>@contact.GivenName</td>
                        <td>@contact.FamilyName</td>
                        <td>@contact.JobTitle</td>
                        <td style="width:1%;white-space:nowrap;">                            
                            <ActionsPopover TriggerText="@($"For: {contact.GivenName} {contact.FamilyName}")" Stretch="true" ActionsPopoverPosition="ActionsPopoverPosition.BottomRight">
                                <PopoverItems>
                                    <ActionPopoverButton TData="Contact" ButtonText="Edit" SvgIcon="--svg-pencil-icon" OnClick="HandleOnEdit" ItemData="@contact"/>
                                     <ActionPopoverButton TData="Contact" ButtonText="Delete" SvgIcon="--svg-trash-can-icon" OnClick="HandleOnDelete" ItemData="@contact" />
                                </PopoverItems>
                            </ActionsPopover>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div style="margin-top:var(--br-unit-space-5);">
        <p> @_output</p>
    </div>
</section>
<ThemeBorderTool Title="Applicable theme border tools" ThemeToolHeadingLevel="ThemeToolHeadingLevel.H2">
    <BorderGroups>
        <BorderGroup Title="Container borders">
            <BorderRadius LabelText="Content radius" ResetText="Reset content radius" MaxRangeValue="@GlobalValues.Radius_Container_Max_Range_Value" CssProperties="@([new(CoreCssVariables.Group_Container_Radius_Content)])" />
            <BorderRadius LabelText="Header radius" ResetText="Reset header radius" MaxRangeValue="@GlobalValues.Radius_Container_Header_Max_Range_Value" CssProperties="@([new(CoreCssVariables.Group_Container_Radius_Header)])" />
        </BorderGroup>
        <BorderGroup Title="Menu borders">
            <BorderRadius LabelText="Trigger, panel radius" ResetText="Reset trigger, panel radius" MaxRangeValue="@GlobalValues.Radius_Menu_Trigger_Panel_Max_Range_Value"
                          CssProperties="@([new(CoreCssVariables.Group_Menu_Radius_Panel), new(CoreCssVariables.Group_Menu_Radius_Header), new(CoreCssVariables.Group_Menu_Radius_Content)])" />
            <BorderRadius LabelText="Menu item radius" ResetText="Reset menu item radius" MaxRangeValue="@GlobalValues.Radius_Menu_Item_Max_Range_Value" CssProperties="@([new(CoreCssVariables.Group_Menu_Radius_item)])" />
        </BorderGroup>
    </BorderGroups>
</ThemeBorderTool>

<h2>
    Code from the example
</h2>
<CodeBox CodeBlock="@ActionsPopoverSnippets.Usage_Example_Row_Actions" AriaLabel="_Actions Popover usage code block" />


<div class="flex-content justify-content-between">
    <a class="@GlobalValues.Link_Button_Class @GlobalValues.Link_Button_Left_Arrow_Modifier" href="@($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_ActionsPopover}/{GlobalValues.Common_Page_Path_Api}")">
        <span aria-hidden="true"></span>
        <span>@GlobalValues.Component_Name_Actions_Popover - @GlobalValues.Common_Page_Title_Api</span>
        <span aria-hidden="true"></span>
    </a>
    <a class="@GlobalValues.Link_Button_Class @GlobalValues.Link_Button_Right_Arrow_Modifier" href="@($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_Announcement}/{GlobalValues.Common_Page_Path_Overview}")">
        <span aria-hidden="true"></span>
        <span>@GlobalValues.Component_Name_Announcement - @GlobalValues.Common_Page_Title_Overview</span>
        <span aria-hidden="true"></span>
    </a>
</div>
@code {
    [Inject] ILiveRegionService LiveRegionService { get; set; } = default!;

    private string _output = String.Empty;

    private Contact[] _contacts = new[]
    {
        new Contact(1, "Nancy", "Davolio", "Sales Representative"),
        new Contact(2, "Andrew", "Fuller", "Vice President, Sales"),
        new Contact(3, "Janet", "Leverling", "Sales Representative"),
        new Contact(4, "Margaret", "Peacock", "Sales Representative"),
        new Contact(5, "Steven", "Buchanan", "Sales Manager")
    };

    private async Task HandleOnEdit(ButtonActionData<Contact> itemData)
    {
        var data = itemData.GetValueOr(null);

        _output = $"You activated the {itemData.ButtonText} option that contained the payload value of {(data is null ? "[null]" : data.ToString())}";
        await LiveRegionService.MakeAnnouncement(new Announcement(_output, AnnouncementType.Info, $"My Actions - {itemData.ButtonText}"), true);
        await InvokeAsync(StateHasChanged);
    }
    private async Task HandleOnDelete(ButtonActionData<Contact> itemData)
    {
        var data = itemData.GetValueOr(null);
        _output = $"You activated the {itemData.ButtonText} option that contained the payload value of {(data is null ? "[null]" : data.ToString())}";
        await LiveRegionService.MakeAnnouncement(new Announcement(_output, AnnouncementType.Info, $"My Actions - {itemData.ButtonText}"), true);
        await InvokeAsync(StateHasChanged);
    }

    private record Contact(int ContactID, string GivenName, string FamilyName, string JobTitle);


}
