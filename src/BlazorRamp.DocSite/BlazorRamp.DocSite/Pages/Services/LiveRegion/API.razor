@attribute [Route($"{GlobalValues.Root_path_Services}/{GlobalValues.Service_Path_Part_Live_Region}/{GlobalValues.Common_Page_Path_Api}")]

<PageTitle>@GlobalValues.Service_Name_Live_Region @GlobalValues.Common_Page_Title_Api</PageTitle>

<h1>@GlobalValues.Service_Name_Live_Region @GlobalValues.Common_Page_Title_Api</h1>
<p>
    Everything you need to work with the Live Region Service, methods, models and enums.
</p>

<section style="margin-top:1.5rem;">

    <h2 id="iliveregion-service-interface" class="mobile-centred-heading">ILiveRegionService interface</h2>
    <div class="@Section.Base @Section.NoPadding @Section.OverflowX(UnitScroll.Auto) @Padding.Block(UnitSpace.Four)">
        <table class="@Table.Base @Table.CodeTable" tabindex="0" aria-labelledby="iliveregion-service-interface">

            <thead>
                <tr>
                    <th scope="col">Method</th>
                    <th scope="col">Description</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>MakeAnnouncement(Announcement announcement, bool replayable = true)</td>
                    <td>
                        Dispatches an announcement to be spoken by a screen reader. Returns a <span class="@CodeSpan.Base">Task</span>.
                        By default unless set to false, replayable adds the announcment message to the rolling log for the
                        announcement history viewer.
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

</section>

<section>

    <h2 id="announcement-record" class="mobile-centred-heading">Announcement record</h2>
    <div class="@Section.Base @Section.NoPadding @Section.OverflowX(UnitScroll.Auto) @Padding.Block(UnitSpace.Four)">
        <table class="@Table.Base @Table.CodeTable" tabindex="0" aria-labelledby="announcement-record">

            <thead>
                <tr>
                    <th scope="col">Property</th>
                    <th scope="col">Type</th>
                    <th scope="col">Description</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Message</td>
                    <td>string</td>
                    <td>The text content to be spoken by the screen reader.</td>
                </tr>
                <tr>
                    <td>AnnouncementType</td>
                    <td>AnnouncementType (enum)</td>
                    <td>TThe semantic classification (e.g., Info, Success, Error).</td>
                </tr>
                <tr>
                    <td>AnnouncementTrigger</td>
                    <td>string?</td>
                    <td>Optional text describing what triggered this announcement. For example clicking a Save Button you would just pass "Save Button"</td>
                </tr>
                <tr>
                    <td>LiveRegionType</td>
                    <td>LiveRegionType (enum)</td>
                    <td>The ARIA priority level (Polite or Assertive).</td>
                </tr>
            </tbody>
        </table>
    </div>
</section>

<section>
    <h2 class="mobile-centred-heading">Supporting enums</h2>
    <section>

        <h3 id="announcementtype-enum" class="mobile-centred-heading">AnnouncementType enum</h3>
        <div class="@Section.Base @Section.NoPadding @Section.OverflowX(UnitScroll.Auto) @Padding.Block(UnitSpace.Four)">
            <table class="@Table.Base @Table.CodeTable" tabindex="0" aria-labelledby="announcementtype-enum">

                <thead>
                    <tr>
                        <th scope="col">Value</th>
                        <th scope="col">Name</th>
                        <th scope="col">Description</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>0</td>
                        <td>Info</td>
                        <td>General informational announcement..</td>
                    </tr>
                    <tr>
                        <td>1</td>
                        <td>OperationStarted</td>
                        <td>Indicates an operation has started.</td>
                    </tr>
                    <tr>
                        <td>2</td>
                        <td>OperationCompleted</td>
                        <td>Indicates an operation has completed successfully.</td>
                    </tr>
                    <tr>
                        <td>3</td>
                        <td>OperationFailed</td>
                        <td>Indicates an operation has failed.</td>
                    </tr>
                    <tr>
                        <td>4</td>
                        <td>OperationCancelled</td>
                        <td>Indicates an operation was cancelled.</td>
                    </tr>
                    <tr>
                        <td>5</td>
                        <td>SystemWarning</td>
                        <td>System-level warning message.</td>
                    </tr>
                    <tr>
                        <td>6</td>
                        <td>SystemError</td>
                        <td>System-level error message.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>
    <section>

        <h3 id="liveregiontype-enum" class="mobile-centred-heading">LiveRegionType enum</h3>
        <div class="@Section.Base @Section.NoPadding @Section.OverflowX(UnitScroll.Auto) @Padding.Block(UnitSpace.Four)">
            <table class="@Table.Base @Table.CodeTable" tabindex="0" aria-labelledby="liveregiontype-enum">

                <thead>
                    <tr>
                        <th scope="col">Value</th>
                        <th scope="col">Name</th>
                        <th scope="col">Description</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>0</td>
                        <td>Polite</td>
                        <td>Waits for the screen reader to finish current speech before announcing.</td>
                    </tr>
                    <tr>
                        <td>1</td>
                        <td>Assertive</td>
                        <td>Interrupts the screen reader immediately.</td>
                    </tr>

                </tbody>
            </table>
        </div>
    </section>
</section>


<div class="flex-content justify-content-between">
    <a class="@GlobalValues.Link_Button_Class @GlobalValues.Link_Button_Left_Arrow_Modifier" href="@($"{GlobalValues.Root_path_Services}/{GlobalValues.Service_Path_Part_Live_Region}/{GlobalValues.Common_Page_Path_Accessibility}")">
        <span aria-hidden="true"></span>
        <span>@GlobalValues.Service_Name_Live_Region - @GlobalValues.Common_Page_Title_Accessibility</span>
        <span aria-hidden="true"></span>
    </a>
    <a class="@GlobalValues.Link_Button_Class @GlobalValues.Link_Button_Right_Arrow_Modifier" href="@($"{GlobalValues.Root_path_Services}/{GlobalValues.Service_Path_Part_Live_Region}/{GlobalValues.Common_Page_Path_Usage}")">
        <span aria-hidden="true"></span>
        <span>@GlobalValues.Service_Name_Live_Region - @GlobalValues.Common_Page_Title_Usage</span>
        <span aria-hidden="true"></span>
    </a>
</div>
@code {

}
