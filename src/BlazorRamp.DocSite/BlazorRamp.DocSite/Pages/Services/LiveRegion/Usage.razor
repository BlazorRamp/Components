@attribute [Route($"{GlobalValues.Root_path_Services}/{GlobalValues.Service_Path_Part_Live_Region}/{GlobalValues.Common_Page_Path_Usage}")]

<PageTitle>@GlobalValues.Component_Name_Accordion @GlobalValues.Common_Page_Title_Usage</PageTitle>

<h1>@GlobalValues.Component_Name_Accordion @GlobalValues.Common_Page_Title_Usage</h1>


<section>
    <h2 class="mobile-centred-heading">Making announcements</h2>

    <p>
        Please keep your messages short and to the point, for example on completion of saving a customer entry "Saved Successfully" would be sufficient.
        Provide context when necessary; the "Theme" button on this site uses the live regions service as follows:
    </p>
    <CodeBox CodeBlock="@CoreSnippets.Make_Announcement" AriaLabel="Making an announcement code block" />
    <p>
        <strong>Note: </strong> The <span class="@CodeSpan.Base">AnnouncementTypo</span> is currently not exposed but in the future may be used for filtering announcements.
    </p>
</section>

<div class="@FlexContent.Base @FlexContent.Wrap(UnitFlexWrap.Wrap) @LayoutAlignment.JustifyContent(UnitJustifyContent.SpaceBetween) @LayoutAlignment.AlignItems(UnitAlignItems.Centre)">
        <a class="@Button.Base @Button.LinkStyle @Gap.SetColGap(UnitGapSize.Four)" href="@($"{GlobalValues.Root_path_Services}/{GlobalValues.Service_Path_Part_Live_Region}/{GlobalValues.Common_Page_Path_Api}")">
        <span class="@SvgIcon.Base @SvgIcon.Size(UnitIconSize.ExtraLarge)" aria-hidden="true" style="--_svg-icon-source:var(--svg-left-arrow-circle-icon)"></span>
        <span>@GlobalValues.Service_Name_Live_Region - @GlobalValues.Common_Page_Title_Api</span>

    </a>
        <a class="@Button.Base @Button.LinkStyle @Gap.SetColGap(UnitGapSize.Four)" href="@($"{GlobalValues.Root_path_Theming}/{GlobalValues.Common_Page_Path_Overview}")">

        <span>@GlobalValues.Theming_Name - @GlobalValues.Common_Page_Title_Overview</span>
        <span class="@SvgIcon.Base @SvgIcon.Size(UnitIconSize.ExtraLarge)" aria-hidden="true" style="--_svg-icon-source:var(--svg-right-arrow-circle-icon)"></span>
    </a>
</div>
@code {

}
