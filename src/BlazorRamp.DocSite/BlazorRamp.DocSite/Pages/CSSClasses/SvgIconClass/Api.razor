                        <th scope="col">Default Value</th>
                        <th scope="col">Description</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>--_svg-icon-source</td>
                        <td>none</td>
                        <td>The masked SVG, supplied inline by the consumer. Left unset, the icon renders as a plain <span class="@CodeSpan.Base">currentColor</span> square rather than disappearing.</td>
                    </tr>
                    <tr>
                        <td>--_svg-icon-size</td>
                        <td>1.5em</td>
                        <td>The icon's width and height, before any <span class="@CodeSpan.Base">Size</span> modifier is applied.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>
</section>

