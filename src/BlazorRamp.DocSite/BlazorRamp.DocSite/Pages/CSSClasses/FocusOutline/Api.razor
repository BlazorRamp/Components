<section>
    <h2 class="mobile-centred-heading">CSS variables</h2>
    <p>
        The following variables can be overridden to alter the appearance of br-focus-outline. Width, style, offset and colour default to the shared
        <span class="@CodeSpan.Base">--br-comp-all-outline-*</span> layer, so overriding those tokens keeps every component's focus ring - and this utility -
        in sync automatically.
    </p>
    <section>
        <h3 id="focusoutline-base-variables" class="mobile-centred-heading">FocusOutline base variables</h3>
        <p>Private variables set on the element itself before any modifier is applied.</p>
        <div class="@Section.Base @Section.NoPadding @Section.OverflowX(UnitScroll.Auto) @Padding.Block(UnitSpace.Four)">
            <table class="@Table.Base @Table.CodeTable" tabindex="0" aria-labelledby="focusoutline-base-variables">
                <thead>
                    <tr>
                        <th scope="col">Variable Name</th>
                        <th scope="col">Default Value</th>
                        <th scope="col">Description</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>--_focus-outline-width</td>
                        <td>var(--br-comp-all-outline-width)</td>
                        <td>The outline's width before any width modifier is applied.</td>
                    </tr>
                    <tr>
                        <td>--_focus-outline-style</td>
                        <td>var(--br-comp-all-outline-style)</td>
                        <td>The outline's border style (e.g. solid).</td>
                    </tr>
                    <tr>
                        <td>--_focus-outline-offset</td>
                        <td>var(--br-comp-all-outline-offset)</td>
                        <td>The outline's offset from the element's edge before any offset modifier is applied.</td>
                    </tr>
                    <tr>
                        <td>--_focus-outline-colour</td>
                        <td>var(--br-comp-all-outline-colour)</td>
                        <td>The outline's colour.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>
    <section>
        <h3 id="focusoutline-shared-variables" class="mobile-centred-heading">Shared variables consumed</h3>
        <p>
            <span class="@CodeSpan.Base">br-focus-outline's</span> defaults read from these shared
            <span class="@CodeSpan.Base">--br-comp-all-outline-*</span> tokens, the same tokens used by every focusable component's own focus ring.
        </p>
        <div class="@Section.Base @Section.NoPadding @Section.OverflowX(UnitScroll.Auto) @Padding.Block(UnitSpace.Four)">
            <table class="@Table.Base @Table.CodeTable" tabindex="0" aria-labelledby="focusoutline-shared-variables">
                <thead>
                    <tr>
                        <th scope="col">Variable Name</th>
                        <th scope="col">Description</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>--br-comp-all-outline-width</td>
                        <td>The default outline width used across the library.</td>
                    </tr>
                    <tr>
                        <td>--br-comp-all-outline-style</td>
                        <td>The default outline border style used across the library.</td>
                    </tr>
                    <tr>
                        <td>--br-comp-all-outline-offset</td>
                        <td>The default outline offset used across the library.</td>
                    </tr>
                    <tr>
                        <td>--br-comp-all-outline-colour</td>
                        <td>The default outline colour used across the library.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>
</section>

