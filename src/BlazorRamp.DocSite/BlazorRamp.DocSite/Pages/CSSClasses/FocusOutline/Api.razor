            <thead>
                <tr>
                    <th scope="col">Class</th>
                    <th scope="col">Type</th>
                    <th scope="col">Description</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>br-focus-outline</td>
                    <td>Block</td>
                    <td>The root focus indicator class. Shows an outline on <span class="@CodeSpan.Base">:focus-visible</span> using the shared outline tokens.</td>
                </tr>
                <tr>
                    <td>br-focus-outline--off</td>
                    <td>Modifier</td>
                    <td>Suppresses the outline entirely, for both mouse and keyboard focus.</td>
                </tr>
                <tr>
                    <td>br-focus-outline--on-focus</td>
                    <td>Modifier</td>
                    <td>Shows the outline on any focus, not just keyboard/assistive-technology focus.</td>
                </tr>
                <tr>
                    <td>
                        br-focus-outline--width-0<br>
                        br-focus-outline--width-1<br>
                        br-focus-outline--width-2<br>
                        br-focus-outline--width-3<br>
                        br-focus-outline--width-4<br>
                        br-focus-outline--width-5
                    </td>
