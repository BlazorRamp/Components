<section>
    <h2 class="page-heading">CSS variables</h2>
    <p>
        The following variables can be overridden to alter the appearance of br-section. They're consumed from the shared
        <span class="@CodeSpan.Base">--br-cls-*</span> layer, so a theme change updates every section on the page automatically -
        you don't need to override anything to stay in sync with your chosen theme.
    </p>

    <section class="code-table">
        <h3 id="section-heading-variables" class="code-table__heading">Section heading variables</h3>
        <p>
            <span class="@CodeSpan.Base">br-section's </span>colour modifiers read from these shared
            <span class="@CodeSpan.Base">--br-cls-*</span> tokens.
        </p>
        <table aria-labelledby="section-heading-variables">
            <thead>
                <tr>
                    <th scope="col">Variable Name</th>
                    <th scope="col">Description</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>
                        --br-cls-neutral-lighter<br />
                        --br-cls-secondary-lighter<br />
                        --br-cls-accent-lighter<br />
                        --br-cls-primary-lighter
                    </td>
                    <td>
                        Background colours used by the <span class="@CodeSpan.Base">
                        --neutral-lighter
                        <br />--secondary-lighter<br />--accent-lighter<br />
                        --primary-lighter
                    </span> modifiers.
                </td>
            </tr>
            <tr>
                <td>
                    --br-cls-neutral-text<br />
                    --br-cls-secondary-text<br />
                    --br-cls-accent-text<br />
                    --br-cls-primary-text
                </td>
                <td>
                    Text colours used by the 
                    <span class="@CodeSpan.Base">--neutral-text<br />--secondary-text<br />--accent-text<br />--primary-text</span> modifiers.
                </td>
            </tr>
            <tr>
                <td>
                    --br-cls-primary-heading-text<br />
                    --br-cls-secondary-heading-text<br />
                    --br-cls-accent-heading-text<br />
                    --br-cls-neutral-heading-text
                </td>
                <td>
                    Heading text colours used by <span class="@CodeSpan.Base">Section.Heading.Text()</span>.
                </td>
            </tr>
        </tbody>
    </table>
</section>
</section>

<h2 class="page-heading">Usage</h2>

<p>
    Below each code section is the result of the code in the section.
</p>
<p>
    A basic section.
</p>
<CodeBox CodeBlock="@CssClassesSnippets.Section_Basic_Example" AriaLabel="Basic section example" />

<div class="@Section.Base">
    <p>Basic section content.</p>
</div>
<p>
    A bordered section using the container grouping border radius with a heading:
</p>
<CodeBox CodeBlock="@CssClassesSnippets.Section_Container_With_Header_Example" AriaLabel="Section with heading example" />

<div class="@Section.Base @Section.Bordered @Section.Radius(SectionRadius.Container)">
    <h3 class="@Section.Heading.Base">Section title</h3>
    <p>Content goes here.</p>
</div>

<p>
    A themed, centred borderless section with a coloured heading that uses the content border radius:
</p>

<CodeBox CodeBlock="@CssClassesSnippets.Section_Coloured_Example" AriaLabel="Section with theme coloured heading example" />

