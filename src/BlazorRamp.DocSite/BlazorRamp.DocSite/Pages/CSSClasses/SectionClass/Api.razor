<section>

<h2 class="page-heading">Usage</h2>

<p>
    Below each code section is the result of the code in the section.
</p>
<p>
    A basic section.
</p>
<CodeBox CodeBlock="@CssClassesSnippets.Section_Basic_Example" AriaLabel="Basic section example" />

<div class="@Section.Base">
    <p>Basic section content.</p>
</div>
<p>
    A bordered section using the container grouping border radius with a heading:
</p>
<CodeBox CodeBlock="@CssClassesSnippets.Section_Container_With_Header_Example" AriaLabel="Section with heading example" />

<section class="@Section.Base @Section.Bordered @Section.Radius(SectionRadius.Container)">
    <h3 class="@Section.Heading.Base">Section title</h3>
    <p>Content goes here.</p>
</section>

<p>
    A themed, centred borderless section with a coloured heading that uses the content border radius 
    (explicitly defined for the example, as its the default without any modifier).:
</p>

<CodeBox CodeBlock="@CssClassesSnippets.Section_Coloured_Example" AriaLabel="Section with theme coloured heading example" />

<section class="@Section.Base
    @Section.Background(SectionBackground.PrimaryLighter)
    @Section.Text(SectionText.PrimaryDark)
    @Section.ColumnCentred
    @Section.Radius(SectionRadius.Content)">
    <h3 class="@Section.Heading.Base @Section.Heading.Text(SectionHeadingText.PrimaryDark)">
        Accent callout
    </h3>
    <p>This section uses the primary colour family throughout.</p>
</section>

<ThemeBorderTool  Title="Theme border tool" ThemeToolHeadingLevel="ThemeToolHeadingLevel.H2">
    <BorderGroups>

        <BorderGroup Title="Content borders">
            <BorderRadius LabelText="Content radius" ResetText="Reset content radius" MaxRangeValue="@GlobalValues.Radius_Content_Max_Range_Value" CssProperties="@([new(CoreCssVariables.Group_Content_Radius)])" />
        </BorderGroup>
        <BorderGroup Title="Container borders">
            <BorderRadius LabelText="Content radius" ResetText="Reset content radius" MaxRangeValue="@GlobalValues.Radius_Container_Max_Range_Value" CssProperties="@([new(CoreCssVariables.Group_Container_Radius_Content)])" />
            <BorderRadius LabelText="Header radius" ResetText="Reset header radius" MaxRangeValue="@GlobalValues.Radius_Container_Header_Max_Range_Value" CssProperties="@([new(CoreCssVariables.Group_Container_Radius_Header)])" />
        </BorderGroup>
        <BorderGroup Title="Dialog borders">
            <BorderRadius LabelText="Outer radius" ResetText="Reset outer radius" MaxRangeValue="@GlobalValues.Radius_Dialog_Surface_Max_Range_Value" CssProperties="@([new(CoreCssVariables.Group_Dialog_Radius_Surface), new(CoreCssVariables.Group_Dialog_Radius_Base)])" />
            <BorderRadius LabelText="Inner radius" ResetText="Reset inner radius" MaxRangeValue="@GlobalValues.Radius_Dialog_Content_Max_Range_Value" CssProperties="@([new(CoreCssVariables.Group_Dialog_Radius_Content)])" />
        </BorderGroup>

    </BorderGroups>
</ThemeBorderTool>

