<section>
    <h2 id="c#-classes" class="page-heading">C# API</h2>
    <p>
        <span class="@CodeSpan.Base">Section</span> provides the BEM CSS classes for the br-section block: a general-purpose,
        theme-reactive content section used for page content, cards, and other bordered or coloured content areas.
    </p>
    <section class="code-table">
        <h3 id="section-class" class="code-table__heading">Section class</h3>
        <table aria-labelledby="section-class">
            <thead>
                <tr>
                    <th scope="col">Return</th>
                    <th scope="col">Const/Static Method</th>
                    <th scope="col">Description</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Section.Base</td>
                    <td>string</td>
                    <td>The base class, <span class="@CodeSpan.Base">br-section</span>. Always required.</td>
                </tr>
                <tr>
                    <td>Section.Bordered</td>
                    <td>string</td>
                    <td>Adds a visible border using the shared divider colour.</td>
                </tr>
                <tr>
                    <td>Section.NoPadding</td>
                    <td>string</td>
                    <td>Removes the default section's base padding.</td>
                </tr>
                <tr>
                    <td>Section.CodeFont</td>
                    <td>string</td>
                    <td></td>
                </tr>
                <tr>
                    <td>Section.NoMarginBlock</td>
                    <td>string</td>
                    <td>Switches the section's font family to the shared code font.</td>
                </tr>
                <tr>
                    <td>Section.NoMarginBlock</td>
                    <td>string</td>
                    <td>Lays out the section's content as a centred flex column.</td>
                </tr>
                <tr>
                    <td>Section.Radius(SectionRadius sectionRadius)</td>
                    <td>string</td>
                    <td>Gets the class that sets the section's border radius.</td>
                </tr>
                <tr>
                    <td>Section.Background(SectionBackground sectionBackground)</td>
                    <td>string</td>
                    <td>Gets the class that sets the section's background colour.</td>
                </tr>
                <tr>
                    <td>Section.Text(SectionText sectionText)</td>
                    <td>string</td>
                    <td>Gets the class that sets the section's text colour.</td>
                </tr>
                <tr>
                    <td>Section.FontSize(SectionFontSize sectionFontSize)</td>
                    <td>string</td>
                    <td>Gets the class that sets the section's base font size.</td>
                </tr>
            </tbody>
        </table>
    </section>

    <section class="code-table">
        <h3 id="section-heading-class" class="code-table__heading">Section.Heading class</h3>
        <p>
            <span class="@CodeSpan.Base">Section.Heading</span>. Provides the BEM CSS classes for the <span class="@CodeSpan.Base">br-section__heading</span>
            element, the heading sub-part of a <span class="@CodeSpan.Base">br-section</span>.
        </p>
        <table aria-labelledby="section-heading-class">
            <thead>
                <tr>
                    <th scope="col">Return</th>
                    <th scope="col">Const/Static Method</th>
                    <th scope="col">Description</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Section.Heading.Base</td>
                    <td>string</td>
                    <td>The base class, <span class="@CodeSpan.Base">br-section__heading</span>. Always required.</td>
                </tr>
                <tr>
                    <td>Section.Heading.MobileCentred</td>
                    <td>string</td>
                    <td>Centre-aligns the heading text below the small breakpoint.</td>
                </tr>
                <tr>
                    <td></td>
                    <td>string</td>
                    <td>Gets the class that sets the heading's text colour. See SectionHeadingText below</td>
                </tr>
                <tr>
                    <td>Section.Heading.Text(SectionHeadingText sectionHeadingText)</td>
                    <td>string</td>
                    <td>Gets the class that sets the heading's text colour.</td>
                </tr>
                <tr>
                    <td>Section.Heading.FontSize(SectionHeadingFontSize sectionHeadingFontSize)</td>
                    <td>string</td>
                    <td>Gets the class that sets the heading's font size</td>
                </tr>
            </tbody>
        </table>
    </section>
</section>

