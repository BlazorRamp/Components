<section>
    <h2 class="page-heading">CSS variables</h2>
    <p>
        The following variables can be overridden to alter the appearance of br-section. They're consumed from the shared
        <span class="@CodeSpan.Base">--br-cls-*</span> layer, so a theme change updates every section on the page automatically -
        you don't need to override anything to stay in sync with your chosen theme.
    </p>
    <section class="code-table">
        <h3 id="section-base-variables" class="code-table__heading">Section base variables</h3>
        <p>Private variables set on the element itself before any modifier is applied.</p>
        <table aria-labelledby="section-base-variables">
            <thead>
                <tr>
                    <th scope="col">Variable Name</th>
                    <th scope="col">Default Value</th>
                    <th scope="col">Description</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>--_section-background</td>
                    <td>var(--br-unit-colour-canvas)</td>
                    <td>The section's background colour before any colour modifier is applied.</td>
                </tr>
                <tr>
                    <td>--_section-text</td>
                    <td>var(--br-unit-colour-canvas-text)</td>
                    <td>The section's text colour before any colour modifier is applied.</td>
                </tr>
                <tr>
                    <td>--_section-font-size</td>
                    <td>var(--br-unit-font-size-1)</td>
                    <td>The section's base font size before any size modifier is applied.</td>
                </tr>
            </tbody>
        </table>
    </section>
    <section class="code-table">
        <h3 id="section-heading-variables" class="code-table__heading">Section heading variables</h3>
        <p>
            <span class="@CodeSpan.Base">br-section's </span>colour modifiers read from these shared
            <span class="@CodeSpan.Base">--br-cls-*</span> tokens.
        </p>
        <table aria-labelledby="section-heading-variables">
            <thead>
                <tr>
                    <th scope="col">Variable Name</th>
                    <th scope="col">Description</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>
                        --br-cls-neutral-lighter<br />
                        --br-cls-secondary-lighter<br />
                        --br-cls-accent-lighter<br />
                        --br-cls-primary-lighter
                    </td>
                    <td>
                        Background colours used by the <span class="@CodeSpan.Base">
                        --neutral-lighter
                        <br />--secondary-lighter<br />--accent-lighter<br />
                        --primary-lighter
                    </span> modifiers.
                </td>
            </tr>
            <tr>
                <td>
                    --br-cls-neutral-text-dark<br />
                    --br-cls-secondary-text-dark-dark<br />
                    --br-cls-accent-text-dark-dark<br />
                    --br-cls-primary-text-dark
                </td>
                <td>
                    Text colours used by the
                    <span class="@CodeSpan.Base">--neutral-text-dark<br />--secondary-text-dark<br />--accent-text-dark<br />--primary-text-dark</span> modifiers.
                </td>
            </tr>
            <tr>
                <td>
                    --br-cls-primary-heading-text-dark<br />
                    --br-cls-secondary-heading-text-dark<br />
                    --br-cls-accent-heading-text-dark<br />
                    --br-cls-neutral-heading-text-dark
                </td>
                <td>
                    Heading text colours used by <span class="@CodeSpan.Base">Section.Heading.Text()</span>.
                </td>
            </tr>
        </tbody>
    </table>
</section>
</section>

