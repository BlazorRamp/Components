@attribute [Route($"{GlobalValues.Root_path_CSS_Classes}/{GlobalValues.CSS_Path_Part_CodeSpan}/{GlobalValues.Common_Page_Path_Api}")]

<PageTitle>@GlobalValues.CSS_Name_CodeSpan @GlobalValues.Common_Page_Title_Api_Usage</PageTitle>

<h1>@GlobalValues.CSS_Name_CodeSpan @GlobalValues.Common_Page_Title_Api_Usage</h1>


<p>
    Everything you need to work with the <span class="@CodeSpan.Base">@CodeSpan.Base</span> CSS class: the BEM classes it provides, the strongly-typed <span class="@CodeSpan.Base">CodeSpan</span> C# object
    used to apply them, supporting enums, and the CSS variables used for styling.
</p>

<h2 class="page-heading">Overview</h2>

<p>
    <span class="@CodeSpan.Base">@CodeSpan.Base</span> is an inline element used to present a short fragment of code within a line of text, such as a class name, property, or file path mentioned in prose.
</p>
<p>
    Colours are theme-reactive: they're built from the <span class="@CodeSpan.Base">--br-cls-*</span> variables described below, which in turn derive from the same
    <span class="@CodeSpan.Base">--br-unit-*</span> primitives used across every Blazor Ramp component. Changing your theme updates <span class="@CodeSpan.Base">@CodeSpan.Base</span> automatically
    - no separate configuration needed.
</p>
<p>
    Unlike <span class="@CodeSpan.Base">br-section</span>, <span class="@CodeSpan.Base">@CodeSpan.Base</span> has a fixed border radius and does not expose a radius modifier.
</p>

<section>
    <h2 id="c#-classes" class="page-heading">C# API</h2>
    <p>
        <span class="@CodeSpan.Base">CodeSpan</span> provides the BEM CSS classes for the @CodeSpan.Base block: an inline element
        used to present a short fragment of code within a line of text.
    </p>
    <section class="code-table">
        <h3 id="codespan-class" class="code-table__heading">CodeSpan class</h3>
        <table aria-labelledby="codespan-class">
            <thead>
                <tr>
                    <th scope="col">Return</th>
                    <th scope="col">Const/Static Method</th>
                    <th scope="col">Description</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>string</td>
                    <td>CodeSpan.Base</td>
                    <td>The base class, <span class="@CodeSpan.Base">@CodeSpan.Base</span>. Always required.</td>
                </tr>
                <tr>
                    <td>string</td>
                    <td>CodeSpan.FontSize(CodeSpanFontSize codeSpanFontSize)</td>
                    <td>Gets the class that sets the code span's font size.</td>
                </tr>
                <tr>
                    <td>string</td>
                    <td>CodeSpan.Scheme(CodeSpanScheme scheme)</td>
                    <td>Gets the class that sets the code span's colour scheme.</td>
                </tr>
            </tbody>
        </table>
    </section>
</section>

<section>
    <h2 class="page-heading">Supporting enums</h2>
    <section class="code-table">
        <h3 id="codespan-font-size-enum" class="code-table__heading">CodeSpanFontSize enum</h3>
        <p>
            Sets the font size of a <span class="@CodeSpan.Base">@CodeSpan.Base</span> element.
        </p>
        <table aria-labelledby="codespan-font-size-enum">
            <thead>
                <tr>
                    <th scope="col">Value</th>
                    <th scope="col">Name</th>
                    <th scope="col">Description</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>0</td>
                    <td>Label</td>
                    <td>Label-sized text, matching the size used for input/form labels.</td>
                </tr>
                <tr>
                    <td>1</td>
                    <td>Regular</td>
                    <td>The regular body text size.</td>
                </tr>
                <tr>
                    <td>2</td>
                    <td>Two</td>
                    <td>A larger text size, one step above regular.</td>
                </tr>
                <tr>
                    <td>3</td>
                    <td>Three</td>
                    <td>A larger text size, two steps above regular.</td>
                </tr>
                <tr>
                    <td>4</td>
                    <td>Four</td>
                    <td>A larger text size, three steps above regular.</td>
                </tr>
                <tr>
                    <td>5</td>
                    <td>Five</td>
                    <td>A larger text size, four steps above regular.</td>
                </tr>
                <tr>
                    <td>6</td>
                    <td>Six</td>
                    <td>The largest text size available on this scale.</td>
                </tr>
            </tbody>
        </table>
    </section>

    <section class="code-table">
        <h3 id="codespan-scheme-enum" class="code-table__heading">CodeSpanScheme enum</h3>
        <p>
            Sets the colour scheme (text and background colour pairing) of a <span class="@CodeSpan.Base">@CodeSpan.Base</span> element.
        </p>
        <table aria-labelledby="codespan-scheme-enum">
            <thead>
                <tr>
                    <th scope="col">Value</th>
                    <th scope="col">Name</th>
                    <th scope="col">Description</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>0</td>
                    <td>Inverted</td>
                    <td>An inverted colour scheme, using the canvas colour and its inverted counterpart. The default scheme.</td>
                </tr>
                <tr>
                    <td>1</td>
                    <td>Neutral</td>
                    <td>A neutral colour scheme.</td>
                </tr>
                <tr>
                    <td>2</td>
                    <td>Primary</td>
                    <td>A primary-hue colour scheme.</td>
                </tr>
                <tr>
                    <td>3</td>
                    <td>Secondary</td>
                    <td>A secondary-hue colour scheme.</td>
                </tr>
                <tr>
                    <td>4</td>
                    <td>Accent</td>
                    <td>An accent-hue colour scheme. The scheme applied when no modifier is present.</td>
                </tr>
            </tbody>
        </table>
    </section>
</section>

<section>
    <h2 class="page-heading">Usage</h2>

    <p>
        Below each code section is the result of the code in the section.
    </p>
    <p>
        A basic code span, inline with text:
    </p>
    <CodeBox CodeBlock="@CssClassesSnippets.CodeSpan_Basic_Example" AriaLabel="Basic code span example" />
    <p>
        Set the <span class="@CodeSpan.Base">ControlID</span> parameter to override the generated id.
    </p>

    <p>
        A code span using the primary colour scheme and a larger font size:
    </p>
    <CodeBox CodeBlock="@CssClassesSnippets.CodeSpan_Scheme_Font_Example" AriaLabel="Themed code span example" />
    <p>
        Call <span class="@CodeSpan.Base @CodeSpan.Scheme(CodeSpanScheme.Primary) @CodeSpan.FontSize(CodeSpanFontSize.Two)">ClearFilter() </span>to reset the input.
    </p>

</section>

