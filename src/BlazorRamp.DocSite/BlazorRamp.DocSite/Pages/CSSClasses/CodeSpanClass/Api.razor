                <td>Sets the code span's text and background colour pairing.</td>
            </tr>
        </tbody>
    </table>
</section>

<section>
    <h2 class="page-heading">CSS variables</h2>
    <p>
        The following variables can be overridden to alter the appearance of @CodeSpan.Base. Colour and font size variables are consumed from the shared
        <span class="@CodeSpan.Base">--br-cls-*</span> layer, so a theme change updates every code span on the page automatically -
        you don't need to override anything to stay in sync with your chosen theme.
    </p>

    <section class="code-table">
        <h3 id="codespan-shared-variables" class="code-table__heading">Shared variables consumed</h3>
        <p>
            <span class="@CodeSpan.Base">@CodeSpan.Base's</span> colour scheme modifiers and font family read from these shared
            <span class="@CodeSpan.Base">--br-cls-*</span> tokens.
        </p>
        <table aria-labelledby="codespan-shared-variables">
            <thead>
                <tr>
                    <th scope="col">Variable Name</th>
                    <th scope="col">Description</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>--br-cls-code-font-family</td>
                    <td>The font family used by the code span.</td>
                </tr>
                <tr>
                    <td>
                        --br-cls-neutral-lighter<br>
                        --br-cls-secondary-lighter<br>
                        --br-cls-accent-lighter<br>
                        --br-cls-primary-lighter
                    </td>
                    <td>
                        Background colours used by the <span class="@CodeSpan.Base">
                        --neutral-scheme<br>--secondary-scheme<br>--accent-scheme<br>
                        --primary-scheme
                    </span> modifiers.
                </td>
            </tr>
            <tr>
                <td>
                    --br-cls-neutral-text<br>
                    --br-cls-secondary-text-dark<br>
                    --br-cls-accent-text-dark<br>
                    --br-cls-primary-text-dark
                </td>
                <td>
                    Text colours used by the
                    <span class="@CodeSpan.Base">--neutral-scheme<br>--secondary-scheme<br>--accent-scheme<br>--primary-scheme</span> modifiers.
                </td>
            </tr>
        </tbody>
    </table>
</section>
</section>



