    <h3 id="css-classes" class="code-table__heading">CSS classes</h3>

    <table aria-labelledby="css-classes">
        <thead>
            <tr>
                <th scope="col">Class</th>
                <th scope="col">Type</th>
                <th scope="col">Description</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>@CodeSpan.Base</td>
                <td>Block</td>
                <td>The root code span element. Sets default padding, border radius, font, colour and background.</td>
            </tr>
            <tr>
                <td>
                    @CodeSpan.Base--font-size-label<br>
                    @CodeSpan.Base--font-size-one<br>
                    @CodeSpan.Base--font-size-two<br>
                    @CodeSpan.Base--font-size-three<br>
                    @CodeSpan.Base--font-size-four<br>
                    @CodeSpan.Base--font-size-five<br>
                    @CodeSpan.Base--font-size-six
                </td>
                <td>Modifier(s)</td>
                <td>Sets the code span's font size.</td>
            </tr>
            <tr>
                <td>
                    @CodeSpan.Base--inverted-scheme<br>
                    @CodeSpan.Base--neutral-scheme<br>
                    @CodeSpan.Base--primary-scheme<br>
                    @CodeSpan.Base--secondary-scheme<br>
