<section>
    <h2 class="mobile-centred-heading">Using Icons</h2>
    <p>
        You can add spans to your button content that hold icons to create buttons with icons and text or icon only buttons. 
        <strong>Note: </strong> although icon only buttons are WCAG compliant with an accessible name, this does make it harder for
        voice control users as unless they know what the buttons hidden accessible name is. The software they use can add a grid and/or just
        numbers next to controls without visible names for the user. Try to add text if possible, I provide examples of both.
    </p>
    <div class="@FlexContent.Base @FlexContent.Wrap(UnitFlexWrap.Wrap) @Gap.SetGaps(UnitGapSize.Five)">
        <button type="button" class="@Button.Base @Button.Scheme(ButtonSolidScheme.SuccessLighter)">
            <span class="@SvgIcon.Base" style="--_svg-icon-source:var(--svg-save-icon);"></span>
            <span>Save</span>
        </button>
        <button type="button" class="@Button.Base @Button.Scheme(ButtonSolidScheme.SuccessLighter)">
            <span>Save</span>
            <span class="@SvgIcon.Base" style="--_svg-icon-source:var(--svg-save-icon);"></span>
        </button>
        <button type="button" class="@Button.Base @Button.Scheme(ButtonSolidScheme.SuccessLighter) @Button.Squared @Button.Size(ButtonSize.Regular) @Button.UseColumns @Button.FixedRadius(UnitRadius.Two) @Gap.SetGaps(UnitGapSize.None)">
            <span class="@SvgIcon.Base" style="--_svg-icon-source:var(--svg-save-icon);"></span>
            <span>Save</span>
        </button>
        <button type="button" class="@Button.Base @Button.Scheme(ButtonSolidScheme.SuccessLighter) @Button.Squared @Button.Size(ButtonSize.Regular) @Button.UseColumns @Button.FixedRadius(UnitRadius.Two) @Gap.SetGaps(UnitGapSize.None)">
            <span>Save</span>
            <span class="@SvgIcon.Base" style="--_svg-icon-source:var(--svg-save-icon);"></span>
        </button>
        <button type="button" class="@Button.Base @Button.Scheme(ButtonSolidScheme.SuccessLighter) @Button.Squared @Button.Size(ButtonSize.Small)">
            <span class="@SvgIcon.Base @SvgIcon.Size(UnitIconSize.Small)" style="--_svg-icon-source:var(--svg-save-icon);"></span>
        </button>
        <button type="button" class="@Button.Base @Button.Scheme(ButtonSolidScheme.SuccessLighter) @Button.Squared @Button.Size(ButtonSize.Regular)">
            <span class="@SvgIcon.Base" style="--_svg-icon-source:var(--svg-save-icon);"></span>
        </button>
        <button type="button" class="@Button.Base @Button.Scheme(ButtonSolidScheme.SuccessLighter) @Button.Squared @Button.Size(ButtonSize.Regular) @Button.FixedRadius(UnitRadius.Two)">
            <span class="@SvgIcon.Base" style="--_svg-icon-source:var(--svg-save-icon);"></span>
        </button>
        <button type="button" class="@Button.Base @Button.Scheme(ButtonSolidScheme.SuccessLighter) @Button.Squared @Button.Size(ButtonSize.ExtraLarge) @Button.FixedRadius(UnitRadius.Two)">
            <span class="@SvgIcon.Base @SvgIcon.Size(UnitIconSize.Regular)" style="--_svg-icon-source:var(--svg-save-icon);"></span>
        </button>
    </div>

</section>

<section>
    <h2 id="css-classes" class="mobile-centred-heading">CSS classes</h2>
    <div class="@Section.Base @Section.NoPadding @Section.OverflowX(UnitScroll.Auto) @Padding.Block(UnitSpace.Four)">
        <table class="@Table.Base @Table.CodeTable" tabindex="0" aria-labelledby="css-classes">
            <thead>
                <tr>
                    <th scope="col">Class</th>
                    <th scope="col">Type</th>
                    <th scope="col">Description</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>br-button</td>
                    <td>Block</td>
                    <td>The root button element. Sets default padding, border radius, font, colour, background, and interaction states.</td>
                </tr>
                <tr>
                    <td>br-button--full-width</td>
                    <td>Modifier</td>
                    <td>Makes the button take the full width of its container.</td>
                </tr>
                <tr>
                    <td>
                        br-button--small<br>
                        br-button--regular<br>
                        br-button--large<br>
                        br-button--extra-large
                    </td>
                    <td>Modifier(s)</td>
                    <td>Sets the button's size.</td>
                </tr>
                <tr>
                    <td>
                        br-button--solid-inverted
                    </td>
                    <td>Modifier</td>
                    <td>Solid inverted background and border, using the canvas colour and its inverted counterpart.</td>
                </tr>
                <tr>
                    <td>
                        br-button--solid-neutral<br>
                        br-button--solid-neutral-lighter<br>
                        br-button--solid-neutral-darker
                    </td>
                    <td>Modifier(s)</td>
                    <td>Solid neutral background and border, and its light/dark variants.</td>
                </tr>
                <tr>
                    <td>
                        br-button--solid-primary<br>
                        br-button--solid-primary-lighter<br>
                        br-button--solid-primary-darker
                    </td>
                    <td>Modifier(s)</td>
                    <td>Solid primary-hue background and border, and its light/dark variants.</td>
                </tr>
                <tr>
                    <td>
                        br-button--solid-secondary<br>
                        br-button--solid-secondary-lighter<br>
                        br-button--solid-secondary-darker
                    </td>
                    <td>Modifier(s)</td>
                    <td>Solid secondary-hue background and border, and its light/dark variants.</td>
                </tr>
                <tr>
                    <td>
                        br-button--solid-accent<br>
                        br-button--solid-accent-lighter<br>
                        br-button--solid-accent-darker
                    </td>
                    <td>Modifier(s)</td>
                    <td>Solid accent-hue background and border, and its light/dark variants.</td>
                </tr>
                <tr>
                    <td>
                        br-button--solid-danger<br>
                        br-button--solid-danger-lighter<br>
                        br-button--solid-danger-darker
                    </td>
                    <td>Modifier(s)</td>
                    <td>Solid danger background and border, and its light/dark variants.</td>
                </tr>
                <tr>
                    <td>
                        br-button--solid-warning<br>
                        br-button--solid-warning-lighter<br>
                        br-button--solid-warning-darker
                    </td>
                    <td>Modifier(s)</td>
                    <td>Solid warning background and border, and its light/dark variants.</td>
                </tr>
                <tr>
                    <td>
                        br-button--solid-success<br>
                        br-button--solid-success-lighter<br>
                        br-button--solid-success-darker
                    </td>
                    <td>Modifier(s)</td>
                    <td>Solid success background and border, and its light/dark variants.</td>
                </tr>
                <tr>
                    <td>
                        br-button--solid-info<br>
                        br-button--solid-info-lighter<br>
                        br-button--solid-info-darker
                    </td>
                    <td>Modifier(s)</td>
                    <td>Solid informational background and border, and its light/dark variants.</td>
                </tr>
            </tbody>
        </table>
    </div>
</section>

<section>
    <h2 class="mobile-centred-heading">CSS variables</h2>
    <p>
        The following variables can be overridden to alter the appearance of br-button. Colour variables are consumed from the shared
        <span class="@CodeSpan.Base">--br-cls-*</span> layer, so a theme change updates every button on the page automatically -
        you don't need to override anything to stay in sync with your chosen theme.
    </p>

    <section>
        <h3 id="button-base-variables" class="mobile-centred-heading">Button base variables</h3>
        <p>Private variables set on the element itself before any modifier is applied.</p>
        <div class="@Section.Base @Section.NoPadding @Section.OverflowX(UnitScroll.Auto) @Padding.Block(UnitSpace.Four)">
            <table class="@Table.Base @Table.CodeTable" tabindex="0" aria-labelledby="button-base-variables">
                <thead>
                    <tr>
                        <th scope="col">Variable Name</th>
                        <th scope="col">Default Value</th>
                        <th scope="col">Description</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>--_button-border-colour</td>
                        <td>var(--br-comp-all-button-border-colour)</td>
                        <td>The button's border colour before any scheme modifier is applied.</td>
                    </tr>
                    <tr>
                        <td>--_button-background</td>
                        <td>var(--br-comp-all-button-background)</td>
                        <td>The button's background colour before any scheme modifier is applied.</td>
                    </tr>
                    <tr>
                        <td>--_button-text</td>
                        <td>var(--br-comp-all-button-text)</td>
                        <td>The button's text colour before any scheme modifier is applied.</td>
                    </tr>
                    <tr>
                        <td>--_button-padding-block</td>
                        <td>var(--br-unit-space-3)</td>
                        <td>The button's block-direction (top/bottom) padding before any size modifier is applied.</td>
                    </tr>
                    <tr>
                        <td>--_button-padding-inline</td>
                        <td>var(--br-unit-space-4)</td>
                        <td>The button's inline-direction (left/right) padding before any size modifier is applied.</td>
                    </tr>
                    <tr>
                        <td>--_button-hover</td>
                        <td>hsl(from var(--br-unit-colour-primary) h s l / var(--br-unit-opacity-val-10))</td>
                        <td>The background colour applied on hover for non-solid buttons.</td>
                    </tr>
                    <tr>
                        <td>--_button-hover-brightness</td>
                        <td>115%</td>
                        <td>The brightness filter applied on hover for solid buttons.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>

    <section>
        <h3 id="button-shared-variables" class="mobile-centred-heading">Shared variables consumed</h3>
        <p>
            <span class="@CodeSpan.Base">br-button's</span> solid colour scheme modifiers read from these shared
            <span class="@CodeSpan.Base">--br-cls-*</span> tokens.
        </p>
        <div class="@Section.Base @Section.NoPadding @Section.OverflowX(UnitScroll.Auto) @Padding.Block(UnitSpace.Four)">
            <table class="@Table.Base @Table.CodeTable" tabindex="0" aria-labelledby="button-shared-variables">
                <thead>
                    <tr>
                        <th scope="col">Variable Name</th>
                        <th scope="col">Description</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>
                            --br-cls-neutral<br>
                            --br-cls-primary<br>
                            --br-cls-secondary<br>
                            --br-cls-accent<br>
                            --br-cls-danger<br>
                            --br-cls-warning<br>
                            --br-cls-success<br>
                            --br-cls-info
                        </td>
                        <td>
                            Background and border colours used by the base solid scheme modifiers. Text colour for these is computed with <span class="@CodeSpan.Base">contrast-color()</span>.
                        </td>
                    </tr>
                    <tr>
                        <td>
                            --br-cls-neutral-lighter, -secondary-lighter, -accent-lighter, -primary-lighter, -danger-lighter, -warning-lighter, -success-lighter, -info-lighter
                        </td>
                        <td>
                            Background and border colours used by the <span class="@CodeSpan.Base">-lighter</span> solid scheme modifiers.
                        </td>
                    </tr>
                    <tr>
                        <td>
                            --br-cls-neutral-darker, -secondary-darker, -accent-darker, -primary-darker, -danger-darker, -warning-darker, -success-darker, -info-darker
                        </td>
                        <td>
                            Background and border colours used by the <span class="@CodeSpan.Base">-darker</span> solid scheme modifiers.
                        </td>
                    </tr>
                    <tr>
                        <td>
                            --br-cls-neutral-text-dark, -secondary-text-dark, -accent-text-dark, -primary-text-dark, -danger-text-dark, -warning-text-dark, -success-text-dark, -info-text-dark
                        </td>
                        <td>
                            Text colours used by the <span class="@CodeSpan.Base">-lighter</span> solid scheme modifiers.
                        </td>
                    </tr>
                    <tr>
                        <td>
                            --br-cls-neutral-text-light, -secondary-text-light, -accent-text-light, -primary-text-light, -danger-text-light, -warning-text-light, -success-text-light, -info-text-light
                        </td>
                        <td>
                            Text colours used by the <span class="@CodeSpan.Base">-darker</span> solid scheme modifiers.
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>
</section>





<div class="@FlexContent.Base @FlexContent.Wrap(UnitFlexWrap.Wrap) @LayoutAlignment.JustifyContent(UnitJustifyContent.SpaceBetween) @LayoutAlignment.AlignItems(UnitAlignItems.Centre)">
        <a class="@Button.Base @Button.LinkStyle @Gap.SetColGap(UnitGapSize.Four)" href="@($"{GlobalValues.Root_path_CSS_Classes}/{GlobalValues.Common_Page_Path_CSS_Variables}")">
        <span class="@SvgIcon.Base @SvgIcon.Size(UnitIconSize.ExtraLarge)" aria-hidden="true" style="--_svg-icon-source:var(--svg-left-arrow-circle-icon)"></span>
        <span>@GlobalValues.CSS_Name_CSS_Classes - @GlobalValues.Common_Page_Title_Variables</span>

    </a>
        <a class="@Button.Base @Button.LinkStyle @Gap.SetColGap(UnitGapSize.Four)" href="@($"{GlobalValues.Root_path_CSS_Classes}/{GlobalValues.CSS_Path_Part_CodeSpan}/{GlobalValues.Common_Page_Path_Api}")">

        <span>@GlobalValues.CSS_Name_CodeSpan - @GlobalValues.Common_Page_Title_Api_Usage</span>
        <span class="@SvgIcon.Base @SvgIcon.Size(UnitIconSize.ExtraLarge)" aria-hidden="true" style="--_svg-icon-source:var(--svg-right-arrow-circle-icon)"></span>
    </a>
</div>
