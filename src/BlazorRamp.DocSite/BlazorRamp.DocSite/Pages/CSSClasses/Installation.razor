@attribute [Route($"{GlobalValues.Root_path_CSS_Classes}/{GlobalValues.Common_Page_Path_Installation}")]

<PageTitle>@GlobalValues.CSS_Name_CSS_Classes @GlobalValues.Common_Page_Title_Installation</PageTitle>

<h1>@GlobalValues.CSS_Name_CSS_Classes @GlobalValues.Common_Page_Title_Installation</h1>

<p>
    <strong>Note: </strong> It is a requirement that the Blazor Ramp Core <span class="@CodeSpan.Base">core-live-region.js</span> script, <span class="@CodeSpan.Base">LiveRegionService</span>, and
    associated <span class="@CodeSpan.Base">&lt;AnnouncementHistory /&gt;</span> component are added alongside this packages’s specific
    requirements (a stylesheet reference in this instance).
</p>
<p>
    You do not need to add the BlazorRamp.Core package separately, as BlazorRamp.Core is included as a transitive package, you only need to add the packages that contain the components, frameworks or services
    that you wish to use i.e the <b>BlazorRamp.CssClasses</b> NuGet package.
</p>
<p>
    Please follow the instructions in the <a class="@GlobalValues.Link_Class" href="@($"{GlobalValues.Root_path_Getting_Started}{GlobalValues.Common_Page_Path_Installation}")">@GlobalValues.Getting_Started_Name - @GlobalValues.Common_Page_Title_Installation</a>
    ensuring that in the <span class="@CodeSpan.Base">&lt;head&gt;</span> section you also add the Accordion stylesheet as follows:
</p>
<CodeBox CodeBlock="@CssClassesSnippets.Add_CssClasses_Style_Sheet" AriaLabel="Add css classes stylesheet code block" />

<h2 id="release-history">Release history</h2>

<ol reversed class="history-list">
    <li>
        <h3>
            Version 1.4.0 — <time datetime="2026-09-17">September 17, 2026</time>
        </h3>
        <ul>
            <li>
                Added Link and SvgIcon classes as well as additional methods to the Button class; a 
                square aspect ratio for icon only buttons and a modifier for links that make them look like buttons when hovered or focused.
            </li>
        </ul>
    </li>
    <li>
        <h3>
            Version 1.3.0 — <time datetime="2026-09-13">September 13, 2026</time>
        </h3>
        <ul>
            <li>
                Added GridRow, FlexContent and LayoutAlignment CSS classes and associated C# helpers.
            </li>
        </ul>
    </li>
    <li>
        <h3>
            Version 1.2.0 — <time datetime="2026-09-11">September 11, 2026</time>
        </h3>
        <ul>
            <li>
                Added the FocusOutline utility class and associated CSS class br-focus-outline for adding a customisable focus indicator outline to any focusable element.
            </li>
        </ul>
    </li>
    <li>
        <h3>
            Version 1.1.1 — <time datetime="2026-09-10">September 10, 2026</time>
        </h3>
        <ul>
            <li>
                Additional selector added to the Section class for focus indicators when tables have a tabindex and are focus-visible.
            </li>
        </ul>
    </li>
    <li>
        <h3>
            Version 1.1.0 — <time datetime="2026-09-09">September 09, 2026</time>
        </h3>
        <ul>
            <li>
                Added a Table class and helper so you can have static/manual tables look like the Data Table component.
            </li>
        </ul>
    </li>
    <li>
        <h3>
            Version 1.0.1 — <time datetime="2026-09-06">September 06, 2026</time>
        </h3>
        <ul>
            <li>
                Added general Overflow,Position and Radius utility classes as well adding a position method to the Section class.
            </li>
            <li>
                Added a transparent background Enum option for the Section class.
            </li>
        </ul>
    </li>
    <li>
        <h3>
            Version 1.0.0 — <time datetime="2026-09-05">September 05, 2026</time>
        </h3>
        <ul>
            <li>Initial release of the <span class=@CodeSpan.Base">BlazorRamp.CssClasses v1.0.0</span> NuGet package, multi-targeting <span class="@CodeSpan.Base">.NET 8.0, .NET 9.0 & .NET 10.0</span></li>
        </ul>
    </li>
</ol>

<div class="@BlazorRamp.CssClasses.Common.Utilities.FlexContent.Base 
    @BlazorRamp.CssClasses.Common.Utilities.FlexContent.Wrap(UnitFlexWrap.Wrap) 
    @BlazorRamp.CssClasses.Common.Utilities.LayoutAlignment.JustifyContent(UnitJustifyContent.SpaceBetween) 
    @BlazorRamp.CssClasses.Common.Utilities.LayoutAlignment.AlignItems(UnitAlignItems.Centre)">
    <a class="@Button.Base @Button.LinkStyle  @BlazorRamp.CssClasses.Common.Utilities.Gap.SetColGap(UnitGapSize.Four)" href="@($"{GlobalValues.Root_path_CSS_Classes}/{GlobalValues.Common_Page_Title_Overview}")">
        <span class="@SvgIcon.Base @SvgIcon.Size(UnitIconSize.ExtraLarge)" aria-hidden="true" style="--_svg-icon-source:var(--svg-left-arrow-circle-icon)"></span>
        <span>@GlobalValues.CSS_Name_CSS_Classes - @GlobalValues.Common_Page_Title_Overview</span>

    </a>
    <a class="@Button.Base @Button.LinkStyle  @BlazorRamp.CssClasses.Common.Utilities.Gap.SetColGap(UnitGapSize.Four)" href="@($"{GlobalValues.Root_path_CSS_Classes}/{GlobalValues.Common_Page_Path_CSS_Variables}")">

        <span>@GlobalValues.CSS_Name_CSS_Classes - @GlobalValues.Common_Page_Title_Variables</span>
        <span class="@SvgIcon.Base @SvgIcon.Size(UnitIconSize.ExtraLarge)" aria-hidden="true" style="--_svg-icon-source:var(--svg-right-arrow-circle-icon)"></span>
    </a>
</div>
