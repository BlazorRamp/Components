                    <td>string</td>
                    <td>Padding.InlineStart(UnitSpace unitSpace)</td>
                    <td>Gets the class that sets inline-start (left in LTR) padding.</td>
                </tr>
                <tr>
                    <td>string</td>
                    <td>Padding.InlineEnd(UnitSpace unitSpace)</td>
                    <td>Gets the class that sets inline-end (right in LTR) padding.</td>
                </tr>
                <tr>
                    <td>string</td>
                    <td>Padding.Block(UnitSpace unitSpace)</td>
                    <td>Gets the class that sets block-direction (top/bottom) padding.</td>
                </tr>
                <tr>
                    <td>string</td>
                    <td>Padding.BlockStart(UnitSpace unitSpace)</td>
                    <td>Gets the class that sets block-start (top) padding.</td>
                </tr>
                <tr>
                    <td>string</td>
                    <td>Padding.BlockEnd(UnitSpace unitSpace)</td>
                    <td>Gets the class that sets block-end (bottom) padding.</td>
                </tr>
            </tbody>
        </table>
    </section>
</section>

