                    <th scope="col">Description</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>string</td>
                    <td>Padding.All(UnitSpace unitSpace)</td>
                    <td>Gets the class that sets padding on all sides.</td>
                </tr>
                <tr>
                    <td>string</td>
                    <td>Padding.Inline(UnitSpace unitSpace)</td>
                    <td>Gets the class that sets inline-direction (left/right in LTR) padding.</td>
                </tr>
