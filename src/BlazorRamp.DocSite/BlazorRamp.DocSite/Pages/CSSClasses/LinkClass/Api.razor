@using BlazorRamp.DocSite.Pages.GettingStarted
@attribute [Route($"{GlobalValues.Root_path_CSS_Classes}/{GlobalValues.CSS_Path_Part_Link}/{GlobalValues.Common_Page_Path_Api}")]

<PageTitle>@GlobalValues.CSS_Name_Link @GlobalValues.Common_Page_Title_Api_Usage</PageTitle>

<h1>@GlobalValues.CSS_Name_Link @GlobalValues.Common_Page_Title_Api_Usage</h1>

<p>
    Everything you need to work with the <span class="@CodeSpan.Base">br-link</span> CSS class: the BEM classes it provides, the strongly-typed <span class="@CodeSpan.Base">Link</span> C# object
    used to apply them, supporting enums, and the CSS variables used for styling.
</p>

<h2 class="mobile-centred-heading">Overview</h2>

<p>
    <span class="@CodeSpan.Base">br-link</span> is for a link that sits inside a paragraph or body of text - underlined by default, coloured to inherit
    its surrounding text colour rather than a fixed link colour, and laid out as a small inline flex container so it can hold an
    <span class="@CodeSpan.Base">SvgIcon</span> alongside its text without breaking its inline flow.
</p>
<p>
    For a link that should look like a button instead - solid fill, no underline, a distinct colour scheme - don't use
    <span class="@CodeSpan.Base">br-link</span>. Apply <span class="@CodeSpan.Base">Button</span>'s classes directly to your <span class="@CodeSpan.Base">&lt;a&gt;</span> element instead; a real,
    navigating anchor styled to look like a button is both the simpler and the more accessible pattern - see the <span class="@CodeSpan.Base">Button</span> reference page,
    including its <span class="@CodeSpan.Base">LinkStyle</span> modifier for a button that only reveals its fill on hover or focus.
</p>
<p>
    To align a link's children (for example when combined with <span class="@CodeSpan.Base">UseColumns</span>), or to change the gap between an icon and its text,
    combine <span class="@CodeSpan.Base">br-link</span> with the shared <span class="@CodeSpan.Base">LayoutAlignment</span> and <span class="@CodeSpan.Base">Gap</span> utility classes - see their
    respective reference pages.
</p>

<section>
    <h2 id="c#-classes" class="mobile-centred-heading">C# API</h2>
    <p>
        <span class="@CodeSpan.Base">Link</span> provides the BEM CSS classes for the br-link block: an inline flex element
        for a link that sits within a paragraph or body of text.
    </p>
    <section>
        <h3 id="link-class" class="mobile-centred-heading">Link class</h3>
        <div class="@Section.Base @Section.NoPadding @Section.OverflowX(UnitScroll.Auto) @Padding.Block(UnitSpace.Four)">
            <table class="@Table.Base @Table.CodeTable" tabindex="0" aria-labelledby="link-class">
                <thead>
                    <tr>
                        <th scope="col">Return</th>
                        <th scope="col">Const/Static Method</th>
                        <th scope="col">Description</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>string</td>
                        <td>Link.Base</td>
                        <td>The base class, <span class="@CodeSpan.Base">br-link</span>. Always required.</td>
                    </tr>
                    <tr>
                        <td>string</td>
                        <td>Link.UseColumns</td>
                        <td>Sets the link's flex layout axis to use the direction of column instead of the default row.</td>
                    </tr>
                    <tr>
                        <td>string</td>
                        <td>Link.FixedRadius(UnitRadius unitRadius)</td>
                        <td>
                            Gets the modifier class that sets the link's border radius to a
                            fixed unit value, bypassing the themeable border radius grouping used by default.
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>
</section>

