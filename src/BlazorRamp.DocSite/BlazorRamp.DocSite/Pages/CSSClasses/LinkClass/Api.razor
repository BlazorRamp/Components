</section>

<section>
    <h2 class="mobile-centred-heading">Usage</h2>
    <p>
        Below is a paragraph of Lorum Ipsum text with a link to the Blazor Ramp homepage, appearing after the first two words.
    </p>
    <p>
        orem ipsum <a class="@Link.Base" href="/">Blazor Ramp home page</a> dolor sit amet, consectetur adipiscing elit. Donec eleifend tortor pulvinar diam fringilla luctus. Quisque tincidunt
        purus a mi condimentum efficitur. Sed arcu nulla, convallis ut est vel, malesuada pellentesque diam. Aliquam gravida a leo
        quis commodo. Sed a mi ullamcorper, condimentum nisl quis, imperdiet sapien. Vestibulum quis risus.
    </p>
    <CodeBox CodeBlock="@CssClassesSnippets.Link_Code_Example" AriaLabel="Link code example" />
</section>

<ThemeBorderTool Title="Theme border tool" ThemeToolHeadingLevel="ThemeToolHeadingLevel.H2">
    <BorderGroups>
        <BorderGroup Title="Button/link borders">
            <BorderRadius LabelText="Button radius" ResetText="Reset button radius" MaxRangeValue="@GlobalValues.Radius_Button_Max_Range_Value" CssProperties="@([new(CoreCssVariables.Group_Button_Radius)])" />
        </BorderGroup>
    </BorderGroups>
</ThemeBorderTool>

<section>
    <h3 id="css-classes" class="mobile-centred-heading">CSS classes</h3>
    <div class="@Section.Base @Section.NoPadding @Section.OverflowX(UnitScroll.Auto) @Padding.Block(UnitSpace.Four)">
        <table class="@Table.Base @Table.CodeTable" tabindex="0" aria-labelledby="css-classes">
            <thead>
                <tr>
                    <th scope="col">Class</th>
                    <th scope="col">Type</th>
                    <th scope="col">Description</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>br-link</td>
                    <td>Block</td>
                    <td>
                        The root link element. Underlined by default, coloured to inherit its surrounding text, laid
                        out as an inline flex row with a default gap between its children.
                    </td>
                </tr>
                <tr>
                    <td>br-link--columns</td>
                    <td>Modifier</td>
                    <td>Sets the link's flex layout axis to the block (column) direction instead of the default row.</td>
                </tr>
                <tr>
                    <td>
                        br-link--radius-none<br>
                        br-link--radius-one<br>
                        br-link--radius-two<br>
                        br-link--radius-three<br>
                        br-link--radius-four<br>
                        br-link--radius-five<br>
                        br-link--radius-six<br>
                        br-link--radius-seven<br>
                        br-link--radius-eight<br>
                        br-link--radius-nine<br>
                        br-link--radius-full
                    </td>
                    <td>Modifier(s)</td>
                    <td>Sets the link's border radius to a fixed unit value, bypassing the themeable border radius grouping used by default.</td>
                </tr>
            </tbody>
        </table>
    </div>
</section>

<section>
    <h2 class="mobile-centred-heading">CSS variables</h2>
    <p>
        <span class="@CodeSpan.Base">br-link</span> doesn't define its own private variables - its border radius and focus outline read directly
        from the following shared tokens, so a theme change updates every link on the page automatically.
    </p>
    <section>
        <h3 id="link-shared-variables" class="mobile-centred-heading">Shared variables consumed</h3>
        <div class="@Section.Base @Section.NoPadding @Section.OverflowX(UnitScroll.Auto) @Padding.Block(UnitSpace.Four)">
            <table class="@Table.Base @Table.CodeTable" tabindex="0" aria-labelledby="link-shared-variables">
                <thead>
                    <tr>
                        <th scope="col">Variable Name</th>
                        <th scope="col">Description</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>--br-group-button-border-radius</td>
                        <td>The link's default border radius, before any <span class="@CodeSpan.Base">FixedRadius</span> modifier is applied.</td>
                    </tr>
                    <tr>
                        <td>--br-unit-space-3</td>
                        <td>The default gap between the link's children (for example, an icon and its text).</td>
                    </tr>
                    <tr>
                        <td>
                            --br-comp-all-outline-offset<br>
                            --br-comp-all-outline-width<br>
                            --br-comp-all-outline-style<br>
                            --br-comp-all-outline-colour
                        </td>
                        <td>
                            The focus outline shown on <span class="@CodeSpan.Base">:focus-visible</span> and <span class="@CodeSpan.Base">:hover</span>. The outline width is
                            1.5&times; the shared default width, to stand out against the link's own underline.
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>
</section>

<div class="@FlexContent.Base @FlexContent.Wrap(UnitFlexWrap.Wrap) @LayoutAlignment.JustifyContent(UnitJustifyContent.SpaceBetween) @LayoutAlignment.AlignItems(UnitAlignItems.Centre)">

    <a class="@Button.Base @Button.LinkStyle @Gap.SetColGap(UnitGapSize.Four)" href="@($"{GlobalValues.Root_path_CSS_Classes}/{GlobalValues.CSS_Path_Part_LayoutAlignment}/{GlobalValues.Common_Page_Path_Api}")">
        <span class="@SvgIcon.Base @SvgIcon.Size(UnitIconSize.ExtraLarge)" aria-hidden="true" style="--_svg-icon-source:var(--svg-left-arrow-circle-icon)"></span>
        <span>@GlobalValues.CSS_Name_LayoutAlignment - @GlobalValues.Common_Page_Title_Api</span>
    </a>

    <a class="@Button.Base @Button.LinkStyle @Gap.SetColGap(UnitGapSize.Four)" href="@($"{GlobalValues.Root_path_CSS_Classes}/{GlobalValues.CSS_Path_Part_Margin}/{GlobalValues.Common_Page_Path_Api}")">
        <span>@GlobalValues.CSS_Name_Margin - @GlobalValues.Common_Page_Title_Api</span>
        <span class="@SvgIcon.Base @SvgIcon.Size(UnitIconSize.ExtraLarge)" aria-hidden="true" style="--_svg-icon-source:var(--svg-right-arrow-circle-icon)"></span>
    </a>
</div>
