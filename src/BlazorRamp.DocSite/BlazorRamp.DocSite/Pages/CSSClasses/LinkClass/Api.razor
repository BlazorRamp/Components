                <thead>
                    <tr>
                        <th scope="col">Value</th>
                        <th scope="col">Name</th>
                        <th scope="col">Description</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>0</td>
                        <td>None</td>
                        <td>No border radius. Maps to <span class="@CodeSpan.Base">--br-unit-radius-0</span>.</td>
                    </tr>
                    <tr>
                        <td>1</td>
                        <td>One</td>
                        <td>Maps to <span class="@CodeSpan.Base">--br-unit-radius-1</span>.</td>
                    </tr>
                    <tr>
                        <td>2</td>
                        <td>Two</td>
                        <td>Maps to <span class="@CodeSpan.Base">--br-unit-radius-2</span>.</td>
                    </tr>
                    <tr>
                        <td>3</td>
                        <td>Three</td>
                        <td>Maps to <span class="@CodeSpan.Base">--br-unit-radius-3</span>.</td>
                    </tr>
                    <tr>
                        <td>4</td>
                        <td>Four</td>
                        <td>Maps to <span class="@CodeSpan.Base">--br-unit-radius-4</span>.</td>
                    </tr>
                    <tr>
                        <td>5</td>
                        <td>Five</td>
                        <td>Maps to <span class="@CodeSpan.Base">--br-unit-radius-5</span>.</td>
                    </tr>
                    <tr>
                        <td>6</td>
                        <td>Six</td>
                        <td>Maps to <span class="@CodeSpan.Base">--br-unit-radius-6</span>.</td>
                    </tr>
                    <tr>
                        <td>7</td>
                        <td>Seven</td>
                        <td>Maps to <span class="@CodeSpan.Base">--br-unit-radius-7</span>.</td>
                    </tr>
                    <tr>
                        <td>8</td>
                        <td>Eight</td>
                        <td>Maps to <span class="@CodeSpan.Base">--br-unit-radius-8</span>.</td>
                    </tr>
                    <tr>
                        <td>9</td>
                        <td>Nine</td>
                        <td>Maps to <span class="@CodeSpan.Base">--br-unit-radius-9</span>.</td>
                    </tr>
                    <tr>
                        <td>10</td>
                        <td>Full</td>
