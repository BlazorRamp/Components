@using BlazorRamp.DocSite.Pages.GettingStarted
@attribute [Route($"{GlobalValues.Root_path_CSS_Classes}/{GlobalValues.CSS_Path_Part_TextAlign}/{GlobalValues.Common_Page_Path_Api}")]

<PageTitle>@GlobalValues.CSS_Name_TextAlign @GlobalValues.Common_Page_Title_Api_Usage</PageTitle>

<h1>@GlobalValues.CSS_Name_TextAlign @GlobalValues.Common_Page_Title_Api_Usage</h1>

<p>
    Everything you need to work with the <span class="@CodeSpan.Base">br-text-align-*</span> CSS classes: the utility classes provided, the strongly-typed <span class="@CodeSpan.Base">TextAlign</span> C# object
    used to apply them, and the supporting enum used to select an alignment value.
</p>

<h2 class="page-heading">Overview</h2>

<p>
    <span class="@CodeSpan.Base">TextAlign</span> is a <b>utility class</b>, not a BEM component class like <span class="@CodeSpan.Base">Section</span> or <span class="@CodeSpan.Base">Button</span>.
    Rather than describing a block, element, or its variants, it sets a single CSS property - <span class="@CodeSpan.Base">text-align</span> - to a fixed value. Utility classes are flat
    and single-purpose by design, so they can be freely combined with each other and with any other class - including component classes - on the same element.
</p>
<p>
    The <span class="@CodeSpan.Base">Start</span> and <span class="@CodeSpan.Base">End</span> values use CSS logical keywords rather than <span class="@CodeSpan.Base">left</span>/<span class="@CodeSpan.Base">right</span>,
    so alignment adapts automatically to the direction text flows in, without needing separate styling for right-to-left content.
</p>

<section>
    <h2 id="c#-classes" class="page-heading">C# API</h2>
    <p>
        <span class="@CodeSpan.Base">TextAlign</span> provides a utility class that sets an element's CSS <span class="@CodeSpan.Base">text-align</span>.
    </p>
    <section class="code-table">
        <h3 id="text-align-class" class="code-table__heading">TextAlign class</h3>
        <table aria-labelledby="text-align-class">
            <thead>
                <tr>
                    <th scope="col">Return</th>
                    <th scope="col">Static Method</th>
                    <th scope="col">Description</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>string</td>
                    <td>TextAlign.SetAs(UnitTextAlign unitTextAlign)</td>
                    <td>Gets the class that sets an element's CSS <span class="@CodeSpan.Base">text-align</span>.</td>
                </tr>
            </tbody>
        </table>
    </section>
</section>

<section>
    <h2 class="page-heading">Supporting enum</h2>
    <section class="code-table">
        <h3 id="unit-text-align-enum" class="code-table__heading">UnitTextAlign enum</h3>
        <p>
            Sets a CSS <span class="@CodeSpan.Base">text-align</span> value.
        </p>
        <table aria-labelledby="unit-text-align-enum">
            <thead>
                <tr>
                    <th scope="col">Value</th>
                    <th scope="col">Name</th>
                    <th scope="col">Description</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>0</td>
                    <td>Start</td>
                    <td>Aligns text to the start edge of the line box (left in a horizontal, left-to-right writing mode). Adapts automatically for right-to-left content.</td>
                </tr>
                <tr>
                    <td>1</td>
                    <td>Centre</td>
                    <td>Centres text within the line box.</td>
                </tr>
                <tr>
                    <td>2</td>
                    <td>End</td>
                    <td>Aligns text to the end edge of the line box (right in a horizontal, left-to-right writing mode). Adapts automatically for right-to-left content.</td>
                </tr>
                <tr>
                    <td>3</td>
                    <td>Justify</td>
                    <td>Stretches lines so each line (other than the last) has equal width, with text spaced to fill the full width of the line box.</td>
                </tr>
            </tbody>
        </table>
    </section>
</section>

<section class="code-table">
    <h3 id="css-classes" class="code-table__heading">CSS classes</h3>

    <table aria-labelledby="css-classes">
        <thead>
            <tr>
                <th scope="col">Class</th>
                <th scope="col">Type</th>
                <th scope="col">Description</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>br-text-align-start</td>
                <td>Utility</td>
                <td>Sets <span class="@CodeSpan.Base">text-align: start</span>.</td>
            </tr>
            <tr>
                <td>br-text-align-center</td>
                <td>Utility</td>
                <td>Sets <span class="@CodeSpan.Base">text-align: center</span>.</td>
            </tr>
            <tr>
                <td>br-text-align-end</td>
                <td>Utility</td>
                <td>Sets <span class="@CodeSpan.Base">text-align: end</span>.</td>
            </tr>
            <tr>
                <td>br-text-align-justify</td>
                <td>Utility</td>
                <td>Sets <span class="@CodeSpan.Base">text-align: justify</span>.</td>
            </tr>
        </tbody>
    </table>
</section>

<section>
    <h2 class="page-heading">Usage</h2>
    <p>
        The following example just shows text in a box centred horizontally.
    </p>
    
    <CodeBox CodeBlock="@CssClassesSnippets.TextAlign_Code_Example" AriaLabel="TextAlign code example." />

    <div style="width:400px; height:100px;border:1px solid var(--br-comp-all-divider-colour);" class="@TextAlign.SetAs(UnitTextAlign.Centre)">
        Text horizontally centred in a box.
    </div>
</section>

<div class="flex-content justify-content-between">
