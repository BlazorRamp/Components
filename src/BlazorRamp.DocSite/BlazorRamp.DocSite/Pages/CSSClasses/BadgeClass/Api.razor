<section>
    <h2 class="mobile-centred-heading">CSS variables</h2>
    <p>
        The following variables can be overridden to alter the appearance of br-badge. Colour variables are consumed from the shared
        <span class="@CodeSpan.Base">--br-cls-*</span> layer, so a theme change updates every badge on the page automatically -
        you don't need to override anything to stay in sync with your chosen theme.
    </p>

    <section>
        <h3 id="badge-base-variables" class="mobile-centred-heading">Badge base variables</h3>
        <p>Private variables set on the element itself before any modifier is applied.</p>
        <div class="@Section.Base @Section.NoPadding @Section.OverflowX(UnitScroll.Auto) @Padding.Block(UnitSpace.Four)">
            <table class="@Table.Base @Table.CodeTable" tabindex="0" aria-labelledby="badge-base-variables">
                <thead>
                    <tr>
                        <th scope="col">Variable Name</th>
                        <th scope="col">Default Value</th>
                        <th scope="col">Description</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>--_badge-border-colour</td>
                        <td>var(--br-comp-all-button-border-colour)</td>
                        <td>The badge's border colour before any scheme modifier is applied.</td>
                    </tr>
                    <tr>
                        <td>--_badge-background</td>
                        <td>transparent</td>
                        <td>The badge's background colour before any scheme modifier is applied.</td>
                    </tr>
                    <tr>
                        <td>--_badge-text</td>
                        <td>var(--br-comp-all-button-text)</td>
