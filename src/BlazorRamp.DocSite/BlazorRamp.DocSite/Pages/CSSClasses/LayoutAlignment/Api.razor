@using BlazorRamp.DocSite.Pages.GettingStarted
@attribute [Route($"{GlobalValues.Root_path_CSS_Classes}/{GlobalValues.CSS_Path_Part_LayoutAlignment}/{GlobalValues.Common_Page_Path_Api}")]

<PageTitle>@GlobalValues.CSS_Name_LayoutAlignment @GlobalValues.Common_Page_Title_Api_Usage</PageTitle>

<h1>@GlobalValues.CSS_Name_LayoutAlignment @GlobalValues.Common_Page_Title_Api_Usage</h1>

<p>
    Everything you need to work with the <span class="@CodeSpan.Base">br-justify-*</span> and <span class="@CodeSpan.Base">br-align-*</span> CSS classes: the utility classes provided, the strongly-typed <span class="@CodeSpan.Base">LayoutAlignment</span> C# object
    used to apply them, and the supporting enums used to select an alignment value.
</p>

<h2 class="mobile-centred-heading">Overview</h2>

<p>
    <span class="@CodeSpan.Base">LayoutAlignment</span> is a <b>utility class</b>, not a BEM component class like <span class="@CodeSpan.Base">GridRow</span> or <span class="@CodeSpan.Base">FlexContent</span>.
    Rather than describing a block, element, or its variants, each method sets a single CSS alignment property to a fixed value. Utility classes are flat
    and single-purpose by design, so they can be freely combined with each other and with any other class - including component classes - on the same element.
</p>
<p>
    These classes aren't tied to either layout mode - the underlying CSS properties (<span class="@CodeSpan.Base">justify-content</span>, <span class="@CodeSpan.Base">align-content</span>,
    <span class="@CodeSpan.Base">justify-items</span>, <span class="@CodeSpan.Base">align-items</span>, <span class="@CodeSpan.Base">justify-self</span>, <span class="@CodeSpan.Base">align-self</span>) behave the same way whether applied
    within a <span class="@CodeSpan.Base">br-flex-content</span> container or a <span class="@CodeSpan.Base">br-grid-row</span> container, so <span class="@CodeSpan.Base">LayoutAlignment</span> is shared between both rather than
    duplicated per layout mode.
</p>
<p>
    <span class="@CodeSpan.Base">JustifyItems</span> and <span class="@CodeSpan.Base">JustifySelf</span> only take effect within a grid container - flex containers don't support
    <span class="@CodeSpan.Base">justify-items</span>/<span class="@CodeSpan.Base">justify-self</span> at all, since a flex item's alignment along the main axis is instead
    controlled by <span class="@CodeSpan.Base">justify-content</span> on the container.
</p>

<section>
    <h2 id="c#-classes" class="mobile-centred-heading">C# API</h2>
    <p>
        <span class="@CodeSpan.Base">LayoutAlignment</span> provides utility classes that set an element's alignment along the
        justify and align axes, for use within a flex or grid container.
    </p>
    <section>
        <h3 id="layout-alignment-class" class="mobile-centred-heading">LayoutAlignment class</h3>
        <div class="@Section.Base @Section.NoPadding @Section.OverflowX(UnitScroll.Auto) @Padding.Block(UnitSpace.Four)">
            <table class="@Table.Base @Table.CodeTable" tabindex="0" aria-labelledby="layout-alignment-class">
                <thead>
                    <tr>
                        <th scope="col">Return</th>
                        <th scope="col">Static Method</th>
                        <th scope="col">Description</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>string</td>
                        <td>LayoutAlignment.JustifyContent(UnitJustifyContent unitJustifyContent)</td>
                        <td>Gets the class that sets how a container distributes extra space along its main axis between and around content lines.</td>
                    </tr>
                    <tr>
                        <td>string</td>
                        <td>LayoutAlignment.AlignContent(UnitAlignContent unitAlignContent)</td>
                        <td>Gets the class that sets how a container distributes extra space along its cross axis between and around content lines.</td>
                    </tr>
                    <tr>
                        <td>string</td>
                        <td>LayoutAlignment.JustifyItems(UnitJustifyItems unitJustifyItems)</td>
                        <td>Gets the class that sets how a container aligns its items within their cells along the inline axis, as a group. Grid only.</td>
                    </tr>
                    <tr>
                        <td>string</td>
                        <td>LayoutAlignment.AlignItems(UnitAlignItems unitAlignItems)</td>
                        <td>Gets the class that sets how a container aligns its items along the cross axis, as a group.</td>
                    </tr>
                    <tr>
                        <td>string</td>
                        <td>LayoutAlignment.JustifySelf(UnitJustifySelf unitJustifySelf)</td>
                        <td>Gets the class that sets how a single item aligns itself within its cell along the inline axis, overriding the container's <span class="@CodeSpan.Base">JustifyItems</span> value. Grid only.</td>
                    </tr>
                    <tr>
                        <td>string</td>
                        <td>LayoutAlignment.AlignSelf(UnitAlignSelf unitAlignSelf)</td>
                        <td>Gets the class that sets how a single item aligns itself along the cross axis, overriding the container's <span class="@CodeSpan.Base">AlignItems</span> value.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>
</section>

<section>
    <h2 class="mobile-centred-heading">Supporting enums</h2>
    <section>
        <h3 id="unit-justify-content-enum" class="mobile-centred-heading">UnitJustifyContent enum</h3>
        <p>
            Sets how a flex or grid container distributes extra space along its main axis between and around content lines.
        </p>
        <div class="@Section.Base @Section.NoPadding @Section.OverflowX(UnitScroll.Auto) @Padding.Block(UnitSpace.Four)">
            <table class="@Table.Base @Table.CodeTable" tabindex="0" aria-labelledby="unit-justify-content-enum">
                <thead>
                    <tr>
                        <th scope="col">Value</th>
                        <th scope="col">Name</th>
                        <th scope="col">Description</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>0</td>
                        <td>Start</td>
                        <td>Packs lines toward the start of the container.</td>
                    </tr>
                    <tr>
                        <td>1</td>
                        <td>Centre</td>
                        <td>Packs lines toward the centre of the container.</td>
                    </tr>
                    <tr>
                        <td>2</td>
                        <td>End</td>
                        <td>Packs lines toward the end of the container.</td>
                    </tr>
                    <tr>
                        <td>3</td>
                        <td>Stretch</td>
                        <td>Stretches lines to fill the container's main axis.</td>
                    </tr>
                    <tr>
                        <td>4</td>
                        <td>SpaceBetween</td>
                        <td>Distributes lines evenly, with the first line flush to the start and the last flush to the end.</td>
                    </tr>
                    <tr>
                        <td>5</td>
                        <td>SpaceAround</td>
                        <td>Distributes lines evenly, with equal space around each line.</td>
                    </tr>
                    <tr>
                        <td>6</td>
                        <td>SpaceEvenly</td>
                        <td>Distributes lines evenly, with equal space between and around each line.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>

