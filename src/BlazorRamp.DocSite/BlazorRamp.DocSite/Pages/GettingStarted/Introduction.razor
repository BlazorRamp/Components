 @attribute [Route($"{GlobalValues.Root_Path}")]


<PageTitle>Blazor Ramp - Accessible Blazor components</PageTitle>

<div class="landing">
    <section class="landing__hero" aria-labelledby="hero-heading">
        <GoTo LabelText="Intro page heading" />
        <h1 id="hero-heading">Accessible Blazor components, built to WCAG from the start</h1>
       
        <p class="landing__lead">
            Designed for keyboard and screen reader users first, with a live region service at its core and announcements you can review.
        </p>
        <div class="landing__actions">

            <a class="@Button.Base @Button.Size(ButtonSize.ExtraLarge) 
                      @Font.Size(UnitFontSize.Two)
                      @Font.Weight(UnitFontWeight.Medium)"
               href="/installation" style="text-decoration:none;">
                <span class="@SvgIcon.Base" style="--_svg-icon-source:var(--svg-api-icon);" aria-hidden="true"></span>
               <span>Read the docs</span></a>
            <a class="@Button.Base @Button.Size(ButtonSize.ExtraLarge) @Button.Scheme(ButtonSolidScheme.PrimaryDarker)
                        @Font.Size(UnitFontSize.Two)
                        @Font.Weight(UnitFontWeight.Medium)"
               href="/accessibility" style="text-decoration:none;">
               <span class="@SvgIcon.Base" style="--_svg-icon-source:var(--svg-accessibility-icon);" aria-hidden="true"></span> 
               <span>Accessibility</span>
           </a>
        </div>
        <div class="landing__support">
            <ul aria-label="Supported .NET versions">
                <li><span class="@Badge.Base @Badge.Scheme(BadgeSolidScheme.Accent) @Badge.Size(BadgeSize.Medium) @Font.Weight(UnitFontWeight.SemiBold)">.NET 8</span></li>
                <li><span class="@Badge.Base @Badge.Scheme(BadgeSolidScheme.Accent) @Badge.Size(BadgeSize.Medium) @Font.Weight(UnitFontWeight.SemiBold)">.NET 9</span></li>
                <li><span class="@Badge.Base @Badge.Scheme(BadgeSolidScheme.Accent) @Badge.Size(BadgeSize.Medium) @Font.Weight(UnitFontWeight.SemiBold)">.NET 10</span></li>
            </ul>
        </div>
    </section>
    <section class="landing__section" aria-labelledby="features-heading">
        <h2 id="features-heading">Why Blazor Ramp</h2>
        <ul class="landing__cards">
            <li>
                <h3>Tested by hand, on real assistive technology</h3>
                <p>
                    Every component is built with a screen reader running, then manually checked before release
                    with JAWS, NVDA, Narrator, VoiceOver and TalkBack, plus keyboard-only and voice control.
                    Automated scanners alone miss too much.
                </p>
            </li>
            <li>
                <h3>Built from scratch</h3>
                <p>
                    Blazor Ramp uses no third-party CSS or JavaScript libraries, and doesn't import code from
                    component libraries like Shadcn. Every line, from markup and styles, and behaviour, is written
                    from scratch, by hand, specifically for this project.
                </p>
            </li>
            <li>
                <h3>Take only what you need</h3>
                <p>
                    Each component ships as its own NuGet package, so you only install what you use. Every
                    package builds on the same shared Core and design tokens, giving you consistent behaviour,
                    live region announcements and theming throughout.
                </p>
            </li>
            <li>
                <h3>Who it's for</h3>
                <p>
                    Any team building an interactive Blazor site or app that must work for keyboard, screen
                    reader and voice control users, whether for legal reasons (WCAG, Section 508, EN 301 549)
                    or simply to do right by people who rely on assistive technology.
                </p>
            </li>
        </ul>
    </section>
    <section class="landing__section" aria-labelledby="demo-heading">
        <h2 id="demo-heading">See it working - live examples</h2>
        <p>
            <span class="@Badge.Base @Badge.Scheme(BadgeSolidScheme.Info) @Badge.Size(BadgeSize.Small)">GoTo v1.0.0</span> (new) - just use the shortcut <kbd class="@Kbd.Base">Alt+Z</kbd> (Option+Z on macOS) on any page to view 
            <b>GoTo</b> markers that may be present to help keyboard-only users better traverse busy pages.
        </p>
        <section class="@Section.Base @Section.Bordered @Section.Radius(SectionRadius.Content) @Section.Background(SectionBackground.Transparent)" style="margin-top:var(--br-unit-space-7);">
            <Disclosure SvgIcon="--svg-disclosure-icon" ContentMaxHeight="20vh" TriggerText="Disclosure component" @bind-Expanded="@_expanded" style="margin-block-end:2rem;">
                <div class="@FlexContent.Base @LayoutAlignment.AlignItems(UnitAlignItems.Centre) @LayoutAlignment.JustifyContent(UnitJustifyContent.SpaceBetween) @FlexContent.Wrap(UnitFlexWrap.Wrap)">
                    <span>
                        Overview
                    </span>
                    <div class="@FlexContent.Base @Gap.SetGaps(UnitGapSize.Four) @Padding.Block(UnitSpace.Three) @FlexContent.Wrap(UnitFlexWrap.NoWrap)">
                        <Tooltip TooltipText="View the Accessibility Information." TooltipID="edit-tooltip" TooltipPosition="TooltipPosition.TopRight" InvertColours="true">
                            <a aria-label="Accessibility Information" class="@Button.Base @Button.Scheme(ButtonSolidScheme.Inverted)  @Button.Squared @BoxShadow.SetShadow(UnitBoxShadow.Two)"
                               href="@($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_Disclosure}/{GlobalValues.Common_Page_Path_Accessibility}")">
                                <span class="@SvgIcon.Base" style="--_svg-icon-source:var(--svg-accessibility-icon);"></span>
                            </a>
                        </Tooltip>
                        <Tooltip TooltipText="View the Disclosure API." TooltipID="view-tooltip" TooltipPosition="TooltipPosition.TopRight" InvertColours="false">
                            <a aria-label="Disclosure API" class="@Button.Base @Button.Scheme(ButtonSolidScheme.NeutralLighter) @Button.Squared @BoxShadow.SetShadow(UnitBoxShadow.Two)"
                               href="@($"{GlobalValues.Root_path_Components}/{GlobalValues.Component_Path_Part_Disclosure}/{GlobalValues.Common_Page_Path_Api}")">
                                <span class="@SvgIcon.Base" style="--_svg-icon-source:var(--svg-disclosure-icon);"></span>
                            </a>
                        </Tooltip>
                    </div>
                </div>

                <p>
                    The Disclosure component provides an accessible way to show and hide a single region of content. It's made up of a button, the trigger, and the content that the button
                    controls. Activating the trigger with a mouse, touch, or the <kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">Enter</kbd> or <kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">Space</kbd>
                    keys toggles the content, while the trigger's <span class="@CodeSpan.Base">aria-expanded</span> attribute tells assistive technologies whether the content is currently shown
                    and <span class="@CodeSpan.Base">aria-controls</span> associates the trigger with the content it controls.
                    This is the disclosure pattern described in the WAI-ARIA Authoring Practices Guide.
                </p>
            </Disclosure>
            <p>

                Lose the mouse and just use your keyboard to navigate. Or fire up a screen reader - table keys for:  
            <ToggleTip CloseText="Close Keyboard Info." Label="NVDA:" ShowClose="true" ShowLabel="true" ToggleTipLabelOrder="ToggleTipLabelOrder.LabelFirst" ToggleTipSize="ToggleTipSize.Medium">
                <h3>NVDA table keys</h3>
                    <ul>
                        <li><kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">T</kbd> or <kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">Shift</kbd> + <kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">T</kbd> - move to the next or previous table.</li>
                        <li><kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">Ctrl</kbd> + <kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">Alt</kbd> + <kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">Arrow keys</kbd> - move between cells: up and down for rows, left and right for columns.</li>
                        <li><kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">Ctrl</kbd> + <kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">Alt</kbd> + <kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">Home</kbd> or <kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">End</kbd> - jump to the first or last column in the row.</li>
                        <li><kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">NVDA</kbd> + <kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">Ctrl</kbd> + <kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">Alt</kbd> + <kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">Arrow keys</kbd> - read the current row or column aloud.</li>
                        <li><kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">Enter</kbd> or <kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">Space</kbd> - activate a column header sort button.</li>
                    </ul>
            </ToggleTip>
            <ToggleTip CloseText="Close" Label="JAWS:" ShowClose="true" ShowLabel="true" ToggleTipLabelOrder="ToggleTipLabelOrder.LabelFirst" ToggleTipSize="ToggleTipSize.Medium">
                   <h3>JAWS table keys</h3>
                    <ul>
                        <li><kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">T</kbd> or <kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">Shift</kbd> + <kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">T</kbd> - move to the next or previous table.</li>
                        <li><kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">Ctrl</kbd> + <kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">Alt</kbd> + <kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">Arrow keys</kbd> - move between cells: up and down for rows, left and right for columns.</li>
                        <li><kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">Ctrl</kbd> + <kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">Alt</kbd> + <kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">Numpad 5</kbd> - read the current cell with its row and column headers.</li>
                        <li><kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">Insert</kbd> + <kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">Shift</kbd> + <kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">Up Arrow</kbd> - read the current row aloud.</li>
                        <li><kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">Enter</kbd> or <kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">Space</kbd> - activate a column header sort button.</li>
                    </ul>
            </ToggleTip>
                <ToggleTip CloseText="Close" Label="Narrator:" ShowClose="true" ShowLabel="true" ToggleTipLabelOrder="ToggleTipLabelOrder.LabelFirst" ToggleTipSize="ToggleTipSize.Medium">
                 <h3>Narrator table keys</h3>
                    <ul>
                        <li><kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">T</kbd> or <kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">Shift</kbd> + <kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">T</kbd> - move to the next or previous table (scan mode).</li>
                        <li><kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">Ctrl</kbd> + <kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">Alt</kbd> + <kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">Arrow keys</kbd> - move between cells: up and down for rows, left and right for columns.</li>
                        <li><kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">Ctrl</kbd> + <kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">Shift</kbd> + <kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">Alt</kbd> + <kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">/</kbd> - announce your location in the table.</li>
                        <li><kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">Ctrl</kbd> + <kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">Shift</kbd> + <kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">Alt</kbd> + <kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">Arrow keys</kbd> - read the row or column headers, or the current row or column.</li>
                        <li><kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">Enter</kbd> or <kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">Space</kbd> - activate a column header sort button.</li>
                    </ul>
            </ToggleTip>
                <ToggleTip CloseText="Close" Label="VoiceOver:" ShowClose="true" ShowLabel="true" ToggleTipLabelOrder="ToggleTipLabelOrder.LabelFirst" ToggleTipSize="ToggleTipSize.Medium">
                <h3>VoiceOver table keys</h3>
                    <p>The <kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">VO</kbd> key is <kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">Control</kbd> + <kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">Option</kbd>, or <kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">Caps Lock</kbd>.</p>
                    <ul>
                        <li><kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">VO</kbd> + <kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">Command</kbd> + <kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">T</kbd> - move to the next table.</li>
                        <li><kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">VO</kbd> + <kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">Arrow keys</kbd> - move between cells: up and down for rows, left and right for columns.</li>
                        <li><kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">VO</kbd> + <kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">Home</kbd> or <kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">End</kbd> - jump to the first or last cell in the table.</li>
                        <li><kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">VO</kbd> + <kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">Shift</kbd> + <kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">Down Arrow</kbd> or <kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">Up Arrow</kbd> - start or stop interacting with a table, if table grouping is off.</li>
                        <li><kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">VO</kbd> + <kbd class="@Kbd.Base @Kbd.Scheme(KbdScheme.Neutral)">Space</kbd> - activate a column header sort button.</li>
                    </ul>
            </ToggleTip>
            </p>

            <GoTo LabelText="Intro page example contact results table" />

            <DataTable TData="Contact" DataSource="@_dataSource" Title="Contact Results" PagerBinding="@_pagerBinding" FilterRule="_filterRule"
                       FilterAlignment="FilterAlignment.Start" TitleAlignment="TitleAlignment.Start">
                <Filter>
                    <DebounceFilter HintText="Filters the table below across all columns" RegexPattern="^[A-Za-z0-9 ]*$" OnDebounceFilterResult="HandleOnDebounce"
                                    ValidationMessage="Invalid filter, filtering paused, letters, numbers and spaces only" />
                </Filter>
                <TableColumns>
                    <DataColumn DataProperty="c => c.ContactID" DisplayName="ID" IsSortable="true" />
                    <DataColumn DataProperty="c => c.GivenName" DisplayName="First Name" IsSortable="true" />
                    <DataColumn DataProperty="c => c.FamilyName" DisplayName="Surname" IsSortable="true" />
                    <DataColumn DataProperty="c => c.Country" DisplayName="Country" IsSortable="true" />
                    <DataColumn DataProperty="c => c.Rate" DisplayName="Hourly Rate" IsSortable="true" CellFormat="C" ColumnAlignment="ColumnAlignment.End" />
                </TableColumns>
                <BottomPager>
                    <Pager @bind-CurrentPage="@_pagerBinding.CurrentPage" AriaLabel="Contacts pager" TotalItemCount="@_pagerBinding.TotalItemCount" CurrentItemCount="@_pagerBinding.CurrentItemCount"
                           ItemsPerPage="@_pagerBinding.ItemsPerPage" PagerSelectorType="PagerSelectorType.Button" ShowFirstLast="true" PageAlignment="PageAlignment.End" />
                </BottomPager>
            </DataTable>


        </section>
    </section>
