
<CascadingValue TValue="ThemeBorderTool" IsFixed="true" Value="this">
    <section class="@GlobalValues.Theme_Border_Tool_Class" @attributes="AdditionalAttributes">
        
        @GetHeadingFragment(ThemeToolHeadingLevel, _titleText, GlobalValues.Theme_Border_Tool_Title_Class)

        @if (BorderGroups is not null)
        {
            @BorderGroups
        }
        <div class="@GlobalValues.Theme_Border_Tool_Buttons_Class">
            <button type="button" class="@Button.Base" @onclick="HandleReset">@_resetText</button>
        </div>

    </section>

</CascadingValue>

@code {

    [Parameter] public RenderFragment?       BorderGroups          { get; set; }
    [Parameter] public string                Title                 { get; set; }
    [Parameter] public string                ResetText             { get; set; } = "Reset border groups";
    [Parameter] public ThemeToolHeadingLevel ThemeToolHeadingLevel { get; set; } = ThemeToolHeadingLevel.H2;

    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private List<BorderGroup> _borderGroups = [];

    private string _titleText = "Theme border controls";
    private string _resetText = "Reset border groups";

    protected override void OnParametersSet()
    {
        _titleText = String.IsNullOrWhiteSpace(Title) ? "Theme border controls" : Title.Trim();
        _resetText = String.IsNullOrWhiteSpace(ResetText) ? "Reset border groups" : ResetText.Trim();
    }

    internal void AddBorderGroup(BorderGroup borderGroup)
    {
        if (false == _borderGroups.Contains(borderGroup)) _borderGroups.Add(borderGroup);
    }

    internal void RemoveBorderGroup(BorderGroup borderGroup)

        => _borderGroups.Remove(borderGroup);

    private async Task HandleReset()

        => await Reset();    

    internal async Task Reset()
    {
        foreach (var borderGroup in _borderGroups) await borderGroup.Reset();
    }

    internal int CurrentHeadingLevelIndex()

        => (int)ThemeToolHeadingLevel;

    internal async Task<List<CssProperty>> GetLiveBorderProperties()
    {
        List<CssProperty> cssProperties = [];

        foreach (var group in _borderGroups) cssProperties.AddRange(await group.GetLiveCssProperties());

        return cssProperties;
    }

    internal List<CssProperty> GetStoredBorderProperties()
    {
        List<CssProperty> cssProperties = [];

        foreach (var borderGroup in _borderGroups) cssProperties.AddRange(borderGroup.GetStoredBorderProperties());

        return cssProperties;
    }

    private async Task HandleGetProperties()
    {
        var cssProperties = await GetLiveBorderProperties();
    }

    private RenderFragment GetHeadingFragment(ThemeToolHeadingLevel level, string title, string? className = null)

        => level switch
        {
        ThemeToolHeadingLevel.H2 => @<h2 class="@className">@title</h2>,
                    ThemeToolHeadingLevel.H3 => @<h3 class="@className">@title</h3>,
                    ThemeToolHeadingLevel.H4 => @<h4 class="@className">@title</h4>,
                    ThemeToolHeadingLevel.H5 => @<h5 class="@className">@title</h5>,
                    ThemeToolHeadingLevel.H6 => @<h6 class="@className">@title</h6>,
                    _ => @<h3 class="@className">@title</h3>
                };
}
