@implements IAsyncDisposable

<section class="@GlobalValues.Theme_Colour_Tool_Class">
    @{
        GetHeading(ThemeToolHeadingLevel,Title);
    }
    <div class="@GlobalValues.Theme_Colour_Tool_Content_Class">
        <div class="@GlobalValues.Theme_Colour_Tool_Controls_Class">
            <label for="colour-picker">Choose your primary:</label>
            <input id="colour-picker" type="color" value="@_primaryColourValue" @oninput="HandleOnInput" @onchange="HandleOnChange" />
        </div>

        <div class="@GlobalValues.Theme_Colour_Tool_Controls_Class">
            <label for="neutral-slider">Adjust neutral tinge:</label>
            <input id="neutral-slider" type="range" min="0" max="15" value="@_neutralSaturationValue" @oninput="HandleSaturation" @onchange="HandleOnChange" />
        </div>
        <div class="@GlobalValues.Theme_Colour_Tool_Controls_Class">
            <span class="@GlobalValues.Theme_Colour_Tool_Label_Class">Neutral tinge value:</span>
            <span class="@GlobalValues.Theme_Colour_Tool_Output_Class">@_neutralSaturationValue</span>
        </div>
        <div class="@GlobalValues.Theme_Colour_Tool_Controls_Class">
            <button class="test-button" @onclick="ResetColourValues">
                Reset
            </button>
        </div>
        <div class="@GlobalValues.Theme_Colour_Tool_Controls_Class">
            <span class="@GlobalValues.Theme_Colour_Tool_Label_Class">To see the default library colours use:</span>
            <div class="@GlobalValues.Theme_Colour_Tool_Swatch_Class">
                <span>H: 220 S:44% L: 48% - with the neutral tinge set to 10</span>
            </div>
        </div>
    </div>
</section>

@{
    void GetHeading(ThemeToolHeadingLevel headingLevel, string title)
    {
        @switch (headingLevel)
        {
            case ThemeToolHeadingLevel.H2: <h2 class="@GlobalValues.Theme_Colour_Tool_Title_Class">@title</h2>; break;
            case ThemeToolHeadingLevel.H3: <h3 class="@GlobalValues.Theme_Colour_Tool_Title_Class">@title</h3>; break;
            case ThemeToolHeadingLevel.H4: <h4 class="@GlobalValues.Theme_Colour_Tool_Title_Class">@title</h4>; break;
            case ThemeToolHeadingLevel.H5: <h5 class="@GlobalValues.Theme_Colour_Tool_Title_Class">@title</h5>; break;
            case ThemeToolHeadingLevel.H6: <h6 class="@GlobalValues.Theme_Colour_Tool_Title_Class">@title</h6>; break;
            default:
                <h3 class="@GlobalValues.Theme_Colour_Tool_Title_Class">@title</h3>
                break;
        }

    }
}
@code {

    [Parameter] public string Title { get; set; } = "Theme controls";
    [Parameter] public ThemeToolHeadingLevel ThemeToolHeadingLevel { get; set; } = ThemeToolHeadingLevel.H2;

    [Parameter] public EventCallback OnColourChanged { get; set; }

    [Inject] ILiveRegionService LiveRegionService { get; set; } = default!;
    [Inject] IJSRuntime JSRuntime { get; set; } = default!;

    private IJSObjectReference? _jsModule = null;

    private string _primaryColourValue = "#008C8C";
    private string _rootPrimaryVar = "--br-unit-colour-primary";
    private string _neutralSaturationVar = "--br-unit-colour-neutral-saturation";
    private string _neutralSaturationValue = "10";

    private async Task HandleSaturation(ChangeEventArgs args)
    {
        _neutralSaturationValue = args.Value.ToString();
        if (_jsModule is not null) await _jsModule.InvokeVoidAsync(GlobalValues.JS_Theme_Set_Style_Property_Func, _neutralSaturationVar, _neutralSaturationValue);
    }

    private async Task HandleOnInput(ChangeEventArgs args)
    {
        _primaryColourValue = args.Value.ToString();

        if (_jsModule is not null) await _jsModule.InvokeVoidAsync(GlobalValues.JS_Theme_Set_Style_Property_Func, _rootPrimaryVar, _primaryColourValue);


    }

    private async Task HandleOnChange()
    {
        if (OnColourChanged.HasDelegate) await OnColourChanged.InvokeAsync();
    }

    private async Task ResetColourValues()
    {
        if (_jsModule is not null)
        {
            _primaryColourValue = await _jsModule.InvokeAsync<string>(GlobalValues.JS_Theme_Get_Comp_Style_Property_Func, CoreCssVariables.Original_Primary_Value_Store_Name);
            _neutralSaturationValue = await _jsModule.InvokeAsync<string>(GlobalValues.JS_Theme_Get_Comp_Style_Property_Func, CoreCssVariables.Original_Saturation_Value_Store_Name);

            // await _jsModule.InvokeVoidAsync(GlobalValues.JS_Theme_Set_Root_Variable_Func, _neutralSaturationVar, _neutralSaturationValue);
            // await _jsModule.InvokeVoidAsync(GlobalValues.JS_Theme_Set_Root_Variable_Func, _rootPrimaryVar, _primaryColourValue);

            await _jsModule.InvokeVoidAsync(GlobalValues.JS_Theme_Remove_Style_Property_Func, _rootPrimaryVar);
            await _jsModule.InvokeVoidAsync(GlobalValues.JS_Theme_Remove_Style_Property_Func, _neutralSaturationVar);

            await LiveRegionService.MakeAnnouncement(new("Site colours have been reset to the default values", AnnouncementTrigger: "Colour reset button"), true);

        }

        await HandleOnChange();
    }

    protected override async Task OnInitializedAsync()
    {
        _jsModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", GlobalValues.JS_Doc_Theme_Module_File_Path);

        if (_jsModule is null) return;

        _primaryColourValue = await _jsModule.InvokeAsync<string>(GlobalValues.JS_Theme_Get_Comp_Style_Property_Func, _rootPrimaryVar);
        _neutralSaturationValue = await _jsModule.InvokeAsync<string>(GlobalValues.JS_Theme_Get_Comp_Style_Property_Func, _neutralSaturationVar);


    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_jsModule is not null) await _jsModule.DisposeAsync();
        }
        catch { }
    }
}
