<section class="@GlobalValues.Theme_Colour_Tool_Class">
    @{
        GetHeadingFragment(ThemeToolHeadingLevel, _titleText, @GlobalValues.Theme_Colour_Tool_Title_Class);
    }
    <div class="@GlobalValues.Theme_Colour_Tool_Content_Class">
        <div class="@GlobalValues.Theme_Colour_Tool_Controls_Class">
            <label for="colour-picker" class="@GlobalValues.Theme_Colour_Tool_Label_Class">Choose your primary:</label>
            <input id="colour-picker" type="color" value="@_primaryColourValue" @oninput="HandleOnInput" @onchange="HandleOnChange" />
        </div>

        <div class="@GlobalValues.Theme_Colour_Tool_Controls_Class">
            <label for="neutral-slider" class="@GlobalValues.Theme_Colour_Tool_Label_Class">Adjust neutral tinge:</label>
            <input id="neutral-slider" type="range" min="0" max="15" value="@_neutralSaturationValue" @oninput="HandleSaturation" @onchange="HandleOnChange" />
        </div>
        <div class="@GlobalValues.Theme_Colour_Tool_Controls_Class">
            <span class="@GlobalValues.Theme_Colour_Tool_Label_Class">Neutral tinge value:</span>
            <span class="@GlobalValues.Theme_Colour_Tool_Output_Class">@_neutralSaturationValue</span>
        </div>
        <div class="@GlobalValues.Theme_Colour_Tool_Controls_Class">
            <button type="button" class="@Button.Base @GlobalValues.Theme_Colour_Tool_Button_Class" @onclick="ResetColourValues">
                Reset colours
            </button>
        </div>
        <div class="@GlobalValues.Theme_Colour_Tool_Controls_Class">
            <span class="@GlobalValues.Theme_Colour_Tool_Label_Class">To see the default library colours use:</span>
            <div class="@GlobalValues.Theme_Colour_Tool_Swatch_Class">
                <span>H: 220 S:44% L: 48% - with the neutral tinge set to 10</span>
            </div>
        </div>
    </div>
</section>


@code {

    [Parameter] public string                Title                 { get; set; } = "Theme colour tool";
    [Parameter] public ThemeToolHeadingLevel ThemeToolHeadingLevel { get; set; } = ThemeToolHeadingLevel.H2;

    [Parameter] public EventCallback OnColourChanged { get; set; }

    [Inject] private ThemeService       ThemeService      { get; set; } = default!;
    [Inject] private ILiveRegionService LiveRegionService { get; set; } = default!;

    private List<CssProperty> _cssProperties = [];

    private string _primaryColourValue      = CoreCssVariables.Colour_Primary_Current_Site_Value;
    private string _rootPrimaryVar          = CoreCssVariables.Colour_Primary;
    private string _neutralSaturationVar    = CoreCssVariables.Colour_Neutral_Saturation;
    private string _neutralSaturationValue  = CoreCssVariables.Colour_Neutral_Saturation_Original_Value;

    private string _titleText = "Theme colour tool";

    protected override void OnParametersSet()
    {
        _titleText = String.IsNullOrWhiteSpace(Title) ? "Theme colour tool" : Title.Trim();
    }

    private async Task HandleSaturation(ChangeEventArgs args)
    {

        _neutralSaturationValue = args.Value.ToString();

        await ThemeService.SetPropertyValue(_neutralSaturationVar, _neutralSaturationValue!);
    }

    private async Task HandleOnInput(ChangeEventArgs args)
    {
        _primaryColourValue = args.Value.ToString();

        await ThemeService.SetPropertyValue(_rootPrimaryVar, _primaryColourValue!);

    }

    private async Task HandleOnChange()
    {
        if (OnColourChanged.HasDelegate) await OnColourChanged.InvokeAsync();
    }

    private async Task ResetColourValues()
    {
        _neutralSaturationValue = CoreCssVariables.Colour_Neutral_Saturation_Original_Value;

        await ThemeService.RemovePropertyValue(_rootPrimaryVar);
        await ThemeService.RemovePropertyValue(_neutralSaturationVar);

        _neutralSaturationValue = await ThemeService.GetPropertyValue(_neutralSaturationVar);
        _primaryColourValue     = await ThemeService.GetPropertyValue(_rootPrimaryVar);

        await LiveRegionService.MakeAnnouncement(new("Site colours have been reset to the default values", AnnouncementTrigger: "Colour reset button"), true);

        await HandleOnChange();
    }

    internal List<CssProperty> GetStoredProperties()

        => [new(_rootPrimaryVar, _primaryColourValue), new(_neutralSaturationVar, _neutralSaturationValue)];    


    protected override async Task OnInitializedAsync()
    {
        _primaryColourValue = await ThemeService.GetPropertyValue(_rootPrimaryVar);
        _neutralSaturationValue = await ThemeService.GetPropertyValue(_neutralSaturationVar);
    }

    private static RenderFragment GetHeadingFragment(ThemeToolHeadingLevel level, string title, string? className = null)

        => level switch
        {
            ThemeToolHeadingLevel.H2 => @<h2 class="@className">@title</h2>,
            ThemeToolHeadingLevel.H3 => @<h3 class="@className">@title</h3>,
            ThemeToolHeadingLevel.H4 => @<h4 class="@className">@title</h4>,
            ThemeToolHeadingLevel.H5 => @<h5 class="@className">@title</h5>,
            ThemeToolHeadingLevel.H6 => @<h6 class="@className">@title</h6>,
            _ => @<h3 class="@className">@title</h3>
        };


}
