
<div class="@Section.Base @Section.Bordered @Section.CodeFont @Section.Text(SectionText.AccentDark) 
            @Section.FontSize(SectionFontSize.Label) @Section.Radius(SectionRadius.Content) @Section.Background(SectionBackground.AccentLighter)" 
     tabindex="0" role="region" aria-label="@_ariaLabel">
    <pre>
        <code>
            @CodeBlock        
        </code>
    </pre>
</div>

@code {

    [Parameter] public string? CodeBlock { get; set; }
    [Parameter] public string AriaLabel { get; set; } = "Code block";

    private MarkupString _codeBlock;
    private string _ariaLabel = "Code block";

    protected override void OnParametersSet()
    {
        _codeBlock = (MarkupString)System.Net.WebUtility.HtmlEncode(CodeBlock ?? "");
        _ariaLabel = String.IsNullOrWhiteSpace(AriaLabel) ? _ariaLabel : AriaLabel.Trim();
    }
}
