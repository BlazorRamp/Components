<div class="code-box" tabindex="0">
    <pre>
        <code>
            @CodeBlock        
        </code>
    </pre>
</div>

@code {

    [Parameter] public string? CodeBlock { get; set; }

    private MarkupString _codeBlock;

    protected override void OnParametersSet()
    
        => _codeBlock = (MarkupString)System.Net.WebUtility.HtmlEncode(CodeBlock ?? "");
    
}
