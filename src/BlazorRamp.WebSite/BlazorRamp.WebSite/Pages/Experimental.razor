@code {
    private EditContext _editContextOne = default!;
    private EditContext _editContextTwo = default!;
    private EditContext _editContextThree = default!;
    private EditContext _editContextFour = default!;

    private Contact     _contactTwoData     = new("", "");
    private Contact     _contactOneData     = new("", "");
    private Contact     _contactThreeData   = new("", "");
    private Contact     _contactFourData    = new("", "");

    private ImmutableDictionary<string, BoxedValidator> _contactOneBoxedValidators = default!;
    private ImmutableDictionary<string, BoxedValidator> _contactTwoBoxedValidators = default!;
    private ImmutableDictionary<string, BoxedValidator> _contactThreeBoxedValidators = default!;
    private ImmutableDictionary<string, BoxedValidator> _contactFourBoxedValidators = default!;


    private ElementReference _resetButtonOne;
    private ElementReference _resetButtonTwo;
    private ElementReference _resetButtonThree;

    protected override void OnInitialized()
    {

        ResetForms(1, true);

    }

    private async Task ResetForms(int formNumber, bool all = false)
    {
        if (all)
        {
            _contactOneData = new("", "");
            _contactTwoData = new("", "");
            _contactThreeData = new("", "");
            _contactFourData = new("", "");

            _editContextOne = new EditContext(_contactOneData);
            var builderOne = BlazorValidationBuilder<Contact>.Create()
                                .ForMember(c => c.Surname, ContactValidators.SurnameValidator)
                                    .ForMember(c => c.Email, ContactValidators.EmailValidator);


            _contactOneBoxedValidators = builderOne.GetBoxedValidators();


            _editContextTwo = new EditContext(_contactTwoData);
            var builderTwo = BlazorValidationBuilder<Contact>.Create()
                                .ForMember(c => c.Surname, ContactValidators.SurnameValidator)
                                    .ForMember(c => c.Email, ContactValidators.EmailValidator);


            _contactTwoBoxedValidators = builderTwo.GetBoxedValidators();


            _editContextThree = new EditContext(_contactThreeData);
            var builderThree = BlazorValidationBuilder<Contact>.Create()
                                .ForMember(c => c.Surname, ContactValidators.SurnameValidator)
                                    .ForMember(c => c.Email, ContactValidators.EmailValidator);


            _contactThreeBoxedValidators = builderThree.GetBoxedValidators();

            _editContextFour = new EditContext(_contactFourData);
            var builderFour = BlazorValidationBuilder<Contact>.Create()
                                .ForMember(c => c.Surname, ContactValidators.SurnameValidator)
                                    .ForMember(c => c.Email, ContactValidators.EmailValidator);


            _contactFourBoxedValidators = builderFour.GetBoxedValidators();

            return;
        }

        switch (formNumber)
        {
            case 1:
                _contactOneData = new("", "");

                _editContextOne = new EditContext(_contactOneData);
                var builderOne = BlazorValidationBuilder<Contact>.Create()
                                    .ForMember(c => c.Surname, ContactValidators.SurnameValidator)
                                        .ForMember(c => c.Email, ContactValidators.EmailValidator);

                _contactOneBoxedValidators = builderOne.GetBoxedValidators();
                await Task.Yield();
                await _resetButtonOne.FocusAsync();
                break;
            case 2:
                _contactTwoData = new("", "");

                _editContextTwo = new EditContext(_contactTwoData);
                var builderTwo = BlazorValidationBuilder<Contact>.Create()
                                    .ForMember(c => c.Surname, ContactValidators.SurnameValidator)
                                        .ForMember(c => c.Email, ContactValidators.EmailValidator);

                _contactTwoBoxedValidators = builderTwo.GetBoxedValidators();
                await Task.Yield();
                await _resetButtonTwo.FocusAsync();
                break;
            case 3:

                _contactThreeData = new("", "");

                _editContextThree = new EditContext(_contactThreeData);
                var builderThree = BlazorValidationBuilder<Contact>.Create()
                                    .ForMember(c => c.Surname, ContactValidators.SurnameValidator)
                                        .ForMember(c => c.Email, ContactValidators.EmailValidator);


                _contactThreeBoxedValidators = builderThree.GetBoxedValidators();

                await Task.Yield();
                await _resetButtonThree.FocusAsync();
                break;
            case 4:
                _contactFourData = new("", "");
                _editContextFour = new EditContext(_contactFourData);
                var builderFour = BlazorValidationBuilder<Contact>.Create()
                                    .ForMember(c => c.Surname, ContactValidators.SurnameValidator)
                                        .ForMember(c => c.Email, ContactValidators.EmailValidator);


                _contactFourBoxedValidators = builderFour.GetBoxedValidators();

                break;
        }

    }

    private async Task HandleSubmit()
    {
        await Task.CompletedTask;
    }
}
