@page "/experimental"
@using System.Collections.Immutable
@using BlazorRamp.Inputs.Common.Constants
@using BlazorRamp.Inputs.Components
@using BlazorRamp.WebSite.common.Validators
@using Validated.Blazor
@using Validated.Blazor.Builders
@using Validated.Blazor.Types

<PageTitle>Experimental Input</PageTitle>


<section class="@GlobalValues.Info_Box_Class @GlobalValues.Info_Box_Coloured_Modifier">
    <h1 class="@GlobalValues.Info_Box_Heading_Class">Experimental Text Input</h1>

    <p>
        Below are just three combinations of using the using aria-describedby to hold the id of validaion errors and hint text or for only the hint text with a
        separate tabbable region for the validation errors. dependent on the component settings the hint text id can be removed as noted in each fake form section.
    </p>
    <p>
        The components are all using Blazors EditContext along with my custom validation package that integrate with the EditContext.
        The components can also use Data Annotations along with the Blazors annotaion validator but these short circuit i.e if there are 3 rules and the first one fails the next 2 are not run
        so you only see the one message. You fix that but then may get the other errors, so I dislike these.
    </p>
    <p>
       <strong>Important: </strong> All Email fields are set to validate on change (when it loses focus) <strong>the Surname field validates on each key stroke</strong>. 
    </p>
    <p>
        The fake submit button also causes validation to occur. <strong>I have NOT included any SR announcments or Validaiton Summaries</strong> as the experimental demo is just about field to field interaction.
    </p>
    <p>
        The Reset button will reset that forms demo.
    </p>
    <p>
        Form Three with the tabbable regions works best with on input (Surname field)
    </p>
</section>

<section class="@GlobalValues.Info_Box_Class">
    <h2 class="@GlobalValues.Info_Box_Heading_Class">Form One</h2>

    <p>The form fields below use the id's of both the element that holds the error messages and the hint text</p>

    <EditForm EditContext="@_editContextOne" OnValidSubmit="HandleSubmit" novalidate>
        <BlazorValidated TEntity="Contact" BoxedValidators="_contactOneBoxedValidators" AddDisplayName="true" />

            <div class="br-input-row">
  
            <TextInput class="br-col-xs-12 br-col-sm-6" HintText="Use your work email address for example name@work.com" @bind-Value="_contactOneData.Email" UpdateOnInput="false" AriaDisabled="false" 
                       ReadOnly="false" SvgIcon="--svg-email-icon" TextInputType="TextInputType.Text" autocomplete="email" ValidationDisplayMode="ValidationDisplayMode.DescribedByWithHint" />
                   
            <TextInput class="br-col-xs-12 br-col-sm-6" HintText="Enter your surname as it appears on official documents" @bind-Value="_contactOneData.Surname" UpdateOnInput="true" 
                       AriaDisabled="false" SvgIcon="--svg-surname-icon" TextInputType="TextInputType.Text" autocomplete="family-name" ValidationDisplayMode="ValidationDisplayMode.DescribedByWithHint" />
        </div>

        <div style="display:flex;justify-content:space-between;flex-wrap:wrap; gap:1rem; margin-top:1rem;">
            <button class="test-button" type="submit">Fake Submit</button>
            <button @ref="_resetButtonOne" class="test-button" type="button" @onclick="() => ResetForms(1)">Reset</button>
        </div>

    </EditForm>
</section>


<section class="@GlobalValues.Info_Box_Class">
    <h2 class="@GlobalValues.Info_Box_Heading_Class">Form Two</h2>
    <p>The form fields below removes the id of the hint text from aria-describedby when there are errors.</p>


    <EditForm EditContext="@_editContextTwo" novalidate>
        <BlazorValidated TEntity="Contact" BoxedValidators="_contactTwoBoxedValidators" AddDisplayName="true" />

        <div class="br-input-row">
  
            <TextInput class="br-col-xs-12 br-col-sm-6" HintText="Use your work email address for example name@work.com" @bind-Value="_contactTwoData.Email" UpdateOnInput="false" AriaDisabled="false" 
                       ReadOnly="false" SvgIcon="--svg-email-icon" TextInputType="TextInputType.Text" autocomplete="email" ValidationDisplayMode="ValidationDisplayMode.DescribedByHintSuppressed" />
                   
            <TextInput class="br-col-xs-12 br-col-sm-6" HintText="Enter your surname as it appears on official documents" @bind-Value="_contactTwoData.Surname" UpdateOnInput="true" AriaDisabled="false" 
                       SvgIcon="--svg-surname-icon" TextInputType="TextInputType.Text" autocomplete="family-name" ValidationDisplayMode="ValidationDisplayMode.DescribedByHintSuppressed" />
        </div>

        <div style="display:flex;justify-content:space-between;flex-wrap:wrap; gap:1rem; margin-top:1rem;">
            <button class="test-button" type="submit">Fake Submit</button>
            <button @ref="_resetButtonTwo" class="test-button" type="button" @onclick="() => ResetForms(2)">Reset</button>
        </div>
    </EditForm>
</section>

<section class="@GlobalValues.Info_Box_Class">
    <h2 class="@GlobalValues.Info_Box_Heading_Class">Form Three</h2>
    <p>The form fields below has the id of the hint text for aria-describedby but uses a tabbable region for errors.</p>


    <EditForm EditContext="@_editContextThree" novalidate>
        <BlazorValidated TEntity="Contact" BoxedValidators="_contactThreeBoxedValidators" AddDisplayName="true" />

        <div class="br-input-row">
  
            <TextInput class="br-col-xs-12 br-col-sm-6" HintText="Use your work email address for example name@work.com"@bind-Value="_contactThreeData.Email" UpdateOnInput="false" AriaDisabled="false" 
            ReadOnly="false" SvgIcon="--svg-email-icon" TextInputType="TextInputType.Text" autocomplete="email" ValidationDisplayMode="ValidationDisplayMode.TabbableWithHint" />
                   
            <TextInput class="br-col-xs-12 br-col-sm-6" HintText="Enter your surname as it appears on official documents" @bind-Value="_contactThreeData.Surname" UpdateOnInput="true" AriaDisabled="false"
                       SvgIcon="--svg-surname-icon" TextInputType="TextInputType.Text" autocomplete="family-name" ValidationDisplayMode="ValidationDisplayMode.TabbableWithHint" />
        </div>

        <div style="display:flex;justify-content:space-between;flex-wrap:wrap; gap:1rem; margin-top:1rem;">
            <button class="test-button" type="submit">Fake Submit</button>
            <button @ref="_resetButtonThree" class="test-button" type="button" @onclick="() => ResetForms(3)">Reset</button>
        </div>
    </EditForm>
</section>

