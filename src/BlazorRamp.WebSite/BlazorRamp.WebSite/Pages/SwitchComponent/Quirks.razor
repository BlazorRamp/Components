@attribute [Route(GlobalValues.Path_Switch_Quirks)]

<PageTitle>@GlobalValues.Page_Title_Switch_Quirks</PageTitle>

<section class="@GlobalValues.Info_Box_Class @GlobalValues.Info_Box_Coloured_Modifier">
    <h1 class="@GlobalValues.Info_Box_Heading_Class">Switch Quirks & Issues</h1>

    <p>
        Below are all the quirks and/or issues that I experienced whilst testing the Switch component.
    </p>

</section>

<section class="section-box">
    <h2 id="screen-reader-quirks" class="@GlobalValues.Info_Box_Heading_Class">Screen reader quirks</h2>
    <ul aria-labelledby="screen-reader-quirks">
        <li><b>Narrator</b> paired with <b>Firefox</b> announces button on/off instead of switch on/off.</li>
    </ul>
</section>


<div class="flex-content justify-content-between">
    <a class="@GlobalValues.Link_Button_Class @GlobalValues.Link_Button_Left_Arrow_Modifier" href="@GlobalValues.Path_Switch_Overview">
        <span aria-hidden="true"></span>
        <span>@GlobalValues.Main_Nav_Section_Heading_Switch - @GlobalValues.Page_Heading_Switch_Overview</span>
        <span aria-hidden="true"></span>
    </a>
    <a class="@GlobalValues.Link_Button_Class @GlobalValues.Link_Button_Right_Arrow_Modifier" href="@GlobalValues.Path_Tabs_Overview">
        <span aria-hidden="true"></span>
        <span>@GlobalValues.Main_Nav_Section_Heading_Tabs - @GlobalValues.Page_Heading_Tabs_Overview</span>
        <span aria-hidden="true"></span>
    </a>
</div>

