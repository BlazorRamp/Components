@attribute [Route($"{GlobalValues.Root_Path_Components}/{GlobalValues.Component_Path_Part_Switch}/{GlobalValues.Common_Page_Path_Quirks_Issues}")]

<PageTitle>@GlobalValues.Component_Name_Switch @GlobalValues.Common_Page_Title_Quirks_Issues</PageTitle>

<section class="@GlobalValues.Info_Box_Class @GlobalValues.Info_Box_Coloured_Modifier">
    <h1 class="@GlobalValues.Info_Box_Heading_Class">@GlobalValues.Component_Name_Switch @GlobalValues.Common_Page_Title_Quirks_Issues</h1>

    <p>
        Below are all the quirks and/or issues that I experienced whilst testing the Switch component.
    </p>

</section>

<section class="section-box">
    <h2 id="screen-reader-quirks" class="@GlobalValues.Info_Box_Heading_Class">Screen reader quirks</h2>
    <ul aria-labelledby="screen-reader-quirks">
        <li><b>Narrator</b> paired with <b>Firefox</b> announces button on/off instead of switch on/off.</li>
    </ul>
    <p style="margin-top:1rem;">
        <strong>Note: </strong> The same quirks were also noted in the ARIA Authoring Practices Guide (APG) example.
    </p>
</section>


<div class="flex-content justify-content-between">
    <a class="@GlobalValues.Link_Button_Class @GlobalValues.Link_Button_Left_Arrow_Modifier" href="@($"{GlobalValues.Root_Path_Components}/{GlobalValues.Component_Path_Part_Switch}/{GlobalValues.Common_Page_Path_Overview_Tests}")">
        <span aria-hidden="true"></span>
        <span>@GlobalValues.Component_Name_Switch - @GlobalValues.Common_Page_Title_Overview_Tests</span>
        <span aria-hidden="true"></span>
    </a>
    <a class="@GlobalValues.Link_Button_Class @GlobalValues.Link_Button_Right_Arrow_Modifier" href="@($"{GlobalValues.Root_Path_Components}/{GlobalValues.Component_Path_Part_Tabs}/{GlobalValues.Common_Page_Path_Overview_Tests}")">
        <span aria-hidden="true"></span>
        <span>@GlobalValues.Component_Name_Tabs - @GlobalValues.Common_Page_Title_Overview_Tests</span>
        <span aria-hidden="true"></span>
    </a>
</div>

