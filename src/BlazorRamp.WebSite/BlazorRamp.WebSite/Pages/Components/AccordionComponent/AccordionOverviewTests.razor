        </AccordionItem>
    </Accordion>

</section>


<div class="flex-content justify-content-between">
    <a class="@GlobalValues.Link_Button_Class @GlobalValues.Link_Button_Left_Arrow_Modifier" href="@GlobalValues.Common_Page_Path_About">
        <span aria-hidden="true"></span>
        <span>@GlobalValues.Main_Nav_Section_Heading_Overview - @GlobalValues.Common_Page_Title_About</span>
        <span aria-hidden="true"></span>
    </a>
    <a class="@GlobalValues.Link_Button_Class @GlobalValues.Link_Button_Right_Arrow_Modifier" href="@($"{GlobalValues.Root_Path_Components}/{GlobalValues.Component_Path_Part_Accordion}/{GlobalValues.Common_Page_Path_Quirks_Issues}")">
        <span aria-hidden="true"></span>
        <span>@GlobalValues.Component_Name_Accordion - @GlobalValues.Common_Page_Title_Quirks_Issues</span>
        <span aria-hidden="true"></span>
    </a>
</div>
