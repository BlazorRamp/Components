@attribute [Route($"{GlobalValues.Root_Path_Components}/{GlobalValues.Component_Path_Part_GoTo}/{GlobalValues.Common_Page_Path_Quirks_Issues}")]

<PageTitle>@GlobalValues.Component_Name_GoTo @GlobalValues.Common_Page_Title_Quirks_Issues</PageTitle>

<GoTo LabelText="GoTo quirks and issues page heading" />

<section class="@GlobalValues.Info_Box_Class @GlobalValues.Info_Box_Coloured_Modifier">
    <h1 class="@GlobalValues.Info_Box_Heading_Class">@GlobalValues.Component_Name_GoTo @GlobalValues.Common_Page_Title_Quirks_Issues</h1>

    <p>
        Below are all the quirks and/or issues that I experienced whilst testing the Disclosure component.
    </p>
</section>

<section class="section-box">
    <h2 id="screen-reader-quirks" class="@GlobalValues.Info_Box_Heading_Class">Screen reader quirks</h2>
    <ul aria-labelledby="screen-reader-quirks">
        <li>
            <b>Narrator</b> is very verbose when paired with either Edge or Chrome when activating and reading the marker labels, but is fine when paired with Firefox.
        </li>
        <li>
            <b>Talkback.</b> GoTo was designed for desktop keyboard-only non-screen reader users. However, tt works with Talkback on Android using Chrome,
            but will not scroll markers into view like the desktop version.
        </li>
    </ul>
    <p>
        <strong>Important</strong> Unlike the other components GoTo has not been tested with VoiceOver on the iPhone and as such is not supported.
    </p>
</section>

<GoTo LabelText="GoTo quirks and issues page navigation" />

<div class="flex-content justify-content-between">
    <a class="@GlobalValues.Link_Button_Class @GlobalValues.Link_Button_Left_Arrow_Modifier" href="@($"{GlobalValues.Root_Path_Components}/{GlobalValues.Component_Path_Part_GoTo}/{GlobalValues.Common_Page_Path_Overview_Tests}")">
        <span aria-hidden="true"></span>
        <span>@GlobalValues.Component_Name_GoTo - @GlobalValues.Common_Page_Title_Overview_Tests</span>
        <span aria-hidden="true"></span>
    </a>
    <a class="@GlobalValues.Link_Button_Class @GlobalValues.Link_Button_Right_Arrow_Modifier" href="@($"{GlobalValues.Root_Path_Components}/{GlobalValues.Component_Path_Part_Inputs}/{GlobalValues.Common_Page_Path_Overview}")">
        <span aria-hidden="true"></span>
        <span>@GlobalValues.Component_Name_Inputs - @GlobalValues.Common_Page_Title_Overview</span>
        <span aria-hidden="true"></span>
    </a>
</div>

