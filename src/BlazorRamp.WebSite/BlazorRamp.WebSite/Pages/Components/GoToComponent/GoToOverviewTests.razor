        <span>@GlobalValues.Component_Name_Disclosure - @GlobalValues.Common_Page_Title_Overview_Page_Tests</span>
        <span aria-hidden="true"></span>
    </a>
    <a class="@GlobalValues.Link_Button_Class @GlobalValues.Link_Button_Right_Arrow_Modifier" href="@($"{GlobalValues.Root_Path_Components}/{GlobalValues.Component_Path_Part_GoTo}/{GlobalValues.Common_Page_Path_Quirks_Issues}")">
        <span aria-hidden="true"></span>
        <span>@GlobalValues.Component_Name_GoTo - @GlobalValues.Common_Page_Title_Quirks_Issues</span>
