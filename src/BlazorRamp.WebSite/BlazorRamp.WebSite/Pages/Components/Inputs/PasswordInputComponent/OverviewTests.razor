        await _liveRegionService.MakeAnnouncement(announcement);
        await ResetButtonFive.FocusAsync();
    }
    private async Task ResetEditContextSix()
    {
        var announcement = new Announcement("Example six has been reset", AnnouncementType.Info, "Reset Example Six Button");
       
        _contactDataSix = new();
        _editContextSix = new EditContext(_contactDataSix);
       
        await _liveRegionService.MakeAnnouncement(announcement);
        await ResetButtonSix.FocusAsync();
    }

    public class ContactDto
    {

        public string Password { get; set; }
        public string ConfirmPassword { get; set; }
    }

}
