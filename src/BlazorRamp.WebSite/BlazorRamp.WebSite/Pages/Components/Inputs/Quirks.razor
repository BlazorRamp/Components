@attribute [Route($"{GlobalValues.Root_Path_Components}/{GlobalValues.Component_Path_Part_Inputs}/{GlobalValues.Common_Page_Path_Quirks_Issues}")]

<PageTitle>@GlobalValues.Component_Name_Inputs @GlobalValues.Common_Page_Title_Quirks_Issues</PageTitle>

<section class="@GlobalValues.Info_Box_Class @GlobalValues.Info_Box_Coloured_Modifier">
    <h1 class="@GlobalValues.Info_Box_Heading_Class">@GlobalValues.Component_Name_Inputs @GlobalValues.Common_Page_Title_Quirks_Issues</h1>

    <p>
        Below are all the quirks and/or issues that I experienced whilst testing the inputs and input error summary component
    </p>

</section>

<section class="section-box">
    <h2 id="screen-reader-issues">Screen reader issues</h2>
    <ul aria-labelledby="screen-reader-issues">
        <li>
            <b>Narrator</b> on Firefox currently does not seem to honour <span class="code-span">aria-required</span> or <span class="code-span">aria-invalid</span>; please check your version
            of Narrator and version of Firefox if you need to support this pairing. Its recommended that Narrator be used with Edge or Chrome.
        </li>
    </ul>
</section>
<div class="flex-content justify-content-between">
    <a class="@GlobalValues.Link_Button_Class @GlobalValues.Link_Button_Left_Arrow_Modifier" href="@($"{GlobalValues.Root_Path_Components}/{GlobalValues.Component_Path_Part_Inputs}/{GlobalValues.Common_Page_Path_Overview}")">
        <span aria-hidden="true"></span>
        <span>@GlobalValues.Component_Name_Inputs - @GlobalValues.Common_Page_Title_Overview_Tests</span>
        <span aria-hidden="true"></span>
    </a>
    <a class="@GlobalValues.Link_Button_Class @GlobalValues.Link_Button_Right_Arrow_Modifier" href="@($"{GlobalValues.Root_Path_Components}/{GlobalValues.Component_Path_Part_Inputs}/{GlobalValues.Component_Path_Part_NumericInput}/{GlobalValues.Common_Page_Path_Overview_Tests}")">
        <span aria-hidden="true"></span>
        <span>@GlobalValues.Component_Name_Numeric_Input - @GlobalValues.Common_Page_Title_Overview_Tests</span>
        <span aria-hidden="true"></span>
    </a>
</div>

