    private async Task ResetEditContextOne()
    {
        var announcement = new Announcement("Example one has been reset", AnnouncementType.Info, "Reset Example One Button");

        _scheduleDataOne = new();
        _editContextOne = new EditContext(_scheduleDataOne);

        await _liveRegionService.MakeAnnouncement(announcement);

        await ResetButtonOne.FocusAsync();

    }
