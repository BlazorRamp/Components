@code {

    private ScheduleDto _scheduleDataOne   = new();
    private ScheduleDto _scheduleDataTwo   = new();
    private ScheduleDto _scheduleDataThree = new();
    private ScheduleDto _scheduleDataFour  = new();
    private ScheduleDto _scheduleDataFive  = new();
    private ScheduleDto _scheduleDataSix   = new();

    private ImmutableDictionary<string, BoxedValidator> _boxedValidators = default!;

    private EditContext _editContextOne   = default!; 
    private EditContext _editContextTwo   = default!;
    private EditContext _editContextThree = default!;
    private EditContext _editContextFour  = default!;
    private EditContext _editContextFive  = default!;
    private EditContext _editContextSix   = default!;

    private ElementReference ResetButtonOne {get;set;}= default;
    private ElementReference ResetButtonTwo {get;set;}= default;
    private ElementReference ResetButtonThree {get;set;}= default;
    private ElementReference ResetButtonFour { get; set; } = default;
    private ElementReference ResetButtonFive { get; set; } = default;
    private ElementReference ResetButtonSix { get; set; } = default;

    protected override async Task OnInitializedAsync()
    {

        var startTimeValidator = MemberValidators.CreateRangeValidator<TimeOnly>(TimeOnly.FromTimeSpan(new TimeSpan(7, 0, 0)), TimeOnly.FromTimeSpan(new TimeSpan(10, 0, 0)), "StartTime", "Start Time", "Must be between 7am and 10am.");
        var startWorkValidator = MemberValidators.CreateRangeValidator<TimeOnly>(TimeOnly.FromTimeSpan(new TimeSpan(7, 0, 0)), TimeOnly.FromTimeSpan(new TimeSpan(10, 0, 0)), "StartWork", "Start Work", "If entered must be between 7am and 10am");
        

        _boxedValidators = BlazorValidationBuilder<ScheduleDto>.Create()
                               .ForMember(c => c.StartTime, startTimeValidator)
                               .ForNullableMember(c => c.StartWork, startWorkValidator) //Nullable in my library means optional
                                .GetBoxedValidators();

        _editContextOne   = new EditContext(_scheduleDataOne);
        _editContextTwo   = new EditContext(_scheduleDataTwo);
        _editContextThree = new EditContext(_scheduleDataThree);
        _editContextFour  = new EditContext(_scheduleDataFour);
        _editContextFive  = new EditContext(_scheduleDataFive);
        _editContextSix   = new EditContext(_scheduleDataSix);

    }


    private async Task HandleSubmitOne()
    {
        _editContextOne.Validate();
        var announcement = new Announcement("Validation invoked on example one form fields", AnnouncementType.Info, "Submit One Button");

        await _liveRegionService.MakeAnnouncement(announcement);

    }
    private async Task HandleSubmitTwo()
    {
        _editContextTwo.Validate();
        var announcement = new Announcement("Validation invoked on example two form fields", AnnouncementType.Info, "Submit Two Button");

        await _liveRegionService.MakeAnnouncement(announcement);
    }
