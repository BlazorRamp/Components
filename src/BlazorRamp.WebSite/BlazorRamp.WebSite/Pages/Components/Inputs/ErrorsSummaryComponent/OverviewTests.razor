
@attribute [Route($"{GlobalValues.Root_Path_Components}/{GlobalValues.Component_Path_Part_Inputs}/{GlobalValues.Component_Path_Part_ErrorsSummary}/{GlobalValues.Common_Page_Path_Overview_Tests}")]

@inject ILiveRegionService _liveRegionService

<PageTitle>@GlobalValues.Component_Name_Errors_Summary @GlobalValues.Common_Page_Title_Overview_Tests</PageTitle>

<section class="@GlobalValues.Info_Box_Class @GlobalValues.Info_Box_Coloured_Modifier">
    <h1 class="@GlobalValues.Info_Box_Heading_Class">@GlobalValues.Component_Name_Errors_Summary @GlobalValues.Common_Page_Title_Overview_Tests</h1>

    <p>
        The Inputs Errors Summary component is a simple component designed to show the validation messages that may have occurred for the form field with a link that 
        takes the user to the erroneous field so they can correct it.
    </p>

</section>
<section class="@GlobalValues.Main_Nav_Section_Heading_SkipTo @GlobalValues.Info_Box_Class">

    <h2 class="@GlobalValues.Info_Box_Heading_Class">Information & instructions</h2>
    <p>
        All of the form fields below have validation rules attached, all are required excluding the Hourly Rate field that is optional. Each field is set to use immediate validation with a tabbable region for the 
        error messages that appear below the respective input.
    </p>
    <p>
        The Input Error Summary component in both of the examples below have been set to show only once a full model validation has occurred. The first example uses validation that has been set to begin field level
        validation prior to any attempt to submit the fake form. For the second example, the validation process has been set to occur only after a submit attempt has been made. In the second example, the whole model 
        will be validated on submit and then field level validation will occur as of the first example.
    </p>
    <p>
        You can click the fake submit buttons at any time. By default, as three of the fields are required, if you try to submit the form without entering any data there will be at least three erroneous fields.
    </p>
</section>
<section class="@GlobalValues.Info_Box_Class">

    <h3 class="@GlobalValues.Info_Box_Heading_Class">Expectations</h3>

    <ul>
        <li>
            On clicking the fake submit button, if there are any validation errors the input errors summary should be displayed at the top of the form with focus being set on this landmark region.
        </li>
        <li>
            For the second example that uses the deferred validation approach, no visual or audible validation messages should be displayed for any field until after a submit attempt that contains errors.
        </li>
        <li>
            Screen readers should announce the regions heading to the user so they are aware of the form errors.  
        </li>
        <li>
            Each field error should contain a link to the input as well as having a list of the actual errors that occurred for that field.
        </li>
        <li>
            Clicking the link should take you to the erroneous input. 
        </li>
        <li>
           Screen reader users should should also have this summary region listed in their landmarks shortcuts.
        </li>
        <li>
            Voice control users should be able to navigate to any field directly using the appropriate command and the visible field name and/or by issuing the command to activate the link using its
            visible accessible name.
        </li>
    </ul>
</section>
<section class="section-box">
    <h2>Input error summary example one</h2>

    <EditForm Model="@_contactDataOne" OnValidSubmit="HandleSubmitOne">

        <BlazorValidated TEntity="ContactDto" BoxedValidators="_boxedValidators" AddDisplayName="true" DeferFieldValidation="false" />

        <InputErrorsSummary InputSuffix="Field" TitleHeadingLevel="TitleHeadingLevel.H3" SummaryDisplay="SummaryDisplay.OnModelValidated" Title="There is a problem with your entries">

            <div class="br-input-row">
                <TextInput class="br-col-xs-12 br-col-sm-6" LabelText="First Name" Required="true" ErrorsLabel="errors" UpdateOnInput="true" TextInputType="TextInputType.Text" ValidationDisplayMode="ValidationDisplayMode.TabbableWithHint"
                           @bind-Value="_contactDataOne.FirstName" HintText="The name you use on official documents" SvgIcon="--svg-user-icon" autocomplete="given-name" />

                <TextInput class="br-col-xs-12 br-col-sm-6" LabelText="Surname" Required="true" ErrorsLabel="errors" UpdateOnInput="true" TextInputType="TextInputType.Text" ValidationDisplayMode="ValidationDisplayMode.TabbableWithHint"
                           @bind-Value="_contactDataOne.Surname" HintText="The surname you use on official documents" SvgIcon="--svg-user-icon" autocomplete="family-name" />
            </div>
            <div class="br-input-row">

                <NumericInput class="br-col-xs-12 br-col-sm-6" @bind-Value="_contactDataOne.Age" Required="true"
                              LabelText="Age" ErrorsLabel="errors" HintText="Your current age in years." UpdateOnInput="true"
                              ValidationDisplayMode="ValidationDisplayMode.TabbableWithHint" ParseErrorMessage="Please enter a valid number for this field type." />

                <NumericInput class="br-col-xs-12 br-col-sm-6" @bind-Value="_contactDataOne.HourlyRate" Required="false" Format="C"
                              LabelText="Hourly Rate" ErrorsLabel="errors" HintText="Optional, how much you charge per hour." UpdateOnInput="true"
                              ValidationDisplayMode="ValidationDisplayMode.TabbableWithHint" ParseErrorMessage="Please enter a valid number for this field type." maxlength="50" />

            </div>
        </InputErrorsSummary>

        <div style="display:flex;justify-content:space-between;flex-wrap:wrap;gap:1rem;">
            <button class="br-col-xs-12 normal-button" type="submit">Fake submit one to trigger validation on the model</button>
            <button @ref="ResetButtonOne" class="normal-button" type="button" @onclick="ResetExampleOne">Reset example one</button>
        </div>
    </EditForm>

</section>

<p>
    The next form is identical to the first one, but this time no field validation will take place until the form has tried to be submitted, after which field level
    will take place as of the first example.
</p>
<section class="section-box">
    <h2>Input error summary example two (no validation until submit)</h2>

    <EditForm EditContext="@_editContextTwo" OnValidSubmit="HandleSubmitTwo">

        <BlazorValidated TEntity="ContactDto" BoxedValidators="_boxedValidators" AddDisplayName="true" DeferFieldValidation="true" />

        <InputErrorsSummary InputSuffix="Field" TitleHeadingLevel="TitleHeadingLevel.H3" SummaryDisplay="SummaryDisplay.OnModelValidated">

            <div class="br-input-row">
                <TextInput class="br-col-xs-12 br-col-sm-6" LabelText="First Name" Required="true" ErrorsLabel="errors" UpdateOnInput="true" TextInputType="TextInputType.Text" ValidationDisplayMode="ValidationDisplayMode.TabbableWithHint"
                           @bind-Value="_contactDataTwo.FirstName" HintText="The name you use on official documents" SvgIcon="--svg-user-icon" autocomplete="given-name" />

                <TextInput class="br-col-xs-12 br-col-sm-6" LabelText="Surname" Required="true" ErrorsLabel="errors" UpdateOnInput="true" TextInputType="TextInputType.Text" ValidationDisplayMode="ValidationDisplayMode.TabbableWithHint"
                           @bind-Value="_contactDataTwo.Surname" HintText="The surname you use on official documents" SvgIcon="--svg-user-icon" autocomplete="family-name" />
            </div>
            <div class="br-input-row">

                <NumericInput class="br-col-xs-12 br-col-sm-6" @bind-Value="_contactDataTwo.Age" Required="true"
                              LabelText="Age" ErrorsLabel="errors" HintText="Your current age in years." UpdateOnInput="true"
                              ValidationDisplayMode="ValidationDisplayMode.TabbableWithHint" ParseErrorMessage="Please enter a valid number for this field type." />

                <NumericInput class="br-col-xs-12 br-col-sm-6" @bind-Value="_contactDataTwo.HourlyRate" Required="false" Format="C"
                              LabelText="Hourly Rate" ErrorsLabel="errors" HintText="Optional, how much you charge per hour." UpdateOnInput="true"
                              ValidationDisplayMode="ValidationDisplayMode.TabbableWithHint" ParseErrorMessage="Please enter a valid number for this field type." maxlength="50" />

            </div>
        </InputErrorsSummary>

        <div style="display:flex;justify-content:space-between;flex-wrap:wrap;gap:1rem;">
            <button class="normal-button" type="submit">Fake submit two to trigger validation on the model</button>
            <button @ref="ResetButtonTwo" class="normal-button" type="button" @onclick="ResetExampleTwo">Reset example two</button>
        </div>
    </EditForm>

</section>

<div class="flex-content justify-content-between">
    <a class="@GlobalValues.Link_Button_Class @GlobalValues.Link_Button_Left_Arrow_Modifier" href="@($"{GlobalValues.Root_Path_Components}/{GlobalValues.Component_Path_Part_Inputs}/{GlobalValues.Component_Path_Part_TimeInput}/{GlobalValues.Common_Page_Path_Overview_Tests}")">
        <span aria-hidden="true"></span>
        <span>@GlobalValues.Component_Name_Time_Input - @GlobalValues.Common_Page_Title_Overview_Tests</span>
        <span aria-hidden="true"></span>
    </a>

    <a class="@GlobalValues.Link_Button_Class @GlobalValues.Link_Button_Right_Arrow_Modifier" href="@($"{GlobalValues.Root_Path_Components}/{GlobalValues.Component_Path_Part_NavGroup}/{GlobalValues.Common_Page_Path_Overview_Tests}")">
        <span aria-hidden="true"></span>
        <span>@GlobalValues.Component_Name_NavGroup - @GlobalValues.Common_Page_Title_Overview_Tests</span>
        <span aria-hidden="true"></span>
    </a>


</div>


@code {
    private ContactDto _contactDataOne  = new();
    private ContactDto _contactDataTwo = new();
    private EditContext _editContextOne = default!;
    private EditContext _editContextTwo = default!;
    private ElementReference ResetButtonOne { get; set; } = default;
    private ElementReference ResetButtonTwo { get; set; } = default;
    private ImmutableDictionary<string, BoxedValidator> _boxedValidators = default!;

    protected override void OnInitialized()
    {

        var firstNameValidator = MemberValidators.CreateStringRegexValidator(@"^(?=.{2,25}$)[A-Z][A-Za-z]*(?:['\- ][A-Za-z]+)*$", "FirstName", "First Name", "Must start with a capital letter and be between 2 and 25 characters in length.");

        /*
        * Although its easy to create a regex that does everything I prefer to break things down into separate rules, so below creates a validator made up of two rules.
                 */
        var surnameValidator = MemberValidators.CreateStringRegexValidator(@"^(?=.{2,})[A-Z][A-Za-z]*(?:['\- ][A-Za-z]+)*\z", "Surname", "Surname", "Must start with a capital letter and no double spaces.")
                            .AndThen(MemberValidators.CreateStringLengthValidator(2, 25, "Surname", "Surname", "Must be between 2 and 25 characters in length but you entered {ActualLength} characters."));

        var ageValidator = MemberValidators.CreateRangeValidator<int>(16, 120, "Age", "Age", "Must be between 16 and 120");

        var salaryValidator = MemberValidators.CreatePrecisionScaleValidator<decimal>(50, 2, "HourlyRate", "Hourly Rate", "Can only contain a maximum of 2 decimal places")
                        .AndThen(MemberValidators.CreateRangeValidator<decimal>(10.00M, 200.00M, "HourlyRate", "Hourly Rate", $"Must be between {String.Format("{0:C}", 10)} and {String.Format("{0:C}", 100)}"));


        _boxedValidators = BlazorValidationBuilder<ContactDto>.Create()
                                .ForMember(c => c.FirstName, firstNameValidator)
                                .ForMember(c => c.Surname, surnameValidator)
                                .ForMember(c => c.Age, ageValidator)
                                .ForNullableMember(c => c.HourlyRate, salaryValidator)
                            .GetBoxedValidators();

        _editContextOne = new EditContext(_contactDataOne);
        _editContextTwo = new EditContext(_contactDataTwo);
    }


    private void HandleSubmitOne() { }
    private void HandleSubmitTwo() { }

    
    private async Task ResetExampleOne()
    {
        var announcement = new Announcement("Summary example one has been reset.", AnnouncementType.Info, "Reset example one button");

        _contactDataOne = new();
        _editContextOne = new EditContext(_contactDataOne);

        await _liveRegionService.MakeAnnouncement(announcement);

        await ResetButtonOne.FocusAsync();

    }
    private async Task ResetExampleTwo()
    {
        var announcement = new Announcement("Summary example two has been reset.", AnnouncementType.Info, "Reset example two button");

        _contactDataTwo = new();
        _editContextTwo = new EditContext(_contactDataTwo);

        await _liveRegionService.MakeAnnouncement(announcement);

        await ResetButtonTwo.FocusAsync();

    }
    public class ContactDto
    {
        public string FirstName { get; set; }
        public string Surname { get; set; }
        public int Age { get; set; }
        public decimal? HourlyRate { get; set; }
    }

}
