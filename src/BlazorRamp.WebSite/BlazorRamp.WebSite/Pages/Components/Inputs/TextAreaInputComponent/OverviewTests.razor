@code {

    private ContactDto _contactDataOne   = new();
    private ContactDto _contactDataTwo   = new();
    private ContactDto _contactDataThree = new();
    private ContactDto _contactDataFour  = new();
    private ContactDto _contactDataFive  = new();
    private ContactDto _contactDataSix   = new();

    private ImmutableDictionary<string, BoxedValidator> _boxedValidators = default!;

    private EditContext _editContextOne   = default!; 
    private EditContext _editContextTwo   = default!;
    private EditContext _editContextThree = default!;
    private EditContext _editContextFour  = default!;
    private EditContext _editContextFive  = default!;
    private EditContext _editContextSix   = default!;

    private ElementReference ResetButtonOne {get;set;}= default;
    private ElementReference ResetButtonTwo {get;set;}= default;
    private ElementReference ResetButtonThree {get;set;}= default;
    private ElementReference ResetButtonFour { get; set; } = default;
    private ElementReference ResetButtonFive { get; set; } = default;
    private ElementReference ResetButtonSix { get; set; } = default;

    protected override async Task OnInitializedAsync()
    {

        var notesValidator = MemberValidators.CreateStringLengthValidator(1, 20, "Notes", "Notes", "Must contain text with a maximum of 40 characters.");

        _boxedValidators = BlazorValidationBuilder<ContactDto>.Create()
                                .ForMember(c => c.Notes, notesValidator)
                                .GetBoxedValidators();

        _editContextOne   = new EditContext(_contactDataOne);
        _editContextTwo   = new EditContext(_contactDataTwo);
        _editContextThree = new EditContext(_contactDataThree);
        _editContextFour  = new EditContext(_contactDataFour);
        _editContextFive  = new EditContext(_contactDataFive);
        _editContextSix   = new EditContext(_contactDataSix);

    }


    private async Task HandleSubmitOne()
    {
        _editContextOne.Validate();
        var announcement = new Announcement("Validation invoked on example one form field.", AnnouncementType.Info, "Submit One Button");

        await _liveRegionService.MakeAnnouncement(announcement);

    }
    private async Task HandleSubmitTwo()
    {
        _editContextTwo.Validate();
        var announcement = new Announcement("Validation invoked on example two form field.", AnnouncementType.Info, "Submit Two Button");

        await _liveRegionService.MakeAnnouncement(announcement);
    }
