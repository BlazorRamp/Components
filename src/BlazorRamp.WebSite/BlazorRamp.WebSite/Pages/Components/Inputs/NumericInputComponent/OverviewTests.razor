                              ValidationDisplayMode="ValidationDisplayMode.DescribedByHintSuppressed" ParseErrorMessage="Please enter a valid number for this field type." />
            </div>

            <div style="display:flex;justify-content:space-between;flex-wrap:wrap;gap:1rem;">
