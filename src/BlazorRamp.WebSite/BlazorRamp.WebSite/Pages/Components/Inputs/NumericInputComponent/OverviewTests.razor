@code {

    private InventoryDto  _inventoryDataOne = new();
    private InventoryDto  _inventoryDataTwo = new();
    private InventoryDto  _inventoryDataThree = new();
    private InventoryDto  _inventoryDataFour = new();
    private InventoryDto  _inventoryDataFive = new();
    private InventoryDto  _inventoryDataSix = new();

    private ImmutableDictionary<string, BoxedValidator> _boxedValidators = default!;

    private EditContext _editContextOne = default!;
    private EditContext _editContextTwo = default!;
    private EditContext _editContextThree = default!;
    private EditContext _editContextFour = default!;
    private EditContext _editContextFive = default!;
    private EditContext _editContextSix = default!;

    private ElementReference ResetButtonOne { get; set; } = default;
    private ElementReference ResetButtonTwo { get; set; } = default;
    private ElementReference ResetButtonThree { get; set; } = default;
    private ElementReference ResetButtonFour { get; set; } = default;
    private ElementReference ResetButtonFive { get; set; } = default;
    private ElementReference ResetButtonSix { get; set; } = default;

    protected override void OnInitialized()
    {

        var unitValidator = MemberValidators.CreateRangeValidator<int>(1, 999, "UnitsInStock", "Units in stock", "Must be between 1 and 999");

        var priceValidation = MemberValidators.CreatePrecisionScaleValidator<decimal>(5, 2, "UnitPrice", "Unit price", "Cannot be more than than one hundred thousand with a maximum of 2 decimal places")
                                .AndThen(MemberValidators.CreatePredicateValidator<decimal>(c => c > 1M, "UnitPrice", "Unit Price", "Must be greater than " + String.Format("{0:C}", 1)));

        _boxedValidators = BlazorValidationBuilder<InventoryDto>.Create()
                                .ForMember(c => c.UnitsInStock, unitValidator)
                                .ForMember(c => c.UnitPrice, priceValidation)
                                .GetBoxedValidators();

        _editContextOne = new EditContext(_inventoryDataOne);
        _editContextTwo = new EditContext(_inventoryDataTwo);
        _editContextThree = new EditContext(_inventoryDataThree);
        _editContextFour = new EditContext(_inventoryDataFour);
        _editContextFive = new EditContext(_inventoryDataFive);
        _editContextSix = new EditContext(_inventoryDataSix);


    }


    private async Task HandleSubmitOne()
    {
        _editContextOne.Validate();
        var announcement = new Announcement("Validation invoked on example one form fields", AnnouncementType.Info, "Submit One Button");

        await _liveRegionService.MakeAnnouncement(announcement);

    }
    private async Task HandleSubmitTwo()
    {
        _editContextTwo.Validate();
        var announcement = new Announcement("Validation invoked on example two form fields", AnnouncementType.Info, "Submit Two Button");

        await _liveRegionService.MakeAnnouncement(announcement);
    }
    private async Task HandleSubmitThree()
    {
        _editContextThree.Validate();
        var announcement = new Announcement("Validation invoked on example three form fields", AnnouncementType.Info, "Submit Three Button");

        await _liveRegionService.MakeAnnouncement(announcement);
    }
    private async Task HandleSubmitFour()
    {
        _editContextFour.Validate();
        var announcement = new Announcement("Validation invoked on example four form fields", AnnouncementType.Info, "Submit Four Button");

        await _liveRegionService.MakeAnnouncement(announcement);

    }
    private async Task HandleSubmitFive()
    {
        _editContextFive.Validate();
        var announcement = new Announcement("Validation invoked on example five form fields", AnnouncementType.Info, "Submit Five Button");

        await _liveRegionService.MakeAnnouncement(announcement);
    }
    private async Task HandleSubmitSix()
    {
        _editContextSix.Validate();
        var announcement = new Announcement("Validation invoked on example six form fields", AnnouncementType.Info, "Submit Six Button");

        await _liveRegionService.MakeAnnouncement(announcement);
    }


    private async Task ResetEditContextOne()
    {
        var announcement = new Announcement("Example one has been reset", AnnouncementType.Info, "Reset Example One Button");

        _inventoryDataOne = new();
        _editContextOne = new EditContext(_inventoryDataOne);

        await _liveRegionService.MakeAnnouncement(announcement);

        await ResetButtonOne.FocusAsync();

    }
    private async Task ResetEditContextTwo()
    {
        var announcement = new Announcement("Example two has been reset", AnnouncementType.Info, "Reset Example Two Button");
       
        _inventoryDataTwo = new();
        _editContextTwo = new EditContext(_inventoryDataTwo);

        await _liveRegionService.MakeAnnouncement(announcement);
        await ResetButtonTwo.FocusAsync();
    }
    private async Task ResetEditContextThree()
    {
        var announcement = new Announcement("Example three has been reset", AnnouncementType.Info, "Reset Example Three Button");
       
        _inventoryDataThree = new();
        _editContextThree = new EditContext(_inventoryDataThree);

        await _liveRegionService.MakeAnnouncement(announcement);
        await ResetButtonThree.FocusAsync();
    }

    private async Task ResetEditContextFour()
    {
        var announcement = new Announcement("Example four has been reset", AnnouncementType.Info, "Reset Example Four Button");

        _inventoryDataFour = new();
