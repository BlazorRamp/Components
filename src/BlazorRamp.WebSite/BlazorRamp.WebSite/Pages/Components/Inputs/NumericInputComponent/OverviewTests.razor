                <NumericInput class="br-col-xs-12 br-col-sm-6" @bind-Value="_inventoryDataThree.UnitPrice" Required="true" Format="C" LabelText="Unit Price" ErrorsLabel="errors" HintText="The price per unit." UpdateOnInput="true"
