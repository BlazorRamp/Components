@using System.Web
@using Microsoft.AspNetCore.Components.Sections

@attribute [Route($"{GlobalValues.Root_Path_Components}/{GlobalValues.Component_Path_Part_Pager}/{GlobalValues.Common_Page_Path_Overview_Tests}")]

@inject NavigationManager _navigationManager

<PageTitle>@GlobalValues.Component_Name_Pager @GlobalValues.Common_Page_Title_Overview_Tests</PageTitle>

<section class="@GlobalValues.Info_Box_Class @GlobalValues.Info_Box_Coloured_Modifier">
    <h1 class="@GlobalValues.Info_Box_Heading_Class">@GlobalValues.Component_Name_Pager @GlobalValues.Common_Page_Title_Overview_Tests</h1>

    <p>
        The Pager component is used to help navigate between result set pages, such as pages of records displayed in a data table or pages that contains product listings. 
        For data tables the pager can be configured to use buttons for the page selectors and links when displaying product listings.
    </p>
    <p>
        <b>Released: </b>Current version <b>v1.0.2</b> See the documentation site for more information: <a target="_blank" class="@GlobalValues.Link_Class" href="@GlobalValues.Site_Link_Docs_Pager">Pager documentation (opens in new window)</a>
    </p>
</section>

<section class="@GlobalValues.Main_Nav_Section_Heading_SkipTo @GlobalValues.Info_Box_Class">

    <h2 class="@GlobalValues.Info_Box_Heading_Class">Information & instructions</h2>
    <p>
        The structure of the component is simply a <span class="code-span">nav</span> element that contains either buttons or links dependant on the components configuration options.
        The  <span class="code-span">nav</span> element has the <span class="code-span">aria-labelledby</span> attribute that uses two identifiers. The first part is a name such as Data Pager,
        the second points to the information seen above the buttons or links, so screen reader users on entering the pager or via landmark lists, will 
        have both the name of the pager and its state announced such as Data Pager, Current page 5 of 10.
    </p>
    <p>
        The Pager component has various design time and runtime configurable options, such as whether it uses buttons for when used with a data table or
        links for when used to page product listings. You can configure whether or not to show the first and last button/links. 
    </p>
    <p>
        The page information is runtime configurable and uses replacement tokens, so this text can be shorter or longer to suit the context.
    </p>
    <p>
        If a button or link is not required such as the first and previous ones when on the first page,these are styled differently and use <span class="code-span">aria-disabled</span> 
        as an indicator to screen reader users that there is currently nothing the button or link can do. Activating it just announces the current page information.
    </p>
    <p>
        Screen reader users on activating a button or link will have the information that is displayed next to th the buttons or links announced.
        <strong>Note: </strong>I use the my Live Region Service for these announcements, and the pager has been configured not to add these announcements
        to the rolling log normally viewed using the announcement history dialog accessed via the Alerts Button, bottom right of the page or using the
        key combination <kbd>Ctrl + Shift + H</kbd>.
    </p>
    <p>
        <strong>Note:</strong> As this is a site is single page application, the links will not lose focus unless you choose ot open in a new window
        in which case you would be at the start of the page and have to navigate back to the pager. Also note, this is hosted on GitPages which needs
        a bit of script for Blazor, I have not amended this, so you will not see any page numbers in the address bar as you normally would when using the 
        link style pagers.
    </p>

    <p>
        Below are four examples of the pagers using both buttons and links, with and without the First and Last selectors.
        Using the keys specified below to change navigate the result sets.
    </p>
    <h3 id="pager-keyboard" class="@GlobalValues.Info_Box_Heading_Class">Keyboard interaction</h3>

    <ul aria-labelledby="pager-keyboard">
        <li><kbd>Tab, Shift + Tab</kbd> - to set focus on a link or button, and move in either direction.</li>
        <li><kbd>Enter or Space</kbd> - when on a button activates it and changes the data page.</li>
        <li><kbd>Enter</kbd> - when on a link activates it and changes result page.</li>
    </ul>

</section>
<section class="@GlobalValues.Info_Box_Class">

    <h3 class="@GlobalValues.Info_Box_Heading_Class">Expectations</h3>

    <ul>
        <li>
            Tabbing or shift tabbing to the component should set focus on the first or last button or link within the pager.
        </li>
        <li>
            On entering the pager, screen reader users should have announced the name of the pager and its current state.
        </li>
        <li>
            Tabbing or shift tabbing should allow you to traverse the pager selectors.
        </li>
        <li>
            Using the enter or space key on a button should change the page, with the page information being announced to screen reader users. 
            If the result set is not filtered screen readers users will have announced what is displayed, the current page, number of pages and items. For a filtered
            result set the additional information shown is also announced such as 80 items filtered from 100.
        </li>
        <li>
            Using the enter key on a link should change the page, with the page information being announced to screen reader users.
            If the result set is not filtered screen readers users will have announced what is displayed, the current page, number of pages and items. For a filtered
            result set the additional information shown is also announced such as 80 items filtered from 100.
        </li>
        <li>
            If a page selector is not required such as the First and Previous selectors when the current page is 1, then these selectors will have the <span class="code-span">aria-disabled</span>
            attribute added. Excluding Narrator (see the next page quirks and issues), activating a disabled selector just announces the current page information., 
        </li>
        <li>
            Voice control users should be able to navigate the pager by using the appropriate commands along with the visible name such as click Next.
        </li>
    </ul>
</section>

<section class="@GlobalValues.Info_Box_Class">
    <h2 class="@GlobalValues.Info_Box_Heading_Class">Pager examples using buttons normally used above or below data tables</h2>

    <section class="@GlobalValues.Info_Box_Class">

        <h3 class="@GlobalValues.Info_Box_Heading_Class @GlobalValues.Tab_Stop_Indicator_Class" tabindex="0">Tab stop before a filtered data table pager (without table), first, previous, next and last buttons</h3>
    
            <Pager @bind-CurrentPage="@_fullButtonCurrentPage" AriaLabel="Four button pager" TotalItemCount="100" CurrentItemCount="80" ItemsPerPage="10" 
                PagerSelectorType="PagerSelectorType.Button" ShowFirstLast="true"></Pager>

    </section>
    <section class="@GlobalValues.Info_Box_Class">

        <h3 class="@GlobalValues.Info_Box_Heading_Class @GlobalValues.Tab_Stop_Indicator_Class" tabindex="0">Tab stop before a data table pager (without table), only previous and next buttons</h3>

        <Pager @bind-CurrentPage="_minButtonCurrentPage" AriaLabel="Two button pager" TotalItemCount="50" CurrentItemCount="50" ItemsPerPage="10" 
            PagerSelectorType="PagerSelectorType.Button" ShowFirstLast="false"></Pager>

    </section>
</section>

<section class="@GlobalValues.Info_Box_Class">

    <h2 class="@GlobalValues.Info_Box_Heading_Class">Pager examples using links, the type typically seen at the top or bottom of product listings</h2>


    <section class="@GlobalValues.Info_Box_Class">

        <h3 class="@GlobalValues.Info_Box_Heading_Class @GlobalValues.Tab_Stop_Indicator_Class" tabindex="0">Tab stop before a page results pager (without results), first, previous, next and last links</h3>

        <Pager @bind-CurrentPage="_fullLinkCurrentPage" AriaLabel="Four links pager" TotalItemCount="100" CurrentItemCount="100" ItemsPerPage="10" 
            PagerSelectorType="PagerSelectorType.Link" ShowFirstLast="true"></Pager>

    </section>
    <section class="@GlobalValues.Info_Box_Class">

        <h3 class="@GlobalValues.Info_Box_Heading_Class @GlobalValues.Tab_Stop_Indicator_Class" tabindex="0">Tab stop before a page results pager (without results), only the previous and next links</h3>

        <Pager @bind-CurrentPage="_minLinkCurrentPage" QueryParamName="another-page" AriaLabel="Two links pager" TotalItemCount="50" CurrentItemCount="50" 
        ItemsPerPage="10" PageCountText="Current page {currentpage} of {lastpage}" PagerSelectorType="PagerSelectorType.Link" ShowFirstLast="false"></Pager>

    </section>
</section>

@code{

    private int _fullButtonCurrentPage = 1;
    private int _minButtonCurrentPage  = 1;
    private int _fullLinkCurrentPage   = 1;
    private int _minLinkCurrentPage    = 1;

    protected override void OnInitialized()
    {
        //One time thing uses binding there after but you could also use [SupplyParameterFromQuery(Name = "page")]
        var pageValueFull = HttpUtility.ParseQueryString(new Uri(_navigationManager.Uri).Query).Get("page");
        var pageValueMin  = HttpUtility.ParseQueryString(new Uri(_navigationManager.Uri).Query).Get("another-page");

        _fullLinkCurrentPage = int.TryParse(pageValueFull, out int full) ? full : 1;
        _minLinkCurrentPage = int.TryParse(pageValueMin, out int min) ? min : 1;
    }
}


<div class="flex-content justify-content-between">
    <a class="@GlobalValues.Link_Button_Class @GlobalValues.Link_Button_Left_Arrow_Modifier" href="@($"{GlobalValues.Root_Path_Components}/{GlobalValues.Component_Path_Part_NavGroup}/{GlobalValues.Common_Page_Path_Quirks_Issues}")">
        <span aria-hidden="true"></span>
        <span>@GlobalValues.Component_Name_NavGroup - @GlobalValues.Common_Page_Title_Quirks_Issues</span>
        <span aria-hidden="true"></span>
    </a>
    <a class="@GlobalValues.Link_Button_Class @GlobalValues.Link_Button_Right_Arrow_Modifier" href="@($"{GlobalValues.Root_Path_Components}/{GlobalValues.Component_Path_Part_Pager}/{GlobalValues.Common_Page_Path_Quirks_Issues}")">
        <span aria-hidden="true"></span>
        <span>@GlobalValues.Component_Name_Pager - @GlobalValues.Common_Page_Title_Quirks_Issues</span>
        <span aria-hidden="true"></span>
    </a>

</div>
