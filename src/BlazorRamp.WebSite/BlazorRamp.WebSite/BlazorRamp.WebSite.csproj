<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\..\assets\BlazorRampKey.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="compilerconfig.json" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\Scripts\test-component.ts" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BlazorRamp.Accordion" Version="1.0.1" />
    <PackageReference Include="BlazorRamp.ActionsPopover" Version="2.1.3" />
    <PackageReference Include="BlazorRamp.BusyIndicator" Version="1.3.0" />
    <PackageReference Include="BlazorRamp.Core" Version="1.1.2" />
    <PackageReference Include="BlazorRamp.DataTable" Version="1.0.0" />
    <PackageReference Include="BlazorRamp.DebounceFilter" Version="1.1.0" />
    <PackageReference Include="BlazorRamp.DialogFramework" Version="1.0.2" />
    <PackageReference Include="BlazorRamp.Inputs" Version="1.8.2" />
    <PackageReference Include="BlazorRamp.NavGroup" Version="1.0.3" />
    <PackageReference Include="BlazorRamp.Pager" Version="1.0.3" />
    <PackageReference Include="BlazorRamp.SkipTo" Version="1.0.3" />
    <PackageReference Include="BlazorRamp.Switch" Version="1.0.0" />
    <PackageReference Include="BlazorRamp.Tabs" Version="1.0.0" />
    <PackageReference Include="BlazorRamp.ToggleTip" Version="1.0.2" />
    <PackageReference Include="BuildWebCompiler2022" Version="1.14.15" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.10" PrivateAssets="all" />
    <PackageReference Include="Microsoft.TypeScript.MSBuild" Version="6.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Validated.Blazor" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\assets\css\" />
    <Folder Include="wwwroot\assets\js\" />
    <Folder Include="wwwroot\assets\img\" />
    <Folder Include="wwwroot\css\" />
  </ItemGroup>

  <ItemGroup>
    <None Include="compilerconfig.json" />
  </ItemGroup>

  <ItemGroup>
    <TypeScriptCompile Include="Assets\Scripts\test-component.ts" />
  </ItemGroup>

	<ItemGroup>
		<None Update="tsconfig.json">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
			<CopyToPublishDirectory>Never</CopyToPublishDirectory>
			<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
		</None>
		<Content Update="tsconfig.json">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
			<CopyToPublishDirectory>Never</CopyToPublishDirectory>
			<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
		</Content>
	</ItemGroup>


</Project>
