@page "/"




<PageTitle>Home</PageTitle>

@rendermode InteractiveServer


<h1>Hello, world!</h1>

Welcome to your new app.

<EditForm EditContext="@_editContext" OnValidSubmit="HandleSubmit" novalidate style="background-color:aliceblue;">

    @*     <DataAnnotationsValidator /> *@

    <BlazorValidated TEntity="ContactDto" BoxedValidators="_contactBoxedValidators" AddDisplayName="true" />

    <InputErrorsSummary SummaryDisplay="SummaryDisplay.OnModelValidated">


        <InputNumber @bind-Value="_contactData.Age" />
        <div class="br-input-row">
            <NumericInput class="br-col-xs-12 br-col-sm-6" HintText="Some hint text about the type of entry" DataPosition="DataPosition.Start"
                          @bind-Value="_contactData.Age" UpdateOnInput="true" AriaDisabled="false" ValidationDisplayMode="ValidationDisplayMode.TabbableWithHint" Format="F2" />

            <NumericInput class="br-col-xs-12 br-col-sm-6" HintText="Some hint text about the type of entry" LabelText="Nullable Salary" DataPosition="DataPosition.End" SvgIcon="--svg-food-icon"
                          @bind-Value="_contactData.Salary" UpdateOnInput="true" AriaDisabled="false" ValidationDisplayMode="ValidationDisplayMode.TabbableWithHint" Format="F2" />
        </div>

        <div class="br-input-row">

            <TextInput class="br-col-xs-12 br-col-sm-6" autocomplete="given-name" @bind-Value="_contactData.GivenName" LabelText="Surname" AriaDisabled="true" HintText="The name that you use on official documents"
                       UpdateOnInput="true" SvgIcon="--svg-food-icon" ValidationDisplayMode="ValidationDisplayMode.TabbableWithHint" />

                   
        </div>

        <div class="br-input-row">

            <PasswordInput class="br-col-xs-12 br-col-sm-6" HintText="Some hint text about the type of entry" LabelText="Password"
                           @bind-Value="_contactData.Password" UpdateOnInput="true" AriaDisabled="false" SvgIcon="--svg-food-icon" ValidationDisplayMode="ValidationDisplayMode.TabbableWithHint" />

            <PasswordInput class="br-col-xs-12 br-col-sm-6" HintText="Some hint text about the type of entry" LabelText="Password Confirmation"
                           @bind-Value="_contactData.ConfirmPassword" UpdateOnInput="false" AriaDisabled="false" ValidationDisplayMode="ValidationDisplayMode.TabbableWithHint" />
        </div>

        <div class="br-input-row">
            <CheckboxInput class="br-col-xs-12 br-col-sm-6" HintText="You go a 50/50 chance of getting it right" @bind-Value="_contactData.IsAlive"
                           ValidationDisplayMode="ValidationDisplayMode.TabbableWithHint" />
        </div>

        <div class="br-input-row">
            <SelectInput class="br-col-xs-12 br-col-sm-6" @bind-Value="_contactData.ContactID" LabelText="Select Me" HintText="Select something" DataPosition="DataPosition.Centre" 
                         ErrorsLabel="Errors" ParseErrorMessage="Not able to apply this value please contact support." SvgIcon="--svg-food-icon">
                       <OptionValues>
                    <option value="0">Not Entered</option>
                    <option value="1">Option 1</option>
                    <option  value="2">Option 2</option>
                       </OptionValues>
            </SelectInput>   
        </div>



        <div class="br-input-row">

            @{
                var index = 0;
            }
            @foreach (var contactMethod in _contactData.ContactMethods)
            {

                <TextInput class="br-col-xs-12 br-col-sm-6" LabelText="" @bind-Value="contactMethod.MethodValue" HintText="Enter some value" ValidationDisplayMode="ValidationDisplayMode.TabbableWithHint" UpdateOnInput="true" />

                <div class="br-input-row">
                    <button class="btn btn-danger" type="button" @onclick="() => RemoveContactMethod(contactMethod)">Delete</button>
                    <hr />
                </div>
                index++;
            }

        </div>

    </InputErrorsSummary>

    <button class="btn btn-primary" type="submit">Submit</button>

</EditForm>
<button class="btn btn-primary" type="button" @onclick="AddContactMethod">Add Contact Method</button>
<button class="btn btn-primary" type="button" @onclick="Test">Click</button>

@code {

    private EditContext _editContext = default!;
    private ContactDto _contactData = StaticData.CreateContactObjectGraph();

    private ImmutableDictionary<string, BoxedValidator> _contactBoxedValidators = default!;

    protected override void OnInitialized()
    {
      
        _editContext = new EditContext(_contactData);
        _contactData.ContactID = 1;
        _contactData.FamilyName = null;

        var builder = BlazorValidationBuilder<ContactDto>.Create()
                        .ForMember(c => c.Title, ContactValidators.TitleValidator)                      //< using a ready built title member validator
                        .ForMember(c => c.GivenName, ContactValidators.GivenNameValidator)
                        .ForMember(c => c.FamilyName, ContactValidators.FamilyNameValidator)            // << This validator (function) combines two functions a regex and a separate length validator
                        .ForMember(c => c.Password, ContactValidators.PasswordValidator)            // << This validator (function) combines two functions a regex and a separate length validator
                        .ForNullableMember(c => c.NullableAge, ContactValidators.NullableAgeValidator)
                        .ForMember(c => c.Age, ContactValidators.AgeValidator)
                        .ForNullableMember(c => c.Salary, ContactValidators.SalaryValidator)
                        .ForMember(c => c.IsAlive, ContactValidators.IsAliveValidator)
                        .ForMember(c => c.ContactID, ContactValidators.ContactIDVallidator)
         // .ForComparisonWithValue(c => c.DOB, ContactValidators.DOBValidator)
         // .ForComparisonWithMember(c => c.CompareDOB, ContactValidators.CompareDOBValidator)
         // .ForNestedMember(c => c.Address, AddressValidators.GetBoxedAddressValidators())// << Getting all the address validators from a pre-created builder.
         .ForEachCollectionMember(c => c.ContactMethods, ContactMethodValidators.GetBoxedContactMethodValidators());
        // .ForCollection(c => c.ContactMethods, MemberValidators.CreateCollectionLengthValidator<List<ContactMethodDto>>(1, 3, "ContactMethods", "Contact methods", "Must have at least 1 contact method but no more than 3"));// << created on the fly

        
        _contactBoxedValidators = builder.GetBoxedValidators();

        //_contactData.ContactMethods = [];
    }

    private void Test()
    {
        _contactData = new();
        _editContext = new EditContext(_contactData);
    }
    public async Task HandleSubmit()
    {

    }
    private void AddContactMethod()

    => _contactData.ContactMethods.Add(new ContactMethodDto());

    private void RemoveContactMethod(ContactMethodDto contactMethod)

        => _contactData.ContactMethods.Remove(contactMethod);
}