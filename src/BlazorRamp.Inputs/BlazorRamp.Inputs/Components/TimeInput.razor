@typeparam TValue
@inherits TimeTypeInput<TValue>


<div @ref="ControlReference"
     @attributes="@GetAttributes(AdditionalAttributes)"
    id="@InputID"
    class="@TimeInputClasses" 
    role="group" 
    aria-labelledby="@ControlLabelledbyID"
    aria-invalid="true"
    aria-describedby="@(AriaDescribedByID)"
    aria-required="@(Required ? "true" : null)">
    

    <span id="@ControlLabelledbyID" class="@GlobalValues.Time_Input_Label_Class" @onmousedown:preventDefault>
        @LabelNameText
        @if (Required)
        {
            <span aria-hidden="true" class="@GlobalValues.Time_Input_Asterisk_Class"> *</span>
        }
    </span>
    @if (HintNormalised is not null)
    {
        <span id="@HintTextID" class="@GlobalValues.Time_Input_Hint_Class">
            @HintNormalised
        </span>
    }

    @if (false == String.IsNullOrWhiteSpace(SvgVariable))
    {
        <span aria-hidden="true" class="@GlobalValues.Time_Input_Icon_Class" style="@SvgVariable"></span>
    }
    else
    {
        <span aria-hidden="true"></span>
    }


    <div class="@GlobalValues.Time_Input_Field_Area_Class" data-br-input-position="@DataPosition.ToString().ToLower()">

        <div class="@GlobalValues.Time_Input_Segment_Wrapper_Class">

            <div class="@GlobalValues.Time_Input_Segment_Class">
                <label class="@GlobalValues.Time_Input_Segment_Label_Class" for="@HoursInputID">@HoursText</label>
                <input id="@HoursInputID" class="@GlobalValues.Time_Input_Field_Class" type="text" inputmode="numeric" 
                       readonly="@(base.ReadOnly ? "readonly" : null)"
                       aria-disabled="@(base.IsDisabled ? "true" : null)"
                       maxlength="2"
                       @ref="HoursReference"
                       @bind-value:get="HoursValue"
                       @bind-value:event="oninput"
                       @bind-value:set="HandleHoursSet"
                       @onfocus="() => HoursValue = StripLeadingZero(HoursValue)"       />
                       
            </div>

            <span aria-hidden="true">:</span>

            <div class="@GlobalValues.Time_Input_Segment_Class">
                <label class="@GlobalValues.Time_Input_Segment_Label_Class" for="@MinutesInputID">@MinutesText</label>
                <input id="@MinutesInputID" class="@GlobalValues.Time_Input_Field_Class" type="text" inputmode="numeric" 
                       readonly="@(base.ReadOnly ? "readonly" : null)"
                       aria-disabled="@(base.IsDisabled ? "true" : null)"
                        maxlength="2"
                       @ref="MinutesReference"
                       @bind-value:get="MinutesValue"
                       @bind-value:event="oninput"
                       @bind-value:set="HandleMinutesSet" 
                       @onfocus="() => MinutesValue = StripLeadingZero(MinutesValue)" />
            </div>

            @if (EnableSeconds)
            {
                <span aria-hidden="true">:</span>

                <div class="@GlobalValues.Time_Input_Segment_Class">
                    <label class="@GlobalValues.Time_Input_Segment_Label_Class" for="@SecondsInputID">@SecondsText</label>
                    <input id="@SecondsInputID" class="@GlobalValues.Time_Input_Field_Class" type="text" inputmode="numeric" 
                           readonly="@(base.ReadOnly ? "readonly" : null)"
                           aria-disabled="@(base.IsDisabled ? "true" : null)"
                           maxlength="2"
                           @ref="SecondsReference"
                           @bind-value:get="SecondsValue"
                           @bind-value:event="oninput"
                           @bind-value:set="HandleSecondsSet"
                           @onfocus="() => SecondsValue = StripLeadingZero(SecondsValue)" />
                </div>
            }
        </div>

    </div>

    <span class="@GlobalValues.Time_Input_State_Icon_Class" data-br-invalid-state="@GetInvalidStateAttributeValue(base.InvalidState)" aria-hidden="true"></span>

    <div class="@GlobalValues.Time_Input_Error_Wrapper_Class">

        @if (HasErrors)
        {
            <div class="@GlobalValues.Time_Input_Error_Class" tabindex="@(TabbableError ? "0" : null)" aria-label="@(TabbableError ? $"{LabelNameText.TrimEnd(':')} {ErrorsText}" : null)" role="@(TabbableError ? "region" : null)">

                <ul id="@ErrorMessageID">
                    @foreach (var errorMessage in InvalidMessages)
                    {
                        <li>@errorMessage</li>
                    }
                </ul>

            </div>
        }

    </div>

</div>
