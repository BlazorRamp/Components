@inherits TextAreaTypeInput

<div class="@TextAreaInputClasses">
    <label class="@GlobalValues.TextArea_Input_Label_Class" for="@InputID" @onmousedown:preventDefault>
        @LabelNameText
        @if (Required)
        {
            <span aria-hidden="true" class="@GlobalValues.TextArea_Input_Asterisk_Class"> *</span>
        }
    </label>
    @if (HintNormalised is not null)
    {
        <span id="@HintTextID" class="@GlobalValues.TextArea_Input_Hint_Class">
            @HintNormalised
        </span>
    }

    @if (false == String.IsNullOrWhiteSpace(SvgVariable))
    {
        <span aria-hidden="true" class="@GlobalValues.TextArea_Input_Icon_Class" style="@SvgVariable"></span>
    }
    else
    {
        <span aria-hidden="true"></span>
    }
    <div class="@GlobalValues.TextArea_Input_Field_Area_Class" style="@($"{GlobalValues.TextAraa_CSS_Row_Variable_Name}:{InputRows};")">

        <textarea @ref="ControlReference" @attributes="@GetAttributes(AdditionalAttributes)" class="@TextAreaClasses" id="@InputID"
               type="textarea"
               rows="@InputRows"
               aria-invalid="@(HasErrors ? "true" : null)"
               aria-describedby="@(AriaDescribedByID)"
               aria-required="@(Required ? "true" : null)"
               aria-disabled="@(base.IsDisabled ? "true" : null)"
               readonly="@(base.ReadOnly ? "readonly" : null)"
               @onblur="HandleOnBlur"
               @bind-value:get="@TextAreaValue"
               @bind-value:event="@(UpdateOnInput ? "oninput" : "onchange")"
               @bind-value:set="HandlePropertySet"
               data-br-input-position="@DataPosition.ToString().ToLower()" />

            <span class="@GlobalValues.TextArea_Input_Field_Counter_Class">
                Number of characters
            </span>
    </div>

    <span class="@GlobalValues.TextArea_Input_State_Icon_Class" data-br-invalid-state="@GetInvalidStateAttributeValue(base.InvalidState)" aria-hidden="true"></span>

    <div class="@GlobalValues.TextArea_Input_Error_Wrapper_Class">

        @if (HasErrors)
        {
            <div class="@GlobalValues.TextArea_Input_Error_Class" tabindex="@(TabbableError ? "0" : null)" aria-label="@(TabbableError ? $"{LabelNameText.TrimEnd(':')} {ErrorsText}" : null)" role="@(TabbableError ? "region" : null)">

                <ul id="@ErrorMessageID">
                    @foreach (var errorMessage in InvalidMessages)
                    {
                        <li>@errorMessage</li>
                    }
                </ul>

            </div>
        }

    </div>

</div>

