@typeparam TValue
@inherits NumericTypeInput<TValue>

<div class="@NumericInputClasses">
    <label class="@GlobalValues.Numeric_Input_Label_Class" for="@InputID">
        @LabelText
        @if (_required)
        {
            <span aria-hidden="true" class="@GlobalValues.Numeric_Input_Asterisk_Class"> *</span>
        }
    </label>
    @if (HintNormalised is not null)
    {
        <span id="@HintTextID" class="@GlobalValues.Numeric_Input_Hint_Class">
            @HintNormalised
        </span>
    }
    
    @if (false == String.IsNullOrWhiteSpace(SvgVariable))
    {
        <span aria-hidden="true" class="@GlobalValues.Numeric_Input_Icon_Class" style="@SvgVariable"></span>
    }
   
    <input @ref="ControlReference" @attributes="@GetAttributes(AdditionalAttributes)" class="@GlobalValues.Numeric_Input_Field_Class" id="@InputID"
           type="text"
           inputmode="@InputMode"
           aria-invalid="@(base.HasErrors ? "true" : null)"
           aria-describedby="@(base.AriaDescribedByID)"
           aria-required="@(_required ? "true" : null)"
           aria-disabled="@(base.IsDisabled ? "true" : null)"
           readonly="@(base.ReadOnly ? "readonly" : null)"
           @onblur="HandleOnBlur"
           @bind-value:get="@_stringValue"
           @bind-value:event="@(UpdateOnInput ? "oninput" : "onchange")"
           @bind-value:set="HandlePropertySet" />

    <span class="@StateIconClasses" aria-hidden="true"></span>

    <div class="@GlobalValues.Numeric_Input_Error_Wrapper_Class">
        
        @if (HasErrors)
        {
            <div id="@ErrorMessageID" class="@GlobalValues.Numeric_Input_Error_Class" tabindex="@(TabbableError ? "0" : null)" aria-label="@(TabbableError ? $"{LabelText.TrimEnd(':')} {ErrorsText}" : null)" role="@(TabbableError ? "region" : null)">

                <ul>
                    @foreach (var errorMessage in InvalidMessages)
                    {
                        <li>@errorMessage</li>
                    }
                </ul>

            </div>
        }

    </div>

</div>

