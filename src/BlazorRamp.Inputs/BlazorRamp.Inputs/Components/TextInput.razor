@inherits TextTypeInput

<div class="@TextInputClasses">
    <label class="@GlobalValues.Text_Input_Label_Class" for="@InputID">
        @DisplayNameText
        @if (Required)
        {
            <span aria-hidden="true" class="@GlobalValues.Text_Input_Asterisk_Class"> *</span>
        }
    </label>
    @if (HintNormalised is not null)
    {
        <span id="@HintTextID" class="@GlobalValues.Text_Input_Hint_Class">
            @HintNormalised
        </span>
    }
    
    @if (false == String.IsNullOrWhiteSpace(SvgVariable))
    {
        <span aria-hidden="true" class="@GlobalValues.Text_Input_Icon_Class" style="@SvgVariable"></span>
    }
   
    <input @ref="ControlReference" @attributes="@GetAttributes(AdditionalAttributes)" class="@GlobalValues.Text_Input_Field_Class" id="@InputID"
           type="@InputType" 
           aria-invalid="@(HasErrors ? "true" : null)" 
           aria-describedby="@(AriaDescribedByID)"
           aria-required="@(Required ? "true" : null)"
           aria-disabled="@(base.IsDisabled ? "true" : null)"
           readonly="@(base.ReadOnly ? "readonly" : null)"
           @bind-value:get="@CurrentValueAsString"
           @bind-value:event="@(UpdateOnInput ? "oninput" : "onchange")"
           @bind-value:set="HandlePropertySet" 
 />

    <span class="@StateIconClasses" aria-hidden="true"></span>

    <div class="@GlobalValues.Text_Input_Error_Wrapper_Class">
        
        @if (HasErrors)
        {
            <div id="@ErrorMessageID" class="@GlobalValues.Text_Input_Error_Class" tabindex="@(TabbableError ? "0" : null)" aria-label="@(TabbableError ? $"{DisplayNameText.TrimEnd(':')} {ErrorsText}" : null)" role="@(TabbableError ? "region" : null)">

            <ul>
                @foreach (var errorMessage in InvalidMessages)
                {
                    <li>@errorMessage</li>
                }
            </ul>

            </div>
        }

    </div>

</div>

