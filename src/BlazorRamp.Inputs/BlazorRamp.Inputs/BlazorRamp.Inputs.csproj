<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
	  <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\..\assets\BlazorRampKey.snk</AssemblyOriginatorKeyFile>
    <Title>BlazorRamp.Inputs</Title>
    <Version>1.0.5</Version>
    <Authors>Paul Kent</Authors>
    <Description>Base set of the simple inputs for the Blazor Ramp ecosystem</Description>
    <PackageProjectUrl>https://github.com/BlazorRamp/Components</PackageProjectUrl>
    <RepositoryUrl>https://github.com/BlazorRamp/Components</RepositoryUrl>
    <Copyright>Copyright (c) 2026 Paul Kent and BlazorRamp Contributors</Copyright>
    <PackageTags>Blazor; Accessible Components; Accessibility; ARIA; TextIInput; PasswordInput; NumericInput; Input;</PackageTags>
    <PackageReleaseNotes>Amended display to show full erroneous value for decimal formatted strings.</PackageReleaseNotes>
    <AssemblyVersion>1.0.5</AssemblyVersion>
    <FileVersion>1.0.5</FileVersion>
	  <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
	  <Deterministic>true</Deterministic>
	  <PackageReadmeFile>README.md</PackageReadmeFile>
	  <PackageLicenseFile>LICENSE</PackageLicenseFile>
  </PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<DebugType>embedded</DebugType>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<DebugType>embedded</DebugType>
	</PropertyGroup>

  <ItemGroup>
    <Content Remove="compilerconfig.json" />
  </ItemGroup>


  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BlazorRamp.Core" Version="1.0.8" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="8.0.25" />
	  <PackageReference Include="BuildWebCompiler2022" Version="1.14.15">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	  </PackageReference>
	  
	  <!-- 
		It seems having the typesript msbuild causes the static asset errors. The compiler works without it
		but you cannot debug - so include it when debugging.
	  -->
	  <!--<PackageReference Include="Microsoft.TypeScript.MSBuild" Version="6.0.3">
	    <PrivateAssets>all</PrivateAssets>
	    <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	  </PackageReference>-->
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\LICENSE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="compilerconfig.json" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\assets\css\" />
    <Folder Include="wwwroot\assets\js\" />
  </ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="BlazorRamp.Inputs.Tests.Unit" key="" />
	</ItemGroup>
	
</Project>
