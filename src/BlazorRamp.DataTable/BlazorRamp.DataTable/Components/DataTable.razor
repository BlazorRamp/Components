
@typeparam TData
@attribute [CascadingTypeParameter(nameof(TData))]

<CascadingValue Value="this" IsFixed="true">
    @TableColumns
</CascadingValue>

@if (_tableColumns.Count == 0) return;

<div class="@GlobalValues.DataTable_Class">
    <div id="@_tableTitleID" class="@(TitleHidden ? $"{GlobalValues.DataTable_Title_Class} {GlobalValues.DataTable_Title_Hidden_Modifier}" : GlobalValues.DataTable_Title_Class)" 
        data-br-data-position="@DataTableHelper.GetTitlePosition(TitleAlignment)">
        @_tableTitle
    </div>

    <div class="@GlobalValues.DataTable_Filter_Area_Class">
        <div data-br-filter-position="@DataTableHelper.GetFilterPosition(FilterAlignment)">
            @Filter
        </div>
    </div>

    <div class="@GlobalValues.DataTable_Top_Pager_Class">@TopPager</div>

    <div class="@GlobalValues.DataTable_Content_Wrapper_Class">

        <BusyIndicator ShowIndicator="@_showTableSpinner" Replayable="false" AriaEndText="@_operationCompletedAnnouncement"
                       ContentPosition="ContentPosition.Centre" UseAssertive="false" UseClearOverlay="true" DelayBeforeCloseMS="100"></BusyIndicator>
        
        <div @ref="ContentElementRef" class="@GlobalValues.DataTable_Content_Class" style="@_tableHeightStyle">

            <table @attributes="@AdditionalAttributes" aria-labelledby="@_tableTitleID" aria-rowcount="@_dataSource.Count" tabindex="@(AddTableTabIndex ? "0" : "-1")" @ref="@TableElementRef">
            <thead>
                <tr>
                    @foreach (var column in _tableColumns)
                    {
                        @if (column is DataColumn<TData> dataColumn)
                        {
                            var ariaSortValue = column.ColumnSortDirection == ColumnSortDirection.NotSorted ? null : (column.ColumnSortDirection == ColumnSortDirection.Ascending ? "ascending" : "descending");
                            <th aria-sort="@ariaSortValue" scope="col" data-br-data-position="@DataTableHelper.GetDataPosition(dataColumn.ColumnAlignment)" style="@dataColumn.HeaderStyle" >
                                @{
                                    CheckAddSortable(dataColumn, ariaSortValue);
                                }
                            </th>
                            continue;
                        }
                        <th scope="col" data-br-data-position="@DataTableHelper.GetDataPosition(column.ColumnAlignment)" style="@column.HeaderStyle">

                            @if (column is TemplateColumn<TData> templateColumn && templateColumn.HeaderTemplate is not null)
                            {
                                @templateColumn.HeaderTemplate(column.Title)
                            }
                            else
                            {
                                @column.Title
                            }
                        </th>
                    }
                    @if (RowSelectionMode != RowSelectionMode.None) { AddCheckBoxColumnHeader(); }
                </tr>
            </thead>
                <tbody>

                @if (PagerBinding is not null || (PagerBinding is null && VirtualizeItemSizePX < 1))
                {
                    AddRows();
                }
                else
                {
                    AddVirtualizedRows();
                }
                @if (_dataPage.Count == 0)
                {
                    <tr class="@GlobalValues.DataTable_Row_No_Data_Class" data-br-last-row="true"><td colspan="@_tableColumns.Count">@_noDataText</td></tr>
                }
            </tbody>
        </table>
        <span id="@_pressSortTextID" hidden>@_pressToSortText</span>
    </div>
    
    </div>

    <div class="@GlobalValues.DataTable_Bottom_Pager_Class">@BottomPager</div>

    @if(false == _usePaging && _dataSource.Count > 0)
    {
        <div class="@GlobalValues.DataTable_Messages_Class">@_displayCountMessage</div>
    }
   

</div>

@{
    void CheckAddSortable(DataColumn<TData> dataColumn, string? sortDirection)
    {
        @if (true == dataColumn.IsSortable)
        {
            <button type="button" class="@GlobalValues.DataTable_Column_Sorter_Class" @onclick="() => HandleColumnHeaderClick(dataColumn)" 
                    data-br-data-position="@DataTableHelper.GetDataPosition(dataColumn.ColumnAlignment)" aria-describedby="@_pressSortTextID">

                <span class="@GlobalValues.DataTable_Column_Title_Class">@dataColumn.Title</span>
                <span class="@GlobalValues.DataTable_Column_Icon_Class" data-br-aria-sort="@sortDirection" aria-hidden="true"></span>
            
            </button>
            return;
        }
        <span class="@GlobalValues.DataTable_Column_Title_Class">@dataColumn.Title</span>
    }

    void AddRows()
    {
        @if (_dataPage.Count == 0) { return; }

         var isRowSelectable = RowSelectionMode != RowSelectionMode.None;
         var selectableModifier = isRowSelectable ? GlobalValues.DataTable_Data_Row_Selectable_Modifier : "";

        @for (int index = 0; index < _dataPage.Count; index++)
        {
            var rowItem     = _dataPage[index];
            var containsRow = _selectedRows.Contains(rowItem);
            var isSelected  = isRowSelectable && containsRow;
            var selectClass = isSelected ? GlobalValues.DataTable_Data_Row_Selected_Modifier : selectableModifier;
            string? lastRow = index == _dataPage.Count - 1 ? "true" : null;

            <tr @key="@rowItem" class="@DataTableHelper.BuildClassList(GlobalValues.DataTable_Data_Row_Class, selectClass)" style="@(RowStyleFunc is not null ? RowStyleFunc(rowItem) : null)"
                @onclick="(e) => HandleOnSelectedRow(e, rowItem)" data-br-last-row="@lastRow">

                @foreach (var column in _tableColumns)
                {
                    @if (column is DataColumn<TData> dataColumn)
                    {
                        var dataValue = dataColumn.ValueGetter!(rowItem);
                        var cellFuncStyle = dataColumn.CellStyleFunc is not null ? dataColumn.CellStyleFunc(rowItem) : null;

                        @if (dataColumn.CellTemplate is null)
                        {
                            <td data-br-data-position="@DataTableHelper.GetDataPosition(dataColumn.ColumnAlignment)" style="@($"{column.CellStyle}{(cellFuncStyle is null ? null : cellFuncStyle)}")">
                                @(column.HasFormatString ? DataTableHelper.FormatValue(dataValue, dataColumn.FormatString) : dataValue)
                            </td>

                        }
                        else
                        {
                            <td data-br-data-position="@DataTableHelper.GetDataPosition(dataColumn.ColumnAlignment)" style="@column.CellStyle">@dataColumn.CellTemplate!(rowItem)</td>
                        }
                        continue;
                    }
                    <td class="@GlobalValues.DataTable_Template_Column_Cell_Class" data-br-data-position="@DataTableHelper.GetDataPosition(column.ColumnAlignment)" style="@column.CellStyle">
                        @if (column.CellTemplate is not null){@column.CellTemplate!(rowItem)}
                    </td>
                }
                @if (isRowSelectable) { AddCheckBox(rowItem, containsRow); }
            </tr>
        }
    }


    void AddVirtualizedRows()
    {

        @if(_dataPage.Count == 0){ return; }

        var isRowSelectable = RowSelectionMode != RowSelectionMode.None;
        var selectableModifier = isRowSelectable ? GlobalValues.DataTable_Data_Row_Selectable_Modifier : "";

        <Virtualize TItem="TData" Items="@_dataPage" Context="rowItem" ItemSize="@VirtualizeItemSizePX" SpacerElement="tr" OverscanCount="@(OverscanCount < 1 ? GlobalValues.DataTable_OverscanCount : OverscanCount)" >
            @{
                var containsRow = _selectedRows.Contains(rowItem);
                var isSelected = isRowSelectable && containsRow;
                var selectClass = isSelected ? GlobalValues.DataTable_Data_Row_Selected_Modifier : selectableModifier;
                var lastRow = _dataPage.Count > 0 && EqualityComparer<TData>.Default.Equals(rowItem, _dataPage[^1]) ? "true" : null;

            }
            <tr @key="@rowItem" class="@DataTableHelper.BuildClassList(GlobalValues.DataTable_Data_Row_Class, selectClass)" style="@(RowStyleFunc is not null ? RowStyleFunc(rowItem) : null)"
                @onclick="(e) => HandleOnSelectedRow(e, rowItem)" data-br-last-row="@lastRow" >

                @foreach (var column in _tableColumns)
                {
                    @if (column is DataColumn<TData> dataColumn)
                    {

                        var dataValue = dataColumn.ValueGetter!(rowItem);
                        var cellFuncStyle = dataColumn.CellStyleFunc is not null ? dataColumn.CellStyleFunc(rowItem) : null;

                        @if (dataColumn.CellTemplate is null)
                        {
                            <td data-br-data-position="@DataTableHelper.GetDataPosition(dataColumn.ColumnAlignment)" style="@($"{column.CellStyle}{(cellFuncStyle is null ? null : cellFuncStyle)}")">
                                @(column.HasFormatString ? DataTableHelper.FormatValue(dataValue, dataColumn.FormatString) : dataValue)
                            </td>
                        }
                        else
                        {
                            <td data-br-data-position="@DataTableHelper.GetDataPosition(dataColumn.ColumnAlignment)" style="@column.CellStyle">@dataColumn.CellTemplate!(rowItem)</td>
                        }
                        continue;
                    }

                    <td data-br-data-position="@DataTableHelper.GetDataPosition(column.ColumnAlignment)" style="@column.CellStyle">
                        @if (column.CellTemplate is not null){@column.CellTemplate!(rowItem)}
                    </td>
                }
                @if (isRowSelectable)
                {
                    var checkboxLabel = RowIdentifierFunc is not null ? RowIdentifierFunc(rowItem) : null;

                    <td class="@GlobalValues.DataTable_Row_Selector_Class">
                        <input type="checkbox" checked="@containsRow"
                               aria-label="@checkboxLabel" aria-labelledby="@(checkboxLabel is null ? _selectRowLabelID : null)" @onchange="(args) => ToggleSelection((bool)args.Value!, rowItem)" @onclick:stopPropagation="true" />
                    </td>
                }

            </tr>
        </Virtualize>
    }
    void AddCheckBoxColumnHeader()
    {
        <th scope="col" id="@_selectRowLabelID" class="@GlobalValues.DataTable_Column_Selector_Class">
           @_rowSelectHeading
        </th>
    }
    void AddCheckBox(TData rowItem, bool containsRow)
    {
        var checkboxLabel = RowIdentifierFunc is not null ? RowIdentifierFunc(rowItem) : null;

        <td class="@GlobalValues.DataTable_Row_Selector_Class">
            <input type="checkbox" checked="@containsRow"
                   aria-label="@checkboxLabel" aria-labelledby="@(checkboxLabel is null ? _selectRowLabelID : null)" @onchange="(args) => ToggleSelection((bool)args.Value!, rowItem)" @onclick:stopPropagation="true" />
        </td>
    }


}