@page "/"
@using System.Diagnostics



@rendermode @(new InteractiveServerRenderMode(true))

<PageTitle>Home</PageTitle>
<p>Before table paragraph</p>

<DataTable TData="Contact" TitleAlignment="TitleAlignment.Start" FilterAlignment="FilterAlignment.End" TitleHidden="false" DataSource="@_contacts" DefaultSortIndex="2" 
               FilterRule="@_filterRule" RowSelectionMode="RowSelectionMode.Single" RowStyleFunc="@rowStyleFunc" RowSelectHeading="Pick" 
               SelectedRowsChanged="HandleRowsChanged" TableHeight="500px">
    <Filter>
        <DebounceFilter HintText="Filters across all columns of the table" RegexPattern="^[A-Za-z0-9]*$" OnDebounceFilterResult="HandleOnDebounce"
        ValidationMessage="Invalid filter, filtering paused, letters and numbers only"  />
    </Filter>
    <TopPager>



    </TopPager>
    <TableColumns>
        <DataColumn DataProperty="d => d.ContactID" DisplayName="Contact id" IsSortable="true" />
        <DataColumn DataProperty="d => d.Title" DisplayName="Title" IsSortable="true" />
        <DataColumn DataProperty="d => d.GivenName" DisplayName="First name" IsSortable="true" />
        <DataColumn DataProperty="d => d.FamilyName" DisplayName="Surname" IsSortable="true" ColumnAlignment="ColumnAlignment.Start" />
        <DataColumn DataProperty="d => d.Country" DisplayName="Country of residence" IsSortable="true">
                <CellTemplate Context="rowItem">
                    @if (rowItem.Country == "United Kingdom")
                    {
                        <span style="display:inline-flex;align-items:center;gap:0.75rem;">
                            <span class="united-kingdom-flag-icon" aria-hidden="true"></span>
                            <a href="https://www.rct.uk/visit/buckingham-palace" target="_blank">
                                @rowItem.Country
                            </a>
                        </span>

                        return;
                    }
                    @rowItem.Country
                </CellTemplate>
        </DataColumn>
            <DataColumn DataProperty="d => d.DateOfBirth" DisplayName="Date of birth" ColumnAlignment="ColumnAlignment.Centre" />
            <DataColumn DataProperty="d => d.Rate" DisplayName="Hourly Rate" ColumnAlignment="ColumnAlignment.End" CellFormat="C" IsSortable="true" />
@*         <TemplateColumn ColumnAlignment="ContentAlignment.Centre" CellStyle="width:100px;word-break: keep-all;" HeaderStyle="width:100px;">
            <HeaderTemplate>Test</HeaderTemplate>
            <CellTemplate Context="rowItem" >nothing</CellTemplate>
        </TemplateColumn> *@
    </TableColumns>
    <BottomPager>
@*             <Pager @bind-CurrentPage="@_pagerBinding.CurrentPage" AriaLabel="Two button pager" TotalItemCount="@_pagerBinding.TotalItemCount" CurrentItemCount="@_pagerBinding.CurrentItemCount" ItemsPerPage="@_pagerBinding.ItemsPerPage"
                   PagerSelectorType="PagerSelectorType.Button" ShowFirstLast="true" PageAlignment="PageAlignment.End" AddApplicationRole="true" /> *@
    </BottomPager>
</DataTable>

<p>After table paragraph</p>
<p>After table paragraph</p>
<p>
    Lorem ipsum dolor sit amet, consectetur adipiscing elit. Ut dapibus interdum risus, eu consectetur mauris semper tempus. Suspendisse aliquet hendrerit posuere.
    Aliquam maximus dui porta odio blandit porttitor. Donec lobortis dui dolor, vitae aliquet urna pretium vitae. Vivamus id augue enim. Nullam facilisis vitae mi
    ac varius. Fusce suscipit convallis ante maximus rhoncus. In ac dictum sem, nec finibus metus. Proin eget lectus faucibus, tincidunt lorem et, rhoncus nibh.
    Maecenas efficitur ultricies accumsan.
</p>

@code{

    private PagerBinding _pagerBinding = new(0, 0, 0, 10);

    private List<Contact> _contacts = [];

    private Func<Contact, bool>? _filterRule = null;


    private Func<Contact, string?> rowStyleFunc = (data) => data.FamilyName == "Adams" ? "color:red" : null;

    private Func<Contact, string> checkboxLabel = (data) => $"For contact {data.ContactID}, {data.GivenName} {data.FamilyName}";

    protected override void OnInitialized()
    {
        _contacts = StaticData.GetContacts(100_000);

        base.OnInitialized();
    }

    private async Task HandleOnDebounce(DebouncedFilterResult debounceResult)
    {
        if (debounceResult.IsValid)
        {
            _filterRule = (data) => data.ContactID.ToString().Contains(debounceResult.FilterValue, StringComparison.OrdinalIgnoreCase)
                                    || data.GivenName.Contains(debounceResult.FilterValue, StringComparison.OrdinalIgnoreCase)
                                    || data.FamilyName.Contains(debounceResult.FilterValue, StringComparison.OrdinalIgnoreCase)
                                    || data.Country.ToString().Contains(debounceResult.FilterValue, StringComparison.OrdinalIgnoreCase)
                                    || (data.DateOfBirth.ToString() ?? string.Empty).Contains(debounceResult.FilterValue, StringComparison.OrdinalIgnoreCase);


            await InvokeAsync(StateHasChanged);
        }
    }

    public async Task HandleRowsChanged(List<Contact> selectedData)
    {
        if(selectedData.Count > 0)
        {
            Debug.WriteLine($"Selected contact {selectedData[0]}");
        }
       
    }
}