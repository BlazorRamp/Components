
<button class="@GlobalValues.Switch_Class" type="button" role="switch" aria-checked="@_switchState.ToString().ToLower()"
        @onclick="() => RaiseOnSwitchStateChanged(!_switchState)" aria-label="@Label" aria-disabled="@Disabled.ToString().ToLower()">

    <span class="@GlobalValues.Switch_Label_Class">@Label</span>

    <span class="@GlobalValues.Switch_Track_Class">
        <span class="@GlobalValues.Switch_Thumb_Class"></span>
    </span>

</button>