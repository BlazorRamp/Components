@page "/"


@rendermode InteractiveServer

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>
<Switch @bind-SwitchState="@_switchState" Label="Airplane mode:" Disabled="@_switchDisabled" SpaceBetween="true" />
<Switch @bind-SwitchState="@_switchState" Label="Airplane mode:" Disabled="@_switchDisabled" SpaceBetween="true" />


Welcome to your new app


      
<input type="text" value="Paul" />


<button type="button" @onclick="() => _switchDisabled = !_switchDisabled">Toggle Disabled</button>

<Switch SwitchState="@_switchState" Label="Airplane mode:" Disabled="@_switchDisabled" SwitchStateChanged="HandleSwitchChange" />

@code {

    private bool _switchState    = false;
    private bool _switchDisabled = false;

    private void HandleSwitchChange(bool switchState)
    {
        _switchState = switchState;
    }
}