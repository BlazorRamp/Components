@page "/"
@using BlazorRamp.CssClasses


<PageTitle>Home</PageTitle>

@rendermode @(new InteractiveServerRenderMode(false))


<section class="@FlexContent.Base @Gap.SetGaps(UnitGapSize.Five)" >

    <span class="@Badge.Base @Badge.Size(BadgeSize.Tiny) @Badge.Scheme(BadgeSolidScheme.Danger)">
        <span class="@SvgIcon.Base @SvgIcon.Size(UnitIconSize.Small)" style="--_svg-icon-source:var(--svg-food-icon);"></span>
        <span>Tiny Badge</span>
    </span>


    <span class="@Badge.Base @Badge.Size(BadgeSize.Small) @Badge.Scheme(BadgeSolidScheme.DangerLighter)">
        <span class="@SvgIcon.Base @SvgIcon.Size(UnitIconSize.Small)" style="--_svg-icon-source:var(--svg-food-icon);"></span>
        Small Badge
        </span>
    
    
    <span class="@Badge.Base @Badge.Size(BadgeSize.Medium)">
        <span class="@SvgIcon.Base @SvgIcon.Size(UnitIconSize.Regular)" style="--_svg-icon-source:var(--svg-settings-icon);"></span>
        Medium Badge</span>
    
    
    <span class="@Badge.Base @Badge.Size(BadgeSize.Large) @Badge.TransparentBorder">
        <span class="@SvgIcon.Base @SvgIcon.Size(UnitIconSize.Large)" style="--_svg-icon-source:var(--svg-settings-icon);"></span>
        Larger Badge</span>

</section>

<section>
 
    <h3 id="my-table-heading">Table title</h3>
            <div class="@Section.Base @Section.Bordered @Section.NoPadding @Section.NoMarginBlock @Section.FixedRadius(UnitRadius.Five) @Section.Bordered">
        <div style="max-height: 350px;" class="@Section.Base @Section.NoPadding @Section.NoMarginBlock @Overflow.XY(UnitScroll.Auto) ">
            <table class="@Table.Base @Table.StripedRows @Table.NoBorder @Table.HoverRows"  tabindex="0" aria-labelledby="my-table-heading">
                <thead>
                    <tr>
                        <th scope="col">Date</th>
                        <th scope="col">Temp. (C)</th>
                        <th scope="col">Temp. (F)</th>
                        <th scope="col">Summary</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var forecast in _forecasts)
                    {
                        <tr>
                            <td>@forecast.Date.ToShortDateString()</td>
                            <td>@forecast.TemperatureC</td>
                            <td>@forecast.TemperatureF</td>
                            <td>@forecast.Summary</td>
                        </tr>
                    }
                </tbody>
            </table>
          </div>
    </div>
   
</section>
<p>
    test
</p>
    <table class="@Table.Base @Table.StripedRows 
        @Table.AlignColumn(UnitColumn.Two, UnitTextAlign.Centre)
        @Table.AlignColumn(UnitColumn.Three, UnitTextAlign.End)
        @Table.AlignColumn(UnitColumn.Five, UnitTextAlign.Start)">
  
        <thead>
            <tr>
                <th scope="col">Date</th>
                <th scope="col">Temp. (C)</th>
                <th scope="col">Temp. (F)</th>
                <th scope="col">Summary</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var forecast in _forecasts)
            {
                <tr>
                    <td>@forecast.Date.ToShortDateString()</td>
                    <td>@forecast.TemperatureC</td>
                    <td>@forecast.TemperatureF</td>
                    <td>@forecast.Summary</td>
                </tr>
            }
        </tbody>
    </table>

    <div>
        <pre>


            d


            d

            d
        </pre>
    </div>

@code {

    private List<WeatherForecast> _forecasts = [];


    protected override void OnInitialized()
    {
        var startDate = DateOnly.FromDateTime(DateTime.Now);
        var summaries = new[] { "Freezing", "Bracing", "Chilly", "Cool", "Mild", "Warm", "Balmy", "Hot", "Sweltering", "Scorching" };

        _forecasts = Enumerable.Range(1, 10)
                        .Select(index => new WeatherForecast(startDate.AddDays(index), Random.Shared.Next(-20, 55), summaries[Random.Shared.Next(summaries.Length)])).ToList();

    }
    private record WeatherForecast(DateOnly Date, int TemperatureC, string? Summary)
    {
        public int TemperatureF => 32 + (int)(TemperatureC / 0.5556);
    }
}
