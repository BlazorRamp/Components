
@if(_isInteractive)
{
    <a class="@BuildClassList(SkipToType)" href="@_relativeUrl" target="_self" @onclick:stopPropagation="true" @onclick:preventDefault="true" @onclick="() => HandleNavigation(_relativeUrl, _targetID)"
       data-br-skip-to="@SkipToType.ToString().ToLower()" data-br-component="@GlobalValues.Component_Name">

        <span class="@GlobalValues.SkipTo_Content_Class">
            @if (_iconVisible)
            {
                <span class ="@GlobalValues.SkipTo_Icon_Class"></span>
            }
            <span>@_skipToText</span>
        </span>
    </a>
}
else
{
    <a class="@GlobalValues.SkipTo_Class" href="@_targetID" target="_self" data-br-skip-to="@SkipToType.ToString().ToLower()" data-br-component="@GlobalValues.Component_Name">

        <span class="@GlobalValues.SkipTo_Content_Class">
            @if (_iconVisible)
            {
                <span class="@GlobalValues.SkipTo_Icon_Class"></span>
            }
            <span>@_skipToText</span>
        </span>
    </a>
}

