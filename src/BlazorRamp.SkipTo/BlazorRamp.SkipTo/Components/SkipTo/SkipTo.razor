
@if(_isInteractive)
{
    <a class="@BuildClassList(SkipToType)" href="@_relativeUrl" @onclick:stopPropagation="true" @onclick:preventDefault="true" @onclick="() => HandleNavigation(_relativeUrl, _targetID)">

        <span class="@GlobalValues.SkipTo_Content_Class">
            @if (_iconVisible)
            {
                <span class ="@GlobalValues.SkipTo_Icon_Class"></span>
            }
            <span>@_skipToText</span>
        </span>
    </a>
}
else
{
    <a class="@GlobalValues.SkipTo_Class" href="@_targetID" target="_self">

        <span class="@GlobalValues.SkipTo_Content_Class">
            @if (_iconVisible)
            {
                <span class="@GlobalValues.SkipTo_Icon_Class"></span>
            }
            <span>@_skipToText</span>
        </span>
    </a>
}

