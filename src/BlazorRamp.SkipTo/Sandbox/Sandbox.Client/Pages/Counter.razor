@page "/counter"
@using BlazorRamp.SkipTo.Common.Constants

@rendermode @(new InteractiveWebAssemblyRenderMode(false))
<PageTitle>Counter</PageTitle>

<h1>Counter</h1>
<SkipTo SkipToText="Skip Text" IconVisible="true" TargetID="section-content-two" SkipToType="SkipToType.Section"  />
<p role="status">Current count: @currentCount</p>

<pre>
    








    sfssf




    sfs







    sdfsaf












    safsf













    sdfsdfs

























    dddd






    wwwwwwwwww



















    eeeeeeeeeeeeeeeee











    rrrrrrrrrrrrrrrrrr








    ttttttttttttttt










</pre>

<button id="section-content-two" class="btn btn-primary" @onclick="IncrementCount">Click me</button>

@code {
    private int currentCount = 0;

    private void IncrementCount()
    {
        currentCount++;
    }
}
